      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: armor_break-close-06
      textKey: narrative.armor_break.close-06
      englishFallback: Sahrin's warnings are spreading. We have the evidence and
        the choice of our next route. Commander, the citywide response is yours to
        direct.
      speaker: 5
      voiceClip: {fileID: 8300000, guid: 7b3dbe9ac76f04d7ea1ea82eb3a2bf8b, type: 3}
