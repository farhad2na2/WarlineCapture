    - key: ui.v3.recon_assets_confirm_increased_m.b929fb5404
      value: "\u0648\u0627\u062D\u062F\u0647\u0627\u06CC \u0634\u0646\u0627\u0633\u0627\u06CC\u06CC
        \u0627\u0641\u0632\u0627\u06CC\u0634 \u0641\u0639\u0627\u0644\u06CC\u062A
        \u0634\u0628\u0647\u200C\u0646\u0638\u0627\u0645\u06CC\u0627\u0646 \u0627\u0637\u0631\u0627\u0641
        \u067E\u0644 \u0634\u0645\u0627\u0644\u06CC \u0631\u0627 \u062A\u0623\u06CC\u06CC\u062F
        \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F. \u0686\u0646\u062F \u06A9\u0627\u0631\u0648\u0627\u0646
        \u062A\u062F\u0627\u0631\u06A9\u0627\u062A\u06CC \u062F\u0631 \u062D\u0627\u0644
        \u0648\u0631\u0648\u062F \u0628\u0647 \u0628\u062E\u0634 \u06CC\u0627\u0644
        \u0634\u0631\u0642\u06CC \u062F\u06CC\u062F\u0647 \u0634\u062F\u0647\u200C\u0627\u0646\u062F.
        \u067E\u0646\u062C\u0631\u0647 \u062D\u0645\u0644\u0647 \u062F\u0631 \u06F1\u06F2
        \u0633\u0627\u0639\u062A \u0622\u06CC\u0646\u062F\u0647 \u067E\u06CC\u0634\u0646\u0647\u0627\u062F
        \u0645\u06CC\u200C\u0634\u0648\u062F."
