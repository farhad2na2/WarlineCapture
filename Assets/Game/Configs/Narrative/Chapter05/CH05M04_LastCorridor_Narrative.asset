  - stateId: LastCorridor-debrief-1
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: 59bc09e4e09542dc9399c1ce405b3c10
      m_SubObjectName: CH05M04_LastCorridor_Debrief-b-16x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    panel20x9Reference:
      m_AssetGUID: 59bc09e4e09542dc9399c1ce405b3c10
      m_SubObjectName: CH05M04_LastCorridor_Debrief-b-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: last_corridor-debrief-02
      textKey: narrative.last_corridor.debrief-02
      englishFallback: "The repaired link and the protected alternate served the
        same city. Military and relief needs stayed in one plan. The medical teams,
        engineers, pilots and soldiers can now take their final roles without leaving
        Sahrin\u2019s recovery behind."
      speaker: 2
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 16.928572
      essentialCaption: 1
    continueStateId: LastCorridor-debrief-2
    skipStateId: LastCorridor-debrief-complete
    reducedMotionSupported: 1
    durationSeconds: 16.928572
