      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: command_node-brief-06
      textKey: narrative.command_node.brief-06
      englishFallback: The two keys are my preserved archive and your live emergency
        credential. Together they can stop his override without granting permanent
        rule. I will wait for explicit authority.
      speaker: 3
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 12.714286
      essentialCaption: 1
