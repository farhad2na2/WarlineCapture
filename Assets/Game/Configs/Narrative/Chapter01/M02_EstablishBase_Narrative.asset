  sequenceId: seq.ch01.m02.debrief
  entryStateId: M02-DEBRIEF-DIALOGUE
  defaultSkipDestinationId: M02-DEBRIEF-COMPLETE
  states:
  - stateId: M02-DEBRIEF-DIALOGUE
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID:
      m_SubObjectName:
      m_SubObjectType:
      m_SubObjectGUID:
      m_EditorAssetChanged: 0
    panel20x9Reference:
      m_AssetGUID:
      m_SubObjectName:
      m_SubObjectType:
      m_SubObjectGUID:
      m_EditorAssetChanged: 0
    lines:
    - lineId: m02-debrief.line.1
      textKey: narrative.m02.debrief.samira
      englishFallback: The forward post is operational. Clinic and municipal response
        channels are back online.
      speaker: 2
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 3.75
      essentialCaption: 1
    - lineId: m02-debrief.line.2
      textKey: narrative.m02.debrief.dalia
      englishFallback: Commander, Dalia Rahim. I accept the field-lead role. I will
        direct the ground response from this post.
      speaker: 1
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 4
      deadlineSeconds: 7.75
      essentialCaption: 1
    - lineId: m02-debrief.line.3
      textKey: narrative.m02.debrief.aria
      englishFallback: The warning sector toward the next operation has gone dark.
        Armored movement is approaching through it.
      speaker: 3
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 8
      deadlineSeconds: 11.75
      essentialCaption: 1
    continueStateId: M02-DEBRIEF-COMPLETE
    skipStateId: M02-DEBRIEF-COMPLETE
