      "speaker": "ARIA",
      "locale": "en-US",
      "text": "The warning sector is offline. Scouts report an armored convoy on the western road. Our Ground Radar Tank can confirm vehicles once they enter coverage.",
      "voiceId": "Fi9tPTnEcbh3of7hOHC8",
      "voiceName": "Warline - ARIA Civic Relay",
