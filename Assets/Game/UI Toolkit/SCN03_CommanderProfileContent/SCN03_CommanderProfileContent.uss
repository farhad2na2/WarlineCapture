/* ==========================================================================
   SCN-03 Commander/Profile Content - UI Toolkit USS
   New bright command-table art direction.
   This content does not define a header; the shell keeps the Main Menu header.
   ========================================================================== */

.scn03-commander-profile-content {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    -unity-font-definition: url("../../../Synty/InterfaceMilitaryCombatHUD/Fonts/Oxanium/Oxanium-Bold.ttf");
    color: rgb(242, 232, 196);
    background-color: rgb(8, 10, 10);
}

.scn03-commander-profile-content Button {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
}

.background,
.background-shade,
.panel-frame,
.button-frame,
.small-button-frame,
.primary-button-frame,
.secondary-button-frame,
.portrait-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.background {
    left: -1.5%;
    right: -1.5%;
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_background_command_table_no_ui.png");
    -unity-background-scale-mode: scale-and-crop;
}

.background-shade {
    background-color: rgba(5, 7, 7, 0.38);
}

.panel {
    position: absolute;
}

.panel-frame {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_panel_frame_large.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 78;
    -unity-slice-right: 78;
    -unity-slice-top: 60;
    -unity-slice-bottom: 60;
    -unity-slice-scale: 0.40px;
    -unity-background-image-tint-color: rgb(246, 232, 182);
}

.panel-title {
    position: absolute;
    left: 6%;
    right: 6%;
    top: 5%;
    height: 10%;
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(244, 227, 178);
}

.left-content {
    position: absolute;
    left: 1.55%;
    top: 15%;
    width: 16.9%;
    height: 66%;
}

.back-button {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 10%;
}

.button-frame,
.secondary-button-frame {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_nav_button_frame_default.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 130;
    -unity-slice-right: 130;
    -unity-slice-top: 95;
    -unity-slice-bottom: 95;
    -unity-slice-scale: 0.22px;
}

.primary-button-frame {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_cta_primary_gold_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 72;
    -unity-slice-right: 72;
    -unity-slice-top: 36;
    -unity-slice-bottom: 36;
    -unity-slice-scale: 0.38;
}

.button-label {
    position: absolute;
    left: 18%;
    right: 8%;
    top: 0;
    bottom: 0;
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(245, 231, 190);
}

.back-icon {
    position: absolute;
    left: 8%;
    top: 29%;
    width: 13%;
    height: 42%;
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_nav_chevron_icon.png");
    -unity-background-scale-mode: scale-to-fit;
}

.route-strip {
    position: absolute;
    left: 0;
    top: 13%;
    width: 100%;
    height: 76%;
}

.route-strip > .panel-frame {
    visibility: hidden;
}

.profile-tab {
    position: relative;
    width: 100%;
    height: 15.5%;
    margin-left: 0;
    margin-top: 4%;
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_nav_button_frame_default.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 130;
    -unity-slice-right: 130;
    -unity-slice-top: 95;
    -unity-slice-bottom: 95;
    -unity-slice-scale: 0.22px;
}

.profile-tab .panel-frame,
.profile-tab .button-frame,
.profile-tab .small-button-frame,
.profile-tab .secondary-button-frame {
    visibility: hidden;
}

.profile-tab-selected {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_nav_button_frame_selected.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 130;
    -unity-slice-right: 130;
    -unity-slice-top: 95;
    -unity-slice-bottom: 95;
    -unity-slice-scale: 0.22px;
}

.tab-icon {
    position: absolute;
    left: 8%;
    top: 26%;
    width: 16%;
    height: 48%;
    -unity-background-scale-mode: scale-to-fit;
}

.overview-icon { background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_hold_shield.png"); }
.stats-icon { background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_units_group.png"); }
.badge-icon { background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_badge_owned_checkmark.png"); }
.history-icon { background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_attack_reticle.png"); }
.upgrade-icon { background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_upgrades_chevrons.png"); }

.tab-label {
    position: absolute;
    left: 30%;
    right: 8%;
    top: 0;
    bottom: 0;
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(238, 223, 184);
}

.middle-content {
    position: absolute;
    left: 18.4%;
    top: 13%;
    width: 45.2%;
    height: 74%;
}

.right-content {
    position: absolute;
    right: 1.2%;
    top: 13%;
    width: 34%;
    height: 74%;
}

.screen-title {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 5.5%;
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(244, 227, 178);
    white-space: nowrap;
}

.screen-subtitle {
    position: absolute;
    left: 0;
    right: 0;
    top: 5.5%;
    height: 4%;
    font-size: 20px;
    -unity-text-align: middle-left;
    color: rgb(165, 199, 88);
    white-space: nowrap;
}

.identity-panel {
    left: 0;
    top: 10%;
    width: 100%;
    height: 32%;
}

.portrait-panel {
    position: absolute;
    left: 4%;
    top: 12%;
    width: 31%;
    height: 78%;
}

.portrait-frame {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_mode_card_frame_selected.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 62;
    -unity-slice-right: 62;
    -unity-slice-top: 62;
    -unity-slice-bottom: 62;
    -unity-slice-scale: 0.28;
}

.commander-portrait {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 7%;
    bottom: 7%;
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_commander_portrait.png");
    -unity-background-scale-mode: scale-and-crop;
}

.edit-id-button {
    position: absolute;
    right: 8%;
    top: 8%;
    width: 18%;
    height: 18%;
}

.small-button-frame {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_header_square_button_frame_default.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
    -unity-slice-scale: 0.36;
}

.edit-icon {
    position: absolute;
    left: 25%;
    right: 25%;
    top: 25%;
    bottom: 25%;
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_settings_gear_icon.png");
    -unity-background-scale-mode: scale-to-fit;
}

.identity-card {
    position: absolute;
    left: 38%;
    right: 5%;
    top: 16%;
    bottom: 14%;
}

.rank-badge {
    position: absolute;
    left: 0;
    top: 4%;
    width: 18%;
    height: 28%;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_hold_shield.png");
    -unity-background-scale-mode: scale-to-fit;
}

.identity-title,
.identity-name,
.identity-subtitle,
.identity-level {
    position: absolute;
    left: 22%;
    right: 0;
    -unity-font-style: bold;
    white-space: nowrap;
}

.identity-title {
    top: 3%;
    height: 18%;
    font-size: 26px;
    color: rgb(159, 213, 61);
}

.identity-name {
    top: 23%;
    height: 25%;
    font-size: 52px;
    color: rgb(246, 232, 190);
    white-space: nowrap;
}

.identity-subtitle {
    top: 54%;
    height: 20%;
    font-size: 24px;
    color: rgb(206, 194, 159);
    white-space: nowrap;
}

.identity-level {
    top: 78%;
    height: 18%;
    font-size: 28px;
    color: rgb(235, 194, 61);
}

.overview-panel {
    left: 0;
    top: 44%;
    width: 100%;
    height: 26%;
}

.stats-grid {
    position: absolute;
    left: 4%;
    right: 4%;
    top: 20%;
    bottom: 10%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.stat-card {
    width: 48%;
    height: 45%;
    margin-bottom: 3%;
    background-color: rgba(8, 13, 13, 0.72);
}

.stat-value {
    position: absolute;
    left: 5%;
    top: 5%;
    width: 28%;
    height: 42%;
    font-size: 48px;
    color: rgb(235, 194, 61);
    -unity-text-align: middle-center;
}

.stat-label {
    position: absolute;
    left: 37%;
    right: 4%;
    top: 11%;
    height: 30%;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(242, 232, 196);
}

.stat-suffix {
    position: absolute;
    left: 37%;
    right: 4%;
    top: 49%;
    height: 30%;
    font-size: 20px;
    color: rgb(164, 184, 105);
}

.account-panel {
    left: 0;
    bottom: 0;
    width: 100%;
    height: 30%;
}

.ability-rows {
    position: absolute;
    left: 4%;
    right: 4%;
    top: 22%;
    bottom: 9%;
}

.ability-row {
    position: relative;
    width: 100%;
    height: 28%;
    margin-bottom: 2.5%;
    background-color: rgba(7, 11, 11, 0.66);
}

.ability-icon {
    position: absolute;
    left: 3%;
    top: 18%;
    width: 8%;
    height: 64%;
    -unity-background-scale-mode: scale-to-fit;
}

.readiness-icon { background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_badge_owned_checkmark.png"); }
.operations-icon { background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_buildings.png"); }
.skirmish-icon { background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_attack_reticle.png"); }

.ability-label {
    position: absolute;
    left: 14%;
    top: 0;
    width: 52%;
    height: 100%;
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.ability-value {
    position: absolute;
    right: 5%;
    top: 0;
    width: 24%;
    height: 100%;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: rgb(159, 213, 61);
}

.reward-track-panel {
    left: 0;
    top: 0;
    width: 100%;
    height: 48%;
}

.xp-progress {
    position: absolute;
    left: 6%;
    right: 6%;
    top: 19%;
    height: 18%;
}

.xp-track {
    position: absolute;
    left: 0;
    right: 0;
    top: 8%;
    height: 42%;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_progress_meter_empty_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 42;
    -unity-slice-right: 42;
    -unity-slice-top: 20;
    -unity-slice-bottom: 20;
    -unity-slice-scale: 0.40;
}

.xp-fill {
    position: absolute;
    left: 2%;
    top: 23%;
    width: 82%;
    height: 54%;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_progress_fill_olive_segment.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.xp-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 54%;
    height: 42%;
    font-size: 22px;
    -unity-text-align: middle-center;
    color: rgb(231, 218, 178);
}

.reward-nodes {
    position: absolute;
    left: 7%;
    right: 7%;
    top: 41%;
    height: 19%;
    flex-direction: row;
    justify-content: space-between;
}

.reward-node {
    position: relative;
    width: 14%;
    height: 100%;
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_header_square_button_frame_default.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
    -unity-slice-scale: 0.24;
}

.reward-active {
    -unity-background-image-tint-color: rgb(159, 213, 61);
}

.reward-locked {
    opacity: 0.55;
}

.reward-level {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.reward-text {
    position: absolute;
    left: 7%;
    right: 7%;
    top: 64%;
    height: 14%;
    font-size: 24px;
    -unity-text-align: middle-center;
}

.claim-button {
    position: absolute;
    left: 24%;
    width: 52%;
    bottom: 8%;
    height: 17%;
}

.recent-history-panel {
    left: 0;
    bottom: 0;
    width: 100%;
    height: 49%;
}

.history-row {
    position: relative;
    width: 88%;
    height: 29%;
    margin-left: 6%;
    margin-top: 16%;
    background-color: rgba(6, 10, 10, 0.66);
}

.history-title {
    position: absolute;
    left: 5%;
    right: 20%;
    top: 8%;
    height: 32%;
    font-size: 26px;
    -unity-font-style: bold;
}

.history-subtitle {
    position: absolute;
    left: 5%;
    right: 5%;
    top: 45%;
    height: 28%;
    font-size: 20px;
    color: rgb(198, 188, 156);
}

.history-time {
    position: absolute;
    right: 5%;
    top: 9%;
    width: 18%;
    height: 28%;
    font-size: 20px;
    -unity-text-align: middle-right;
    color: rgb(159, 213, 61);
}

.footer-content {
    position: absolute;
    left: 18.4%;
    right: 1.2%;
    bottom: 2%;
    height: 9%;
    flex-direction: row;
    justify-content: flex-end;
}

.footer-action {
    position: relative;
    width: 22%;
    height: 100%;
    margin-left: 2%;
}

.footer-icon {
    position: absolute;
    left: 9%;
    top: 26%;
    width: 13%;
    height: 48%;
    -unity-background-scale-mode: scale-to-fit;
}

.armory-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_armory_crossed_weapons.png");
}
