.scn09-build-drawer-popup {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    -unity-font-definition: url("../../../Synty/InterfaceMilitaryCombatHUD/Fonts/Oxanium/Oxanium-Medium.ttf");
    color: rgb(225, 220, 195);
    background-color: rgba(0, 0, 0, 0);
}

.scn09-build-drawer-popup Button,
.catalog-item-view {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
}

.build-drawer-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.drawer-frame {
    position: absolute;
    right: 10.4%;
    top: 15%;
    width: 51.25%;
    height: 69.9%;
}

.outer-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Panels/scn09_panel_detail_tall_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 58;
    -unity-slice-bottom: 58;
}

.build-icon {
    position: absolute;
    left: 1.8%;
    top: 3.3%;
    width: 3.7%;
    height: 6%;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_06_icon_build_tools.png");
    -unity-background-scale-mode: scale-to-fit;
}

.drawer-title {
    position: absolute;
    left: 7%;
    top: 3.4%;
    width: 14.6%;
    height: 4.4%;
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(239, 233, 204);
}

.drawer-subtitle {
    position: absolute;
    left: 7%;
    top: 6.4%;
    width: 29.3%;
    height: 2.9%;
    font-size: 18px;
    -unity-text-align: middle-left;
    color: rgba(203, 214, 203, 0.82);
}

.left-panel {
    position: absolute;
    left: 2%;
    top: 12.4%;
    width: 54.6%;
    bottom: 11.6%;
}

.tabs {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 10.6%;
    flex-direction: row;
    justify-content: space-between;
}

.drawer-tab {
    position: relative;
    width: 24.3%;
    height: 100%;
}

.tab-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Panels/scn09_panel_secondary_button_bg.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 16;
    -unity-slice-bottom: 16;
}

.drawer-tab-selected .tab-frame {
    background-image: url("../../Art/UI/Panels/scn09_panel_gold_action_button_bg.png");
}

.tab-icon {
    position: absolute;
    left: 9%;
    top: 22%;
    width: 15%;
    height: 56%;
    -unity-background-scale-mode: scale-to-fit;
}

.aircrafts-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_aircraft_helicopter.png");
}

.vehicles-icon {
    background-image: url("../../Art/UI/Generated/CommanderProfile/TargetLockV01/scn03_icon_12_vehicle.png");
}

.soldiers-icon {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_11_icon_squad_group.png");
}

.buildings-icon {
    background-image: url("../../Art/UI/Generated/CommanderProfile/TargetLockV01/scn03_icon_13_building.png");
}

.tab-label {
    position: absolute;
    left: 29%;
    right: 6%;
    top: 0;
    bottom: 0;
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(232, 226, 198);
}

.catalog-scroll-view {
    position: absolute;
    left: 0.3%;
    right: 0.3%;
    top: 14.6%;
    bottom: 12.9%;
}

.catalog-scroll-view .unity-scroll-view__vertical-scroller,
.catalog-scroll-view .unity-scroll-view__horizontal-scroller,
.production-scroll-view .unity-scroll-view__vertical-scroller,
.production-scroll-view .unity-scroll-view__horizontal-scroller {
    display: none;
}

.catalog-scroll-view > .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

.catalog-content {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    padding-left: 2px;
    padding-right: 2px;
    padding-top: 0;
    padding-bottom: 30px;
}

.catalog-item-view {
    position: relative;
    width: 330px;
    height: 430px;
    margin-right: 22px;
    margin-bottom: 22px;
    overflow: hidden;
}

.catalog-item-frame,
.catalog-thumb,
.catalog-top-overlay,
.catalog-bottom-overlay {
    position: absolute;
}

.catalog-item-frame {
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Panels/scn09_build_card_frame_normal.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 36;
    -unity-slice-right: 36;
    -unity-slice-top: 34;
    -unity-slice-bottom: 34;
}

.catalog-item-view.selected .catalog-item-frame {
    background-image: url("../../Art/UI/Panels/scn09_build_card_frame_selected_check.png");
}

.catalog-thumb {
    left: 7%;
    right: 7%;
    top: 7%;
    height: 65%;
    background-image: url("../../Art/UI/Portraits/Secondary/Portrait_Unit_Chr_Soldier_Female_01_Alt_01_Rifle_Card_512.png");
    -unity-background-scale-mode: scale-and-crop;
}

.catalog-top-overlay {
    left: 7%;
    right: 7%;
    top: 7%;
    height: 44%;
    background-image: url("../../../Synty/InterfaceMilitaryCombatHUD/Sprites/HUD/SPR_HUD_MilitaryCombat_Gradient_Horizontal_01.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.58);
}

.catalog-bottom-overlay {
    left: 4.5%;
    right: 4.5%;
    bottom: 5.5%;
    height: 34%;
    background-image: url("../../../Synty/InterfaceMilitaryCombatHUD/Sprites/HUD/SPR_HUD_MilitaryCombat_Gradient_Vertical_Solid_02.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(0, 0, 0, 0.72);
}

.catalog-title {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 74%;
    height: 9%;
    font-size: 23px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(238, 232, 203);
}

.catalog-role {
    position: absolute;
