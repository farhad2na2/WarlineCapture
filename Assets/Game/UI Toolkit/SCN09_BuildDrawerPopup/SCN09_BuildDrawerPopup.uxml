<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="SCN09_BuildDrawerPopup.uss" />
    <ui:Template name="BuildCatalogItemView" src="SCN09_BuildCatalogItemView.uxml" />
    <ui:Template name="ProductionQueueItemView" src="SCN09_ProductionQueueItemView.uxml" />
    <ui:Template name="ProductionActiveItemView" src="SCN09_ProductionActiveItemView.uxml" />

    <ui:VisualElement name="SCN09_BuildDrawerPopup" class="scn09-build-drawer-popup">
        <ui:VisualElement name="BuildDrawerRoot" class="build-drawer-root">
            <ui:VisualElement name="DrawerFrame" class="drawer-frame">
                <ui:VisualElement name="OuterFrame" class="outer-frame">
                    <ui:VisualElement name="BuildIcon" class="build-icon" />
                    <ui:Label name="Title" class="drawer-title" text="BUILD DRAWER" />
                    <ui:Label name="Subtitle" class="drawer-subtitle" text="Production and field placement" />
                </ui:VisualElement>

                <ui:VisualElement name="LeftPanel" class="left-panel">
                    <ui:VisualElement name="Tabs" class="tabs">
                        <ui:Button name="AircraftsTab" class="drawer-tab" text="">
                            <ui:VisualElement name="Frame" class="tab-frame" />
                            <ui:VisualElement name="Icon" class="tab-icon aircrafts-icon" />
                            <ui:Label name="Label" class="tab-label" text="AIRCRAFTS" />
                        </ui:Button>
                        <ui:Button name="VehiclesTab" class="drawer-tab" text="">
                            <ui:VisualElement name="Frame" class="tab-frame" />
                            <ui:VisualElement name="Icon" class="tab-icon vehicles-icon" />
                            <ui:Label name="Label" class="tab-label" text="VEHICLES" />
                        </ui:Button>
                        <ui:Button name="SoldiersTab" class="drawer-tab" text="">
                            <ui:VisualElement name="Frame" class="tab-frame" />
                            <ui:VisualElement name="Icon" class="tab-icon soldiers-icon" />
                            <ui:Label name="Label" class="tab-label" text="SOLDIERS" />
                        </ui:Button>
                        <ui:Button name="BuildingsTab" class="drawer-tab drawer-tab-selected" text="">
                            <ui:VisualElement name="Frame" class="tab-frame" />
                            <ui:VisualElement name="Icon" class="tab-icon buildings-icon" />
                            <ui:Label name="Label" class="tab-label" text="BUILDINGS" />
                        </ui:Button>
                    </ui:VisualElement>

                    <ui:ScrollView name="CatalogScrollView" class="catalog-scroll-view" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                        <ui:VisualElement name="Content" class="catalog-content">
                            <ui:Button name="ItemView" class="catalog-item-view selected" text="">
                                <ui:VisualElement name="Frame" class="catalog-item-frame" />
                                <ui:VisualElement name="Thumb" class="catalog-thumb thumb-watchtower" />
                                <ui:VisualElement name="TopOverlay" class="catalog-top-overlay" />
                                <ui:VisualElement name="BottomOverlay" class="catalog-bottom-overlay" />
                                <ui:Label name="Title" class="catalog-title" text="GUARD TOWER" />
                                <ui:Label name="Role" class="catalog-role" text="Defensive structure" />
                                <ui:VisualElement name="CostPanel" class="catalog-cost-panel">
                                    <ui:VisualElement name="CreditsTinyCost" class="tiny-cost">
                                        <ui:VisualElement name="Icon" class="tiny-cost-icon credits-icon" />
                                        <ui:Label name="Value" class="tiny-cost-value" text="350" />
                                    </ui:VisualElement>
                                    <ui:VisualElement name="SuppliesTinyCost" class="tiny-cost">
                                        <ui:VisualElement name="Icon" class="tiny-cost-icon supplies-icon" />
                                        <ui:Label name="Value" class="tiny-cost-value" text="80" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement name="TimeTinyCost" class="time-tiny-cost">
                                    <ui:VisualElement name="Icon" class="tiny-cost-icon time-icon" />
                                    <ui:Label name="Value" class="tiny-cost-value" text="00:30" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Button name="ItemView_1" class="catalog-item-view" text="">
                                <ui:VisualElement name="Frame" class="catalog-item-frame" />
                                <ui:VisualElement name="Thumb" class="catalog-thumb thumb-barracks" />
                                <ui:VisualElement name="TopOverlay" class="catalog-top-overlay" />
                                <ui:VisualElement name="BottomOverlay" class="catalog-bottom-overlay" />
                                <ui:Label name="Title" class="catalog-title" text="BARRACKS" />
                                <ui:Label name="Role" class="catalog-role" text="Infantry production" />
                                <ui:VisualElement name="CostPanel" class="catalog-cost-panel">
                                    <ui:VisualElement name="CreditsTinyCost" class="tiny-cost">
                                        <ui:VisualElement name="Icon" class="tiny-cost-icon credits-icon" />
                                        <ui:Label name="Value" class="tiny-cost-value" text="450" />
                                    </ui:VisualElement>
                                    <ui:VisualElement name="SuppliesTinyCost" class="tiny-cost">
                                        <ui:VisualElement name="Icon" class="tiny-cost-icon supplies-icon" />
                                        <ui:Label name="Value" class="tiny-cost-value" text="120" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement name="TimeTinyCost" class="time-tiny-cost">
                                    <ui:VisualElement name="Icon" class="tiny-cost-icon time-icon" />
                                    <ui:Label name="Value" class="tiny-cost-value" text="00:45" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Button name="ItemView_2" class="catalog-item-view" text="">
                                <ui:VisualElement name="Frame" class="catalog-item-frame" />
                                <ui:VisualElement name="Thumb" class="catalog-thumb thumb-vehicle-depot" />
                                <ui:VisualElement name="TopOverlay" class="catalog-top-overlay" />
                                <ui:VisualElement name="BottomOverlay" class="catalog-bottom-overlay" />
                                <ui:Label name="Title" class="catalog-title" text="VEHICLE DEPOT" />
                                <ui:Label name="Role" class="catalog-role" text="Armor production" />
                                <ui:VisualElement name="CostPanel" class="catalog-cost-panel">
                                    <ui:VisualElement name="CreditsTinyCost" class="tiny-cost">
                                        <ui:VisualElement name="Icon" class="tiny-cost-icon credits-icon" />
                                        <ui:Label name="Value" class="tiny-cost-value" text="700" />
                                    </ui:VisualElement>
                                    <ui:VisualElement name="SuppliesTinyCost" class="tiny-cost">
                                        <ui:VisualElement name="Icon" class="tiny-cost-icon supplies-icon" />
                                        <ui:Label name="Value" class="tiny-cost-value" text="180" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement name="TimeTinyCost" class="time-tiny-cost">
                                    <ui:VisualElement name="Icon" class="tiny-cost-icon time-icon" />
                                    <ui:Label name="Value" class="tiny-cost-value" text="01:10" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Button name="ItemView_3" class="catalog-item-view" text="">
                                <ui:VisualElement name="Frame" class="catalog-item-frame" />
                                <ui:VisualElement name="Thumb" class="catalog-thumb thumb-supply-depot" />
                                <ui:VisualElement name="TopOverlay" class="catalog-top-overlay" />
                                <ui:VisualElement name="BottomOverlay" class="catalog-bottom-overlay" />
                                <ui:Label name="Title" class="catalog-title" text="SUPPLY DEPOT" />
                                <ui:Label name="Role" class="catalog-role" text="Logistics storage" />
                                <ui:VisualElement name="CostPanel" class="catalog-cost-panel">
                                    <ui:VisualElement name="CreditsTinyCost" class="tiny-cost">
                                        <ui:VisualElement name="Icon" class="tiny-cost-icon credits-icon" />
                                        <ui:Label name="Value" class="tiny-cost-value" text="500" />
                                    </ui:VisualElement>
                                    <ui:VisualElement name="SuppliesTinyCost" class="tiny-cost">
                                        <ui:VisualElement name="Icon" class="tiny-cost-icon supplies-icon" />
                                        <ui:Label name="Value" class="tiny-cost-value" text="150" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement name="TimeTinyCost" class="time-tiny-cost">
                                    <ui:VisualElement name="Icon" class="tiny-cost-icon time-icon" />
                                    <ui:Label name="Value" class="tiny-cost-value" text="00:55" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Button name="ItemView_4" class="catalog-item-view" text="">
                                <ui:VisualElement name="Frame" class="catalog-item-frame" />
                                <ui:VisualElement name="Thumb" class="catalog-thumb thumb-oil-pump" />
                                <ui:VisualElement name="TopOverlay" class="catalog-top-overlay" />
                                <ui:VisualElement name="BottomOverlay" class="catalog-bottom-overlay" />
                                <ui:Label name="Title" class="catalog-title" text="OIL PUMP" />
                                <ui:Label name="Role" class="catalog-role" text="Fuel extraction" />
                                <ui:VisualElement name="CostPanel" class="catalog-cost-panel">
                                    <ui:VisualElement name="CreditsTinyCost" class="tiny-cost">
                                        <ui:VisualElement name="Icon" class="tiny-cost-icon credits-icon" />
                                        <ui:Label name="Value" class="tiny-cost-value" text="600" />
                                    </ui:VisualElement>
                                    <ui:VisualElement name="SuppliesTinyCost" class="tiny-cost">
                                        <ui:VisualElement name="Icon" class="tiny-cost-icon supplies-icon" />
                                        <ui:Label name="Value" class="tiny-cost-value" text="200" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement name="TimeTinyCost" class="time-tiny-cost">
                                    <ui:VisualElement name="Icon" class="tiny-cost-icon time-icon" />
                                    <ui:Label name="Value" class="tiny-cost-value" text="01:00" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Button name="ItemView_5" class="catalog-item-view" text="">
                                <ui:VisualElement name="Frame" class="catalog-item-frame" />
                                <ui:VisualElement name="Thumb" class="catalog-thumb thumb-fuel-bladder" />
                                <ui:VisualElement name="TopOverlay" class="catalog-top-overlay" />
                                <ui:VisualElement name="BottomOverlay" class="catalog-bottom-overlay" />
                                <ui:Label name="Title" class="catalog-title" text="FUEL BLADDER" />
                                <ui:Label name="Role" class="catalog-role" text="Fuel reserve" />
                                <ui:VisualElement name="CostPanel" class="catalog-cost-panel">
                                    <ui:VisualElement name="CreditsTinyCost" class="tiny-cost">
                                        <ui:VisualElement name="Icon" class="tiny-cost-icon credits-icon" />
                                        <ui:Label name="Value" class="tiny-cost-value" text="400" />
                                    </ui:VisualElement>
                                    <ui:VisualElement name="SuppliesTinyCost" class="tiny-cost">
                                        <ui:VisualElement name="Icon" class="tiny-cost-icon supplies-icon" />
                                        <ui:Label name="Value" class="tiny-cost-value" text="100" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement name="TimeTinyCost" class="time-tiny-cost">
                                    <ui:VisualElement name="Icon" class="tiny-cost-icon time-icon" />
                                    <ui:Label name="Value" class="tiny-cost-value" text="00:40" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Button name="ItemView_6" class="catalog-item-view" text="">
                                <ui:VisualElement name="Frame" class="catalog-item-frame" />
                                <ui:VisualElement name="Thumb" class="catalog-thumb thumb-radar" />
                                <ui:VisualElement name="TopOverlay" class="catalog-top-overlay" />
                                <ui:VisualElement name="BottomOverlay" class="catalog-bottom-overlay" />
                                <ui:Label name="Title" class="catalog-title" text="RADAR ARRAY" />
                                <ui:Label name="Role" class="catalog-role" text="Detection grid" />
                                <ui:VisualElement name="CostPanel" class="catalog-cost-panel">
                                    <ui:VisualElement name="CreditsTinyCost" class="tiny-cost">
                                        <ui:VisualElement name="Icon" class="tiny-cost-icon credits-icon" />
                                        <ui:Label name="Value" class="tiny-cost-value" text="900" />
                                    </ui:VisualElement>
                                    <ui:VisualElement name="SuppliesTinyCost" class="tiny-cost">
                                        <ui:VisualElement name="Icon" class="tiny-cost-icon supplies-icon" />
                                        <ui:Label name="Value" class="tiny-cost-value" text="250" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement name="TimeTinyCost" class="time-tiny-cost">
                                    <ui:VisualElement name="Icon" class="tiny-cost-icon time-icon" />
                                    <ui:Label name="Value" class="tiny-cost-value" text="01:30" />
                                </ui:VisualElement>
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:ScrollView>

                    <ui:VisualElement name="InstructionStrip" class="instruction-strip">
                        <ui:VisualElement name="Frame" class="instruction-frame">
                            <ui:VisualElement name="CursorIcon" class="instruction-cursor-icon" />
                            <ui:VisualElement name="Icon" class="instruction-info-icon" />
                            <ui:Label name="Instruction" class="instruction-text" text="Select a building, choose a valid footprint, then confirm placement." />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="RightPanel" class="right-panel">
                    <ui:VisualElement name="BuildPanel" class="build-panel">
                        <ui:Label name="Name" class="build-name" text="OIL REFINERY" />
                        <ui:Label name="Role" class="build-role" text="RESOURCE STRUCTURE" />
                        <ui:VisualElement name="Preview" class="build-preview">
                            <ui:VisualElement name="PreviewOverlay" class="preview-overlay" />
                            <ui:Label name="Description" class="build-description" text="Turns Oil into Fuel and feeds vehicle production during extended field" />
                            <ui:VisualElement name="PreviewBorder" class="preview-border" />
                        </ui:VisualElement>

                        <ui:VisualElement name="Panel" class="build-detail-list">
                            <ui:VisualElement name="SizePanel" class="build-detail-row">
                                <ui:VisualElement name="Icon" class="detail-icon footprint-icon" />
                                <ui:Label name="Label" class="detail-label" text="FOOTPRINT" />
                                <ui:Label name="Value" class="detail-value" text="4x4" />
                            </ui:VisualElement>
                            <ui:VisualElement class="detail-divider" />
                            <ui:VisualElement name="RequirementsPanel" class="build-detail-row">
                                <ui:Label name="Label" class="detail-label" text="REQUIREMENTS" />
                                <ui:Label name="Placement" class="detail-value wide-value" text="Oil Pump" />
                            </ui:VisualElement>
                            <ui:VisualElement class="detail-divider" />
                            <ui:VisualElement name="PlacementPanel" class="build-detail-row">
                                <ui:VisualElement name="Icon" class="detail-icon placement-corners-icon" />
                                <ui:Label name="Label" class="detail-label" text="PLACEMENT" />
                                <ui:Label name="Placement" class="detail-value wide-value" text="PLACE ON VALID GROUND" />
                            </ui:VisualElement>
                            <ui:VisualElement class="detail-divider" />
                            <ui:VisualElement name="ProductionTimePanel" class="build-detail-row">
                                <ui:Label name="Label" class="detail-label" text="PRODUCTION TIME" />
                                <ui:VisualElement name="TimePanel" class="detail-inline-value">
                                    <ui:VisualElement name="Icon" class="detail-small-icon time-icon" />
                                    <ui:Label name="Value" class="detail-value" text="00:00" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="detail-divider" />
                            <ui:VisualElement name="CostPanel" class="build-detail-row">
                                <ui:Label name="Label" class="detail-label" text="COST" />
                                <ui:VisualElement name="CreditsCost" class="detail-inline-value credits-cost">
                                    <ui:VisualElement name="Icon" class="detail-small-icon credits-icon" />
                                    <ui:Label name="Value" class="detail-value" text="2,000" />
                                </ui:VisualElement>
                                <ui:VisualElement name="SuppliesCost" class="detail-inline-value supplies-cost">
                                    <ui:VisualElement name="Icon" class="detail-small-icon supplies-icon" />
                                    <ui:Label name="Value" class="detail-value" text="2,000" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:Button name="BuildButton" class="build-action-button" text="">
                            <ui:VisualElement name="Frame" class="gold-button-frame" />
                            <ui:Label name="Label" class="build-action-label" text="BUILD" />
                        </ui:Button>
                    </ui:VisualElement>

                    <ui:VisualElement name="ProductionPanel" class="production-panel">
                        <ui:Label name="NoProduction" class="no-production-label" text="NO PRODUCTION QUEUED" />
                        <ui:VisualElement name="ProductionPanelActive" class="production-panel-active">
                            <ui:Label name="Name" class="production-title" text="PRODUCTION QUEUE" />
                            <ui:Label name="Numbers" class="production-count" text="4/6" />
                            <ui:VisualElement name="Icon" class="production-info-icon" />

                            <ui:ScrollView name="ProductionScrollView" class="production-scroll-view" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                                <ui:VisualElement name="Content" class="production-content">
                                    <ui:Instance name="ProductionActiveItemView" template="ProductionActiveItemView" />
                                    <ui:Instance name="ProductionItemView" template="ProductionQueueItemView" />
                                    <ui:Instance name="ProductionItemView_1" template="ProductionQueueItemView" />
                                </ui:VisualElement>
                            </ui:ScrollView>

                            <ui:VisualElement name="ButtonsPanel" class="production-buttons-panel">
                                <ui:Button name="RushButton" class="production-action rush-button" text="">
                                    <ui:VisualElement name="Frame" class="rush-frame" />
                                    <ui:VisualElement name="Icon" class="rush-icon" />
                                    <ui:Label name="Label" class="production-action-label" text="Rush All" />
                                </ui:Button>
                                <ui:Button name="ClearButton" class="production-action clear-button" text="">
                                    <ui:VisualElement name="Frame" class="clear-frame" />
                                    <ui:VisualElement name="Icon" class="clear-icon" />
                                    <ui:Label name="Label" class="production-action-label" text="Clear All" />
                                </ui:Button>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Button name="CloseButton" class="close-button" text="">
                    <ui:VisualElement name="Frame" class="close-frame" />
                    <ui:VisualElement name="Icon" class="close-icon" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
