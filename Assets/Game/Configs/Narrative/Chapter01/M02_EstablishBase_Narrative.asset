  m_Script: {fileID: 11500000, guid: 20e5e009672574912bfa24f3c91ec02a, type: 3}
  m_Name: M02_EstablishBase_Narrative
  m_EditorClassIdentifier: Game.Configs::Game.Configs.NarrativeSequenceConfig
  sequenceId: seq.ch01.m02.brief
  entryStateId: M02-BRIEF-DIALOGUE
  defaultSkipDestinationId: M02-BRIEF-COMPLETE
  states:
  - stateId: M02-BRIEF-DIALOGUE
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID:
      m_SubObjectName:
      m_SubObjectType:
      m_SubObjectGUID:
      m_EditorAssetChanged: 0
    panel20x9Reference:
      m_AssetGUID:
      m_SubObjectName:
      m_SubObjectType:
      m_SubObjectGUID:
      m_EditorAssetChanged: 0
    lines:
    - lineId: m02-brief.line.1
      textKey: narrative.m02.brief.dalia
      englishFallback: The abandoned JRC forward post is the only command point left
        on this district edge. Restore it, then hold its defense lane.
      speaker: 1
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 3.75
      essentialCaption: 1
    - lineId: m02-brief.line.2
      textKey: narrative.m02.brief.aria
      englishFallback: Once the Barracks and rifle squad are operational, the post
        can restore local response channels.
      speaker: 3
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 4
      deadlineSeconds: 7.75
      essentialCaption: 1
    - lineId: m02-brief.line.3
      textKey: narrative.m02.brief.samira
      englishFallback: This post protects the clinic route and municipal crews still
        moving through Old Market. Reopening it is a civic lifeline, not only a military
        position.
      speaker: 2
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 8
      deadlineSeconds: 11.75
      essentialCaption: 1
    continueStateId: M02-BRIEF-COMPLETE
    skipStateId: M02-BRIEF-COMPLETE
    reducedMotionSupported: 1
    durationSeconds: 12
    motionPreset: 0
