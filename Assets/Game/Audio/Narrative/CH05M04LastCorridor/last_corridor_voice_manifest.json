      "id": "last_corridor-debrief-01",
      "speaker": "DALIA",
      "locale": "en-US",
      "text": "Medicine, Fuel and the original reinforcements reached the receiving points. The engineer and physical authority keys arrived in the original APC. All five delivery categories are accounted for, and the column reached the city center before the corridor closed.",
      "voiceId": "MK1Zvh93428YrgOQ8Obr",
      "voiceName": "Warline - Major Dalia Rahim",
      "assetPath": "Assets/Game/Audio/Narrative/CH05M04LastCorridor/Voice/en/last_corridor-debrief-01.wav",
