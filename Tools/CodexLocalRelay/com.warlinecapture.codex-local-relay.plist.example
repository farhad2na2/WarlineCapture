<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.warlinecapture.codex-local-relay</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/farhad/Projects/WarlineCapture/Tools/CodexLocalRelay/codex_local_relay.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/farhad/Projects/WarlineCapture</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/private/tmp/codex-local-relay/launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>/private/tmp/codex-local-relay/launchd.err.log</string>
</dict>
</plist>
