    - key: ui.skirmish.catalog.rifle_squad
      value: "\u06AF\u0631\u0648\u0647 \u062A\u0641\u0646\u06AF\u062F\u0627\u0631
        (\u06F4 \u0646\u0641\u0631)"
    - key: ui.skirmish.city_crossroads_map
      value: "\u0686\u0647\u0627\u0631\u0631\u0627\u0647 \u0634\u0647\u0631"
    - key: ui.skirmish.confirm
      value: "\u062A\u0623\u06CC\u06CC\u062F"
    - key: ui.skirmish.enemy_base
      value: "\u067E\u0627\u06CC\u06AF\u0627\u0647 \u062F\u0634\u0645\u0646"
    - key: ui.skirmish.fog_description
      value: "\u0645\u0646\u0627\u0637\u0642 \u06A9\u0634\u0641\u200C\u0646\u0634\u062F\u0647
        \u0631\u0648 \u067E\u0646\u0647\u0627\u0646 \u06A9\u0646."
    - key: ui.skirmish.fog_of_war
      value: "\u0645\u0647 \u062C\u0646\u06AF"
    - key: ui.skirmish.guide.1.body
      value: "\u067E\u0627\u06CC\u06AF\u0627\u0647 \u0627\u0635\u0644\u06CC\u0650
        \u0639\u0644\u0627\u0645\u062A\u200C\u062E\u0648\u0631\u062F\u0647\u0654
        \u062F\u0634\u0645\u0646 \u0631\u0648 \u0646\u0627\u0628\u0648\u062F \u06A9\u0646
        \u0648 \u0645\u0631\u0627\u0642\u0628 \u067E\u0627\u06CC\u06AF\u0627\u0647
        \u062E\u0648\u062F\u062A \u0628\u0627\u0634. \u0633\u0631\u0628\u0627\u0632\u062E\u0627\u0646\u0647\u0654
        \u0627\u0636\u0627\u0641\u0647 \u062C\u0627\u06CC \u067E\u0627\u06CC\u06AF\u0627\u0647
        \u0627\u0635\u0644\u06CC\u062A \u0631\u0648 \u0646\u0645\u06CC\u200C\u06AF\u06CC\u0631\u0647.
        \u0627\u06AF\u0647 \u062A\u0627 \u067E\u0627\u06CC\u0627\u0646 \u0632\u0645\u0627\u0646
        \u0647\u06CC\u0686\u200C\u06A9\u062F\u0648\u0645 \u0646\u0627\u0628\u0648\u062F
        \u0646\u0634\u0647\u060C \u0628\u0627\u0632\u06CC \u0645\u0633\u0627\u0648\u06CC
        \u0645\u06CC\u200C\u0634\u0647."
    - key: ui.skirmish.guide.1.diagram
      value: "\u0627\u0632 \u067E\u0627\u06CC\u06AF\u0627\u0647\u062A \u062F\u0641\u0627\u0639
        \u06A9\u0646 \u2190 \u062F\u0641\u0627\u0639 \u062F\u0634\u0645\u0646 \u0631\u0648
        \u0628\u0634\u06A9\u0646 \u2190 \u067E\u0627\u06CC\u06AF\u0627\u0647 \u062F\u0634\u0645\u0646
        \u0631\u0648 \u0646\u0627\u0628\u0648\u062F \u06A9\u0646"
    - key: ui.skirmish.guide.1.example
      value: "\u0628\u0627\u0644\u0627\u06CC \u0645\u06CC\u062F\u0627\u0646\u060C
        \xAB\u067E\u0627\u06CC\u06AF\u0627\u0647 \u062E\u0648\u062F\u062A\xBB \u06CC\u0627
        \xAB\u067E\u0627\u06CC\u06AF\u0627\u0647 \u062F\u0634\u0645\u0646\xBB \u0631\u0648
        \u0628\u0632\u0646 \u062A\u0627 \u067E\u06CC\u062F\u0627\u0634 \u06A9\u0646\u06CC.
        \u0627\u0632 \u0646\u0642\u0634\u0647 \u0628\u0631\u0627\u06CC \u0627\u0646\u062A\u062E\u0627\u0628
        \u0645\u0633\u06CC\u0631 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u06A9\u0646."
    - key: ui.skirmish.guide.1.mistake
      value: "\u0644\u0627\u0632\u0645 \u0646\u06CC\u0633\u062A \u0647\u0645\u0647\u0654
        \u0646\u06CC\u0631\u0648\u0647\u0627 \u06CC\u0627 \u0633\u0627\u062E\u062A\u0645\u0627\u0646\u200C\u0647\u0627\u06CC
        \u062A\u062F\u0627\u0631\u06A9\u0627\u062A\u06CC \u062F\u0634\u0645\u0646
        \u0631\u0648 \u0646\u0627\u0628\u0648\u062F \u06A9\u0646\u06CC. \u0647\u062F\u0641
        \u0647\u0645\u0648\u0646 \u067E\u0627\u06CC\u06AF\u0627\u0647 \u0627\u0635\u0644\u06CC\u0650
        \u0639\u0644\u0627\u0645\u062A\u200C\u062E\u0648\u0631\u062F\u0647\u200C\u0633\u062A."
    - key: ui.skirmish.guide.1.title
      value: "\u0628\u0627\u0632\u06CC \u0631\u0648 \u0628\u0628\u0631"
    - key: ui.skirmish.guide.2.body
      value: "\u06A9\u0627\u0631\u062A \u06AF\u0631\u0648\u0647 \u0631\u0648 \u0628\u0632\u0646
        \u062A\u0627 \u0627\u0646\u062A\u062E\u0627\u0628 \u0628\u0634\u0647. \u0628\u0631\u0627\u06CC
        \u062C\u0627\u0628\u0647\u200C\u062C\u0627\u06CC\u06CC\u060C \xAB\u062D\u0631\u06A9\u062A\xBB
        \u0631\u0648 \u0628\u0632\u0646 \u0648 \u0628\u0639\u062F \u0645\u0642\u0635\u062F
        \u0631\u0648 \u0631\u0648\u06CC \u0632\u0645\u06CC\u0646 \u0627\u0646\u062A\u062E\u0627\u0628
        \u06A9\u0646. \u0628\u0631\u0627\u06CC \u062F\u0631\u06AF\u06CC\u0631\u06CC\u060C
        \xAB\u062D\u0645\u0644\u0647\xBB \u0631\u0648 \u0628\u0632\u0646 \u0648 \u0628\u0639\u062F
        \u062F\u0634\u0645\u0646 \u0631\u0648 \u0627\u0646\u062A\u062E\u0627\u0628
        \u06A9\u0646. \xAB\u062D\u0641\u0638\xBB \u06AF\u0631\u0648\u0647 \u0631\u0648
        \u0633\u0631 \u062C\u0627\u0634 \u0646\u06AF\u0647 \u0645\u06CC\u200C\u062F\u0627\u0631\u0647
        \u0648 \u0628\u0647 \u062F\u0634\u0645\u0646\u0650 \u062A\u0648\u06CC \u0628\u0631\u062F
        \u0634\u0644\u06CC\u06A9 \u0645\u06CC\u200C\u06A9\u0646\u0647."
    - key: ui.skirmish.guide.2.diagram
      value: "\u06A9\u0627\u0631\u062A \u06AF\u0631\u0648\u0647 \u2190 \u0641\u0631\u0645\u0627\u0646
        \u2190 \u0645\u0642\u0635\u062F \u06CC\u0627 \u062F\u0634\u0645\u0646"
    - key: ui.skirmish.guide.2.example
      value: "\u06AF\u0631\u0648\u0647\u200C\u0647\u0627 \u0631\u0648 \u0628\u06CC\u0631\u0648\u0646
        \u0627\u0632 \u0628\u0631\u062F \u062F\u0634\u0645\u0646 \u062C\u0645\u0639
        \u06A9\u0646\u060C \u0628\u0639\u062F \u0628\u0627 \u0647\u0645 \u062D\u0645\u0644\u0647
        \u06A9\u0646. \u0642\u0628\u0644 \u0627\u0632 \u062D\u0645\u0644\u0647 \u0628\u0647
        \u067E\u0627\u06CC\u06AF\u0627\u0647\u060C \u0628\u0631\u062C \u062F\u0641\u0627\u0639\u06CC
        \u0631\u0648 \u0627\u0632 \u0628\u06CC\u0646 \u0628\u0628\u0631."
    - key: ui.skirmish.guide.2.mistake
      value: "\xAB\u062D\u0631\u06A9\u062A\xBB \u0628\u0631\u0627\u06CC \u062C\u0627\u0628\u0647\u200C\u062C\u0627\u06CC\u06CC\u0647.
        \u0627\u06AF\u0647 \u06AF\u0631\u0648\u0647 \u0631\u0648 \u0642\u0628\u0644
        \u0627\u0632 \u0641\u0631\u0645\u0627\u0646 \u062D\u0645\u0644\u0647 \u0632\u06CC\u0631
        \u0622\u062A\u0634 \u062F\u0634\u0645\u0646 \u0628\u0641\u0631\u0633\u062A\u06CC\u060C
        \u0645\u0645\u06A9\u0646\u0647 \u062A\u0644\u0641\u0627\u062A \u0628\u062F\u06CC."
    - key: ui.skirmish.guide.2.title
      value: "\u0627\u0646\u062A\u062E\u0627\u0628 \u0648 \u0641\u0631\u0645\u0627\u0646"
    - key: ui.skirmish.guide.3.body
      value: "\xAB\u0633\u0627\u062E\u062A\xBB \u0631\u0648 \u0628\u0627\u0632 \u06A9\u0646
        \u062A\u0627 \u062F\u0641\u0627\u0639 \u0628\u0633\u0627\u0632\u06CC \u06CC\u0627
        \u062A\u0641\u0646\u06AF\u062F\u0627\u0631 \u0622\u0645\u0648\u0632\u0634
        \u0628\u062F\u06CC. \u0633\u0627\u062E\u062A\u0645\u0627\u0646 \u0631\u0648
        \u0631\u0648\u06CC \u0632\u0645\u06CC\u0646\u0650 \u062E\u0627\u0644\u06CC
        \u0648 \u062F\u0648\u0631 \u0627\u0632 \u062C\u0627\u062F\u0647 \u0648 \u067E\u06CC\u0627\u062F\u0647\u200C\u0631\u0648
        \u0628\u0630\u0627\u0631. \u067E\u06CC\u0634\u200C\u0646\u0645\u0627\u06CC\u0634
        \u0631\u0648 \u062C\u0627\u0628\u0647\u200C\u062C\u0627 \u06A9\u0646 \u06CC\u0627
        \u0628\u0686\u0631\u062E\u0648\u0646 \u062A\u0627 \u0633\u0628\u0632 \u0628\u0634\u0647\u060C
        \u0628\u0639\u062F \u062A\u0623\u06CC\u06CC\u062F \u06A9\u0646. \u0628\u0627
        \u0634\u0631\u0648\u0639 \u0622\u0645\u0648\u0632\u0634\u060C \u067E\u0646\u062C\u0631\u0647
        \u0628\u0633\u062A\u0647 \u0645\u06CC\u200C\u0634\u0647 \u0648 \u0646\u06CC\u0631\u0648\u0647\u0627\u06CC
        \u0622\u0645\u0627\u062F\u0647 \u0628\u0647 \u06A9\u0627\u0631\u062A\u200C\u0647\u0627\u06CC
        \u06AF\u0631\u0648\u0647 \u0627\u0636\u0627\u0641\u0647 \u0645\u06CC\u200C\u0634\u0646."
    - key: ui.skirmish.guide.3.diagram
      value: "\u0633\u0627\u062E\u062A \u2190 \u0627\u0646\u062A\u062E\u0627\u0628
        \u0645\u0648\u0631\u062F \u2190 \u0628\u0631\u0631\u0633\u06CC \u0647\u0632\u06CC\u0646\u0647
        \u0648 \u062C\u0627 \u2190 \u062A\u0623\u06CC\u06CC\u062F"
    - key: ui.skirmish.guide.3.example
      value: "\u0634\u0645\u0627\u0631\u0646\u062F\u0647\u0654 \u067E\u06CC\u0627\u062F\u0647\u200C\u0646\u0638\u0627\u0645
        \u0633\u0642\u0641 \u0646\u06CC\u0631\u0648\u0647\u0627\u062A \u0631\u0648
        \u0646\u0634\u0648\u0646 \u0645\u06CC\u200C\u062F\u0647. \u0646\u0632\u062F\u06CC\u06A9
        \u067E\u0627\u06CC\u06AF\u0627\u0647 \u062F\u0641\u0627\u0639 \u0628\u0633\u0627\u0632
        \u0648 \u0628\u0631\u0627\u06CC \u062C\u0627\u06CC\u06AF\u0632\u06CC\u0646
        \u06A9\u0631\u062F\u0646 \u062A\u0644\u0641\u0627\u062A\u060C \u0645\u0635\u0627\u0644\u062D
        \u0646\u06AF\u0647 \u062F\u0627\u0631."
    - key: ui.skirmish.guide.3.mistake
      value: "\u0641\u0631\u0645\u0627\u0646\u06CC \u06A9\u0647 \u0642\u0628\u0648\u0644
        \u0646\u0634\u062F\u0647 \u0645\u0646\u0627\u0628\u0639 \u062E\u0631\u062C
        \u0646\u0645\u06CC\u200C\u06A9\u0646\u0647. \u0642\u0628\u0644 \u0627\u0632
        \u062A\u0644\u0627\u0634 \u062F\u0648\u0628\u0627\u0631\u0647\u060C \u067E\u06CC\u0627\u0645
        \u0647\u0632\u06CC\u0646\u0647 \u06CC\u0627 \u0638\u0631\u0641\u06CC\u062A
        \u0631\u0648 \u0628\u062E\u0648\u0646."
    - key: ui.skirmish.guide.3.title
      value: "\u0633\u0627\u062E\u062A\u200C\u0648\u0633\u0627\u0632 \u0648 \u0646\u06CC\u0631\u0648\u06CC
        \u06A9\u0645\u06A9\u06CC"
    - key: ui.skirmish.guide.4.body
      value: "\u06A9\u0627\u0645\u06CC\u0648\u0646\u200C\u0647\u0627 \u0646\u0641\u062A
        \u0631\u0648 \u062E\u0648\u062F\u06A9\u0627\u0631 \u0645\u06CC\u200C\u0631\u0633\u0648\u0646\u0646.
        \u06A9\u0627\u0631\u06AF\u0627\u0647\u060C \u0646\u0641\u062A\u0650 \u062A\u062D\u0648\u06CC\u0644\u200C\u06AF\u0631\u0641\u062A\u0647\u200C\u0634\u062F\u0647
        \u0631\u0648 \u0628\u0647 \u0645\u0635\u0627\u0644\u062D \u062A\u0628\u062F\u06CC\u0644
        \u0645\u06CC\u200C\u06A9\u0646\u0647 \u0648 \u067E\u0627\u0644\u0627\u06CC\u0634\u06AF\u0627\u0647
        \u0633\u0648\u062E\u062A \u0622\u0645\u0627\u062F\u0647 \u0645\u06CC\u200C\u062F\u0647.
        \u0645\u0631\u0627\u0642\u0628 \u06A9\u0627\u0645\u06CC\u0648\u0646\u200C\u0647\u0627
        \u0648 \u0633\u0627\u062E\u062A\u0645\u0627\u0646\u200C\u0647\u0627\u06CC
        \u062A\u062F\u0627\u0631\u06A9\u0627\u062A\u06CC \u0628\u0627\u0634. \u0627\u06AF\u0647
        \u0633\u0627\u062E\u062A\u0645\u0648\u0646\u06CC \u0627\u0632 \u062F\u0633\u062A
        \u0631\u0641\u062A \u0648 \u0645\u0646\u0627\u0628\u0639 \u06A9\u0627\u0641\u06CC
        \u062F\u0627\u0634\u062A\u06CC\u060C \u0627\u0632 \xAB\u0633\u0627\u062E\u062A\xBB
        \u062C\u0627\u06CC\u06AF\u0632\u06CC\u0646\u0634 \u06A9\u0646."
    - key: ui.skirmish.guide.4.diagram
      value: "\u067E\u0645\u067E \u0646\u0641\u062A \u2190 \u062A\u062D\u0648\u06CC\u0644
        \u0628\u0627\u0631 \u2190 \u0645\u0635\u0627\u0644\u062D \u06CC\u0627 \u0633\u0648\u062E\u062A"
    - key: ui.skirmish.guide.4.example
      value: "\u0627\u06AF\u0647 \u0645\u0635\u0627\u0644\u062D \u062F\u06CC\u06AF\u0647
        \u0632\u06CC\u0627\u062F \u0646\u0645\u06CC\u200C\u0634\u0647\u060C \u067E\u0645\u067E
        \u0646\u0641\u062A\u060C \u06A9\u0627\u0645\u06CC\u0648\u0646\u200C\u0647\u0627\u06CC
        \u0628\u0627\u0631\u0628\u0631\u06CC \u0648 \u06A9\u0627\u0631\u06AF\u0627\u0647
        \u0631\u0648 \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646."
    - key: ui.skirmish.guide.4.mistake
      value: "\u0646\u0641\u062A\u06CC \u06A9\u0647 \u0647\u0646\u0648\u0632 \u06A9\u0646\u0627\u0631
        \u0645\u0646\u0628\u0639\u0647\u060C \u062A\u062D\u0648\u06CC\u0644 \u062F\u0627\u062F\u0647
        \u0646\u0634\u062F\u0647. \u0645\u0633\u06CC\u0631 \u0631\u0648 \u0628\u0627\u0632
        \u0646\u06AF\u0647 \u062F\u0627\u0631 \u0648 \u0641\u0631\u0635\u062A \u0628\u062F\u0647
        \u06A9\u0627\u0645\u06CC\u0648\u0646\u200C\u0647\u0627 \u0631\u0641\u062A\u200C\u0648\u0628\u0631\u06AF\u0634\u062A\u0634\u0648\u0646
        \u0631\u0648 \u06A9\u0627\u0645\u0644 \u06A9\u0646\u0646."
    - key: ui.skirmish.guide.4.title
      value: "\u062A\u062F\u0627\u0631\u06A9\u0627\u062A \u0631\u0648 \u0641\u0639\u0627\u0644
        \u0646\u06AF\u0647 \u062F\u0627\u0631"
    - key: ui.skirmish.guide.title
      value: "\u0631\u0627\u0647\u0646\u0645\u0627\u06CC \u062D\u0645\u0644\u0647
        \u0628\u0647 \u067E\u0627\u06CC\u06AF\u0627\u0647"
    - key: ui.skirmish.income_multiplier
      value: "\u0636\u0631\u06CC\u0628 \u062F\u0631\u0622\u0645\u062F"
    - key: ui.skirmish.industrial_basin_map
      value: "\u062D\u0648\u0636\u0647 \u0635\u0646\u0639\u062A\u06CC"
    - key: ui.skirmish.infantry
      value: "\u067E\u06CC\u0627\u062F\u0647\u200C\u0646\u0638\u0627\u0645"
    - key: ui.skirmish.intel_description
      value: "\u0641\u0646\u0627\u0648\u0631\u06CC \u062F\u0634\u0645\u0646 \u0631\u0648
        \u0647\u0646\u06AF\u0627\u0645 \u0634\u0646\u0627\u0633\u0627\u06CC\u06CC
        \u0622\u0634\u06A9\u0627\u0631 \u06A9\u0646."
    - key: ui.skirmish.intel_reveal
      value: "\u0627\u0641\u0634\u0627\u06CC \u0627\u0637\u0644\u0627\u0639\u0627\u062A"
    - key: ui.skirmish.logistics_full
      value: "\u0638\u0631\u0641\u06CC\u062A \u067E\u0631\u0647: \u06F2 \u06A9\u0627\u0645\u06CC\u0648\u0646
        \u0628\u0627\u0631\u0628\u0631\u06CC \u0648 \u06F1 \u062A\u0627\u0646\u06A9\u0631\u060C
        \u0628\u0627 \u0627\u062D\u062A\u0633\u0627\u0628 \u0635\u0641 \u062A\u0648\u0644\u06CC\u062F."
    - key: ui.skirmish.logistics_full.short
      value: "\u0638\u0631\u0641\u06CC\u062A \u0645\u0627\u0634\u06CC\u0646\u200C\u0647\u0627\u06CC
        \u062A\u062F\u0627\u0631\u06A9\u0627\u062A \u067E\u0631\u0647."
    - key: ui.skirmish.main_menu
      value: "\u0645\u0646\u0648\u06CC \u0627\u0635\u0644\u06CC"
    - key: ui.skirmish.match_help
      value: "\u067E\u0627\u06CC\u06AF\u0627\u0647 \u062F\u0634\u0645\u0646 \u0631\u0648
        \u0646\u0627\u0628\u0648\u062F \u06A9\u0646. \u0628\u0627 \u0628\u0631\u062C
        \u0648 \u062A\u0641\u0646\u06AF\u062F\u0627\u0631 \u0627\u0632 \u067E\u0627\u06CC\u06AF\u0627\u0647\u062A
        \u062F\u0641\u0627\u0639 \u06A9\u0646. \u06A9\u0627\u0631\u062A \u06AF\u0631\u0648\u0647
        \u0631\u0648 \u0628\u0632\u0646\u060C \u0628\u0639\u062F \xAB\u062D\u0631\u06A9\u062A\xBB
        \u06CC\u0627 \xAB\u062D\u0645\u0644\u0647\xBB."
    - key: ui.skirmish.no_resume
      value: "\u0627\u06AF\u0647 \u062E\u0627\u0631\u062C \u0628\u0634\u06CC\u060C
        \u0627\u06CC\u0646 \u0628\u0627\u0632\u06CC \u062A\u0645\u0648\u0645 \u0645\u06CC\u200C\u0634\u0647.
        \u062A\u0646\u0638\u06CC\u0645\u0627\u062A\u062A \u0628\u0631\u0627\u06CC
        \u06CC\u0647 \u0628\u0627\u0632\u06CC \u062A\u0627\u0632\u0647 \u0630\u062E\u06CC\u0631\u0647
        \u0645\u06CC\u200C\u0645\u0648\u0646\u0647."
    - key: ui.skirmish.objective_explanation
      value: "\u0633\u0631\u0628\u0627\u0632\u062E\u0648\u0646\u0647\u0654 \u0627\u0635\u0644\u06CC
        \u062F\u0634\u0645\u0646 \u0631\u0648 \u0646\u0627\u0628\u0648\u062F \u06A9\u0646
        \u0648 \u0627\u0632 \u0645\u0627\u0644 \u062E\u0648\u062F\u062A \u0645\u062D\u0627\u0641\u0638\u062A
        \u06A9\u0646. \u0627\u06AF\u0647 \u062A\u0627 \u0622\u062E\u0631 \u0648\u0642\u062A
        \u0647\u0631 \u062F\u0648 \u0633\u0627\u0644\u0645 \u0628\u0627\u0634\u0646\u060C
        \u0628\u0627\u0632\u06CC \u0645\u0633\u0627\u0648\u06CC \u0645\u06CC\u200C\u0634\u0647."
    - key: ui.skirmish.player_auto_ai
      value: "\u06A9\u0646\u062A\u0631\u0644 \u062E\u0648\u062F\u06A9\u0627\u0631
        \u0628\u0627\u0632\u06CC\u06A9\u0646"
    - key: ui.skirmish.player_auto_ai_description
      value: "\u0628\u0631\u0627\u06CC \u0622\u0632\u0645\u0627\u06CC\u0634 \u0634\u0628\u06CC\u0647\u200C\u0633\u0627\u0632\u06CC\u060C
        \u06A9\u0646\u062A\u0631\u0644 \u062C\u0646\u0627\u062D \u062E\u0648\u062F\u062A
        \u0631\u0648 \u0628\u0647 \u0647\u0648\u0634 \u0645\u0635\u0646\u0648\u0639\u06CC
        \u0628\u0633\u067E\u0627\u0631."
    - key: ui.skirmish.player_base
      value: "\u067E\u0627\u06CC\u06AF\u0627\u0647 \u062E\u0648\u062F\u062A"
    - key: ui.skirmish.population
      value: "\u0633\u0631\u0628\u0627\u0632\u0647\u0627 {0} \u0627\u0632 \u06F2\u06F4"
    - key: ui.skirmish.population_full
      value: "\u0638\u0631\u0641\u06CC\u062A \u0633\u0631\u0628\u0627\u0632\u0647\u0627
        \u067E\u0631\u0647\u061B \u0633\u0642\u0641 \u06F2\u06F4 \u0646\u0641\u0631\u0647
        \u0648 \u0633\u0631\u0628\u0627\u0632\u0647\u0627\u06CC \u062A\u0648\u06CC
        \u0635\u0641 \u0647\u0645 \u062D\u0633\u0627\u0628 \u0645\u06CC\u200C\u0634\u0646."
    - key: ui.skirmish.population_full.short
      value: "\u0638\u0631\u0641\u06CC\u062A \u067E\u06CC\u0627\u062F\u0647\u200C\u0646\u0638\u0627\u0645
        \u067E\u0631\u0647."
    - key: ui.skirmish.preset_summary
      value: "\u06F1 \u062D\u0631\u06CC\u0641 \xB7 \u0639\u0627\u062F\u06CC \xB7
        \u062D\u062F\u0627\u06A9\u062B\u0631 \u06F1\u06F5 \u062F\u0642\u06CC\u0642\u0647"
    - key: ui.skirmish.prototype_scope
      value: "\u062F\u06CC\u062F \u06A9\u0627\u0645\u0644 \u0646\u0642\u0634\u0647
        \xB7 \u0628\u062F\u0648\u0646 \u067E\u0627\u062F\u0627\u0634 \u062F\u0627\u0633\u062A\u0627\u0646\u06CC"
    - key: ui.skirmish.reason.bothbasesdestroyed
      value: "\u0647\u0631 \u062F\u0648 \u067E\u0627\u06CC\u06AF\u0627\u0647 \u0647\u0645\u200C\u0632\u0645\u0627\u0646
        \u0646\u0627\u0628\u0648\u062F \u0634\u062F\u0646."
    - key: ui.skirmish.reason.enemy_base_destroyed
      value: "\u067E\u0627\u06CC\u06AF\u0627\u0647 \u0627\u0635\u0644\u06CC \u062F\u0634\u0645\u0646
        \u0631\u0648 \u0646\u0627\u0628\u0648\u062F \u06A9\u0631\u062F\u06CC."
    - key: ui.skirmish.reason.mainbasedestroyed
      value: "\u06CC\u06A9 \u067E\u0627\u06CC\u06AF\u0627\u0647 \u0627\u0635\u0644\u06CC
        \u0646\u0627\u0628\u0648\u062F \u0634\u062F."
    - key: ui.skirmish.reason.player_base_destroyed
      value: "\u062F\u0634\u0645\u0646 \u067E\u0627\u06CC\u06AF\u0627\u0647 \u0627\u0635\u0644\u06CC\u062A
        \u0631\u0648 \u0646\u0627\u0628\u0648\u062F \u06A9\u0631\u062F."
    - key: ui.skirmish.reason.surrender
      value: "\u0627\u0632 \u0646\u0628\u0631\u062F \u0627\u0646\u0635\u0631\u0627\u0641
        \u062F\u0627\u062F\u06CC."
    - key: ui.skirmish.reason.timelimit
      value: "\u0648\u0642\u062A \u062A\u0645\u0648\u0645 \u0634\u062F. \u0647\u0631
        \u062F\u0648 \u067E\u0627\u06CC\u06AF\u0627\u0647 \u0633\u0627\u0644\u0645
        \u0645\u0648\u0646\u062F\u0646."
    - key: ui.skirmish.recruitment_accepted
      value: "\u062F\u0631\u062E\u0648\u0627\u0633\u062A \u0627\u0633\u062A\u062E\u062F\u0627\u0645
        \u062B\u0628\u062A \u0634\u062F. \u0628\u0627\u0644\u06AF\u0631\u062F \u06F4
        \u0633\u0631\u0628\u0627\u0632 \u0631\u0648 \u0628\u0647 \u067E\u0627\u06CC\u06AF\u0627\u0647\u062A
        \u0645\u06CC\u200C\u0631\u0633\u0648\u0646\u0647."
    - key: ui.skirmish.replay
      value: "\u062F\u0648\u0628\u0627\u0631\u0647 \u0628\u0627\u0632\u06CC \u06A9\u0646"
    - key: ui.skirmish.reserves
      value: "\u0646\u06CC\u0631\u0648\u06CC \u06A9\u0645\u06A9\u06CC"
    - key: ui.skirmish.restart_confirm
      value: "\u0646\u0628\u0631\u062F \u0631\u0648 \u0628\u0627 \u0647\u0645\u06CC\u0646
        \u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u0627\u0632 \u0627\u0648\u0644
        \u0634\u0631\u0648\u0639 \u06A9\u0646\u06CC\u0645\u061F"
    - key: ui.skirmish.restart_match
      value: "\u0634\u0631\u0648\u0639 \u062F\u0648\u0628\u0627\u0631\u0647\u0654
        \u0646\u0628\u0631\u062F"
