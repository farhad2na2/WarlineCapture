    lines:
    - lineId: supply_line-brief-01
      textKey: narrative.supply_line.brief.01
      englishFallback: The pump extracts Oil. The tray truck carries it to the refinery.
        The tanker then delivers refined Fuel to the warehouse. The trucks handle
        their routes automatically; protect every link.
      speaker: 3
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 13.357142
      essentialCaption: 1
    continueStateId: SupplyLine-brief-1
