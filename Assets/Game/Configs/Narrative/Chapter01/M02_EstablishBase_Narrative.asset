      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: m02-comms.line.1
      textKey: narrative.m02.comms.dalia
      englishFallback: Enemy patrol approaching from the west. Hold the post and
        keep them away from the clinic road.
      speaker: 1
      voiceClip: {fileID: 8300000, guid: f723ab16eb70b4c81bc8ecc69ca065e7, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 7.79
      essentialCaption: 1
    - lineId: m02-comms.line.2
      textKey: narrative.m02.comms.aria
      englishFallback: We found a city access list on one attacker. It was copied
        before the first strike.
      speaker: 3
      voiceClip: {fileID: 8300000, guid: aa7e094ed06a449ac8c434e56625a5c3, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 8.04
      deadlineSeconds: 16.79
      essentialCaption: 1
    - lineId: m02-comms.line.3
      textKey: narrative.m02.comms.samira
      englishFallback: It marks power stations, service gates, and tunnels. Someone
        stole it before the attack.
      speaker: 2
      voiceClip: {fileID: 8300000, guid: 4d2c2c8435c4f4a568e4786f8056e9b2, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 17.04
      deadlineSeconds: 25.390001
      essentialCaption: 1
