  - stateId: CommandNode-brief-2
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: 54bbc76708a945098a0afc9b05f18ef5
      m_SubObjectName: CH05M05_CommandNode-brief-c-16x9
