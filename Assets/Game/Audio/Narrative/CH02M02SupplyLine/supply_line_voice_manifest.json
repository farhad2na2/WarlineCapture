      "voiceId": "7uxeJ73HfJL9gOH2mttA",
      "voiceName": "Warline - Engineer Samira Haddad",
      "assetPath": "Assets/Game/Audio/Narrative/CH02M02SupplyLine/Voice/en/supply_line-brief-02.wav",
