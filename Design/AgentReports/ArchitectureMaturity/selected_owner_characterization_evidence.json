  "characterizationCases": [
    {
      "id": "ground-recovering-phase",
      "ownerId": "ground-missile-runtime",
      "testPath": "Assets/Tests/Editor/GroundMissileLauncherRuntimeTests.cs",
      "testMethod": "FireSystem_RecoveringPhaseCountsDownWithoutTransitionOrCleanup",
      "disposition": "known-limitation",
      "expectedContract": "Recovering clamps its timer to zero but preserves phase, target, and selected slot and creates no projectile until an explicit future owner decision changes the behavior."
    },
    {
      "id": "ground-projectile-removed-before-impact",
      "ownerId": "ground-missile-runtime",
      "testPath": "Assets/Tests/Editor/GroundMissileLauncherRuntimeTests.cs",
      "testMethod": "ProjectileRemovedBeforeImpact_LeavesLauncherInFlightStateForExplicitCleanupOwner",
      "disposition": "known-limitation",
      "expectedContract": "Removing a projectile without an impact request leaves GroundMissileInFlightComponent on the launcher and produces no impact request."
    },
    {
      "id": "ground-trail-missing-frame-release",
      "ownerId": "ground-missile-runtime",
      "testPath": "Assets/Tests/Editor/GroundMissileLauncherRuntimeTests.cs",
      "testMethod": "MissileTrailVfxView_MissingProjectileReleasesPooledTrailAfterTolerance",
      "disposition": "preserved-behavior",
      "expectedContract": "Repeated sync reuses one trail, more than two missing frames starts release, and elapsed release time returns the instance to the existing pool."
    },
    {
      "id": "transport-duplicate-buffer-entry",
      "ownerId": "transport-boarding-runtime",
      "testPath": "Assets/Tests/Editor/UnitTransportValidationTests.cs",
      "testMethod": "TransportBoardingSystem_DuplicatePassengerEntriesConsumeCapacityPerEntry",
      "disposition": "known-limitation",
      "expectedContract": "Each live duplicate passenger-buffer entry consumes capacity and can cancel an otherwise valid boarding target."
    },
    {
      "id": "transport-missing-buffer-entry",
      "ownerId": "transport-boarding-runtime",
      "testPath": "Assets/Tests/Editor/UnitTransportValidationTests.cs",
      "testMethod": "TransportBoardingSystem_IgnoresMissingPassengerEntitiesWhenCountingOccupancy",
      "disposition": "preserved-behavior",
      "expectedContract": "Null and destroyed passenger-buffer entries remain stored but do not consume capacity or prevent a valid passenger from boarding."
    },
    {
      "id": "transport-vehicle-missing-cargo-capacity",
      "ownerId": "transport-boarding-runtime",
      "testPath": "Assets/Tests/Editor/UnitTransportValidationTests.cs",
      "testMethod": "TransportBoardingSystem_VehicleRequiresCargoCapacity",
      "disposition": "preserved-behavior",
      "expectedContract": "Vehicle capacity is zero without UnitTransportCargoCapacity even when legacy soldier capacity is available."
    },
    {
      "id": "transport-cargo-soldier-override",
      "ownerId": "transport-boarding-runtime",
      "testPath": "Assets/Tests/Editor/UnitTransportValidationTests.cs",
      "testMethod": "TransportBoardingSystem_CargoSoldierCapacityOverridesLegacyCapacity",
      "disposition": "preserved-behavior",
      "expectedContract": "A positive cargo soldier capacity overrides UnitTransportCapacity.SoldierCapacity during job and main-thread revalidation."
    },
    {
      "id": "transport-boarding-target-kind-fallback",
      "ownerId": "transport-boarding-runtime",
      "testPath": "Assets/Tests/Editor/UnitTransportValidationTests.cs",
      "testMethod": "TransportBoardingSystem_BoardingTargetMetadataClassifiesVehicleOccupancy",
      "disposition": "preserved-behavior",
      "expectedContract": "Matching UnitTransportBoardingTarget metadata classifies a live buffered entity as vehicle occupancy when cargo-passenger metadata is absent."
    },
    {
      "id": "transport-multiple-grid-singleton",
      "ownerId": "transport-boarding-runtime",
      "testPath": "Assets/Tests/Editor/UnitTransportValidationTests.cs",
      "testMethod": "TransportBoardingSystem_MultipleGridConfigsRejectAmbiguousSingleton",
      "disposition": "known-limitation",
      "expectedContract": "The exact GridConfig singleton precondition rejects two matching entities before boarding state is consumed."
    }
  ],
