    panel20x9Reference:
      m_AssetGUID: b887896b586f4f4090eba924dda98670
      m_SubObjectName: CH05M05_CommandNode-debrief-c-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: command_node-debrief-03
      textKey: narrative.command_node.debrief-03
      englishFallback: Dalia and I secure military and civilian authority together.
        The two keys protected this emergency action; they do not appoint a permanent
        ruler.
      speaker: 2
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 10.357142
