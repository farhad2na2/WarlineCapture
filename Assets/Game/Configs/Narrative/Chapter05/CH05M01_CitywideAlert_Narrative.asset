    lines:
    - lineId: citywide_alert-debrief-01
      textKey: narrative.citywide_alert.debrief-01
      englishFallback: Both districts are stable. The clinic and utility site are
        intact, and the engineers have restored both services. Keeping forces on
        both fronts protected the people and workers relying on them.
      speaker: 2
      voiceClip: {fileID: 8300000, guid: 809d16dface314bfbb19661c3b76e6c3, type: 3}
