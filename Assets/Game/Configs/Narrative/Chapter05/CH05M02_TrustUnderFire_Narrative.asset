      m_AssetGUID: 9bab85e848b144e0b87e13d0942f48f4
      m_SubObjectName: CH05M02_TrustUnderFire-a-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: trust_under_fire-brief-01
      textKey: narrative.trust_under_fire.brief-01
      englishFallback: Some residents remember help reaching them. Others remember
        delays and have reason to be afraid. The shelters have room, but both routes
        are exposed. Today's proof is open routes and safe arrivals.
      speaker: 2
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 14.071428
      essentialCaption: 1
    continueStateId: TrustUnderFire-brief-1
    skipStateId: TrustUnderFire-brief-complete
    reducedMotionSupported: 1
    durationSeconds: 14.071428
    motionPreset: 0
    locationTitleKey: 
    locationTitleFallback: 
    locationSubtitleKey: 
