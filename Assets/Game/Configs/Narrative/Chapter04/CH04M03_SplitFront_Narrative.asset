      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: split_front-debrief-aria
      textKey: narrative.split_front.debrief-aria
      englishFallback: I have preserved the targeting package and Qassem's offer.
        Neither grants autonomous authority. The evidence points to the air-support
        site; your next operation will decide how we approach it.
      speaker: 3
      voiceClip: {fileID: 8300000, guid: 849c895b8396a4194a12b2742b19f71d, type: 3}
