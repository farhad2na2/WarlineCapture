    - key: unit.description.soldier.1
      value: "\u067E\u06CC\u0627\u062F\u0647\u200C\u0646\u0638\u0627\u0645 \u0645\u062C\u0647\u0632
        \u0628\u0647 \u062A\u0641\u0646\u06AF \u062A\u06A9\u200C\u062A\u06CC\u0631\u0627\u0646\u062F\u0627\u0632\u061B
        \u0628\u0631\u0627\u06CC \u06AF\u0634\u062A \u0648 \u062F\u0641\u0627\u0639."
    - key: unit.description.soldier.2
      value: "\u067E\u06CC\u0627\u062F\u0647\u200C\u0646\u0638\u0627\u0645 \u0645\u062C\u0647\u0632
        \u0628\u0647 \u0645\u0633\u0644\u0633\u0644 \u0633\u0628\u06A9\u061B \u0628\u0631\u0627\u06CC
        \u06AF\u0634\u062A \u0648 \u062F\u0641\u0627\u0639."
    - key: unit.description.soldier.3
      value: "\u067E\u06CC\u0627\u062F\u0647\u200C\u0646\u0638\u0627\u0645 \u0645\u062C\u0647\u0632
        \u0628\u0647 \u062A\u06CC\u0631\u0628\u0627\u0631\u061B \u0628\u0631\u0627\u06CC
        \u06AF\u0634\u062A \u0648 \u062F\u0641\u0627\u0639."
    - key: unit.description.soldier.4
      value: "\u067E\u06CC\u0627\u062F\u0647\u200C\u0646\u0638\u0627\u0645 \u0645\u062C\u0647\u0632
        \u0628\u0647 \u062A\u0641\u0646\u06AF \u067E\u06CC\u0634\u0631\u0641\u062A\u0647\u061B
        \u0628\u0631\u0627\u06CC \u06AF\u0634\u062A \u0648 \u062F\u0641\u0627\u0639."
    - key: unit.description.soldier.5
      value: "\u067E\u06CC\u0627\u062F\u0647\u200C\u0646\u0638\u0627\u0645 \u0645\u062C\u0647\u0632
        \u0628\u0647 \u062A\u067E\u0627\u0646\u0686\u0647\u061B \u0628\u0631\u0627\u06CC
        \u06AF\u0634\u062A \u0648 \u062F\u0641\u0627\u0639."
    - key: unit.description.soldier.6
      value: "\u067E\u06CC\u0627\u062F\u0647\u200C\u0646\u0638\u0627\u0645 \u0645\u062C\u0647\u0632
        \u0628\u0647 \u062A\u067E\u0627\u0646\u0686\u0647\u061B \u0628\u0631\u0627\u06CC
        \u06AF\u0634\u062A \u0648 \u062F\u0641\u0627\u0639."
    - key: unit.description.veh_apc_heavy
      value: "\u0646\u0641\u0631\u0628\u0631 \u0633\u0646\u06AF\u06CC\u0646 \u0628\u0627
        \u0632\u0631\u0647 \u0642\u0648\u06CC\u200C\u062A\u0631\u060C \u0628\u0631\u0627\u06CC
        \u062C\u0627\u0628\u0647\u200C\u062C\u0627\u06CC\u06CC \u06AF\u0631\u0648\u0647
        \u0632\u06CC\u0631 \u0622\u062A\u0634 \u062F\u0634\u0645\u0646."
    - key: unit.description.veh_apc_slow
      value: "\u0646\u0641\u0631\u0628\u0631 \u0645\u0642\u0627\u0648\u0645 \u0628\u0631\u0627\u06CC
        \u0627\u0646\u062A\u0642\u0627\u0644 \u0627\u0645\u0646 \u0646\u06CC\u0631\u0648\u0647\u0627\u06CC
        \u067E\u06CC\u0627\u062F\u0647 \u0628\u0647 \u062E\u0637 \u0645\u0642\u062F\u0645."
    - key: unit.description.veh_drone
      value: "\u067E\u0647\u067E\u0627\u062F \u0633\u0628\u06A9 \u0628\u0631\u0627\u06CC
        \u0634\u0646\u0627\u0633\u0627\u06CC\u06CC\u060C \u067E\u0634\u062A\u06CC\u0628\u0627\u0646\u06CC
        \u06AF\u0634\u062A \u0648 \u0628\u0631\u0631\u0633\u06CC \u0633\u0631\u06CC\u0639
        \u0645\u06CC\u062F\u0627\u0646 \u0646\u0628\u0631\u062F."
    - key: unit.description.veh_helicopter_attack
      value: "\u0628\u0627\u0644\u06AF\u0631\u062F \u0645\u0633\u0644\u062D \u0628\u0631\u0627\u06CC
        \u062D\u0645\u0644\u0647\u0654 \u0633\u0631\u06CC\u0639 \u0648 \u067E\u0634\u062A\u06CC\u0628\u0627\u0646\u06CC
        \u0646\u0632\u062F\u06CC\u06A9 \u0646\u06CC\u0631\u0648\u0647\u0627\u06CC
        \u0632\u0645\u06CC\u0646\u06CC."
    - key: unit.description.veh_helicopter_attack_small
      value: "\u0628\u0627\u0644\u06AF\u0631\u062F \u062A\u0647\u0627\u062C\u0645\u06CC
        \u0686\u0627\u0628\u06A9 \u0628\u0631\u0627\u06CC \u0648\u0627\u06A9\u0646\u0634
        \u0633\u0631\u06CC\u0639\u060C \u062D\u0645\u0644\u0647\u200C\u0647\u0627\u06CC
        \u06A9\u0648\u062A\u0627\u0647 \u0648 \u067E\u0634\u062A\u06CC\u0628\u0627\u0646\u06CC
        \u0647\u0648\u0627\u06CC\u06CC \u0633\u0628\u06A9."
    - key: unit.description.veh_jet_01
      value: "\u062C\u062A \u0631\u0632\u0645\u06CC \u0633\u0631\u06CC\u0639 \u0628\u0631\u0627\u06CC
        \u062D\u0645\u0644\u0647\u0654 \u062F\u0642\u06CC\u0642 \u0648 \u0648\u0627\u06A9\u0646\u0634
        \u0641\u0648\u0631\u06CC \u062F\u0631 \u0645\u06CC\u062F\u0627\u0646 \u0646\u0628\u0631\u062F."
    - key: unit.description.veh_jet_02
      value: "\u062C\u062A \u067E\u06CC\u0634\u0631\u0641\u062A\u0647 \u0628\u0631\u0627\u06CC
        \u0628\u0631\u062A\u0631\u06CC \u0647\u0648\u0627\u06CC\u06CC \u0648 \u062D\u0645\u0644\u0647\u0654
        \u0633\u0631\u06CC\u0639."
    - key: unit.description.veh_light_armored_car
      value: "\u062E\u0648\u062F\u0631\u0648\u06CC \u0632\u0631\u0647\u06CC \u0686\u0627\u0628\u06A9
        \u0628\u0631\u0627\u06CC \u06AF\u0634\u062A\u200C\u0632\u0646\u06CC\u060C
        \u062F\u0648\u0631 \u0632\u062F\u0646 \u062F\u0634\u0645\u0646 \u0648 \u067E\u0634\u062A\u06CC\u0628\u0627\u0646\u06CC
        \u0633\u0631\u06CC\u0639 \u0628\u0627 \u0622\u062A\u0634."
    - key: unit.description.veh_missle_launcher_air
      value: "\u067E\u0631\u062A\u0627\u0628\u06AF\u0631 \u0645\u0648\u0634\u06A9
        \u0632\u0645\u06CC\u0646\u200C\u0628\u0647\u200C\u0647\u0648\u0627 \u0628\u0631\u0627\u06CC
        \u062F\u0641\u0627\u0639 \u0627\u0632 \u067E\u0627\u06CC\u06AF\u0627\u0647
        \u062F\u0631 \u0628\u0631\u0627\u0628\u0631 \u0628\u0627\u0644\u06AF\u0631\u062F\u060C
        \u067E\u0647\u067E\u0627\u062F \u0648 \u062C\u062A."
    - key: unit.description.veh_missle_launcher_ground
      value: "\u067E\u0631\u062A\u0627\u0628\u06AF\u0631 \u0645\u0648\u0634\u06A9
        \u06A9\u0631\u0648\u0632 \u0632\u0645\u06CC\u0646\u200C\u0628\u0647\u200C\u0632\u0645\u06CC\u0646
        \u0628\u0631\u0627\u06CC \u062D\u0645\u0644\u0647 \u0627\u0632 \u062F\u0648\u0631
        \u0628\u0647 \u067E\u0627\u06CC\u06AF\u0627\u0647 \u0648 \u0645\u0648\u0627\u0636\u0639
        \u0645\u0633\u062A\u062D\u06A9\u0645 \u062F\u0634\u0645\u0646."
    - key: unit.description.veh_plane_transport
      value: "\u0647\u0648\u0627\u067E\u06CC\u0645\u0627\u06CC \u0633\u0646\u06AF\u06CC\u0646
        \u062A\u0631\u0627\u0628\u0631\u06CC \u06A9\u0647 \u0646\u06CC\u0631\u0648\u0647\u0627
        \u0648 \u062A\u062C\u0647\u06CC\u0632\u0627\u062A \u062F\u0631\u062E\u0648\u0627\u0633\u062A\u06CC
        \u0631\u0648 \u0628\u0647 \u0641\u0631\u0648\u062F\u06AF\u0627\u0647 \u0645\u06CC\u200C\u0631\u0633\u0648\u0646\u0647."
    - key: unit.description.veh_tank_usa
      value: "\u062A\u0627\u0646\u06A9 \u0631\u0632\u0645\u06CC \u0628\u0627 \u0632\u0631\u0647
        \u0633\u0646\u06AF\u06CC\u0646 \u0648 \u0642\u062F\u0631\u062A \u0622\u062A\u0634
        \u0632\u06CC\u0627\u062F \u0628\u0631\u0627\u06CC \u062F\u0631\u06AF\u06CC\u0631\u06CC
        \u062F\u0631 \u062E\u0637 \u0645\u0642\u062F\u0645."
    - key: unit.description.veh_truck_canopy
      value: "\u0645\u0647\u0645\u0627\u062A \u062D\u0645\u0644 \u0645\u06CC\u200C\u06A9\u0646\u0647
        \u0648 \u0645\u06CC\u200C\u062A\u0648\u0646\u0647 \u0645\u062B\u0644 \u06CC\u06A9
        \u0646\u0641\u0631\u0628\u0631 \u0633\u0628\u06A9 \u0633\u0631\u0628\u0627\u0632\u0647\u0627
        \u0631\u0648 \u062C\u0627\u0628\u0647\u200C\u062C\u0627 \u06A9\u0646\u0647."
    - key: unit.description.veh_truck_tanker
      value: "\u0633\u0648\u062E\u062A \u0631\u0648 \u0628\u0647 \u0645\u062E\u0632\u0646
        \u067E\u0627\u06CC\u06AF\u0627\u0647 \u0645\u06CC\u200C\u0631\u0633\u0648\u0646\u0647
        \u06CC\u0627 \u062F\u0631 \u0645\u06CC\u062F\u0627\u0646 \u0645\u0633\u062A\u0642\u06CC\u0645
        \u0628\u0647 \u062E\u0648\u062F\u0631\u0648\u0647\u0627 \u0633\u0648\u062E\u062A
        \u0645\u06CC\u200C\u062F\u0647."
    - key: unit.description.veh_truck_tray
      value: "\u0628\u0634\u06A9\u0647\u200C\u0647\u0627\u06CC \u0646\u0641\u062A
        \u0631\u0648 \u0627\u0632 \u067E\u0645\u067E\u200C\u0647\u0627 \u0648 \u0627\u0646\u0628\u0627\u0631\u0647\u0627
        \u0628\u0647 \u067E\u0627\u0644\u0627\u06CC\u0634\u06AF\u0627\u0647 \u06CC\u0627
        \u067E\u0627\u06CC\u06AF\u0627\u0647 \u0645\u06CC\u200C\u0631\u0633\u0648\u0646\u0647."
    - key: unit.helicopter.transport.description
      value: "\u0628\u0627\u0644\u06AF\u0631\u062F \u062A\u0631\u0627\u0628\u0631\u06CC
        \u0628\u0631\u0627\u06CC \u0633\u0648\u0627\u0631 \u06A9\u0631\u062F\u0646
        \u0646\u06CC\u0631\u0648\u0647\u0627 \u0631\u0648\u06CC \u0632\u0645\u06CC\u0646
        \u0648 \u067E\u06CC\u0627\u062F\u0647\u200C\u0633\u0627\u0632\u06CC \u0628\u0627
        \u0637\u0646\u0627\u0628 \u0647\u0646\u06AF\u0627\u0645 \u067E\u0631\u0648\u0627\u0632."
    - key: warning_air_attack_type
      value: "\u062D\u0645\u0644\u0647\u0654 \u0647\u0648\u0627\u06CC\u06CC! \u0622\u0645\u0627\u062F\u0647
        \u0628\u0627\u0634"
    - key: warning_attack_count_suffix
      value: "{0}\u060C \u062A\u0639\u062F\u0627\u062F: {1}"
    - key: warning_attack_eta_seconds
      value: "\u062D\u062F\u0648\u062F {0} \u062B\u0627\u0646\u06CC\u0647 \u062A\u0627
        \u0631\u0633\u06CC\u062F\u0646 \u0628\u0647 \u067E\u0627\u06CC\u06AF\u0627\u0647"
    - key: warning_attack_eta_suffix
      value: "{0} \u2014 \u062D\u062F\u0648\u062F {1} \u062B\u0627\u0646\u06CC\u0647
        \u062A\u0627 \u0631\u0633\u06CC\u062F\u0646"
    - key: warning_ground_attack_type
      value: "\u062E\u0648\u062F\u0631\u0648\u0647\u0627\u06CC \u062F\u0634\u0645\u0646
        \u062F\u0627\u0631\u0646 \u062D\u0645\u0644\u0647 \u0645\u06CC\u200C\u06A9\u0646\u0646"
