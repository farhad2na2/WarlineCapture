    },
    {
      "kind": "narrative",
      "id": "last_corridor-brief-02",
      "speaker": "SAMIRA",
      "locale": "en-US",
      "text": "Hold the original engineer at the repair marker for six seconds. Medicine takes the safer alternate lane. Fuel and the key APC may use the repaired main lane or the alternate. Follow each route’s marked entry, midpoint and exit, then hold at receiving for six seconds.",
      "voiceId": "7uxeJ73HfJL9gOH2mttA",
      "voiceName": "Warline - Engineer Samira Haddad",
      "assetPath": "Assets/Game/Audio/Narrative/CH05M04LastCorridor/Voice/en/last_corridor-brief-02.wav",
      "durationSeconds": 18.24,
      "sha256": "daa4e8e9f1dacc9759fd9d0bb35a4fe3bd3339bc1100d460a5fee9c853e9b27b",
      "variant": "",
      "captionSha256": "092ee8eb98882860cbfc432dc1b1fa6366aea7a33d782cba1b5855ec256baddc"
    },
    {
      "deliveryProfile": "fa-conversational-v1",
      "voiceSettings": {
        "stability": 0.5,
        "similarity_boost": 0.75
      },
      "performanceDirection": "[conversational tone]",
      "kind": "narrative",
      "id": "last_corridor-brief-02",
      "speaker": "SAMIRA",
      "locale": "fa-IR",
      "text": "مهندس اصلی رو شش ثانیه روی نشان تعمیر نگه دارین. دارو از مسیر جایگزین امن‌تر می‌ره. سوخت و نفربر کلیدها می‌تونن از مسیر اصلی تعمیرشده یا مسیر جایگزین برن. ورودی، نقطهٔ میانی و خروجی مشخص‌شدهٔ هر مسیر رو دنبال کنین، بعد شش ثانیه در محل دریافت بمونین.",
      "voiceId": "7uxeJ73HfJL9gOH2mttA",
      "voiceName": "Warline - Engineer Samira Haddad",
      "assetPath": "Assets/Game/Audio/Narrative/CH05M04LastCorridor/Voice/fa/last_corridor-brief-02.wav",
      "durationSeconds": 23.36,
      "sha256": "80c4fbac5b9fcf73e79484e4d5be6c4b134066c128288f2dddfd871476ca5b2b",
