    - key: ui.aria.production_wait.body
      value: "\u06AF\u0631\u0648\u0647 \u062A\u0641\u0646\u06AF\u062F\u0627\u0631\u062A
        \u062A\u0648\u06CC \u0635\u0641 \u0622\u0645\u0648\u0632\u0634\u0647. \u0635\u0628\u0631
        \u06A9\u0646 \u0622\u0645\u0627\u062F\u0647 \u0628\u0634\u0646\u061B \u0644\u0627\u0632\u0645
        \u0646\u06CC\u0633\u062A \u062F\u06A9\u0645\u0647\u0654 \u062F\u06CC\u06AF\u0647\u200C\u0627\u06CC
        \u0628\u0632\u0646\u06CC. \u0645\u062F\u0627\u0641\u0639\u200C\u0647\u0627
        \u0631\u0648 \u0631\u0648\u06CC \xAB\u062D\u0641\u0638\xBB \u0646\u06AF\u0647
        \u062F\u0627\u0631. \u0648\u0642\u062A\u06CC \u06AF\u0631\u0648\u0647 \u0622\u0645\u0627\u062F\u0647
        \u0628\u0634\u0647\u060C \u0645\u06CC\u200C\u0631\u06CC\u0645 \u062F\u0631\u0633
        \u0628\u0639\u062F."
