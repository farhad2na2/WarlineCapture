private void UpdateResourceHauler(Context c,EntityManager em,GridConfig g,Entity e,float t)=>throw new NotSupportedException("Existing haul phase caller not shared");private void ReleaseOrphanedReservation(Context c,EntityManager em,Entity e){if(em.HasComponent<UnitResourceHaulReservation>(e))throw new NotSupportedException("Orphan release needs computed pairworker");}
private bool TryIssueHaulerMoveToBuilding(Context c,EntityManager em,Entity e,RuntimeBuildingEntity b,out int2 goal){goal=default;throw new NotSupportedException("Approach/queue caller facts unavailable");}private static void ReleaseReservation(Context c,EntityManager em,UnitResourceHaulReservation r)=>throw new NotSupportedException("Pairworker continuation required");private static void SetOrAddResourceHaulReservation(EntityManager em,Entity e,UnitResourceHaulReservation r)=>throw new NotSupportedException("Pairworker continuation required");private void RecordRouteAssignmentTelemetry(EntityManager em,Entity e,ResourceHaulerUtilitySystemHelper.ResourceHaulKind k,bool isReassignment)=>throw new NotSupportedException("Telemetry commit unsupported");
