<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="SCN03_CommanderProfileContent.uss" />

    <ui:VisualElement name="SCN03_CommanderProfileContent" class="scn03-commander-profile-content">
        <ui:VisualElement name="Background" class="background" />
        <ui:VisualElement name="BackgroundShade" class="background-shade" />

        <ui:VisualElement name="LeftContent" class="left-content">
            <ui:Button name="BackButton" class="back-button" text="">
                <ui:VisualElement name="Frame" class="button-frame" />
                <ui:VisualElement name="Icon" class="back-icon" />
                <ui:Label name="Label" class="button-label" text="BACK" />
            </ui:Button>

            <ui:VisualElement name="RouteStrip" class="route-strip">
                <ui:VisualElement name="Frame" class="panel-frame" />
                <ui:Button name="OverviewTab" class="profile-tab profile-tab-selected" text="">
                    <ui:VisualElement name="Icon" class="tab-icon overview-icon" />
                    <ui:Label name="Label" class="tab-label" text="OVERVIEW" />
                </ui:Button>
                <ui:Button name="StatsTab" class="profile-tab" text="">
                    <ui:VisualElement name="Icon" class="tab-icon stats-icon" />
                    <ui:Label name="Label" class="tab-label" text="STATS" />
                </ui:Button>
                <ui:Button name="BadgesTab" class="profile-tab" text="">
                    <ui:VisualElement name="Icon" class="tab-icon badge-icon" />
                    <ui:Label name="Label" class="tab-label" text="BADGES" />
                </ui:Button>
                <ui:Button name="HistoryTab" class="profile-tab" text="">
                    <ui:VisualElement name="Icon" class="tab-icon history-icon" />
                    <ui:Label name="Label" class="tab-label" text="HISTORY" />
                </ui:Button>
                <ui:Button name="UpgradesTab" class="profile-tab" text="">
                    <ui:VisualElement name="Icon" class="tab-icon upgrade-icon" />
                    <ui:Label name="Label" class="tab-label" text="UPGRADES" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="MiddleContent" class="middle-content">
            <ui:Label name="ScreenTitle" class="screen-title" text="COMMANDER PROFILE" />
            <ui:Label name="ScreenSubtitle" class="screen-subtitle" text="Identity, progression, rewards, history, and roster access" />

            <ui:VisualElement name="CommanderIdentityPanel" class="identity-panel panel">
                <ui:VisualElement name="Frame" class="panel-frame" />
                <ui:VisualElement name="PortraitPanel" class="portrait-panel">
                    <ui:VisualElement name="PortraitFrame" class="portrait-frame" />
                    <ui:VisualElement name="Portrait" class="commander-portrait commander-portrait-default" />
                    <ui:Button name="EditIdButton" class="edit-id-button" text="">
                        <ui:VisualElement name="Frame" class="small-button-frame" />
                        <ui:VisualElement name="Icon" class="edit-icon" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement name="IdentityCard" class="identity-card">
                    <ui:VisualElement name="Badge" class="rank-badge" />
                    <ui:Label name="Title" class="identity-title" text="FIELD COMMANDER" />
                    <ui:Label name="Name" class="identity-name" text="COL. ALEX MORGAN" />
                    <ui:Label name="Subtitle" class="identity-subtitle" text="VICTORY IS PLANNED" />
                    <ui:Label name="Level" class="identity-level" text="LEVEL 38" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="OverviewPanel" class="overview-panel panel">
                <ui:VisualElement name="Frame" class="panel-frame" />
                <ui:Label name="Title" class="panel-title" text="OVERVIEW" />
                <ui:VisualElement name="StatsGrid" class="stats-grid">
                    <ui:VisualElement name="VictoriesStatCard" class="stat-card">
                        <ui:Label name="Value" class="stat-value" text="12" />
                        <ui:Label name="Label" class="stat-label" text="VICTORIES" />
                        <ui:Label name="Suffix" class="stat-suffix" text="86% success" />
                    </ui:VisualElement>
                    <ui:VisualElement name="MissionsStatCard" class="stat-card">
                        <ui:Label name="Value" class="stat-value" text="24" />
                        <ui:Label name="Label" class="stat-label" text="MISSIONS" />
                        <ui:Label name="Suffix" class="stat-suffix" text="completed" />
                    </ui:VisualElement>
                    <ui:VisualElement name="CiviliansStatCard" class="stat-card">
                        <ui:Label name="Value" class="stat-value" text="91%" />
                        <ui:Label name="Label" class="stat-label" text="CIVILIANS" />
                        <ui:Label name="Suffix" class="stat-suffix" text="protected" />
                    </ui:VisualElement>
                    <ui:VisualElement name="LostStatCard" class="stat-card">
                        <ui:Label name="Value" class="stat-value" text="7" />
                        <ui:Label name="Label" class="stat-label" text="UNITS LOST" />
                        <ui:Label name="Suffix" class="stat-suffix" text="lifetime" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="AccountSnapshotPanel" class="account-panel panel">
                <ui:VisualElement name="Frame" class="panel-frame" />
                <ui:Label name="Title" class="panel-title" text="ACCOUNT SNAPSHOT" />
                <ui:VisualElement name="AbilityRows" class="ability-rows">
                    <ui:VisualElement name="ReadinessSnapshot" class="ability-row">
                        <ui:VisualElement name="Icon" class="ability-icon readiness-icon" />
                        <ui:Label name="Label" class="ability-label" text="READINESS" />
                        <ui:Label name="Value" class="ability-value" text="HIGH" />
                    </ui:VisualElement>
                    <ui:VisualElement name="OperationsSnapshot" class="ability-row">
                        <ui:VisualElement name="Icon" class="ability-icon operations-icon" />
                        <ui:Label name="Label" class="ability-label" text="OPERATIONS" />
                        <ui:Label name="Value" class="ability-value" text="42" />
                    </ui:VisualElement>
                    <ui:VisualElement name="SkirmishSnapshot" class="ability-row">
                        <ui:VisualElement name="Icon" class="ability-icon skirmish-icon" />
                        <ui:Label name="Label" class="ability-label" text="SKIRMISH" />
                        <ui:Label name="Value" class="ability-value" text="35%" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="RightContent" class="right-content">
            <ui:VisualElement name="RewardTrackPanel" class="reward-track-panel panel">
                <ui:VisualElement name="Frame" class="panel-frame" />
                <ui:Label name="Title" class="panel-title" text="COMMANDER REWARD TRACK" />
                <ui:VisualElement name="XpProgress" class="xp-progress">
                    <ui:VisualElement name="Track" class="xp-track">
                        <ui:VisualElement name="Fill" class="xp-fill" />
                    </ui:VisualElement>
                    <ui:Label name="XpLabel" class="xp-label" text="2,740 / 3,200 XP TO LEVEL 39" />
                </ui:VisualElement>
                <ui:VisualElement name="RewardNodes" class="reward-nodes">
                    <ui:VisualElement name="Node35" class="reward-node reward-claimed"><ui:Label name="Level" class="reward-level" text="35" /></ui:VisualElement>
                    <ui:VisualElement name="Node36" class="reward-node reward-claimed"><ui:Label name="Level" class="reward-level" text="36" /></ui:VisualElement>
                    <ui:VisualElement name="Node37" class="reward-node reward-claimed"><ui:Label name="Level" class="reward-level" text="37" /></ui:VisualElement>
                    <ui:VisualElement name="Node38" class="reward-node reward-active"><ui:Label name="Level" class="reward-level" text="38" /></ui:VisualElement>
                    <ui:VisualElement name="Node39" class="reward-node reward-locked"><ui:Label name="Level" class="reward-level" text="39" /></ui:VisualElement>
                    <ui:VisualElement name="Node40" class="reward-node reward-locked"><ui:Label name="Level" class="reward-level" text="40" /></ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="RewardText" class="reward-text" text="LEVEL 39 REWARD  •  Next milestone unlocks at Level 39" />
                <ui:Button name="ClaimButton" class="claim-button" text="">
                    <ui:VisualElement name="Frame" class="primary-button-frame" />
                    <ui:Label name="Label" class="button-label" text="CLAIM" />
                </ui:Button>
            </ui:VisualElement>

            <ui:VisualElement name="RecentHistoryPanel" class="recent-history-panel panel">
                <ui:VisualElement name="Frame" class="panel-frame" />
                <ui:Label name="Title" class="panel-title" text="RECENT HISTORY" />
                <ui:VisualElement name="FirstContactRow" class="history-row">
                    <ui:Label name="Title" class="history-title" text="M01 First Contact" />
                    <ui:Label name="Subtitle" class="history-subtitle" text="Victory  |  3 stars  |  civilians protected" />
                    <ui:Label name="Time" class="history-time" text="2h ago" />
                </ui:VisualElement>
                <ui:VisualElement name="OldMarketRow" class="history-row">
                    <ui:Label name="Title" class="history-title" text="Skirmish: Old Market" />
                    <ui:Label name="Subtitle" class="history-subtitle" text="Custom win  |  armor squad survived" />
                    <ui:Label name="Time" class="history-time" text="14m ago" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="FooterContent" class="footer-content">
            <ui:Button name="OpenArmoryButton" class="footer-action" text="">
                <ui:VisualElement name="Frame" class="secondary-button-frame" />
                <ui:VisualElement name="Icon" class="footer-icon armory-icon" />
                <ui:Label name="Label" class="button-label" text="OPEN ARMORY" />
            </ui:Button>
            <ui:Button name="DetailButton" class="footer-action" text="">
                <ui:VisualElement name="Frame" class="secondary-button-frame" />
                <ui:Label name="Label" class="button-label" text="DETAIL" />
            </ui:Button>
            <ui:Button name="ReplayButton" class="footer-action" text="">
                <ui:VisualElement name="Frame" class="secondary-button-frame" />
                <ui:Label name="Label" class="button-label" text="REPLAY" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
