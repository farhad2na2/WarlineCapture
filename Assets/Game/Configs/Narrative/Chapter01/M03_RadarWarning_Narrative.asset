  - stateId: M03-brief-1
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: 2686a20211ec94f4bb6a95e7ae00d7d3
      m_SubObjectName: M03-B02-16x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    panel20x9Reference:
      m_AssetGUID: 2686a20211ec94f4bb6a95e7ae00d7d3
      m_SubObjectName: M03-B02-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: m03-brief-02
      textKey: narrative.m03.brief.02
      englishFallback: Hold them at the junction or defend closer to the post. Keep
        the clinic corridor open. Even an unarmed carrier must not reach the inner
        core.
      speaker: 1
      voiceClip: {fileID: 8300000, guid: 468eade130e554e1c95b63f03d90d59e, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
