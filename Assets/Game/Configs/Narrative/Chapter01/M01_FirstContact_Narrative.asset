    lines:
    - lineId: m01-brief.line.1
      textKey: narrative.m01.brief.dalia
      englishFallback: 'First contact is confirmed: three armed Ash Line operatives
        are blocking the clinic corridor in Old Market.'
      speaker: 1
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 3.75
      essentialCaption: 1
    - lineId: m01-brief.line.2
      textKey: narrative.m01.brief.aria
      englishFallback: 'Threat profiles: Courier carries orders, Warden controls
        the crossing, and Broker coordinates supplies.'
      speaker: 3
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 4
      deadlineSeconds: 7.75
      essentialCaption: 1
    - lineId: m01-brief.line.3
      textKey: narrative.m01.brief.samira
      englishFallback: Civilians are sheltering beyond the patrol. Clear the marked
        corridor; do not pursue outside the district.
      speaker: 2
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 8
      deadlineSeconds: 11.75
      essentialCaption: 1
    continueStateId: M01-BRIEF-COMPLETE
    skipStateId: M01-BRIEF-COMPLETE
