      "durationSeconds": 10.32,
      "sha256": "4178be839860cf9803a2d1acf7f6c21315995614a7893887a37cdda41702fff4",
      "captionSha256": "aaaffc7ff87a0027f0dd8d5c086fa496078fbe39dddf8d84f49b2452044b4411"
