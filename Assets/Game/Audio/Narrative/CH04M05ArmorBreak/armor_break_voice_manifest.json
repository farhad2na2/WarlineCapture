      "voiceName": "Warline - ARIA Civic Relay",
      "assetPath": "Assets/Game/Audio/Narrative/CH04M05ArmorBreak/Voice/en/armor_break-close-02.wav",
      "durationSeconds": 12.48,
      "sha256": "c6cbf5a1caa9bc4fbc52eb9307efa72fa8e33979067d934d8edc16acc041bc0e",
      "captionSha256": "840a73a121e9d020bc32e99b34f2e196fbf644c9ea179fc7402102a48a9dfa94"
    },
    {
      "deliveryProfile": "fa-conversational-v1",
      "voiceSettings": {
        "stability": 0.5,
        "similarity_boost": 0.75
      },
      "performanceDirection": "[conversational tone]",
      "kind": "narrative",
      "id": "armor_break-close-02",
      "speaker": "ARIA",
      "locale": "fa-IR",
      "text": "کلید اول آرشیو بازیابی‌شدهٔ منه؛ دانش سامانه برای شناخت گره‌ها و مسیرهای کنترل رله. بازیابی این آرشیو به من مجوز استفاده از اون علیه شهر رو نمی‌ده.",
      "voiceId": "Fi9tPTnEcbh3of7hOHC8",
      "voiceName": "Warline - ARIA Civic Relay",
      "assetPath": "Assets/Game/Audio/Narrative/CH04M05ArmorBreak/Voice/fa/armor_break-close-02.wav",
      "durationSeconds": 12.56,
      "sha256": "cbe9098d26ae63d5073c56afeda9bcb22bd44a8ab22df82978bd3060e74e9ddb",
      "captionSha256": "7072e58fddd41817c9cf7ea73c0822492ba68a7e53f05d201467ead9d7ae2d78"
    },
    {
      "kind": "narrative",
      "id": "armor_break-close-03",
      "speaker": "DALIA",
      "locale": "en-US",
