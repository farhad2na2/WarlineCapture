      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: last_corridor-debrief-01
      textKey: narrative.last_corridor.debrief-01
      englishFallback: Medicine, Fuel and the original reinforcements reached the
        receiving points. The engineer and physical authority keys arrived in the
        original APC. All five delivery categories are accounted for, and the column
        reached the city center before the corridor closed.
      speaker: 1
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 18.642857
      essentialCaption: 1
