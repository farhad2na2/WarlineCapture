    - key: mission.m05.hud.recovery.enemies
      value: "\u062F\u0634\u0645\u0646\u200C\u0647\u0627 \u0646\u0645\u06CC\u200C\u0630\u0627\u0631\u0646
        \u0628\u0627\u0632\u06CC\u0627\u0628\u06CC \u0631\u0648 \u0634\u0631\u0648\u0639
        \u06A9\u0646\u0645. \u0646\u06AF\u0647\u0628\u0627\u0646\u200C\u0647\u0627\u06CC
        \u0628\u0627\u0642\u06CC\u200C\u0645\u0648\u0646\u062F\u0647 \u0631\u0648
        \u0634\u06A9\u0633\u062A \u0628\u062F\u0647\u060C \u0628\u0639\u062F \u06CC\u0647
        \u0646\u06CC\u0631\u0648 \u0631\u0648 \u0628\u06CC\u0633\u062A \u062B\u0627\u0646\u06CC\u0647
        \u062A\u0648\u06CC \u0645\u062D\u062F\u0648\u062F\u0647\u0654 \u0628\u0627\u06CC\u06AF\u0627\u0646\u06CC
