  - stateId: M05-brief-1
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: 73382e00725e340f6bd9098d960e4308
      m_SubObjectName: M05-B02-16x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    panel20x9Reference:
      m_AssetGUID: 73382e00725e340f6bd9098d960e4308
      m_SubObjectName: M05-B02-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: m05-brief-02
      textKey: narrative.m05.brief.02
      englishFallback: Two rifle squads and a heavy APC are yours. Use the armor
        to open the gate, then bring the rifles through together. Preserve the APC
        if you can; losing it does not end the assault.
      speaker: 1
      voiceClip: {fileID: 8300000, guid: f84516bee75c04ae5a2993d1d54376fe, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 17.88
      essentialCaption: 1
    continueStateId: M05-brief-2
    skipStateId: M05-brief-complete
    reducedMotionSupported: 1
    durationSeconds: 18.13
    motionPreset: 0
