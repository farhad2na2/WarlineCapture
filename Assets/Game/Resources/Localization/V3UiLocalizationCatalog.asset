      value: "\u0634\u06A9\u0633\u062A"
    - key: ui.skirmish.result.draw
      value: "\u0645\u0633\u0627\u0648\u06CC"
    - key: ui.skirmish.result.victory
      value: "\u067E\u06CC\u0631\u0648\u0632\u06CC"
    - key: ui.skirmish.retry
      value: "\u062F\u0648\u0628\u0627\u0631\u0647 \u0627\u0645\u062A\u062D\u0627\u0646
        \u06A9\u0646"
    - key: ui.skirmish.seed
      value: "\u0628\u0630\u0631 \u0647\u0648\u0634 \u0645\u0635\u0646\u0648\u0639\u06CC"
    - key: ui.skirmish.seed_hint
      value: "\u0646\u0642\u0634\u0647 \u0647\u0645\u0648\u0646\u0647\u061B \u0628\u0630\u0631
        \u062A\u0635\u0645\u06CC\u0645\u200C\u0647\u0627\u06CC \u062F\u0634\u0645\u0646
        \u0631\u0648 \u062A\u063A\u06CC\u06CC\u0631 \u0645\u06CC\u200C\u062F\u0647."
    - key: ui.skirmish.squad
      value: "\u06AF\u0631\u0648\u0647 {0}"
    - key: ui.skirmish.start_failed
      value: "\u0646\u0628\u0631\u062F \u0634\u0631\u0648\u0639 \u0646\u0634\u062F"
    - key: ui.skirmish.start_failed.buildingplacement
      value: "\u06CC\u06A9\u06CC \u0627\u0632 \u0633\u0627\u062E\u062A\u0645\u0627\u0646\u200C\u0647\u0627\u06CC
        \u0634\u0631\u0648\u0639 \u0646\u0628\u0631\u062F \u0631\u0648\u06CC \u0632\u0645\u06CC\u0646
        \u0622\u0632\u0627\u062F \u062C\u0627 \u0646\u0634\u062F. \u062F\u0648\u0628\u0627\u0631\u0647
        \u0627\u0645\u062A\u062D\u0627\u0646 \u06A9\u0646 \u06CC\u0627 \u0628\u0647
        \u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u0628\u0631\u06AF\u0631\u062F.
        \u0646\u062A\u06CC\u062C\u0647\u200C\u0627\u06CC \u062B\u0628\u062A \u0646\u0634\u062F\u0647."
    - key: ui.skirmish.start_failed.content
      value: "\u0628\u0627\u0631\u06AF\u0630\u0627\u0631\u06CC \u0645\u06CC\u062F\u0627\u0646
        \u0646\u0628\u0631\u062F \u06A9\u0627\u0645\u0644 \u0646\u0634\u062F. \u062F\u0648\u0628\u0627\u0631\u0647
        \u0627\u0645\u062A\u062D\u0627\u0646 \u06A9\u0646 \u06CC\u0627 \u0628\u0647
        \u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u0628\u0631\u06AF\u0631\u062F.
        \u0646\u062A\u06CC\u062C\u0647\u200C\u0627\u06CC \u062B\u0628\u062A \u0646\u0634\u062F\u0647."
    - key: ui.skirmish.start_failed.timeout
      value: "\u0622\u0645\u0627\u062F\u0647 \u0634\u062F\u0646 \u0645\u06CC\u062F\u0627\u0646
        \u0646\u0628\u0631\u062F \u0628\u06CC\u0634 \u0627\u0632 \u062D\u062F \u0637\u0648\u0644
        \u06A9\u0634\u06CC\u062F. \u062F\u0648\u0628\u0627\u0631\u0647 \u0627\u0645\u062A\u062D\u0627\u0646
        \u06A9\u0646 \u06CC\u0627 \u0628\u0647 \u062A\u0646\u0638\u06CC\u0645\u0627\u062A
        \u0628\u0631\u06AF\u0631\u062F. \u0646\u062A\u06CC\u062C\u0647\u200C\u0627\u06CC
        \u062B\u0628\u062A \u0646\u0634\u062F\u0647."
    - key: ui.skirmish.start_match
      value: "\u0634\u0631\u0648\u0639 \u0646\u0628\u0631\u062F"
    - key: ui.skirmish.starting_money
      value: "\u0627\u0639\u062A\u0628\u0627\u0631 \u0622\u063A\u0627\u0632\u06CC\u0646"
    - key: ui.skirmish.starting_roster
      value: "\u0647\u0631 \u0637\u0631\u0641 \u0628\u0627 \u06F2 \u06AF\u0631\u0648\u0647
        \u062A\u0641\u0646\u06AF\u062F\u0627\u0631\u060C \u06F1 \u062E\u0648\u062F\u0631\u0648\u06CC
        \u0632\u0631\u0647\u06CC \u0648 \u067E\u0627\u06CC\u06AF\u0627\u0647 \u062A\u062F\u0627\u0631\u06A9\u0627\u062A
        \u062E\u0648\u062F\u06A9\u0627\u0631 \u0634\u0631\u0648\u0639 \u0645\u06CC\u200C\u06A9\u0646\u0647.
        \u0633\u0631\u0628\u0627\u0632 \u0628\u06AF\u06CC\u0631 \u0648 \u062F\u0641\u0627\u0639
        \u0628\u0633\u0627\u0632."
    - key: ui.skirmish.statistics
      value: "\u0632\u0645\u0627\u0646 {0} \u2022 \u062A\u0644\u0641\u0627\u062A
        \u062E\u0648\u062F\u06CC {1} / \u062F\u0634\u0645\u0646 {2}\n\u0633\u0627\u062E\u062A\u0645\u0627\u0646\u200C\u0647\u0627\u06CC
        \u0627\u0632\u062F\u0633\u062A\u200C\u0631\u0641\u062A\u0647 {3} / \u0646\u0627\u0628\u0648\u062F\u0634\u062F\u0647
        {4}"
    - key: ui.skirmish.supply_explanation
      value: "\u0628\u0631\u0627\u06CC \u0633\u0627\u062E\u062A \u0648 \u062C\u0630\u0628
        \u0646\u06CC\u0631\u0648 \u0645\u0635\u0627\u0644\u062D \u062E\u0631\u062C
        \u06A9\u0646. \u062A\u0627\u0646\u06A9\u0631\u0647\u0627 \u0646\u0641\u062A
        \u0631\u0648 \u0628\u0647 \u06A9\u0627\u0631\u06AF\u0627\u0647 \u0648 \u067E\u0627\u0644\u0627\u06CC\u0634\u06AF\u0627\u0647
        \u0645\u06CC\u200C\u0631\u0633\u0648\u0646\u0646. \u0641\u0642\u0637 \u0633\u0648\u062E\u062A\u06CC
        \u06A9\u0647 \u062A\u062D\u0648\u06CC\u0644 \u0634\u062F\u0647 \u0642\u0627\u0628\u0644
        \u0627\u0633\u062A\u0641\u0627\u062F\u0647\u200C\u0633\u062A."
    - key: ui.skirmish.surrender
      value: "\u0627\u0646\u0635\u0631\u0627\u0641 \u0627\u0632 \u0646\u0628\u0631\u062F"
