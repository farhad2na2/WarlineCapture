    height: 24%;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_icon_squad_badge.png");
    -unity-background-scale-mode: scale-to-fit;
}

.friendly-icon,
.friendly-pips .casualty-pip-on {
    -unity-background-image-tint-color: rgb(151, 185, 51);
}

.enemy-icon,
.enemy-pips .casualty-pip-on {
    -unity-background-image-tint-color: rgb(214, 77, 42);
}

.casualty-label {
    position: absolute;
