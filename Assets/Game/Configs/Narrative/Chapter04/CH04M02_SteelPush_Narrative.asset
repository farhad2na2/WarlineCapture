      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: steel_push-brief-dalia
      textKey: narrative.steel_push.brief-dalia
      englishFallback: Vanguard armor is coming down the service road. This is an
        open military assault, not an Ash Line raid. Put our tanks across the approach
        and keep infantry covering the reserve.
      speaker: 1
      voiceClip: {fileID: 8300000, guid: e6477a611f6bb4d7292a5f4ba28d96ce, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 13.86
      essentialCaption: 1
    continueStateId: SteelPush-brief-1
    skipStateId: SteelPush-brief-complete
    reducedMotionSupported: 1
    durationSeconds: 13.86
    motionPreset: 0
    locationTitleKey: 
    locationTitleFallback: 
