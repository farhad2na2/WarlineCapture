<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="SCN08_BuildPlacementConfirmationBar.uss" />

    <ui:VisualElement name="SCN08_BuildPlacementConfirmationBar" class="scn08-build-placement-confirmation-bar">
        <ui:VisualElement name="BuildPlacementConfirmationBarRoot" class="build-placement-confirmation-bar-root">
            <ui:VisualElement name="Frame" class="bar-frame" />

            <ui:VisualElement name="BuildingPreviewCard" class="building-preview-card">
                <ui:VisualElement name="Frame" class="preview-card-frame" />
                <ui:VisualElement name="Preview" class="building-preview-image" />
                <ui:VisualElement name="Badge" class="building-preview-badge" />
            </ui:VisualElement>

            <ui:Label name="Title" class="placement-title" text="BUILD: GUARD TOWER" />

            <ui:VisualElement name="StatusChip" class="status-chip">
                <ui:VisualElement name="StatusIcon" class="status-icon" />
                <ui:Label name="Status" class="status-text" text="VALID PLACEMENT" />
            </ui:VisualElement>

            <ui:VisualElement name="CostMetricFrame" class="metric-chip cost-chip" />
            <ui:VisualElement name="CreditsIcon" class="metric-icon credits-icon" />
            <ui:Label name="CostLabel" class="metric-label cost-label" text="COST" />
            <ui:Label name="Cost" class="cost-text" text="420" />

            <ui:VisualElement name="TimeMetricFrame" class="metric-chip time-chip" />
            <ui:VisualElement name="TimeIcon" class="metric-icon time-icon" />
            <ui:Label name="TimeLabel" class="metric-label time-label" text="TIME" />
            <ui:Label name="Duration" class="duration-text" text="00:18" />

            <ui:VisualElement name="InfoDivider" class="section-divider info-divider" />
            <ui:VisualElement name="ActionDivider" class="section-divider action-divider" />

            <ui:Button name="CancelButton" class="placement-action cancel-action" text="">
                <ui:VisualElement name="Icon" class="action-icon cancel-icon" />
                <ui:Label name="Label" class="action-label" text="CANCEL" />
            </ui:Button>

            <ui:Button name="RotateButton" class="rotate-action" text="">
                <ui:VisualElement name="Icon" class="rotate-icon" />
                <ui:Label name="Label" class="rotate-label" text="ROTATE" />
            </ui:Button>

            <ui:Button name="ConfirmButton" class="placement-action confirm-action" text="">
                <ui:VisualElement name="Icon" class="action-icon confirm-icon" />
                <ui:Label name="Label" class="action-label" text="CONFIRM" />
            </ui:Button>

            <ui:VisualElement name="InstructionStrip" class="instruction-strip">
                <ui:VisualElement name="InfoIcon" class="info-icon" />
                <ui:Label name="Instruction" class="instruction-text" text="TAP TO PLACE BUILDING" />
                <ui:Label name="InstructionSecondary" class="instruction-secondary-text" text="DRAG TO ADJUST POSITION" />
                <ui:VisualElement name="PlacementProgress" class="placement-progress-pips">
                    <ui:VisualElement class="placement-progress-pip placement-progress-pip-active" />
                    <ui:VisualElement class="placement-progress-pip" />
                    <ui:VisualElement class="placement-progress-pip" />
                    <ui:VisualElement class="placement-progress-pip" />
                    <ui:VisualElement class="placement-progress-pip" />
                    <ui:VisualElement class="placement-progress-pip" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
