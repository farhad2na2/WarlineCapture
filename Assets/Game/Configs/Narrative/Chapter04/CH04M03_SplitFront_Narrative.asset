      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: split_front-debrief-dalia
      textKey: narrative.split_front.debrief-dalia
      englishFallback: The battery's targeting package was built to request ARIA's
        authorization. This is imported Relay-compatible hardware. Its supply trail
        leads to an air-support site.
      speaker: 1
      voiceClip: {fileID: 8300000, guid: 1f45dacfb4a2b49b7a3efb0067396479, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
