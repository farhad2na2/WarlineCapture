      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: split_front-brief-samira
      textKey: narrative.split_front.brief-samira
      englishFallback: Families are sheltering between the two fronts. Their buildings
        are protected. Smoke can cover our defenders, but this operation does not
        depend on it. Do not pull everyone away from the base.
      speaker: 2
      voiceClip: {fileID: 8300000, guid: e4d50a633cc5e476bbe4a9a7388065eb, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
