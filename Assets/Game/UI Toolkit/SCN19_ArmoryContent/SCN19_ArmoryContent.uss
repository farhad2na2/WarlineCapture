    height: 4.4%;
}

.primary-cta {
    top: 89.8%;
}

.inspect-abilities-cta {
    top: 94.3%;
    left: 9%;
    right: 52%;
}

.equip-cta {
    top: 94.3%;
    left: 52%;
    right: 9%;
}

.primary-cta {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_cta_primary_gold_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 24;
