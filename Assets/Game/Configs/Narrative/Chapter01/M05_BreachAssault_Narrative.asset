      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: m05-brief-01
      textKey: narrative.m05.brief.01
      englishFallback: The engineers traced the outages to this fortified relay.
        Break the road gate, disable its transmitter, and secure the archive. Those
        records can tell us who ordered the attacks.
      speaker: 2
      voiceClip: {fileID: 8300000, guid: 33f74c8f2a50e45b79ee3f81f8db2561, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 17.48
      essentialCaption: 1
    continueStateId: M05-brief-1
    skipStateId: M05-brief-complete
    reducedMotionSupported: 1
    durationSeconds: 17.73
    motionPreset: 0
