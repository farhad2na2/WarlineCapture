      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: citywide_alert-open-07
      textKey: narrative.citywide_alert.open-07
      englishFallback: We will protect these districts and keep command accountable.
        Hold both civic fronts, preserve the people keeping them alive, and prove
        that saving Sahrin does not require Qassem's permanent authority.
      speaker: 1
      voiceClip: {fileID: 8300000, guid: dc5c04f51a41a466d86f236197a4e997, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
