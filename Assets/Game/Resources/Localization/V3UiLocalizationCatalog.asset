      value: "\u067E\u06CC\u0634 \u0627\u0632 \u0631\u0633\u06CC\u062F\u0646 \u062E\u0637
        \u062E\u0627\u06A9\u0633\u062A\u0631\u060C \u067E\u0633\u062A \u062E\u0637
