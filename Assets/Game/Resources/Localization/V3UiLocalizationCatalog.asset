        \u0622\u0647\u0633\u062A\u0647 \u062D\u0631\u06A9\u062A \u0645\u06CC\u200C\u06A9\u0646\u0647
        \u0648\u0644\u06CC \u0628\u0631\u0627\u06CC \u0645\u0623\u0645\u0648\u0631\u06CC\u062A\u200C\u0647\u0627\u06CC
        \u067E\u0631\u062E\u0637\u0631 \u0645\u0642\u0627\u0648\u0645\u0647."
    - key: unit.description.chr_civilian_female_01
      value: "\u0634\u0647\u0631\u0648\u0646\u062F \u063A\u06CC\u0631\u0646\u0638\u0627\u0645\u06CC\u061B
