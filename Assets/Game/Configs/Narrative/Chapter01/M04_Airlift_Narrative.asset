      m_EditorAssetChanged: 0
    lines:
    - lineId: m04-brief-02
      textKey: narrative.m04.brief.02
      englishFallback: Two medics and two engineers are stranded by the western road.
        They are the people who can reopen the clinics and restore the network. Bring
        every one of them home.
      speaker: 2
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 11.714286
      essentialCaption: 1
    continueStateId: M04-brief-2
    skipStateId: M04-brief-complete
