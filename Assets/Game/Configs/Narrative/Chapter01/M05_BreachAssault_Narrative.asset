    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: 8608a2d831b064a92a17c78915fe0528
      m_SubObjectName: M05-B03-16x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    panel20x9Reference:
      m_AssetGUID: 8608a2d831b064a92a17c78915fe0528
      m_SubObjectName: M05-B03-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: m05-brief-03
      textKey: narrative.m05.brief.03
      englishFallback: The relay will erase its archive in twelve minutes. Stop the
        transmitter, defeat the responding guard, and hold the marked archive area
        for twenty clear seconds. I will guide each action.
      speaker: 3
      voiceClip: {fileID: 8300000, guid: d9a6f1293c68645cc905268a5db5af2a, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
