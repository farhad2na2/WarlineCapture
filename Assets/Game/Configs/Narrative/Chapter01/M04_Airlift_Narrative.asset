      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: m04-debrief-02
      textKey: narrative.m04.debrief.02
      englishFallback: The engineers brought their repair records. Several outages
        lead back to the same fortified communications node. We finally have a place
        to investigate.
      speaker: 2
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 10.857142
