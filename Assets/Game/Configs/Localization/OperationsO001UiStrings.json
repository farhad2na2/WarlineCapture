      ]
    },
    {
      "key": "operations.conclude",
      "source": "CONCLUDE",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "پایان مأموریت"
        }
      ]
    },
    {
      "key": "operations.withdraw",
      "source": "WITHDRAW",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "عقب‌نشینی"
        }
      ]
    },
    {
      "key": "operations.withdraw.confirm",
      "source": "Withdraw from Street Signals? This records a withdrawal and applies its district consequences. The mission continues until you confirm.",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "از سیگنال‌های خیابان عقب‌نشینی می‌کنید؟ عقب‌نشینی ثبت می‌شود و پیامدهای آن بر منطقه اعمال خواهد شد. مأموریت تا زمان تأیید شما ادامه دارد."
        }
      ]
    },
    {
      "key": "operations.o001.day_ap",
      "source": "Day {0} • AP {1}",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "روز {0} • امتیاز اقدام {1}"
        }
      ]
    },
