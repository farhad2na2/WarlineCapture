    height: 28%;
    background-image: url("../../Art/UI/Portraits/Secondary/Portrait_Unit_Chr_Insurgent_Male_02_MachineGun_Card_512.png");
    -unity-background-scale-mode: scale-to-fit;
}

.inspection-name {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 38%;
    height: 4.4%;
    font-size: 31px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(235, 229, 199);
}

.inspection-type {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 42.7%;
    height: 3.3%;
    font-size: 23px;
    -unity-text-align: middle-center;
    color: rgb(204, 189, 116);
}

.inspection-description {
    position: absolute;
    left: 9%;
    right: 9%;
    top: 46.8%;
    height: 6.4%;
    font-size: 20px;
    white-space: normal;
    -unity-text-align: upper-center;
    color: rgba(218, 222, 207, 0.86);
}

.stats-panel {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 54.5%;
    height: 12.5%;
}

.stat-row {
