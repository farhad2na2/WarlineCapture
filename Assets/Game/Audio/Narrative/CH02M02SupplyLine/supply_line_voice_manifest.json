      "assetPath": "Assets/Game/Audio/Narrative/CH02M02SupplyLine/Voice/fa/supply_line-debrief-02.wav",
      "durationSeconds": 15.68,
      "sha256": "5a4ff67bee11bac3dc77ad928db55a87165d7036168dbfa78dccaf65649a179d",
