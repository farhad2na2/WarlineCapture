      value: Civilian road crew. Keep Fadi and a worker close to the work site to
        clear it.
    - key: mission.gridlock.crew.group
      value: '{0} CREW'
    - key: mission.gridlock.crew.role
      value: Road crew
    - key: mission.gridlock.crew.select
      value: Select the road crew
    - key: mission.gridlock.deadline
      value: 12 active minutes
