      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: command_node-debrief-02
      textKey: narrative.command_node.debrief-02
      englishFallback: The complete audit has reached district councils, clinic networks,
        military commands and independent civic archives. No single office can bury
        the record again.
      speaker: 3
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 11.428572
      essentialCaption: 1
    continueStateId: CommandNode-debrief-2
    skipStateId: CommandNode-debrief-complete
