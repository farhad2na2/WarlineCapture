    -unity-text-align: middle-left;
    color: rgba(232, 238, 224, 0.94);
}

.build-panel,
.production-panel,
.production-panel-active {
    position: absolute;
    left: 0;
    right: 0;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_panel_frame_large.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 92;
    -unity-slice-right: 92;
    -unity-slice-top: 62;
    -unity-slice-bottom: 62;
}

.build-panel {
    top: 0;
