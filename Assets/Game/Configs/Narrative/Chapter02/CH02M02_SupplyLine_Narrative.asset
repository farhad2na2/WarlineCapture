    panel20x9Reference:
      m_AssetGUID: b99d871cee7b64c25a2a9970a28c409f
      m_SubObjectName: SupplyChain-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: supply_line-brief-03
      textKey: narrative.supply_line.brief.03
      englishFallback: 'Agreed. Forty barrels: twenty for essential services, twenty
        for relief transport. Protect both trucks and all three sites, defeat the
        sabotage teams, then hold the reserve for twenty seconds. We have twelve
        minutes.'
      speaker: 1
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 15.428572
      essentialCaption: 1
