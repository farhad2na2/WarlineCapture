    lines:
    - lineId: supply_line-debrief-02
      textKey: narrative.supply_line.debrief.02
      englishFallback: The stolen Fuel route matches Gridlock's preserved corridor.
        Decommissioned Civic Relay maps place dormant systems at its destination.
        The repeated pattern is now evidence, not coincidence.
      speaker: 3
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
