      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: false_front-brief-02
      textKey: narrative.false_front.brief.02
      englishFallback: The report's seal is valid, but its source trail is incomplete.
        The depot is unconfirmed. I recommend checking both approaches while keeping
        the evacuation route protected.
      speaker: 3
      voiceClip: {fileID: 8300000, guid: e8fef2e4eab9941c7af1ba8ccc8ae539, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
