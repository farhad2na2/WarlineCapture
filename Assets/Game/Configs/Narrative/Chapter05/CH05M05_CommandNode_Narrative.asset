      m_SubObjectName: CH05M05_CommandNode-brief-c-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: command_node-brief-03
      textKey: narrative.command_node.brief-03
      englishFallback: I will supervise the hazardous-control checks. Bring the original
        engineer to each marked isolation point after its guards are defeated, and
        let the full verification finish.
      speaker: 11
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 12.428572
      essentialCaption: 1
    continueStateId: CommandNode-brief-3
    skipStateId: CommandNode-brief-complete
    reducedMotionSupported: 1
    durationSeconds: 12.428572
    motionPreset: 0
    locationTitleKey: 
