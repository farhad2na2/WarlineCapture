  - stateId: TrustUnderFire-debrief-2
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: 8e2ea2d6a04c4599b85c6616535bce39
      m_SubObjectName: CH05M02_TrustUnderFire_Debrief-c-16x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    panel20x9Reference:
      m_AssetGUID: 8e2ea2d6a04c4599b85c6616535bce39
      m_SubObjectName: CH05M02_TrustUnderFire_Debrief-c-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: trust_under_fire-debrief-03
      textKey: narrative.trust_under_fire.debrief-03
      englishFallback: The next strike must leave that proof intact. We will isolate
        the verified network nodes and protect the people and structures around them.
        If the evidence dies there, Qassem becomes another voice claiming we lied.
      speaker: 1
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 15.285714
      essentialCaption: 1
