    lines:
    - lineId: network_collapse-debrief-01
      textKey: narrative.network_collapse.debrief-01
      englishFallback: The verified network is down, and the engineer brought the
        complete audit out safely. The protected buildings and staff survived. We
        chose the slower route because destroying the evidence would only leave Qassem
        another chance to claim we lied.
      speaker: 1
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 17.428572
      essentialCaption: 1
    continueStateId: NetworkCollapse-debrief-1
    skipStateId: NetworkCollapse-debrief-complete
