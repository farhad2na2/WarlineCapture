SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL_ID=Gyour-channel-id

CODEX_WORKTREE=/Users/farhad/Projects/WarlineCapture-SlackAgent
CODEX_BIN=/Applications/Codex.app/Contents/Resources/codex
CODEX_TRIGGER=codex local
POLL_SECONDS=8
STATE_DIR=/private/tmp/codex-local-relay

# Optional. Point this at a directory Jenkins can write to and this Mac can read.
# Jenkins writes JSON task files here when a build fails.
CODEX_TASK_DIR=/Users/farhad/Projects/Jenkins_Builds/WarlineCapture/CodexTasks

# Optional. Leave blank to use the Codex default.
CODEX_MODEL=
