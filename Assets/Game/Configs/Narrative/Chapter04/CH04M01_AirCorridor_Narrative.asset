    lines:
    - lineId: air_corridor-comms-laila
      textKey: narrative.air_corridor.comms-laila
      englishFallback: The western probe is breaking up. Don't chase it. The main
        formation is turning in from the north, and our relief flights still need
        this corridor.
      speaker: 5
      voiceClip: {fileID: 8300000, guid: 1a71bf96840ec4e7b9e2000d90eecfa8, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
