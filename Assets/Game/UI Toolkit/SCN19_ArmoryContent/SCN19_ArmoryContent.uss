.scn19-armory-content {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    -unity-font-definition: url("../../../Synty/InterfaceMilitaryCombatHUD/Fonts/Oxanium/Oxanium-Medium.ttf");
    color: rgb(218, 213, 188);
    background-color: rgb(9, 11, 12);
}

.scn19-armory-content Button,
.armory-item-view {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
}

.background {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(8, 10, 10);
}

.left-content {
    position: absolute;
    left: 0;
    top: 12.96%;
    width: 15%;
    bottom: 11.11%;
}

.title-block {
    position: absolute;
    left: 7.7%;
    top: 0;
    width: 78.8%;
    height: 10.4%;
}

.back-hotspot,
.back-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.back-frame {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV01/scn08_side_quick_button_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 32;
    -unity-slice-right: 32;
    -unity-slice-top: 22;
    -unity-slice-bottom: 22;
}

.back-icon {
    position: absolute;
    left: 7%;
    top: 23%;
    width: 16%;
    height: 54%;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_back_arrow.png");
    -unity-background-scale-mode: scale-to-fit;
}

.back-title {
    position: absolute;
    left: 27%;
    right: 6%;
    top: 18%;
    height: 35%;
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(231, 226, 202);
}

.back-subtitle {
    position: absolute;
    left: 27%;
    right: 6%;
    top: 50%;
    height: 30%;
    font-size: 21px;
    -unity-text-align: middle-left;
    color: rgba(190, 201, 191, 0.8);
}

.left-nav-panel {
    position: absolute;
    left: 7%;
    top: 13%;
    width: 80%;
    height: 72.9%;
}

.nav-item {
    position: relative;
    width: 100%;
    height: 18.8%;
    margin-bottom: 0;
}

.nav-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV01/scn08_side_quick_button_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 32;
    -unity-slice-right: 32;
    -unity-slice-top: 22;
    -unity-slice-bottom: 22;
    -unity-background-image-tint-color: rgba(178, 190, 176, 0.72);
}

.nav-item-selected .nav-frame {
    -unity-background-image-tint-color: rgb(217, 185, 92);
}

.nav-icon {
    position: absolute;
    left: 8%;
    top: 22%;
    width: 18%;
    height: 56%;
    -unity-background-scale-mode: scale-to-fit;
}

.support-icon,
.character-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_units_group.png");
}

.aircraft-icon,
.vehicle-icon,
.building-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_armory_crossed_weapons.png");
}

.nav-label {
    position: absolute;
    left: 31%;
    right: 6%;
    top: 0;
    bottom: 0;
    font-size: 26px;
    -unity-text-align: middle-left;
    color: rgb(221, 216, 191);
}

.middle-content {
    position: absolute;
    left: 15%;
    top: 12.96%;
    right: 15%;
    bottom: 11.11%;
}

.dropdown {
    position: absolute;
    top: 1.5%;
    width: 18.5%;
    height: 6.7%;
    background-color: rgba(10, 16, 16, 0.84);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(195, 181, 122, 0.75);
    border-right-color: rgba(195, 181, 122, 0.75);
    border-top-color: rgba(195, 181, 122, 0.75);
    border-bottom-color: rgba(195, 181, 122, 0.75);
}

.filter-dropdown {
    left: 1.2%;
}

.sort-dropdown {
    right: 36.8%;
}

.dropdown-label {
    position: absolute;
    left: 7%;
    right: 18%;
    top: 0;
    bottom: 0;
    font-size: 24px;
    -unity-text-align: middle-left;
    color: rgb(231, 225, 198);
}

.dropdown-chevron {
    position: absolute;
    right: 7%;
    top: 32%;
    width: 8%;
    height: 36%;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_dropdown_chevron.png");
    -unity-background-scale-mode: scale-to-fit;
}

.armory-scroll-view {
    position: absolute;
    left: 2.1%;
    right: 2.2%;
    top: 10.2%;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
}

.armory-scroll-view > .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

.armory-catalog-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 80px;
}

.armory-item-view {
    position: relative;
    width: 450px;
    height: 700px;
    margin-right: 10px;
    margin-bottom: 10px;
    overflow: hidden;
}

.item-background,
.item-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.item-background-character {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/thumb_04_building_supply_depot_thumb.png");
    -unity-background-scale-mode: scale-and-crop;
}

.item-background-vehicle {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_art_ammunition_depot.png");
    -unity-background-scale-mode: scale-and-crop;
}

.item-background-aircraft {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/thumb_08_building_advanced_radar_thumb.png");
    -unity-background-scale-mode: scale-and-crop;
}

.item-background-building {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/thumb_02_building_vehicle_depot_thumb.png");
    -unity-background-scale-mode: scale-and-crop;
}

.item-background-art {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 12%;
    height: 48%;
    -unity-background-scale-mode: scale-to-fit;
}

.character-card-art {
    background-image: url("../../Art/UI/Portraits/Secondary/Portrait_Unit_Chr_Insurgent_Male_02_MachineGun_Card_512.png");
}

.vehicle-card-art {
    background-image: url("../../Art/UI/Portraits/Generated/Portrait_Unit_Veh_APC_Fast_AI_RealisticVehicle_ChromaGreen.png");
}

.aircraft-card-art,
.building-card-art {
    background-image: url("../../Art/UI/Portraits/Generated/Portrait_Unit_Chr_Soldier_Female_01_AI_RealisticSniper_ChromaGreen.png");
}

.item-frame {
    background-image: url("../../Art/UI/Final/scn19_roster_card_default_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 42;
    -unity-slice-right: 42;
    -unity-slice-top: 42;
    -unity-slice-bottom: 42;
}

.armory-item-view.selected .item-frame {
    background-image: url("../../Art/UI/Final/scn19_roster_card_selected_frame.png");
}

.armory-item-view.locked .item-frame {
    background-image: url("../../Art/UI/Final/scn19_roster_card_locked_frame.png");
}

.item-title {
    position: absolute;
    left: 9%;
    right: 9%;
    top: 61%;
    height: 8%;
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(232, 226, 196);
}

.item-state-row {
    position: absolute;
    left: 19%;
    right: 19%;
    top: 70.5%;
    height: 6.8%;
}

.owned-badge {
    position: absolute;
    left: 0;
    top: 10%;
    width: 18%;
    height: 80%;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_badge_owned_checkmark.png");
    -unity-background-scale-mode: scale-to-fit;
}

.item-state-label {
    position: absolute;
    left: 20%;
    right: 0;
    top: 0;
    bottom: 0;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(126, 216, 156);
}

.item-progress {
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: 8%;
    height: 13%;
}

.item-progress-track {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 20%;
    background-color: rgba(27, 31, 30, 0.95);
}

.item-progress-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 62%;
    background-color: rgb(210, 178, 82);
}

.item-level {
    position: absolute;
    left: 0;
    width: 45%;
    top: 30%;
    bottom: 0;
    font-size: 23px;
    -unity-text-align: middle-left;
    color: rgb(217, 213, 191);
}

.item-type {
    position: absolute;
    right: 0;
    width: 50%;
    top: 30%;
    bottom: 0;
    font-size: 23px;
    -unity-text-align: middle-right;
    color: rgba(204, 216, 206, 0.82);
}

.right-content {
    position: absolute;
    right: 0.8%;
    top: 12.96%;
    width: 25%;
    bottom: 11.11%;
}

.inspection-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 1%;
    bottom: 2%;
}

.inspection-frame,
.inspection-art-background,
.inspection-portrait-art {
    position: absolute;
}

.inspection-frame {
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Final/scn19_inspection_panel_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 52;
    -unity-slice-right: 52;
    -unity-slice-top: 52;
    -unity-slice-bottom: 52;
}

.inspection-art-background {
    left: 7%;
    right: 7%;
    top: 6%;
    height: 30%;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/thumb_04_building_supply_depot_thumb.png");
    -unity-background-scale-mode: scale-and-crop;
}

.inspection-portrait-art {
    left: 13%;
    right: 13%;
