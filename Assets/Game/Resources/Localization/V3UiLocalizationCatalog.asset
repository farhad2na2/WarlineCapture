        \u0628\u06CC\u0633\u062A\u200C\u062B\u0627\u0646\u06CC\u0647\u200C\u0627\u06CC
        \u0634\u0631\u0648\u0639 \u0628\u0634\u0647."
    - key: mission.m05.hud.recovery.progress
      value: "\u062F\u0627\u0631\u0645 \u0627\u0633\u0646\u0627\u062F \u0631\u0648
