      m_SubObjectName: CH04M02_SteelPush_Debrief-b-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: steel_push-debrief-dalia
      textKey: narrative.steel_push.debrief-dalia
      englishFallback: Vanguard was not simply looking for Fuel. These orders tie
        the seizure to Qassem's Relay access plan. We stopped the column, but their
        long-range battery is now targeting the forward base.
      speaker: 1
      voiceClip: {fileID: 8300000, guid: f1ce29357d92343c5bc38d50a3c089fe, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
