.scn09-build-drawer-popup {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    -unity-font-definition: url("../../../Synty/InterfaceMilitaryCombatHUD/Fonts/Oxanium/Oxanium-Medium.ttf");
    color: rgb(235, 229, 202);
    background-color: rgba(0, 0, 0, 0);
}

.scn09-build-drawer-popup Button,
.catalog-item-view {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
}

.build-drawer-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.drawer-frame {
    position: absolute;
    left: 9.8%;
    right: 9.8%;
    top: 8.7%;
    height: 79.4%;
    background-color: rgba(8, 11, 12, 0.96);
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    border-bottom-left-radius: 28px;
    border-bottom-right-radius: 28px;
}

.outer-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(8, 11, 12, 0.96);
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/chrome_01_drawer_outer_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

.build-icon {
    position: absolute;
    left: 4.2%;
    top: 3.2%;
    width: 4.2%;
    height: 6.5%;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_06_icon_build_tools.png");
    -unity-background-scale-mode: scale-to-fit;
}

.drawer-title {
    position: absolute;
    left: 27%;
    right: 27%;
    top: 2%;
    height: 7.2%;
    font-size: 86px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(245, 238, 210);
}

.drawer-subtitle {
    position: absolute;
    left: 9.4%;
    top: 7.4%;
    width: 30%;
    height: 3.4%;
    font-size: 28px;
    -unity-text-align: middle-left;
    color: rgba(214, 223, 212, 0.9);
}

.left-panel {
    position: absolute;
    left: 3.8%;
    top: 14.2%;
    width: 60.8%;
    bottom: 8.6%;
}

.right-panel {
    position: absolute;
    right: 3.8%;
    top: 14.2%;
    width: 30.5%;
    bottom: 8.6%;
}

.tabs {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 9.8%;
    flex-direction: row;
    justify-content: space-between;
}

.drawer-tab {
    position: relative;
    width: 24.3%;
    height: 100%;
    translate: 0 0;
    scale: 1 1;
    transition-property: translate, scale;
    transition-duration: 90ms;
    transition-timing-function: ease-out;
}

.tab-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/chrome_05_tab_idle_bg.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 38;
    -unity-slice-right: 38;
    -unity-slice-top: 17;
    -unity-slice-bottom: 17;
}

.drawer-tab:hover,
.drawer-tab:focus {
    translate: 0 -4px;
    scale: 1.035 1.035;
}

.drawer-tab:active {
    translate: 0 -1px;
    scale: 0.985 0.985;
}

.drawer-tab-selected {
    translate: 0 -2px;
    scale: 1.025 1.025;
}

.drawer-tab:hover .tab-frame,
.drawer-tab:focus .tab-frame,
.drawer-tab-selected .tab-frame {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/chrome_04_tab_selected_bg.png");
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

.tab-icon {
    position: absolute;
    left: 8.5%;
    top: 24%;
    width: 17%;
    height: 52%;
    -unity-background-scale-mode: scale-to-fit;
}

.aircrafts-icon {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_icon_support_parachute.png");
}

.vehicles-icon {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_12_icon_vehicle_depot.png");
}

.soldiers-icon {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_11_icon_squad_group.png");
}

.buildings-icon {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_06_icon_build_tools.png");
}

.tab-label {
    position: absolute;
    left: 30%;
    right: 8%;
    top: 0;
    bottom: 0;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(238, 232, 204);
}

.catalog-scroll-view {
    position: absolute;
    left: 0;
    right: 0;
    top: 12.2%;
    bottom: 12.4%;
}

.catalog-scroll-view .unity-scroll-view__vertical-scroller,
.catalog-scroll-view .unity-scroll-view__horizontal-scroller,
.production-scroll-view .unity-scroll-view__vertical-scroller,
.production-scroll-view .unity-scroll-view__horizontal-scroller {
    display: none;
}

.catalog-scroll-view > .unity-scroll-view__content-container,
.catalog-scroll-view .unity-scroll-view__content-container {
    width: 100%;
    height: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

.catalog-content {
    width: 100%;
    height: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    padding-left: 26px;
    padding-right: 26px;
    padding-top: 12px;
    padding-bottom: 34px;
}

.catalog-item-slot,
.catalog-item-view {
    position: relative;
    width: 23.5%;
    height: 980px;
    margin-right: 1.35%;
    margin-bottom: 56px;
    overflow: visible;
    translate: 0 0;
    scale: 1 1;
    transition-property: translate, scale;
    transition-duration: 90ms;
    transition-timing-function: ease-out;
}

.catalog-item-frame,
.catalog-thumb,
.catalog-top-overlay,
.catalog-bottom-overlay {
    position: absolute;
}

.catalog-item-frame {
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(7, 10, 11, 0.95);
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/chrome_09_card_frame_tall.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

.catalog-item-view:hover,
.catalog-item-view:focus {
    translate: 0 -8px;
    scale: 1.035 1.035;
}

.catalog-item-view:active {
    translate: 0 -2px;
    scale: 0.985 0.985;
}

.catalog-item-slot.selected,
.catalog-item-view.selected {
    translate: 0 -4px;
    scale: 1.025 1.025;
}

.catalog-item-view:hover .catalog-item-frame,
.catalog-item-view:focus .catalog-item-frame,
.catalog-item-slot.selected .catalog-item-frame,
.catalog-item-view.selected .catalog-item-frame {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/chrome_07_selected_card_highlight_frame.png");
    -unity-background-image-tint-color: rgb(255, 232, 112);
}

.catalog-thumb {
    left: 9.5%;
    right: 9.5%;
    top: 13%;
    height: 47%;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/thumb_06_building_oil_refinery_thumb.png");
    -unity-background-scale-mode: scale-and-crop;
}

.thumb-watchtower {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/thumb_03_building_watchtower_thumb.png");
}

.thumb-barracks {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/thumb_01_building_barracks_thumb.png");
}

.thumb-vehicle-depot {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/thumb_02_building_vehicle_depot_thumb.png");
}

.thumb-supply-depot {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/thumb_04_building_supply_depot_thumb.png");
}

.thumb-oil-pump {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/thumb_05_building_oil_pump_thumb.png");
}

.thumb-fuel-bladder {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/thumb_07_building_fuel_bladder_thumb.png");
}

.thumb-radar {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/thumb_08_building_advanced_radar_thumb.png");
}

.catalog-top-overlay {
    left: 9.5%;
    right: 9.5%;
    top: 13%;
    height: 20%;
    background-color: rgba(0, 0, 0, 0.08);
}

.catalog-bottom-overlay {
    left: 9.5%;
    right: 9.5%;
    top: 60%;
    height: 28%;
    background-color: rgba(3, 8, 8, 0.78);
}

.catalog-title {
    position: absolute;
    left: 11.5%;
    right: 11.5%;
    top: 61.5%;
    height: 10.5%;
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(244, 238, 210);
}

.catalog-role {
    position: absolute;
    left: 12%;
    right: 12%;
    top: 72.5%;
    height: 8%;
    font-size: 27px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgba(210, 222, 210, 0.8);
}

.catalog-cost-panel {
    position: absolute;
    left: 12%;
    right: 12%;
    bottom: 7.5%;
    height: 8.7%;
    flex-direction: row;
    justify-content: space-between;
}

.tiny-cost {
    position: relative;
    width: 46%;
    height: 100%;
}

.tiny-cost-icon {
    position: absolute;
    left: 0;
    top: 9%;
    width: 30%;
    height: 82%;
    -unity-background-scale-mode: scale-to-fit;
}

.credits-icon {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_01_icon_credits.png");
}

.supplies-icon {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_02_icon_supplies.png");
}

.time-icon {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_05_icon_time.png");
}

.tiny-cost-value {
    position: absolute;
    left: 35%;
    right: 0;
    top: 0;
    bottom: 0;
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(244, 238, 210);
}

.time-tiny-cost {
    position: absolute;
    left: 31%;
    right: 31%;
    top: 49.5%;
    height: 8.2%;
}

.instruction-strip {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 10.5%;
}

.instruction-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/chrome_14_bottom_instruction_strip.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

.instruction-cursor-icon {
    position: absolute;
    left: 3%;
    top: 24%;
    width: 5%;
    height: 52%;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_18_icon_placement_cursor.png");
    -unity-background-scale-mode: scale-to-fit;
}

.instruction-info-icon {
    position: absolute;
    left: 9.6%;
    top: 27%;
    width: 4.4%;
    height: 46%;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_icon_warning_triangle.png");
    -unity-background-scale-mode: scale-to-fit;
}

.instruction-text {
    position: absolute;
    left: 15.5%;
    right: 4.5%;
    top: 0;
    bottom: 0;
    font-size: 34px;
    -unity-text-align: middle-left;
    color: rgba(232, 238, 224, 0.94);
}

.build-panel,
.production-panel,
.production-panel-active {
    position: absolute;
    left: 0;
    right: 0;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/chrome_02_detail_panel_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

.build-panel {
    top: 0;
    height: 58%;
}

.production-panel {
    bottom: 0;
    height: 38.5%;
}

.build-name {
    position: absolute;
    left: 7%;
    top: 4.8%;
    width: 56%;
    height: 8.4%;
    font-size: 48px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(245, 238, 210);
}

.build-role {
    position: absolute;
    left: 7%;
    top: 13%;
    width: 52%;
    height: 5.1%;
    font-size: 27px;
    -unity-text-align: middle-left;
    color: rgb(219, 191, 93);
}

.build-preview {
    position: absolute;
    left: 7%;
    top: 22%;
    width: 50%;
    height: 40%;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/thumb_06_building_oil_refinery_thumb.png");
    -unity-background-scale-mode: scale-and-crop;
}

.preview-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 38%;
    background-color: rgba(0, 0, 0, 0.64);
}

.build-description {
    position: absolute;
    left: 4.5%;
    right: 4.5%;
    bottom: 6%;
    height: 30%;
    font-size: 29px;
    white-space: normal;
    -unity-text-align: upper-left;
    color: rgba(230, 236, 220, 0.9);
}

.preview-border {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_rect_button_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 90;
    -unity-slice-right: 90;
    -unity-slice-top: 60;
    -unity-slice-bottom: 60;
}

.build-detail-list {
    position: absolute;
    right: 6%;
    top: 6%;
    width: 36%;
    height: 57%;
}

.build-detail-row {
    position: relative;
    width: 100%;
    height: 16.2%;
}

.detail-divider {
    position: relative;
    width: 100%;
    height: 2px;
    background-color: rgba(205, 188, 92, 0.42);
}

.detail-icon,
.detail-small-icon {
    position: absolute;
    -unity-background-scale-mode: scale-to-fit;
}

.detail-icon {
    left: 0;
    top: 22%;
    width: 11%;
    height: 56%;
}

.footprint-icon,
.placement-corners-icon {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_17_icon_placement_corners.png");
}

.detail-label {
    position: absolute;
    left: 14%;
    right: 0;
    top: 0;
    height: 40%;
    font-size: 24px;
    -unity-text-align: middle-left;
    color: rgba(206, 220, 208, 0.82);
}

.detail-value {
    position: absolute;
    right: 0;
    bottom: 4%;
    width: 40%;
    height: 52%;
    font-size: 29px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: rgb(244, 238, 210);
}

.wide-value {
    left: 14%;
    right: 0;
    width: auto;
    -unity-text-align: middle-right;
}

.detail-inline-value {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 42%;
    height: 74%;
}

.credits-cost {
    right: 27%;
}

.supplies-cost {
    right: 0;
}

.detail-small-icon {
    left: 0;
    top: 19%;
    width: 25%;
    height: 62%;
}

.detail-inline-value .detail-value {
    left: 31%;
    right: 0;
    width: auto;
}

.build-action-button {
    position: absolute;
    left: 7%;
    right: 7%;
    bottom: 6%;
    height: 15%;
    translate: 0 0;
    scale: 1 1;
    transition-property: translate, scale;
    transition-duration: 90ms;
    transition-timing-function: ease-out;
}

.gold-button-frame,
.rush-frame,
.clear-frame,
.close-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.gold-button-frame,
.rush-frame {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/chrome_06_gold_action_button_bg.png");
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 25;
    -unity-slice-bottom: 25;
    -unity-background-image-tint-color: rgb(255, 210, 74);
}

.build-action-button:hover,
.build-action-button:focus {
    translate: 0 -5px;
    scale: 1.035 1.035;
}

.build-action-button:active {
    translate: 0 -1px;
    scale: 0.985 0.985;
}

.build-action-label {
    position: absolute;
    left: 4%;
    right: 4%;
    top: 0;
    bottom: 0;
    font-size: 48px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(31, 28, 17);
}

.no-production-label {
    position: absolute;
    left: 7%;
    right: 7%;
    top: 42%;
    height: 14%;
    font-size: 34px;
    -unity-text-align: middle-center;
    color: rgba(210, 222, 212, 0.72);
}

.production-panel-active {
    top: 0;
    bottom: 0;
}

.production-title {
    position: absolute;
    left: 7%;
    top: 6%;
    width: 56%;
    height: 10%;
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(245, 238, 210);
}

.production-count {
    position: absolute;
    right: 13%;
    top: 6.5%;
    width: 14%;
    height: 9%;
    font-size: 31px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: rgb(219, 191, 93);
}

.production-info-icon {
    position: absolute;
    right: 6.2%;
    top: 7%;
    width: 5%;
    height: 8%;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_icon_warning_triangle.png");
    -unity-background-scale-mode: scale-to-fit;
}

.production-scroll-view {
    position: absolute;
    left: 6%;
    right: 6%;
    top: 20%;
    bottom: 23%;
}

.production-content {
    flex-direction: column;
    padding-right: 0;
    padding-bottom: 8px;
}

.production-item-view {
    position: relative;
    width: 100%;
    height: 142px;
    margin-bottom: 16px;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/chrome_12_secondary_button_bg.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

.queue-number-panel,
.queue-order-button {
    position: absolute;
    top: 18%;
    width: 9.5%;
    height: 64%;
}

.queue-number-panel {
    left: 2.4%;
}

.queue-order-button {
    right: 2.4%;
}

.queue-small-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/chrome_13_small_status_chip_bg.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

.queue-number {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(244, 238, 210);
}

.queue-thumb {
    position: absolute;
    left: 14%;
    top: 16%;
    width: 12%;
    height: 68%;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/thumb_06_building_oil_refinery_thumb.png");
    -unity-background-scale-mode: scale-and-crop;
}

.queue-name {
    position: absolute;
    left: 30%;
    top: 28%;
    width: 30%;
    height: 34%;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(244, 238, 210);
}

.queue-time {
    position: absolute;
    right: 16%;
    top: 28%;
    width: 24%;
    height: 34%;
    font-size: 30px;
    -unity-text-align: middle-right;
    color: rgba(214, 226, 214, 0.9);
}

.queue-order-icon {
    position: absolute;
    left: 25%;
    right: 25%;
    top: 25%;
    bottom: 25%;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_icon_menu_list.png");
    -unity-background-scale-mode: scale-to-fit;
}

.active-queue-thumb {
    left: 3%;
}

.active-queue-name {
    position: absolute;
    left: 18%;
    top: 18%;
    width: 32%;
    height: 30%;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(244, 238, 210);
}

.active-progress-slider {
    position: absolute;
    left: 18%;
    top: 55%;
    width: 45%;
    height: 20%;
}

.active-progress-track,
.active-progress-fill-area,
.active-progress-fill {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.active-progress-track {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_progress_track_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 52;
    -unity-slice-right: 52;
    -unity-slice-top: 18;
    -unity-slice-bottom: 18;
}

.active-progress-fill-area {
    right: 35%;
}

.active-progress-fill {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_progress_fill_gold.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 52;
    -unity-slice-right: 52;
    -unity-slice-top: 18;
    -unity-slice-bottom: 18;
}

.active-progress-text {
    position: absolute;
    left: 105%;
    width: 22%;
    top: -35%;
    height: 170%;
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(244, 238, 210);
}

.active-cancel-button {
    right: 2.4%;
}

.active-cancel-icon {
    position: absolute;
    left: 26%;
    right: 26%;
    top: 26%;
    bottom: 26%;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_20_icon_close.png");
    -unity-background-scale-mode: scale-to-fit;
}

.production-buttons-panel {
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: 6%;
    height: 14%;
    flex-direction: row;
    justify-content: space-between;
}

.production-action {
    position: relative;
    width: 48.5%;
    height: 100%;
    translate: 0 0;
    scale: 1 1;
    transition-property: translate, scale;
    transition-duration: 90ms;
    transition-timing-function: ease-out;
}

.clear-frame {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/chrome_12_secondary_button_bg.png");
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

.production-action:hover,
.production-action:focus {
    translate: 0 -4px;
    scale: 1.035 1.035;
}

.production-action:active {
    translate: 0 -1px;
    scale: 0.985 0.985;
}

.rush-icon,
.clear-icon {
    position: absolute;
    left: 17%;
    top: 24%;
    width: 14%;
    height: 52%;
    -unity-background-scale-mode: scale-to-fit;
}

.rush-icon {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_15_icon_plus.png");
}

.clear-icon {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_20_icon_close.png");
}

.production-action-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(244, 238, 210);
}

.rush-button .production-action-label {
    color: rgb(31, 28, 17);
}

.close-button {
    position: absolute;
    right: 3.6%;
    top: 3.2%;
    width: 4.4%;
    height: 6.5%;
    translate: 0 0;
    scale: 1 1;
    transition-property: translate, scale;
    transition-duration: 90ms;
    transition-timing-function: ease-out;
}

.close-frame {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_square_button_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 150;
    -unity-slice-right: 150;
    -unity-slice-top: 150;
    -unity-slice-bottom: 150;
}

.close-button:hover,
.close-button:focus {
    translate: 0 -4px;
    scale: 1.045 1.045;
}

.close-button:active {
    translate: 0 -1px;
    scale: 0.985 0.985;
}

.close-icon {
    position: absolute;
    left: 26%;
    right: 26%;
    top: 26%;
    bottom: 26%;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_20_icon_close.png");
    -unity-background-scale-mode: scale-to-fit;
}
