  states:
  - stateId: SteelPush-debrief-0
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: 75a18f7e42964d4fbc7a627c38641227
