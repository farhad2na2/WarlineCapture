      m_SubObjectName: M04-D03-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: m04-debrief-03
      textKey: narrative.m04.debrief.03
      englishFallback: 'Extraction confirmed. Captain Nasser is on the roster. Next
        objective: assess that communications node. First, let the medical team get
        back to work.'
      speaker: 3
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
