    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: 75a18f7e42964d4fbc7a627c38641227
      m_SubObjectName: CH04M02_SteelPush_Debrief-c-16x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    panel20x9Reference:
      m_AssetGUID: 75a18f7e42964d4fbc7a627c38641227
      m_SubObjectName: CH04M02_SteelPush_Debrief-c-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: steel_push-debrief-aria
      textKey: narrative.steel_push.debrief-aria
      englishFallback: The recovered order names the final authority key, but its
        meaning is not yet confirmed. I will preserve the evidence. The next defense
        requires a verified battery target and enough forces to hold the base.
      speaker: 3
      voiceClip: {fileID: 8300000, guid: 06b58d911f8dc43af922b26d892e8141, type: 3}
