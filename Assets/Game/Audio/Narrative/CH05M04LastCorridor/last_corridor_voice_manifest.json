    {
      "kind": "narrative",
      "id": "last_corridor-comms-01",
      "speaker": "SAMIRA",
      "locale": "en-US",
      "text": "The main lane is obstructed. The original engineer can restore its marked link with a six-second hold; the protected alternate remains connected. Keep medicine on the safer lane and choose the confirmed route for Fuel and the keys. This guidance does not move the convoy for you.",
      "voiceId": "7uxeJ73HfJL9gOH2mttA",
      "voiceName": "Warline - Engineer Samira Haddad",
      "assetPath": "Assets/Game/Audio/Narrative/CH05M04LastCorridor/Voice/en/last_corridor-comms-01.wav",
      "durationSeconds": 16.32,
