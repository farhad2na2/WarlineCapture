.scn19-armory-content {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    -unity-font-definition: url("../../../Synty/InterfaceMilitaryCombatHUD/Fonts/Oxanium/Oxanium-Medium.ttf");
    color: rgb(242, 232, 196);
    background-color: rgb(8, 10, 10);
}

.scn19-armory-content Button,
.armory-item-view {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
}

.background,
.background-shade,
.header-back-plate,
.middle-frame,
.inspection-frame,
.category-frame,
.item-frame,
.bottom-tab-frame,
.resource-frame,
.header-menu-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.background {
    left: -1.5%;
    right: -1.5%;
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_background_command_table_no_ui.png");
    -unity-background-scale-mode: scale-and-crop;
}

.background-shade {
    background-color: rgba(6, 7, 6, 0.16);
}

.header-content {
    position: absolute;
    left: 0.2%;
    right: 0.2%;
    top: 0.55%;
    height: 11.8%;
}

.header-back-plate {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_header_bar_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 110;
    -unity-slice-right: 110;
    -unity-slice-top: 52;
    -unity-slice-bottom: 52;
    -unity-slice-scale: 0.26px;
}

.header-logo-panel {
    position: absolute;
    left: 1.15%;
    top: 9%;
    width: 25.9%;
    height: 76%;
}

.header-logo {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/SplashLoading/TargetLockV04Imagegen/Sprites/scn01_v04_logo_lockup.png");
    -unity-background-scale-mode: scale-to-fit;
}

.header-resource-area {
    position: absolute;
    right: 5.6%;
    top: 17.5%;
    width: 45.8%;
    height: 63%;
    flex-direction: row;
    justify-content: space-between;
}

.resource-panel {
    position: relative;
    width: 24.2%;
    height: 100%;
}

.risk-panel {
    width: 26.2%;
}

.resource-frame {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_resource_chip_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 135;
    -unity-slice-right: 135;
    -unity-slice-top: 82;
    -unity-slice-bottom: 82;
    -unity-slice-scale: 0.19px;
}

.resource-icon,
.resource-text-block,
.resource-plus,
.header-menu-icon {
    position: absolute;
}

.resource-icon {
    left: 7%;
    top: 18%;
    width: 19%;
    height: 64%;
    -unity-background-scale-mode: scale-to-fit;
}

.credits-icon {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_icon_credits_coin.png");
}

.fuel-icon {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_icon_fuel_can.png");
}

.supply-icon {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_resource_crate_icon.png");
}

.risk-icon {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_icon_civilian_group.png");
}

.resource-text-block {
    left: 30%;
    right: 16%;
    top: 11%;
    bottom: 10%;
}

.risk-text-block {
    right: 7%;
}

.resource-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 40%;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: lower-left;
    color: rgb(238, 229, 195);
}

.resource-value {
    position: absolute;
    left: 0;
    right: 0;
    top: 38%;
    bottom: 0;
    font-size: 31px;
    -unity-font-style: bold;
    -unity-text-align: upper-left;
    color: rgb(238, 202, 58);
    white-space: nowrap;
}

.resource-plus {
    right: 5%;
    top: 31%;
    width: 11%;
    height: 38%;
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_plus_icon.png");
    -unity-background-scale-mode: scale-to-fit;
}

.header-menu-button {
    position: absolute;
    right: 1.15%;
    top: 17.5%;
    width: 4.2%;
    height: 63%;
}

.header-menu-frame {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_header_square_button_frame_default.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 150;
    -unity-slice-right: 150;
    -unity-slice-top: 150;
    -unity-slice-bottom: 150;
    -unity-slice-scale: 0.18px;
}

.header-menu-icon {
    left: 25%;
    right: 25%;
    top: 25%;
    bottom: 25%;
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_menu_hamburger_icon.png");
    -unity-background-scale-mode: scale-to-fit;
}

.left-content {
    position: absolute;
    left: 0.65%;
    top: 32.2%;
    width: 16.0%;
    height: 38.7%;
}

.left-nav-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
    justify-content: space-between;
}

.category-button {
    position: relative;
    width: 100%;
    height: 18.1%;
}

.category-frame {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_category_button_default_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 58;
    -unity-slice-right: 58;
    -unity-slice-top: 20;
    -unity-slice-bottom: 20;
    -unity-slice-scale: 0.48px;
}

.category-selected .category-frame {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_category_button_selected_frame.png");
}

.category-icon {
    position: absolute;
    left: 13%;
    top: 23%;
    width: 18%;
    height: 54%;
    -unity-background-scale-mode: scale-to-fit;
}

.units-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_units_group.png");
}

.vehicles-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_vehicle_truck.png");
}

.aircraft-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_aircraft_helicopter.png");
}

.buildings-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_buildings.png");
}

.upgrades-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_upgrades_chevrons.png");
}

.category-label {
    position: absolute;
    left: 39%;
    right: 7%;
    top: 0;
    bottom: 0;
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(240, 232, 199);
    white-space: nowrap;
}

.middle-content {
    position: absolute;
    left: 17.75%;
    top: 12.35%;
    width: 55.6%;
    height: 72.3%;
}

.middle-frame {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_panel_frame_large.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 78;
    -unity-slice-right: 78;
    -unity-slice-top: 60;
    -unity-slice-bottom: 60;
    -unity-slice-scale: 0.34px;
    -unity-background-image-tint-color: rgb(246, 232, 182);
}

.screen-title {
    position: absolute;
    left: 3.2%;
    top: 3.3%;
    width: 24%;
    height: 8.5%;
    font-size: 42px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(242, 232, 196);
    letter-spacing: 0;
}

.dropdown {
    position: absolute;
    top: 4.4%;
    height: 6.8%;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_dropdown_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 22;
    -unity-slice-bottom: 22;
    -unity-slice-scale: 0.46px;
}

.filter-dropdown {
    right: 31.5%;
    width: 23.2%;
}

.sort-dropdown {
    right: 4.2%;
    width: 23.8%;
}

.dropdown-label {
    position: absolute;
    left: 8%;
    right: 18%;
    top: 0;
    bottom: 0;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(242, 232, 196);
}

.dropdown-chevron {
    position: absolute;
    right: 8%;
    top: 29%;
    width: 9%;
    height: 42%;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_dropdown_chevron.png");
    -unity-background-scale-mode: scale-to-fit;
}

.armory-scroll-view {
    position: absolute;
    left: 2.8%;
    right: 3.0%;
    top: 15.1%;
    bottom: 3.2%;
    background-color: rgba(0, 0, 0, 0);
}

.armory-scroll-view .unity-scroll-view__vertical-scroller,
.armory-scroll-view .unity-scroll-view__horizontal-scroller {
    display: none;
}

.armory-scroll-view > .unity-scroll-view__content-container {
    width: 100%;
    min-width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

.armory-catalog-grid {
    width: 100%;
    min-width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    padding-left: 0.6%;
    padding-right: 0.6%;
    padding-top: 0.5%;
    padding-bottom: 22px;
}

.armory-item-view {
    position: relative;
    width: 22.4%;
    height: 278px;
    margin-right: 2.15%;
    margin-bottom: 19px;
    overflow: hidden;
}

.item-frame {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_roster_card_default_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 54;
    -unity-slice-right: 54;
    -unity-slice-top: 64;
    -unity-slice-bottom: 64;
    -unity-slice-scale: 0.68px;
}

.armory-item-view.selected .item-frame {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_roster_card_selected_frame.png");
}

.armory-item-view.locked .item-frame {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_roster_card_locked_frame.png");
}

.item-rarity {
    position: absolute;
    left: 45%;
    top: 0.2%;
    width: 10%;
    height: 9%;
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_deploy_star_icon.png");
    -unity-background-scale-mode: scale-to-fit;
}

.rarity-purple {
    -unity-background-image-tint-color: rgb(190, 126, 231);
}

.item-art {
    position: absolute;
    left: 10.4%;
    right: 10.4%;
    top: 17%;
    height: 35.4%;
    background-color: rgb(12, 15, 14);
    -unity-background-scale-mode: scale-and-crop;
}

.rifle-art,
.sniper-art,
.bomb-art {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_art_rifleman_male_ii.png");
}

.vehicle-art,
.tank-art,
.artillery-art {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_art_canopy_truck.png");
}

.aircraft-art,
.helicopter-art {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_art_attack_helicopter.png");
}

.item-title {
    position: absolute;
    left: 9%;
    right: 9%;
    top: 55.2%;
    height: 9%;
    font-size: 19px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(244, 238, 210);
    white-space: nowrap;
}

.item-state-row {
    position: absolute;
    left: 13%;
    right: 13%;
    top: 65.2%;
    height: 8.5%;
}

.owned-badge,
.lock-badge {
    position: absolute;
    right: 0;
    top: 8%;
    width: 15%;
    height: 84%;
    -unity-background-scale-mode: scale-to-fit;
}

.owned-badge {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_badge_owned_checkmark.png");
}

.lock-badge {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_hold_shield.png");
    -unity-background-image-tint-color: rgb(205, 81, 64);
}

.item-state-label {
    position: absolute;
    left: 0;
    right: 17%;
    top: 0;
    bottom: 0;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.owned-state {
    color: rgb(154, 226, 64);
}

.locked-state {
    color: rgb(229, 84, 60);
}

.item-progress {
    position: absolute;
    left: 11%;
    right: 11%;
    bottom: 7.5%;
    height: 12%;
}

.item-progress-track,
.level-track {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 30%;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_progress_meter_empty_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 36;
    -unity-slice-right: 36;
    -unity-slice-top: 7;
    -unity-slice-bottom: 7;
    -unity-slice-scale: 0.68px;
}

.item-progress-fill,
.level-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 78%;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_progress_fill_olive_segment.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 22;
    -unity-slice-right: 22;
    -unity-slice-top: 5;
    -unity-slice-bottom: 5;
    -unity-slice-scale: 0.68px;
}

.medium-fill {
    width: 58%;
}

.item-level,
.item-type {
    position: absolute;
    top: 38%;
    bottom: 0;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(226, 218, 188);
}

.item-level {
    left: 0;
    width: 42%;
    -unity-text-align: middle-left;
}

.item-type {
    right: 0;
    width: 52%;
    -unity-text-align: middle-right;
}

.right-content {
    position: absolute;
    right: 0.75%;
    top: 12.35%;
    width: 24.4%;
    height: 72.3%;
}

.inspection-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.inspection-frame {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_inspection_panel_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 82;
    -unity-slice-right: 82;
    -unity-slice-top: 82;
    -unity-slice-bottom: 82;
    -unity-slice-scale: 0.52px;
}

.inspection-name {
    position: absolute;
    left: 9%;
    right: 9%;
    top: 2.5%;
    height: 6%;
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(242, 232, 196);
}

.inspection-type {
    position: absolute;
    left: 9%;
    right: 9%;
    top: 8.4%;
    height: 4.5%;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    color: rgb(156, 226, 62);
}

.inspection-portrait-frame {
    position: absolute;
    left: 8.6%;
    right: 8.6%;
    top: 14.0%;
    height: 23.8%;
    background-color: rgb(13, 17, 17);
    overflow: hidden;
}

.inspection-portrait-art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_art_rifleman_male_ii.png");
    -unity-background-scale-mode: scale-and-crop;
}

.level-row {
    position: absolute;
    left: 8.6%;
    right: 8.6%;
    top: 39.0%;
    height: 8.4%;
}

.level-label,
.level-value,
.xp-value {
