}

.health-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_health_cross.png");
}

.damage-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_damage_burst.png");
}

.armor-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_hold_shield.png");
}

.speed-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_speed_boot.png");
}

.capacity-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_units_group.png");
}

.stat-name {
    position: absolute;
    left: 12%;
    width: 55%;
    top: 0;
