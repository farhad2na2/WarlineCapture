      "id": "m01-brief.line.1",
      "speaker": "DALIA",
      "locale": "en-US",
      "text": "First contact is confirmed: three armed Ash Line operatives are blocking the clinic corridor in Old Market.",
      "voiceId": "MK1Zvh93428YrgOQ8Obr",
      "voiceName": "Warline - Major Dalia Rahim",
      "assetPath": "Assets/Game/Audio/Narrative/M01FirstContact/Voice/en/m01-brief.line.1.wav",
