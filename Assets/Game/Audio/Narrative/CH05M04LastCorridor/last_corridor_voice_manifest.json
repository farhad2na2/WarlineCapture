      "variant": "",
      "captionSha256": "7a55bf5d54f0e92a64f17bdc686187aaa23cd1a11f0d142291ff89b889ac1484"
    },
    {
      "deliveryProfile": "fa-conversational-v1",
      "voiceSettings": {
        "stability": 0.5,
        "similarity_boost": 0.75
      },
      "performanceDirection": "[conversational tone]",
      "kind": "narrative",
      "id": "last_corridor-brief-03",
      "speaker": "LAILA",
      "locale": "fa-IR",
      "text": "کریم و من مسیرهای هوایی رو زیر نظر داریم، ولی با این وضعیت تهدید نمی‌تونیم انتقال هوایی رو تأیید کنیم. همهٔ محموله‌های ضروری رو در مسیرهای زمینی مشخص‌شده نگه دارین. کامیون‌های اصلی و نفربر کلیدها رو حفظ کنین؛ خودروی جایگزین، سابقهٔ نگهداری اون‌ها رو حمل نمی‌کنه.",
      "voiceId": "EXAVITQu4vr4xnSDxMaL",
      "voiceName": "Sarah (Captain Laila Nasser)",
      "assetPath": "Assets/Game/Audio/Narrative/CH05M04LastCorridor/Voice/fa/last_corridor-brief-03.wav",
      "durationSeconds": 20.8,
      "sha256": "42b5e17edd30aa278ea1e40171e24a96ce606e50f812687f8b8456d56bad4c93",
