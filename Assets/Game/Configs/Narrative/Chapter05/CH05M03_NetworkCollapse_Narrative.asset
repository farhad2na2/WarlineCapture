      m_EditorAssetChanged: 0
    panel20x9Reference:
      m_AssetGUID: 56ba14ba6a644ce89bfdb1a4b4f68ffd
      m_SubObjectName: CH05M03_NetworkCollapse-a-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: network_collapse-brief-01
      textKey: narrative.network_collapse.brief-01
      englishFallback: "Three command nodes sit among homes and civic services. A
        blind long-range strike would destroy the audit with them. We take the ground
        route: clear each node\u2019s guards, verify its external access, then disable
        only the confirmed node."
      speaker: 1
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 17.5
      essentialCaption: 1
    continueStateId: NetworkCollapse-brief-1
    skipStateId: NetworkCollapse-brief-complete
    reducedMotionSupported: 1
    durationSeconds: 17.5
    motionPreset: 0
    locationTitleKey: 
    locationTitleFallback: 
    locationSubtitleKey: 
    locationSubtitleFallback: 
