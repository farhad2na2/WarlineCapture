      m_EditorAssetChanged: 0
    lines:
    - lineId: trust_under_fire-debrief-01
      textKey: narrative.trust_under_fire.debrief-01
      englishFallback: The evacuation groups reached their shelters, and the routes
        remained open. People could see where help was arriving. We will also keep
        an honest record of delays and damage; a protected road does not erase what
        still needs repair.
      speaker: 2
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 16.5
      essentialCaption: 1
    continueStateId: TrustUnderFire-debrief-1
    skipStateId: TrustUnderFire-debrief-complete
