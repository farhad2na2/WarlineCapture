  text:
  - key: narrative.first_launch.control.skip
    value: "\u0631\u062F \u06A9\u0631\u062F\u0646"
  - key: narrative.first_launch.control.continue
    value: "\u0627\u062F\u0627\u0645\u0647"
  - key: narrative.first_launch.control.confirm_skip
    value: "\u0631\u062F \u06A9\u0631\u062F\u0646 \u0645\u0642\u062F\u0645\u0647"
  - key: narrative.first_launch.control.cancel_skip
    value: "\u0627\u062F\u0627\u0645\u0647\u0654 \u062A\u0645\u0627\u0634\u0627"
  - key: narrative.first_launch.speaker.radio.name
    value: "\u0645\u0631\u06A9\u0632 \u0627\u0639\u0632\u0627\u0645 \u0645\u0646\u0637\u0642\u0647"
  - key: narrative.first_launch.speaker.radio.role
    value: "\u0639\u0645\u0644\u06CC\u0627\u062A \u0627\u0636\u0637\u0631\u0627\u0631\u06CC"
  - key: narrative.first_launch.speaker.radio.accessible_label
    value: "\u0645\u0633\u0626\u0648\u0644 \u0627\u0639\u0632\u0627\u0645 \u0627\u0636\u0637\u0631\u0627\u0631\u06CC
      \u0645\u0646\u0637\u0642\u0647"
  - key: narrative.first_launch.speaker.dalia.name
    value: "\u062F\u0627\u0644\u06CC\u0627 \u0631\u062D\u06CC\u0645"
  - key: narrative.first_launch.speaker.dalia.role
    value: "\u0641\u0631\u0645\u0627\u0646\u062F\u0647\u06CC \u0645\u06CC\u062F\u0627\u0646\u06CC
      \u0648\u0627\u06A9\u0646\u0634 \u0645\u0634\u062A\u0631\u06A9"
  - key: narrative.first_launch.speaker.dalia.accessible_label
    value: "\u0633\u0631\u06AF\u0631\u062F \u062F\u0627\u0644\u06CC\u0627 \u0631\u062D\u06CC\u0645\u060C
      \u0641\u0631\u0645\u0627\u0646\u062F\u0647 \u0645\u06CC\u062F\u0627\u0646\u06CC"
  - key: narrative.first_launch.speaker.samira.name
    value: "\u0633\u0645\u06CC\u0631\u0627 \u062D\u062F\u0627\u062F"
  - key: narrative.first_launch.speaker.samira.role
    value: "\u0632\u06CC\u0631\u0633\u0627\u062E\u062A \u0634\u0647\u0631\u06CC"
  - key: narrative.first_launch.speaker.samira.accessible_label
    value: "\u0645\u0647\u0646\u062F\u0633 \u0633\u0645\u06CC\u0631\u0627 \u062D\u062F\u0627\u062F\u060C
      \u0632\u06CC\u0631\u0633\u0627\u062E\u062A \u0634\u0647\u0631\u06CC"
  - key: narrative.first_launch.speaker.aria.name
    value: "\u0622\u0631\u06CC\u0627"
  - key: narrative.first_launch.speaker.aria.role
    value: "\u062F\u0633\u062A\u06CC\u0627\u0631 \u0627\u0631\u062A\u0628\u0627\u0637
      \u0634\u0647\u0631\u06CC"
  - key: narrative.first_launch.speaker.aria.accessible_label
    value: "\u0622\u0631\u06CC\u0627\u060C \u062F\u0633\u062A\u06CC\u0627\u0631 \u0627\u0631\u062A\u0628\u0627\u0637
      \u0634\u0647\u0631\u06CC"
  - key: narrative.first_launch.speaker.commander.name
    value: "\u0641\u0631\u0645\u0627\u0646\u062F\u0647"
  - key: narrative.first_launch.speaker.commander.role
    value: "\u0633\u062A\u0627\u062F \u0648\u0627\u06A9\u0646\u0634 \u0645\u0634\u062A\u0631\u06A9"
  - key: narrative.first_launch.speaker.commander.accessible_label
    value: "\u0641\u0631\u0645\u0627\u0646\u062F\u0647\u0654 \u0628\u0627\u0632\u06CC\u06A9\u0646"
  - key: narrative.first_launch.location.sahrin.name
    value: "\u0633\u064E\u0647\u0631\u06CC\u0646"
  - key: narrative.first_launch.location.old_market.context
    value: "\u0628\u0627\u0632\u0627\u0631 \u0642\u062F\u06CC\u0645 / \u0633\u0627\u0639\u062A
      \u06F1\u06F0:\u06F0\u06F0 \u0645\u062D\u0644\u06CC"
  - key: narrative.first_launch.identity.title
    value: "\u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A \u0641\u0631\u0645\u0627\u0646\u062F\u0647\u06CC
      \u0627\u0636\u0637\u0631\u0627\u0631\u06CC"
  - key: narrative.first_launch.identity.instruction
    value: "\u0647\u0648\u06CC\u062A \u0641\u0631\u0645\u0627\u0646\u062F\u0647 \u0631\u0627
      \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646\u06CC\u062F"
  - key: narrative.first_launch.identity.callsign
    value: "\u0639\u0646\u0648\u0627\u0646 \u0641\u0631\u0645\u0627\u0646\u062F\u0647"
  - key: narrative.first_launch.guidance.title
    value: "\u0645\u06CC\u0632\u0627\u0646 \u0631\u0627\u0647\u0646\u0645\u0627\u06CC\u06CC
      \u0622\u0631\u06CC\u0627 \u0631\u0627 \u0627\u0646\u062A\u062E\u0627\u0628
      \u06A9\u0646\u06CC\u062F"
  - key: narrative.first_launch.guidance.instruction
    value: "\u0628\u0639\u062F\u0627\u064B \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u06CC\u062F
      \u0627\u06CC\u0646 \u06AF\u0632\u06CC\u0646\u0647 \u0631\u0627 \u062F\u0631
      \u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u0641\u0631\u0645\u0627\u0646\u062F\u0647\u06CC
      \u062A\u063A\u06CC\u06CC\u0631 \u062F\u0647\u06CC\u062F."
  - key: narrative.first_launch.guidance.full
    value: "\u0631\u0627\u0647\u0646\u0645\u0627\u06CC\u06CC \u06A9\u0627\u0645\u0644"
  - key: narrative.first_launch.guidance.contextual
    value: "\u0631\u0627\u0647\u0646\u0645\u0627\u06CC\u06CC \u062A\u0627\u06A9\u062A\u06CC\u06A9\u06CC"
  - key: narrative.first_launch.guidance.minimal
    value: "\u0631\u0627\u0647\u0646\u0645\u0627\u06CC\u06CC \u06A9\u0645"
  - key: narrative.first_launch.skip.title
    value: "\u0628\u0647 \u0641\u0631\u0645\u0627\u0646\u062F\u0647\u06CC \u062A\u0627\u06A9\u062A\u06CC\u06A9\u06CC
      \u0628\u0631\u0648\u06CC\u0645\u061F"
  - key: narrative.first_launch.skip.body
    value: "\u0647\u0648\u06CC\u062A \u067E\u06CC\u0634\u200C\u0641\u0631\u0636 \u0641\u0631\u0645\u0627\u0646\u062F\u0647
      \u0648 \u0631\u0627\u0647\u0646\u0645\u0627\u06CC\u06CC \u06A9\u0627\u0645\u0644
      \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F.
      \u0628\u0639\u062F\u0627\u064B \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u06CC\u062F
      \u0647\u0631 \u062F\u0648 \u0631\u0627 \u062A\u063A\u06CC\u06CC\u0631 \u062F\u0647\u06CC\u062F."
  - key: narrative.first_launch.line.p02_radio
    value: "\u0686\u0646\u062F \u0627\u0646\u0641\u062C\u0627\u0631 \u062F\u0631
      \u0628\u0627\u0632\u0627\u0631 \u0642\u062F\u06CC\u0645 \u06AF\u0632\u0627\u0631\u0634
      \u0634\u062F\u0647. \u0628\u0631\u0642 \u062F\u0627\u0631\u062F \u0642\u0637\u0639
      \u0645\u06CC\u200C\u0634\u0648\u062F. \u0645\u0633\u06CC\u0631 \u0627\u0635\u0644\u06CC
      \u062F\u0631\u0645\u0627\u0646\u06AF\u0627\u0647 \u0628\u0633\u062A\u0647 \u0634\u062F\u0647."
  - key: narrative.first_launch.line.p03_radio
    value: "\u0641\u0631\u0645\u0627\u0646\u062F\u0647\u06CC \u0648\u0627\u06A9\u0646\u0634
      \u0645\u0634\u062A\u0631\u06A9\u060C \u0627\u06CC\u0646\u062C\u0627 \u0645\u0631\u06A9\u0632
      \u0627\u0639\u0632\u0627\u0645 \u0645\u0646\u0637\u0642\u0647 \u0627\u0633\u062A.
      \u0635\u062F\u0627\u06CC \u0645\u0627 \u0631\u0627 \u062F\u0627\u0631\u06CC\u062F\u061F
      \u0633\u0627\u0645\u0627\u0646\u0647\u0654 \u0627\u0631\u062A\u0628\u0627\u0637\u06CC
      \u0645\u0646\u0637\u0642\u0647 \u0627\u0632 \u06A9\u0627\u0631 \u0627\u0641\u062A\u0627\u062F\u0647
      \u0648 \u0627\u0631\u062A\u0628\u0627\u0637 \u0628\u0627 \u0641\u0631\u0645\u0627\u0646\u062F\u0647\u06CC
      \u0642\u0637\u0639 \u0634\u062F\u0647."
  - key: narrative.first_launch.line.p04_dalia
    value: "\u0645\u0631\u06A9\u0632 \u0627\u0639\u0632\u0627\u0645\u060C \u0633\u0631\u06AF\u0631\u062F
      \u062F\u0627\u0644\u06CC\u0627 \u0631\u062D\u06CC\u0645 \u0647\u0633\u062A\u0645
      \u0627\u0632 \u0641\u0631\u0645\u0627\u0646\u062F\u0647\u06CC \u0645\u06CC\u062F\u0627\u0646\u06CC
      \u0648\u0627\u06A9\u0646\u0634 \u0645\u0634\u062A\u0631\u06A9. \u0628\u0627\u0632\u0645\u0627\u0646\u062F\u0647\u200C\u0647\u0627\u06CC
      \u06A9\u0627\u0631\u0648\u0627\u0646 \u0631\u0627 \u067E\u06CC\u062F\u0627
      \u06A9\u0631\u062F\u06CC\u0645. \u0639\u0645\u0644\u06CC\u0627\u062A \u062A\u062E\u0644\u06CC\u0647
      \u062F\u0631 \u062C\u0631\u06CC\u0627\u0646 \u0627\u0633\u062A."
  - key: narrative.first_launch.line.p04_samira
    value: "\u0641\u0631\u0645\u0627\u0646\u062F\u0647\u06CC \u0645\u06CC\u062F\u0627\u0646\u06CC\u060C
      \u0645\u0647\u0646\u062F\u0633 \u0633\u0645\u06CC\u0631\u0627 \u062D\u062F\u0627\u062F
      \u0647\u0633\u062A\u0645 \u0627\u0632 \u0632\u06CC\u0631\u0633\u0627\u062E\u062A
      \u0634\u0647\u0631\u06CC. \u062E\u0627\u0646\u0648\u0627\u062F\u0647\u200C\u0647\u0627
      \u0648 \u0646\u06CC\u0631\u0648\u0647\u0627\u06CC \u0631\u0627\u0647\u062F\u0627\u0631\u06CC
      \u0622\u0646 \u0637\u0631\u0641 \u0645\u0633\u06CC\u0631 \u062F\u0631\u0645\u0627\u0646\u06AF\u0627\u0647
      \u06AF\u06CC\u0631 \u0627\u0641\u062A\u0627\u062F\u0647\u200C\u0627\u0646\u062F."
  - key: narrative.first_launch.line.p05_aria
    value: "\u0645\u0646 \u0622\u0631\u06CC\u0627 \u0647\u0633\u062A\u0645\u060C
      \u062F\u0633\u062A\u06CC\u0627\u0631 \u0627\u0631\u062A\u0628\u0627\u0637 \u0634\u0647\u0631\u06CC.
      \u0632\u06CC\u0631\u0633\u0627\u062E\u062A \u0627\u0631\u062A\u0628\u0627\u0637\u06CC
      \u0622\u0633\u06CC\u0628 \u062F\u06CC\u062F\u0647 \u0648 \u0627\u0631\u062A\u0628\u0627\u0637
      \u0628\u0627 \u0641\u0631\u0645\u0627\u0646\u062F\u0647\u06CC \u0647\u0646\u0648\u0632
      \u0628\u0631\u0642\u0631\u0627\u0631 \u0646\u0634\u062F\u0647 \u0627\u0633\u062A."
  - key: narrative.first_launch.line.p06_aria
    value: "\u067E\u0631\u0648\u062A\u06A9\u0644 \u062A\u062F\u0627\u0648\u0645 \u0639\u0645\u0644\u06CC\u0627\u062A
      \u0627\u0636\u0637\u0631\u0627\u0631\u06CC \u0641\u0639\u0627\u0644 \u0634\u062F.
      \u0641\u0642\u0637 \u06CC\u06A9 \u0645\u0631\u062C\u0639 \u0641\u0631\u0645\u0627\u0646\u062F\u0647\u06CC
      \u062A\u0623\u06CC\u06CC\u062F\u0634\u062F\u0647 \u0628\u0627\u0642\u06CC \u0645\u0627\u0646\u062F\u0647."
  - key: narrative.first_launch.line.p07_aria
    value: "\u0627\u0644\u0627\u0646 \u0628\u0627\u0632\u0627\u0631 \u0642\u062F\u06CC\u0645
      \u0627\u0648\u0644\u0648\u06CC\u062A \u0641\u0648\u0631\u06CC \u0645\u0627\u0633\u062A.
      \u0646\u06CC\u0631\u0648\u0647\u0627\u06CC \u0645\u0633\u0644\u062D \u062F\u0627\u0631\u0646\u062F
      \u0628\u0647 \u0645\u0633\u06CC\u0631 \u0645\u0633\u062F\u0648\u062F\u0634\u062F\u0647\u0654
      \u062F\u0631\u0645\u0627\u0646\u06AF\u0627\u0647 \u0646\u0632\u062F\u06CC\u06A9
      \u0645\u06CC\u200C\u0634\u0648\u0646\u062F."
  - key: narrative.first_launch.line.p09_aria
    value: "\u0647\u0648\u06CC\u062A \u0641\u0631\u0645\u0627\u0646\u062F\u0647 \u062A\u0623\u06CC\u06CC\u062F
      \u0634\u062F. \u0645\u0646 \u067E\u0634\u062A\u06CC\u0628\u0627\u0646\u06CC
      \u062A\u0627\u06A9\u062A\u06CC\u06A9\u06CC \u0631\u0627 \u0627\u0646\u062C\u0627\u0645
      \u0645\u06CC\u200C\u062F\u0647\u0645. \u0627\u062E\u062A\u06CC\u0627\u0631
      \u0641\u0631\u0645\u0627\u0646\u062F\u0647\u06CC \u0628\u0627 \u0634\u0645\u0627\u0633\u062A."
  - key: narrative.first_launch.line.p10_aria
    value: "\u0627\u06CC\u0646 \u062E\u0631\u0627\u0628\u06CC\u200C\u0647\u0627 \u0639\u0645\u062F\u06CC
      \u0628\u0648\u062F\u0647: \u0627\u0648\u0644 \u0628\u0631\u0642\u060C \u0628\u0639\u062F
      \u0631\u0627\u0647\u200C\u0647\u0627 \u0648 \u0628\u0639\u062F \u0641\u0631\u0645\u0627\u0646\u062F\u0647\u06CC."
  - key: narrative.first_launch.line.p11_dalia
    value: "\u062F\u0648 \u06AF\u0631\u0648\u0647 \u0648\u0627\u06A9\u0646\u0634
      \u0645\u0634\u062A\u0631\u06A9 \u0647\u0646\u0648\u0632 \u0641\u0639\u0627\u0644\u200C\u0627\u0646\u062F.
      \u0646\u0632\u062F\u06CC\u06A9\u200C\u062A\u0631\u06CC\u0646 \u067E\u0627\u06CC\u06AF\u0627\u0647
      \u062C\u0644\u0648 \u0627\u0632 \u062F\u0633\u062A\u0631\u0633 \u062E\u0627\u0631\u062C
      \u0634\u062F\u0647."
  - key: narrative.first_launch.line.p12_samira
    value: "\u0645\u0631\u062F\u0645\u060C \u06A9\u0627\u0631\u06A9\u0646\u0627\u0646
      \u062F\u0631\u0645\u0627\u0646\u06AF\u0627\u0647 \u0648 \u0646\u06CC\u0631\u0648\u0647\u0627\u06CC
      \u062E\u062F\u0645\u0627\u062A \u0634\u0647\u0631\u06CC \u0647\u0646\u0648\u0632
      \u0622\u0646 \u0637\u0631\u0641 \u0631\u0627\u0647\u200C\u0628\u0646\u062F\u0627\u0646
      \u06AF\u06CC\u0631 \u0627\u0641\u062A\u0627\u062F\u0647\u200C\u0627\u0646\u062F."
  - key: narrative.first_launch.line.p13_aria
    value: "\u0647\u0646\u0648\u0632 \u0645\u062F\u0631\u06A9 \u06A9\u0627\u0641\u06CC
      \u0646\u062F\u0627\u0631\u06CC\u0645 \u06A9\u0647 \u0628\u0641\u0647\u0645\u06CC\u0645
      \u0686\u0647 \u06A9\u0633\u06CC \u067E\u0634\u062A \u0627\u06CC\u0646 \u062D\u0645\u0644\u0647
      \u0627\u0633\u062A."
  - key: narrative.first_launch.line.p14_commander
    value: "\u062A\u06CC\u0645\u200C\u0647\u0627\u06CC \u0648\u0627\u06A9\u0646\u0634
      \u0631\u0627 \u0628\u0647 \u0647\u0645 \u0648\u0635\u0644 \u06A9\u0646\u06CC\u062F.
      \u0645\u0633\u06CC\u0631 \u062F\u0631\u0645\u0627\u0646\u06AF\u0627\u0647 \u0631\u0627
      \u0627\u0645\u0646 \u06A9\u0646\u06CC\u062F. \u0642\u0628\u0644 \u0627\u0632
      \u062F\u0631\u06AF\u06CC\u0631\u06CC\u060C \u0647\u062F\u0641\u200C\u0647\u0627
      \u0631\u0627 \u062A\u0623\u06CC\u06CC\u062F \u06A9\u0646\u06CC\u062F."
  - key: narrative.first_launch.line.p15_dalia
    value: "\u062F\u0631\u06CC\u0627\u0641\u062A \u0634\u062F. \u06CC\u06A9 \u06AF\u0634\u062A
      \u0645\u0633\u0644\u062D \u0627\u0632 \u062E\u0637 \u062E\u0627\u06A9\u0633\u062A\u0631
      \u062F\u0627\u0631\u062F \u0628\u0647 \u0628\u0627\u0632\u0627\u0631 \u0642\u062F\u06CC\u0645
      \u0646\u0632\u062F\u06CC\u06A9 \u0645\u06CC\u200C\u0634\u0648\u062F. \u0633\u0644\u0627\u062D
      \u0633\u0646\u06AF\u06CC\u0646 \u0646\u062F\u06CC\u062F\u06CC\u0645."
  - key: narrative.first_launch.line.p16_aria
    value: "\u0633\u0647 \u0645\u0647\u0627\u062C\u0645 \u0645\u0633\u0644\u062D
      \u062A\u0623\u06CC\u06CC\u062F \u0634\u062F\u0646\u062F. \u0645\u0631\u062F\u0645
      \u0647\u0646\u0648\u0632 \u067E\u0634\u062A \u0645\u0648\u0627\u0646\u0639
      \u0647\u0633\u062A\u0646\u062F. \u0641\u0642\u0637 \u062F\u0627\u062E\u0644
      \u0645\u0633\u06CC\u0631 \u0639\u0644\u0627\u0645\u062A\u200C\u06AF\u0630\u0627\u0631\u06CC\u200C\u0634\u062F\u0647
      \u062F\u0631\u06AF\u06CC\u0631 \u0634\u0648\u06CC\u062F."
  - key: narrative.first_launch.line.p17_dalia
    value: "\u0646\u06CC\u0631\u0648\u0647\u0627\u06CC \u0645\u06CC\u062F\u0627\u0646\u06CC
