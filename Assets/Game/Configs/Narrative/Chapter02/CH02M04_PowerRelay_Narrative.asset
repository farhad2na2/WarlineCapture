    lines:
    - lineId: power_relay-brief-01
      textKey: narrative.power_relay.brief.01
      englishFallback: The substation serving our homes, shelters and water treatment
        has failed. Displaced families are waiting in the open, and the nearest shelter
        is already overcrowded.
      speaker: 8
      voiceClip: {fileID: 8300000, guid: 250a0b9ba4b9043cfa54fbfe554e5b49, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
