    background-image: url("../../Art/UI/Generated/MainMenuV15C/LayeredOneGo/scn02_icon_campaign_crosshair.png");
}

.operations-title-icon {
    background-image: url("../../Art/UI/Generated/MainMenuV15C/LayeredOneGo/scn02_icon_operations_pin.png");
}

.skirmish-title-icon {
    background-image: url("../../Art/UI/Generated/MainMenuV15C/LayeredOneGo/scn02_icon_skirmish_blades.png");
}

.mode-title {
