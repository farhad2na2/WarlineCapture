      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: m05-debrief-01
      textKey: narrative.m05.debrief.01
      englishFallback: The relay is silent and the records are safe. We have evidence
        now, not another rumor. Take care of the wounded; the city needs everyone
        we can bring home.
      speaker: 2
      voiceClip: {fileID: 8300000, guid: 8243febc819c7472282eb3d84a411247, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 14.36
      essentialCaption: 1
    continueStateId: M05-debrief-2
    skipStateId: M05-debrief-complete
    reducedMotionSupported: 1
    durationSeconds: 14.61
    motionPreset: 0
    locationTitleKey: 
    locationTitleFallback: 
    locationSubtitleKey: 
    locationSubtitleFallback: 
    musicCue: 0
    ambienceCue: 0
    vehicleCue: 0
    eventCue: 3
