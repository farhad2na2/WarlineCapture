<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="UIShellAppCanvas.uss" />

    <ui:VisualElement name="UIShellAppCanvas" class="ui-shell-app-canvas">
        <ui:VisualElement name="SafeAreaRoot" class="safe-area-root">
            <ui:VisualElement name="HeaderBar" class="header-bar shell-region shell-hidden" />

            <ui:VisualElement name="ContentRoot" class="content-root shell-region">
                <ui:VisualElement name="MenuBackgroundRegion" class="menu-background-region shell-slot" />
                <ui:VisualElement name="LoadingLayer" class="loading-layer shell-slot" />
                <ui:VisualElement name="HeaderRegion" class="header-region shell-slot" />
                <ui:VisualElement name="LeftRegion" class="left-region shell-slot" />
                <ui:VisualElement name="MiddleRegion" class="middle-region shell-slot" />
                <ui:VisualElement name="RightRegion" class="right-region shell-slot" />
                <ui:VisualElement name="FooterRegion" class="footer-region shell-slot" />
            </ui:VisualElement>

            <ui:VisualElement name="FooterBar" class="footer-bar shell-region shell-hidden" />

            <ui:VisualElement name="ModalOverlay" class="modal-overlay shell-hidden">
                <ui:VisualElement name="PlaceholderPopup" class="placeholder-popup">
                    <ui:Label name="TitleText" class="placeholder-title" text="Mode" />
                    <ui:Label name="BodyText" class="placeholder-body" text="Coming soon." />
                    <ui:Button name="CloseButton" class="placeholder-close-button" text="">
                        <ui:Label name="LabelText" class="placeholder-close-label" text="CLOSE" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="TooltipLayer" class="tooltip-layer" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
