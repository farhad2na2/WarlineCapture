    },
    {
      "kind": "narrative",
      "id": "last_corridor-brief-03",
      "speaker": "LAILA",
      "locale": "en-US",
      "text": "Karim and I are tracking the air approaches, but we cannot certify an air delivery through this threat picture. Keep every required load on the marked ground routes. Preserve the original trucks and key APC; a replacement cannot carry their custody record.",
      "voiceId": "EXAVITQu4vr4xnSDxMaL",
      "voiceName": "Sarah (Captain Laila Nasser)",
      "assetPath": "Assets/Game/Audio/Narrative/CH05M04LastCorridor/Voice/en/last_corridor-brief-03.wav",
