+namespace Game.Skirmish.Contracts
+{
+    public enum SkirmishEnemyPlanKind : byte { None, Hold, DefendHome, Scout, Assemble, Assault, Reinforce, Recover }
+    public enum SkirmishEnemyDuty : byte { None, HomeReserve, Scout, MainAssault, Escort, Flank, Recover, Service }
+    public enum SkirmishEnemyProductionIntentState : byte { Idle, RequestPending, AcceptedWaiting, Delivered, Backoff, Lost, Abandoned }
+    public enum SkirmishEnemyRejectDomain : byte { None, Feasibility, NativeResult }
+}
