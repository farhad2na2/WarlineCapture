    left: 0;
    right: 0;
    top: 62%;
    bottom: 0;
    font-size: 14px;
    -unity-text-align: middle-center;
    color: rgba(220, 221, 199, 0.85);
}

.source-label {
    position: absolute;
    left: 9%;
    width: 39%;
