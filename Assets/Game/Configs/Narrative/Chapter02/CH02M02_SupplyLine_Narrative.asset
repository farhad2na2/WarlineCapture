      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: supply_line-brief-02
      textKey: narrative.supply_line.brief.02
      englishFallback: This reserve keeps clinic generators and water pumps running.
        Twenty barrels must stay available for those services. Military transport
        cannot take everything.
      speaker: 2
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 11.357142
      essentialCaption: 1
    continueStateId: SupplyLine-brief-2
    skipStateId: SupplyLine-brief-complete
    reducedMotionSupported: 1
    durationSeconds: 11.357142
