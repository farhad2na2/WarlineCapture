    lines:
    - lineId: m04-debrief-01
      textKey: narrative.m04.debrief.01
      englishFallback: Four passengers accounted for. Your escort gave us the time
        we needed. I am joining this operation; you will have an airlift pilot when
        the next team needs a way out.
      speaker: 5
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 11.857142
