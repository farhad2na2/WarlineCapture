      m_SubObjectName: CH04M05_ArmorBreak-c-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: armor_break-brief-03
      textKey: narrative.armor_break.brief-03
      englishFallback: The authority package is inside the command compound. Defeat
        the verified military targets, then recover the package. Optional support
        requires your confirmation for each action. I will mark targets without issuing
        orders.
      speaker: 3
      voiceClip: {fileID: 8300000, guid: 3df847662c6804c4cae3da2f00aebc94, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
