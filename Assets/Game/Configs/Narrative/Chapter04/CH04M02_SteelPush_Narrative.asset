  states:
  - stateId: SteelPush-brief-0
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: ef3183cbf9a84e5196963a22a5e4969d
      m_SubObjectName: CH04M02_SteelPush-a-16x9
