    {
      "kind": "narrative",
      "id": "false_front-debrief-02",
      "speaker": "ARIA",
      "locale": "en-US",
      "text": "I preserved the false report. It traveled through a compromised Relay-era authority channel with a seal compatible with mine. I need to examine whether my missing archive made it.",
