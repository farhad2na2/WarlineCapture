      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: citywide_alert-open-06
      textKey: narrative.citywide_alert.open-06
      englishFallback: You retain approval over every action I propose. The first
        two fronts are the clinic and the utility site. Their priorities remain yours
        to direct; I will show the situation and wait for your decision.
      speaker: 3
      voiceClip: {fileID: 8300000, guid: 34d16eb4787824ce693e2c4722030a28, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
