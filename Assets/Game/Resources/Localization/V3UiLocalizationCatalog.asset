        \u062F\u0627\u062F\u06CC\u060C \u062A\u0648\u0642\u0641 \u06A9\u0646\u060C
        \u0648\u0627\u062D\u062F \u062F\u0631\u0633\u062A \u0631\u0648 \u062F\u0648\u0628\u0627\u0631\u0647
        \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646 \u0648 \xAB\u062D\u0631\u06A9\u062A\xBB
        \u0631\u0648 \u0628\u0632\u0646."
    - key: mission.gridlock.tutorial.1.mistake
      value: "\u0641\u0627\u062F\u06CC \u0648 \u06A9\u0627\u0631\u06AF\u0631\u0647\u0627
        \u0645\u0633\u0644\u062D \u0646\u06CC\u0633\u062A\u0646. \u0642\u0628\u0644
        \u0627\u0632 \u062C\u0644\u0648 \u0628\u0631\u062F\u0646 \u0627\u0648\u0646\u200C\u0647\u0627\u060C
        \u0645\u0633\u06CC\u0631 \u0631\u0648 \u0628\u0627 \u062A\u0641\u0646\u06AF\u062F\u0627\u0631\u0647\u0627
        \u0627\u0645\u0646 \u06A9\u0646."
    - key: mission.gridlock.tutorial.1.title
      value: "\u0645\u062D\u0644 \u06A9\u0627\u0631 \u0627\u0648\u0644 \u0631\u0648
        \u0627\u0645\u0646 \u06A9\u0646"
    - key: mission.gridlock.tutorial.10.body
      value: "\u06A9\u0627\u0645\u06CC\u0648\u0646 \u0627\u0645\u062F\u0627\u062F
        \u0628\u0627\u06CC\u062F \u0628\u06CC\u0633\u062A \u062B\u0627\u0646\u06CC\u0647
        \u062A\u0648\u06CC \u0628\u06CC\u0645\u0627\u0631\u0633\u062A\u0627\u0646
        \u0648 \u062F\u0648\u0631 \u0627\u0632 \u062F\u0634\u0645\u0646 \u0628\u0645\u0648\u0646\u0647.
        \u0627\u06AF\u0647 \u062E\u0627\u0631\u062C \u0628\u0634\u0647 \u06CC\u0627
        \u062F\u0634\u0645\u0646 \u0646\u0632\u062F\u06CC\u06A9 \u0628\u06CC\u0627\u062F\u060C
        \u0634\u0645\u0627\u0631\u0634 \u0627\u0632 \u0646\u0648 \u0634\u0631\u0648\u0639
        \u0645\u06CC\u200C\u0634\u0647."
    - key: mission.gridlock.tutorial.10.diagram
      value: "\u0645\u062D\u0644 \u0627\u0648\u0644 \u2190 \u0645\u062D\u0644 \u062F\u0648\u0645
        \u2190 \u06A9\u0627\u0645\u06CC\u0648\u0646 \u0627\u0645\u062F\u0627\u062F
        \u2190 \u0628\u06CC\u0645\u0627\u0631\u0633\u062A\u0627\u0646"
    - key: mission.gridlock.tutorial.10.example
      value: "\u0627\u06AF\u0647 \u062F\u0633\u062A\u0648\u0631 \u0627\u0634\u062A\u0628\u0627\u0647
        \u062F\u0627\u062F\u06CC\u060C \u062A\u0648\u0642\u0641 \u06A9\u0646\u060C
        \u0648\u0627\u062D\u062F \u062F\u0631\u0633\u062A \u0631\u0648 \u062F\u0648\u0628\u0627\u0631\u0647
        \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646 \u0648 \xAB\u062D\u0631\u06A9\u062A\xBB
        \u0631\u0648 \u0628\u0632\u0646."
    - key: mission.gridlock.tutorial.10.mistake
      value: "\u0641\u0627\u062F\u06CC \u0648 \u06A9\u0627\u0631\u06AF\u0631\u0647\u0627
        \u0645\u0633\u0644\u062D \u0646\u06CC\u0633\u062A\u0646. \u0642\u0628\u0644
        \u0627\u0632 \u062C\u0644\u0648 \u0628\u0631\u062F\u0646 \u0627\u0648\u0646\u200C\u0647\u0627\u060C
        \u0645\u0633\u06CC\u0631 \u0631\u0648 \u0628\u0627 \u062A\u0641\u0646\u06AF\u062F\u0627\u0631\u0647\u0627
        \u0627\u0645\u0646 \u06A9\u0646."
    - key: mission.gridlock.tutorial.10.title
      value: "\u0628\u06CC\u0645\u0627\u0631\u0633\u062A\u0627\u0646 \u0631\u0648
        \u0627\u0645\u0646 \u0646\u06AF\u0647 \u062F\u0627\u0631"
    - key: mission.gridlock.tutorial.2.body
      value: "\u0641\u0627\u062F\u06CC \u0631\u0648 \u0627\u0646\u062A\u062E\u0627\u0628
        \u06A9\u0646\u060C \xAB\u062D\u0631\u06A9\u062A\xBB \u0631\u0648 \u0628\u0632\u0646
        \u0648 \u0645\u062D\u0644 \u06A9\u0627\u0631 \u0645\u0634\u062E\u0635\u200C\u0634\u062F\u0647
        \u0631\u0648 \u0628\u0632\u0646."
    - key: mission.gridlock.tutorial.2.diagram
      value: "\u0645\u062D\u0644 \u0627\u0648\u0644 \u2190 \u0645\u062D\u0644 \u062F\u0648\u0645
        \u2190 \u06A9\u0627\u0645\u06CC\u0648\u0646 \u0627\u0645\u062F\u0627\u062F
        \u2190 \u0628\u06CC\u0645\u0627\u0631\u0633\u062A\u0627\u0646"
    - key: mission.gridlock.tutorial.2.example
      value: "\u0627\u06AF\u0647 \u062F\u0633\u062A\u0648\u0631 \u0627\u0634\u062A\u0628\u0627\u0647
        \u062F\u0627\u062F\u06CC\u060C \u062A\u0648\u0642\u0641 \u06A9\u0646\u060C
        \u0648\u0627\u062D\u062F \u062F\u0631\u0633\u062A \u0631\u0648 \u062F\u0648\u0628\u0627\u0631\u0647
        \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646 \u0648 \xAB\u062D\u0631\u06A9\u062A\xBB
        \u0631\u0648 \u0628\u0632\u0646."
    - key: mission.gridlock.tutorial.2.mistake
      value: "\u0641\u0627\u062F\u06CC \u0648 \u06A9\u0627\u0631\u06AF\u0631\u0647\u0627
        \u0645\u0633\u0644\u062D \u0646\u06CC\u0633\u062A\u0646. \u0642\u0628\u0644
        \u0627\u0632 \u062C\u0644\u0648 \u0628\u0631\u062F\u0646 \u0627\u0648\u0646\u200C\u0647\u0627\u060C
        \u0645\u0633\u06CC\u0631 \u0631\u0648 \u0628\u0627 \u062A\u0641\u0646\u06AF\u062F\u0627\u0631\u0647\u0627
        \u0627\u0645\u0646 \u06A9\u0646."
    - key: mission.gridlock.tutorial.2.title
      value: "\u0641\u0627\u062F\u06CC \u0631\u0648 \u0628\u0647 \u0645\u062D\u0644
        \u0627\u0648\u0644 \u0628\u0628\u0631"
    - key: mission.gridlock.tutorial.3.body
      value: "\u06CC\u06A9 \u06A9\u0627\u0631\u06AF\u0631 \u0631\u0648 \u0627\u0646\u062A\u062E\u0627\u0628
        \u06A9\u0646 \u0648 \u0628\u0647 \u0647\u0645\u0648\u0646 \u0645\u062D\u0644
        \u06A9\u0627\u0631\u06CC \u0628\u0628\u0631 \u06A9\u0647 \u0641\u0627\u062F\u06CC
        \u0627\u0648\u0646\u062C\u0627\u0633\u062A."
    - key: mission.gridlock.tutorial.3.diagram
      value: "\u0645\u062D\u0644 \u0627\u0648\u0644 \u2190 \u0645\u062D\u0644 \u062F\u0648\u0645
        \u2190 \u06A9\u0627\u0645\u06CC\u0648\u0646 \u0627\u0645\u062F\u0627\u062F
        \u2190 \u0628\u06CC\u0645\u0627\u0631\u0633\u062A\u0627\u0646"
    - key: mission.gridlock.tutorial.3.example
      value: "\u0627\u06AF\u0647 \u062F\u0633\u062A\u0648\u0631 \u0627\u0634\u062A\u0628\u0627\u0647
        \u062F\u0627\u062F\u06CC\u060C \u062A\u0648\u0642\u0641 \u06A9\u0646\u060C
        \u0648\u0627\u062D\u062F \u062F\u0631\u0633\u062A \u0631\u0648 \u062F\u0648\u0628\u0627\u0631\u0647
        \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646 \u0648 \xAB\u062D\u0631\u06A9\u062A\xBB
        \u0631\u0648 \u0628\u0632\u0646."
    - key: mission.gridlock.tutorial.3.mistake
      value: "\u0641\u0627\u062F\u06CC \u0648 \u06A9\u0627\u0631\u06AF\u0631\u0647\u0627
        \u0645\u0633\u0644\u062D \u0646\u06CC\u0633\u062A\u0646. \u0642\u0628\u0644
        \u0627\u0632 \u062C\u0644\u0648 \u0628\u0631\u062F\u0646 \u0627\u0648\u0646\u200C\u0647\u0627\u060C
        \u0645\u0633\u06CC\u0631 \u0631\u0648 \u0628\u0627 \u062A\u0641\u0646\u06AF\u062F\u0627\u0631\u0647\u0627
        \u0627\u0645\u0646 \u06A9\u0646."
    - key: mission.gridlock.tutorial.3.title
      value: "\u06CC\u06A9 \u06A9\u0627\u0631\u06AF\u0631 \u0631\u0648 \u0628\u0631\u0633\u0648\u0646"
    - key: mission.gridlock.tutorial.4.body
      value: "\u0628\u0631\u0627\u06CC \u06A9\u0627\u0631\u060C \u0641\u0627\u062F\u06CC
        \u0648 \u06CC\u06A9 \u06A9\u0627\u0631\u06AF\u0631 \u0632\u0646\u062F\u0647
        \u0628\u0627\u06CC\u062F \u0627\u06CC\u0646\u062C\u0627 \u0628\u0627\u0634\u0646
        \u0648 \u062F\u0634\u0645\u0646 \u0646\u0632\u062F\u06CC\u06A9 \u0646\u0628\u0627\u0634\u0647.
        \u0627\u06AF\u0647 \u06A9\u0627\u0631 \u0645\u062A\u0648\u0642\u0641 \u0628\u0634\u0647\u060C
        \u0648\u0642\u062A\u06CC \u0627\u0645\u0646 \u0634\u062F \u0627\u0632 \u0647\u0645\u0648\u0646\u200C\u062C\u0627
        \u0627\u062F\u0627\u0645\u0647 \u067E\u06CC\u062F\u0627 \u0645\u06CC\u200C\u06A9\u0646\u0647."
    - key: mission.gridlock.tutorial.4.diagram
      value: "\u0645\u062D\u0644 \u0627\u0648\u0644 \u2190 \u0645\u062D\u0644 \u062F\u0648\u0645
        \u2190 \u06A9\u0627\u0645\u06CC\u0648\u0646 \u0627\u0645\u062F\u0627\u062F
        \u2190 \u0628\u06CC\u0645\u0627\u0631\u0633\u062A\u0627\u0646"
    - key: mission.gridlock.tutorial.4.example
      value: "\u0627\u06AF\u0647 \u062F\u0633\u062A\u0648\u0631 \u0627\u0634\u062A\u0628\u0627\u0647
        \u062F\u0627\u062F\u06CC\u060C \u062A\u0648\u0642\u0641 \u06A9\u0646\u060C
        \u0648\u0627\u062D\u062F \u062F\u0631\u0633\u062A \u0631\u0648 \u062F\u0648\u0628\u0627\u0631\u0647
        \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646 \u0648 \xAB\u062D\u0631\u06A9\u062A\xBB
        \u0631\u0648 \u0628\u0632\u0646."
    - key: mission.gridlock.tutorial.4.mistake
      value: "\u0641\u0627\u062F\u06CC \u0648 \u06A9\u0627\u0631\u06AF\u0631\u0647\u0627
        \u0645\u0633\u0644\u062D \u0646\u06CC\u0633\u062A\u0646. \u0642\u0628\u0644
        \u0627\u0632 \u062C\u0644\u0648 \u0628\u0631\u062F\u0646 \u0627\u0648\u0646\u200C\u0647\u0627\u060C
        \u0645\u0633\u06CC\u0631 \u0631\u0648 \u0628\u0627 \u062A\u0641\u0646\u06AF\u062F\u0627\u0631\u0647\u0627
        \u0627\u0645\u0646 \u06A9\u0646."
    - key: mission.gridlock.tutorial.4.title
      value: "\u0627\u0632 \u06A9\u0627\u0631\u06AF\u0631\u0647\u0627 \u0645\u062D\u0627\u0641\u0638\u062A
        \u06A9\u0646"
    - key: mission.gridlock.tutorial.5.body
      value: "\u0642\u0628\u0644 \u0627\u0632 \u062C\u0644\u0648 \u0628\u0631\u062F\u0646
        \u06A9\u0627\u0631\u06AF\u0631\u0647\u0627\u060C \u062A\u0641\u0646\u06AF\u062F\u0627\u0631\u0647\u0627
        \u0631\u0648 \u0628\u0647 \u0645\u062D\u0644 \u062F\u0648\u0645 \u0628\u0628\u0631.
        \u0627\u0632 \u0628\u062E\u0634 \u0628\u0627\u0632\u0634\u062F\u0647 \u0647\u0645
        \u0645\u062D\u0627\u0641\u0638\u062A \u06A9\u0646."
    - key: mission.gridlock.tutorial.5.diagram
      value: "\u0645\u062D\u0644 \u0627\u0648\u0644 \u2190 \u0645\u062D\u0644 \u062F\u0648\u0645
        \u2190 \u06A9\u0627\u0645\u06CC\u0648\u0646 \u0627\u0645\u062F\u0627\u062F
        \u2190 \u0628\u06CC\u0645\u0627\u0631\u0633\u062A\u0627\u0646"
    - key: mission.gridlock.tutorial.5.example
      value: "\u0627\u06AF\u0647 \u062F\u0633\u062A\u0648\u0631 \u0627\u0634\u062A\u0628\u0627\u0647
        \u062F\u0627\u062F\u06CC\u060C \u062A\u0648\u0642\u0641 \u06A9\u0646\u060C
        \u0648\u0627\u062D\u062F \u062F\u0631\u0633\u062A \u0631\u0648 \u062F\u0648\u0628\u0627\u0631\u0647
        \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646 \u0648 \xAB\u062D\u0631\u06A9\u062A\xBB
        \u0631\u0648 \u0628\u0632\u0646."
    - key: mission.gridlock.tutorial.5.mistake
      value: "\u0641\u0627\u062F\u06CC \u0648 \u06A9\u0627\u0631\u06AF\u0631\u0647\u0627
        \u0645\u0633\u0644\u062D \u0646\u06CC\u0633\u062A\u0646. \u0642\u0628\u0644
        \u0627\u0632 \u062C\u0644\u0648 \u0628\u0631\u062F\u0646 \u0627\u0648\u0646\u200C\u0647\u0627\u060C
        \u0645\u0633\u06CC\u0631 \u0631\u0648 \u0628\u0627 \u062A\u0641\u0646\u06AF\u062F\u0627\u0631\u0647\u0627
        \u0627\u0645\u0646 \u06A9\u0646."
    - key: mission.gridlock.tutorial.5.title
      value: "\u0645\u062D\u0644 \u06A9\u0627\u0631 \u062F\u0648\u0645 \u0631\u0648
        \u0627\u0645\u0646 \u06A9\u0646"
    - key: mission.gridlock.tutorial.6.body
      value: "\u0641\u0627\u062F\u06CC \u0631\u0648 \u0628\u0647 \u0645\u062D\u0644
        \u062F\u0648\u0645 \u0628\u0628\u0631. \u0628\u062E\u0634 \u0627\u0648\u0644
        \u0645\u0633\u06CC\u0631 \u0628\u0627\u0632 \u0645\u06CC\u200C\u0645\u0648\u0646\u0647."
    - key: mission.gridlock.tutorial.6.diagram
      value: "\u0645\u062D\u0644 \u0627\u0648\u0644 \u2190 \u0645\u062D\u0644 \u062F\u0648\u0645
        \u2190 \u06A9\u0627\u0645\u06CC\u0648\u0646 \u0627\u0645\u062F\u0627\u062F
        \u2190 \u0628\u06CC\u0645\u0627\u0631\u0633\u062A\u0627\u0646"
    - key: mission.gridlock.tutorial.6.example
      value: "\u0627\u06AF\u0647 \u062F\u0633\u062A\u0648\u0631 \u0627\u0634\u062A\u0628\u0627\u0647
        \u062F\u0627\u062F\u06CC\u060C \u062A\u0648\u0642\u0641 \u06A9\u0646\u060C
        \u0648\u0627\u062D\u062F \u062F\u0631\u0633\u062A \u0631\u0648 \u062F\u0648\u0628\u0627\u0631\u0647
        \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646 \u0648 \xAB\u062D\u0631\u06A9\u062A\xBB
        \u0631\u0648 \u0628\u0632\u0646."
    - key: mission.gridlock.tutorial.6.mistake
      value: "\u0641\u0627\u062F\u06CC \u0648 \u06A9\u0627\u0631\u06AF\u0631\u0647\u0627
        \u0645\u0633\u0644\u062D \u0646\u06CC\u0633\u062A\u0646. \u0642\u0628\u0644
        \u0627\u0632 \u062C\u0644\u0648 \u0628\u0631\u062F\u0646 \u0627\u0648\u0646\u200C\u0647\u0627\u060C
        \u0645\u0633\u06CC\u0631 \u0631\u0648 \u0628\u0627 \u062A\u0641\u0646\u06AF\u062F\u0627\u0631\u0647\u0627
        \u0627\u0645\u0646 \u06A9\u0646."
    - key: mission.gridlock.tutorial.6.title
      value: "\u0641\u0627\u062F\u06CC \u0631\u0648 \u062C\u0644\u0648 \u0628\u0628\u0631"
    - key: mission.gridlock.tutorial.7.body
      value: "\u06CC\u06A9 \u06A9\u0627\u0631\u06AF\u0631 \u0628\u0627\u0642\u06CC\u200C\u0645\u0648\u0646\u062F\u0647
        \u0631\u0648 \u067E\u06CC\u0634 \u0641\u0627\u062F\u06CC \u062A\u0648\u06CC
        \u0645\u062D\u0644 \u062F\u0648\u0645 \u0628\u0628\u0631. \u0627\u06AF\u0647
        \u0645\u0633\u06CC\u0631 \u0646\u0627\u0627\u0645\u0646 \u0634\u062F\u060C
        \u062A\u0648\u0642\u0641 \u06A9\u0646 \u06CC\u0627 \u0639\u0642\u0628 \u0628\u06A9\u0634."
    - key: mission.gridlock.tutorial.7.diagram
      value: "\u0645\u062D\u0644 \u0627\u0648\u0644 \u2190 \u0645\u062D\u0644 \u062F\u0648\u0645
        \u2190 \u06A9\u0627\u0645\u06CC\u0648\u0646 \u0627\u0645\u062F\u0627\u062F
        \u2190 \u0628\u06CC\u0645\u0627\u0631\u0633\u062A\u0627\u0646"
    - key: mission.gridlock.tutorial.7.example
      value: "\u0627\u06AF\u0647 \u062F\u0633\u062A\u0648\u0631 \u0627\u0634\u062A\u0628\u0627\u0647
        \u062F\u0627\u062F\u06CC\u060C \u062A\u0648\u0642\u0641 \u06A9\u0646\u060C
        \u0648\u0627\u062D\u062F \u062F\u0631\u0633\u062A \u0631\u0648 \u062F\u0648\u0628\u0627\u0631\u0647
        \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646 \u0648 \xAB\u062D\u0631\u06A9\u062A\xBB
        \u0631\u0648 \u0628\u0632\u0646."
    - key: mission.gridlock.tutorial.7.mistake
