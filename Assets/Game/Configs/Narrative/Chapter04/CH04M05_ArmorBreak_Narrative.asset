  m_EditorClassIdentifier: Game.Configs::Game.Configs.NarrativeSequenceConfig
  sequenceId: seq.ch04.close.protocol_fragment_04
  entryStateId: ArmorBreak-close-0
  defaultSkipDestinationId: ArmorBreak-close-complete
  states:
  - stateId: ArmorBreak-close-0
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
