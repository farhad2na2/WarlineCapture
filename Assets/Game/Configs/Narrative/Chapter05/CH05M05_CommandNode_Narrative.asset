      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: command_node-brief-01
      textKey: narrative.command_node.brief-01
      englishFallback: The Civic Relay joins power, communications, clinics and transport.
        Isolate its outer military controls before entering the core. The city must
        survive the assault.
      speaker: 1
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 11.714286
      essentialCaption: 1
    continueStateId: CommandNode-brief-1
    skipStateId: CommandNode-brief-complete
    reducedMotionSupported: 1
    durationSeconds: 11.714286
    motionPreset: 0
    locationTitleKey: 
