      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: citywide_alert-open-01
      textKey: narrative.citywide_alert.open-01
      englishFallback: 'Five districts carry the record of our decisions: trust earned
        or lost, evidence preserved, and infrastructure still functioning. I will
        carry those consequences forward without treating an unverified report as
        fact.'
      speaker: 3
      voiceClip: {fileID: 8300000, guid: c5e21ab211cfd4e37abe58cbf5174609, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 17.86
      essentialCaption: 1
    continueStateId: CitywideAlert-open-1
    skipStateId: CitywideAlert-open-complete
    reducedMotionSupported: 1
    durationSeconds: 17.86
    motionPreset: 0
    locationTitleKey: 
    locationTitleFallback: 
    locationSubtitleKey: 
    locationSubtitleFallback: 
    musicCue: 0
