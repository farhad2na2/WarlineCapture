.pop07-inbox-popup {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    -unity-font-definition: url("../../../Synty/InterfaceMilitaryCombatHUD/Fonts/Oxanium/Oxanium-Medium.ttf");
    color: rgb(239, 232, 202);
    background-color: rgba(0, 0, 0, 0);
}

.pop07-inbox-popup Button {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
}

.inbox-backdrop-scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.64);
}

.inbox-popup-frame {
    position: absolute;
    left: 27%;
    right: 27%;
    top: 15%;
    bottom: 13%;
    transform-origin: 50% 50%;
}

.inbox-popup-chrome {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_panel_frame_large.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 96;
    -unity-slice-right: 96;
    -unity-slice-top: 64;
    -unity-slice-bottom: 64;
}

.inbox-header-panel {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 6.5%;
    height: 17%;
}

.inbox-header-icon {
    position: absolute;
    left: 0;
    top: 9%;
    width: 11%;
    height: 78%;
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_mail_icon.png");
    -unity-background-scale-mode: scale-to-fit;
}

.inbox-title {
    position: absolute;
    left: 14%;
    right: 28%;
    top: 0;
    height: 55%;
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(247, 217, 99);
    white-space: nowrap;
}

.inbox-subtitle {
    position: absolute;
    left: 14.4%;
    right: 28%;
    bottom: 0;
    height: 36%;
    font-size: 18px;
    -unity-text-align: middle-left;
    color: rgb(229, 221, 190);
    white-space: nowrap;
}

.inbox-close-action {
    position: absolute;
    right: 0;
    top: 10%;
    width: 24%;
    height: 70%;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_rect_button_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 56;
    -unity-slice-right: 56;
    -unity-slice-top: 34;
    -unity-slice-bottom: 34;
}

.inbox-close-label {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 0;
    bottom: 0;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(239, 232, 202);
}

.inbox-message-list {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 29%;
    bottom: 18%;
}

.inbox-message-row {
    position: relative;
    height: 29%;
    margin-bottom: 3%;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_bottom_tab_default_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 28;
    -unity-slice-bottom: 28;
}

.inbox-message-row.unread {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_rect_button_selected_frame.png");
}

.message-priority {
    position: absolute;
    left: 4%;
    top: 30%;
    width: 3.4%;
    height: 40%;
    background-color: rgb(169, 205, 55);
}

.message-priority.high {
    background-color: rgb(247, 217, 99);
}

.message-priority.medium {
    background-color: rgb(169, 205, 55);
}

.message-priority.low {
    background-color: rgb(110, 122, 99);
}

.message-title {
    position: absolute;
    left: 10%;
    right: 24%;
    top: 14%;
    height: 32%;
    font-size: 21px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(239, 232, 202);
    white-space: nowrap;
}

.message-body {
    position: absolute;
    left: 10%;
    right: 24%;
    bottom: 13%;
    height: 31%;
    font-size: 15px;
    -unity-text-align: middle-left;
    color: rgb(181, 174, 148);
    white-space: nowrap;
}

.message-time {
    position: absolute;
    right: 5%;
    top: 0;
    bottom: 0;
    width: 16%;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: rgb(247, 217, 99);
    white-space: nowrap;
}

.inbox-footer-panel {
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: 7%;
    height: 8%;
    background-color: rgba(6, 11, 11, 0.62);
}

.inbox-footer-text {
    position: absolute;
    left: 4%;
    right: 4%;
    top: 0;
    bottom: 0;
    font-size: 14px;
    -unity-text-align: middle-left;
    color: rgb(177, 169, 145);
    white-space: nowrap;
}
