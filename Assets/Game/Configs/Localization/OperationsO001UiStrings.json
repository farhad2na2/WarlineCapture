    {
      "key": "operations.o001.extraction_progress",
      "source": "Safe extraction: {0}/2 infantry",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "خروج امن: {0}/2 نیروی پیاده"
        }
      ]
    },
    {
      "key": "operations.o001.extraction_hold",
      "source": "Bring at least two infantry into extraction and clear nearby enemies.",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "حداقل دو نیروی پیاده را به محل خروج برسانید و دشمنان نزدیک را از بین ببرید."
        }
