  - stateId: TrustUnderFire-brief-1
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: 9bab85e848b144e0b87e13d0942f48f4
      m_SubObjectName: CH05M02_TrustUnderFire-b-16x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    panel20x9Reference:
      m_AssetGUID: 9bab85e848b144e0b87e13d0942f48f4
      m_SubObjectName: CH05M02_TrustUnderFire-b-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: trust_under_fire-brief-02
      textKey: narrative.trust_under_fire.brief-02
      englishFallback: Qassem's broadcast says we abandoned these neighborhoods.
        Evacuation is a military priority. Clear the attackers on each protected
        route, keep the transports intact, and escort the groups to both shelters.
        Do not take a destructive shortcut through occupied buildings.
      speaker: 1
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 19.142857
      essentialCaption: 1
    continueStateId: TrustUnderFire-brief-2
    skipStateId: TrustUnderFire-brief-complete
    reducedMotionSupported: 1
    durationSeconds: 19.142857
    motionPreset: 0
    locationTitleKey: 
    locationTitleFallback: 
    locationSubtitleKey: 
    locationSubtitleFallback: 
    musicCue: 0
    ambienceCue: 0
    vehicleCue: 0
    eventCue: 3
