    lines:
    - lineId: m05-debrief-03
      textKey: narrative.m05.debrief.03
      englishFallback: First Response is complete. The reconnaissance team and armor
        parts are assigned to your roster. Review your results, then return to the
        campaign map. We will follow the evidence.
      speaker: 1
      voiceClip: {fileID: 8300000, guid: 5da2bde47396640e3aad21bac179cffa, type: 3}
