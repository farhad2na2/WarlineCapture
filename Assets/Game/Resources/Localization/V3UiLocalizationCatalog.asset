    - key: mission.m03.result.undamaged
      value: "\u0628\u06CC\u200C\u0622\u0633\u06CC\u0628"
    - key: mission.m03.result.victory
      value: "\u067E\u06CC\u0631\u0648\u0632\u06CC"
    - key: mission.m03.result.victory_body
      value: "\u0647\u0631 \u062F\u0648 \u0628\u062E\u0634 \u06A9\u0627\u0631\u0648\u0627\u0646
        \u0645\u062A\u0648\u0642\u0641 \u0634\u062F\u0646. \u067E\u0627\u0633\u06AF\u0627\u0647
        \u0633\u0631 \u062C\u0627\u0634\u0647 \u0648 \u0645\u062D\u062F\u0648\u062F\u0647\u0654
        \u0645\u0631\u06A9\u0632\u06CC \u0627\u0645\u0646\u0647. \u0633\u062A\u0627\u0631\u0647\u200C\u0647\u0627\u06CC
        \u062D\u0641\u0627\u0638\u062A \u0627\u0632 \u0645\u0631\u062F\u0645 \u0648
        \u0633\u0644\u0627\u0645\u062A \u067E\u0627\u0633\u06AF\u0627\u0647 \u0631\u0648
        \u0628\u0628\u06CC\u0646."
    - key: mission.m03.reward.guard_tower
      value: "\u062F\u0633\u062A\u0631\u0633\u06CC \u0628\u0647 \u0628\u0631\u062C
        \u0646\u06AF\u0647\u0628\u0627\u0646\u06CC"
    - key: mission.m03.reward.radar_ping
      value: "\u062F\u0633\u062A\u0631\u0633\u06CC \u0628\u0647 \u0627\u0633\u06A9\u0646
        \u0628\u0627 \u0631\u0627\u062F\u0627\u0631"
    - key: mission.m03.reward.unlocks
      value: "\u0628\u0631\u062C \u0646\u06AF\u0647\u0628\u0627\u0646\u06CC + \u0627\u0633\u06A9\u0646
        \u0628\u0627 \u0631\u0627\u062F\u0627\u0631"
    - key: mission.m03.save.body
      value: "\u062F\u0641\u0627\u0639 \u062A\u0645\u0648\u0645 \u0634\u062F\u060C
        \u0648\u0644\u06CC \u067E\u06CC\u0634\u0631\u0641\u062A \u0648 \u067E\u0627\u062F\u0627\u0634\u200C\u0647\u0627
        \u0630\u062E\u06CC\u0631\u0647 \u0646\u0634\u062F\u0646. \u0642\u0628\u0644
        \u0627\u0632 \u062E\u0631\u0648\u062C\u060C \u062F\u0648\u0628\u0627\u0631\u0647
        \u0630\u062E\u06CC\u0631\u0647\u200C\u0633\u0627\u0632\u06CC \u0631\u0648
        \u0627\u0645\u062A\u062D\u0627\u0646 \u06A9\u0646."
    - key: mission.m03.save.failed
      value: "\u067E\u06CC\u0634\u0631\u0641\u062A \u0630\u062E\u06CC\u0631\u0647
        \u0646\u0634\u062F"
    - key: mission.m03.save.pending
      value: "\u067E\u0627\u062F\u0627\u0634\u200C\u0647\u0627 \u062F\u0631 \u0627\u0646\u062A\u0638\u0627\u0631
        \u0630\u062E\u06CC\u0631\u0647\u200C\u0633\u0627\u0632\u06CC"
    - key: mission.m03.save.retry
      value: "\u0630\u062E\u06CC\u0631\u0647\u0654 \u062F\u0648\u0628\u0627\u0631\u0647"
    - key: mission.m03.scan.contact_result
      value: "\u0627\u0633\u06A9\u0646: {0} \u062E\u0648\u062F\u0631\u0648 \u067E\u06CC\u062F\u0627
        \u0634\u062F\u061B \u062F\u0641\u0627\u0639 \u0631\u0648 \u0627\u062F\u0627\u0645\u0647
        \u0628\u062F\u0647."
    - key: mission.m03.scan.empty_result
      value: "\u0627\u0633\u06A9\u0646: \u062E\u0648\u062F\u0631\u0648\u06CC\u06CC
        \u0646\u06CC\u0633\u062A\u061B \u062F\u0641\u0627\u0639 \u0631\u0648 \u0627\u062F\u0627\u0645\u0647
        \u0628\u062F\u0647."
    - key: mission.m03.star.civilians_safe
      value: "\u0647\u0631 \u0686\u0647\u0627\u0631 \u063A\u06CC\u0631\u0646\u0638\u0627\u0645\u06CC
        \u0632\u0646\u062F\u0647 \u0645\u0627\u0646\u062F\u0646\u062F"
    - key: mission.m03.star.complete
      value: "\u06A9\u0627\u0631\u0648\u0627\u0646 \u0631\u0648 \u0645\u062A\u0648\u0642\u0641
        \u0648 \u067E\u0627\u0633\u06AF\u0627\u0647 \u0631\u0648 \u062D\u0641\u0638
        \u06A9\u0646"
    - key: mission.m03.star.post_undamaged
      value: "\u067E\u0627\u0633\u06AF\u0627\u0647 \u0622\u0633\u06CC\u0628 \u0646\u062F\u06CC\u062F"
    - key: mission.m03.summary
      value: "\u0627\u0632 \u067E\u0627\u0633\u06AF\u0627\u0647 \u062F\u0631 \u0628\u0631\u0627\u0628\u0631
        \u062F\u0648 \u0628\u062E\u0634 \u06A9\u0627\u0631\u0648\u0627\u0646 \u062F\u0641\u0627\u0639
        \u06A9\u0646. \u0646\u06CC\u0631\u0648\u0647\u0627\u062A \u0631\u0648 \u0645\u0633\u062A\u0642\u0631
        \u06A9\u0646\u060C \u0647\u0634\u062F\u0627\u0631\u0647\u0627 \u0631\u0648
        \u0628\u062E\u0648\u0646 \u0648 \u062E\u0648\u062F\u062A \u062A\u0635\u0645\u06CC\u0645
        \u0628\u06AF\u06CC\u0631 \u0686\u0637\u0648\u0631 \u062F\u0641\u0627\u0639\u062A
        \u0631\u0648 \u062A\u0642\u0648\u06CC\u062A \u06A9\u0646\u06CC."
    - key: mission.m03.tactics.build
      value: "\u0628\u0631\u062C \u0627\u0632 \u06CC\u0647 \u062C\u0627\u06CC \u062B\u0627\u0628\u062A
        \u0634\u0644\u06CC\u06A9 \u0645\u06CC\u200C\u06A9\u0646\u0647\u061B \u0645\u0627\u0646\u0639\u060C
        \u062C\u0627\u062F\u0647 \u0631\u0648 \u0645\u06CC\u200C\u0628\u0646\u062F\u0647.
        \u0645\u0635\u0627\u0644\u062D \u0631\u0648 \u0628\u0631\u0627\u06CC \u067E\u0648\u0634\u0634
        \u0645\u0633\u06CC\u0631 \u062E\u0631\u062C \u06A9\u0646 \u06CC\u0627 \u0628\u0631\u0627\u06CC
        \u0646\u06CC\u0631\u0648\u06CC \u06A9\u0645\u06A9\u06CC \u0646\u06AF\u0647
        \u062F\u0627\u0631."
    - key: mission.m03.tactics.radar
      value: "\u0631\u0627\u062F\u0627\u0631 \u0645\u0633\u06CC\u0631 \u0631\u0648
        \u0632\u0648\u062F\u062A\u0631 \u062A\u0623\u06CC\u06CC\u062F \u06A9\u0631\u062F.
        \u0627\u0633\u06A9\u0646 \u0628\u0627\u0642\u06CC\u200C\u0645\u0627\u0646\u062F\u0647
        \u0631\u0648 \u0628\u0631\u0627\u06CC \u0645\u0648\u062C \u0628\u0639\u062F
        \u0646\u06AF\u0647 \u062F\u0627\u0631."
    - key: mission.m03.tactics.visual
      value: "\u0627\u06AF\u0647 \u062F\u0634\u0645\u0646 \u0646\u0632\u062F\u06CC\u06A9
        \u0628\u0627\u0634\u0647\u060C \u0628\u0627 \u062F\u06CC\u062F \u0645\u0633\u062A\u0642\u06CC\u0645
        \u0647\u0645 \u0645\u06CC\u200C\u062A\u0648\u0646\u06CC \u0634\u0646\u0627\u0633\u0627\u06CC\u06CC\u0634
        \u06A9\u0646\u06CC. \u0631\u0627\u062F\u0627\u0631 \u06CC\u0647 \u0646\u0648\u0628\u062A
        \u0627\u0633\u06A9\u0646 \u0645\u0635\u0631\u0641 \u0645\u06CC\u200C\u06A9\u0646\u0647
        \u062A\u0627 \u0632\u0648\u062F\u062A\u0631 \u062E\u0628\u0631\u062A \u06A9\u0646\u0647."
    - key: mission.m03.tutorial.1.body
      value: "\u0628\u0628\u06CC\u0646 \u06AF\u0632\u0627\u0631\u0634 \u0627\u0632
        \u06A9\u062C\u0627 \u0627\u0648\u0645\u062F\u0647\u060C \u06A9\u0627\u0631\u0648\u0627\u0646
        \u062A\u0648\u06CC \u06A9\u062F\u0648\u0645 \u0645\u0633\u06CC\u0631\u0647
        \u0648 \u062D\u062F\u0648\u062F\u0627\u064B \u06A9\u06CC \u0645\u06CC\u200C\u0631\u0633\u0647.
        \u062F\u06CC\u062F\u0647\u200C\u0628\u0627\u0646 \u0647\u0646\u0648\u0632
        \u062A\u0639\u062F\u0627\u062F \u062E\u0648\u062F\u0631\u0648\u0647\u0627
        \u0631\u0648 \u062A\u0623\u06CC\u06CC\u062F \u0646\u06A9\u0631\u062F\u0647."
    - key: mission.m03.tutorial.1.title
      value: "\u0647\u0634\u062F\u0627\u0631 \u0631\u0648 \u0628\u062E\u0648\u0646"
    - key: mission.m03.tutorial.10.body
      value: "\u062E\u0648\u062F\u0631\u0648\u0647\u0627\u06CC \u0645\u0633\u0644\u062D
        \u0628\u0647 \u0646\u06CC\u0631\u0648\u0647\u0627\u062A \u0622\u0633\u06CC\u0628
        \u0645\u06CC\u200C\u0632\u0646\u0646. \u0646\u0641\u0631\u0628\u0631 \u0628\u06CC\u200C\u0633\u0644\u0627\u062D
        \u0647\u0645 \u0645\u06CC\u200C\u062A\u0648\u0646\u0647 \u0648\u0627\u0631\u062F
        \u0645\u062D\u062F\u0648\u062F\u0647\u0654 \u0645\u0631\u06A9\u0632\u06CC
        \u0628\u0634\u0647. \u0647\u062F\u0641\u06CC \u0631\u0648 \u0627\u0646\u062A\u062E\u0627\u0628
        \u06A9\u0646 \u06A9\u0647 \u062D\u0636\u0648\u0631\u0634 \u062A\u0623\u06CC\u06CC\u062F
        \u0634\u062F\u0647."
    - key: mission.m03.tutorial.10.title
      value: "\u062A\u0647\u062F\u06CC\u062F\u0647\u0627\u06CC \u062A\u0623\u06CC\u06CC\u062F\u0634\u062F\u0647
        \u0631\u0648 \u0627\u0648\u0644\u0648\u06CC\u062A \u0628\u062F\u0647"
    - key: mission.m03.tutorial.11.body
      value: "\u0647\u0634\u062F\u0627\u0631 \u062F\u0648\u0645 \u0631\u0648 \u0628\u062E\u0648\u0646
        \u0648 \u0648\u0636\u0639\u06CC\u062A \u0646\u06CC\u0631\u0648\u0647\u0627\u062A
        \u0631\u0648 \u0628\u0628\u06CC\u0646. \u0627\u06AF\u0647 \u0644\u0627\u0632\u0645\u0647
        \u062C\u0627\u0628\u0647\u200C\u062C\u0627\u0634\u0648\u0646 \u06A9\u0646\u061B
        \u0631\u0627\u0647 \u067E\u0627\u0633\u06AF\u0627\u0647 \u0628\u0627\u06CC\u062F
        \u0632\u06CC\u0631 \u067E\u0648\u0634\u0634\u062A \u0628\u0645\u0648\u0646\u0647."
    - key: mission.m03.tutorial.11.title
      value: "\u0628\u0631\u0627\u06CC \u06A9\u0627\u0631\u0648\u0627\u0646 \u0627\u0635\u0644\u06CC
        \u0622\u0645\u0627\u062F\u0647 \u0634\u0648"
    - key: mission.m03.tutorial.12.body
      value: "\u0647\u0645\u0647\u0654 \u062E\u0648\u062F\u0631\u0648\u0647\u0627\u06CC
        \u062F\u0634\u0645\u0646 \u0631\u0648 \u0645\u062A\u0648\u0642\u0641 \u06A9\u0646.
        \u062A\u0641\u0646\u06AF\u062F\u0627\u0631\u0647\u0627 \u0631\u0648 \u0631\u0648\u06CC
        \xAB\u062D\u0641\u0638\xBB \u0646\u06AF\u0647 \u062F\u0627\u0631. \u0627\u06AF\u0647
        \u0645\u0631\u062F\u0645 \u0648 \u067E\u0627\u0633\u06AF\u0627\u0647 \u0633\u0627\u0644\u0645
        \u0628\u0645\u0648\u0646\u0646\u060C \u0633\u062A\u0627\u0631\u0647\u0654
        \u0627\u0636\u0627\u0641\u0647 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u06CC."
    - key: mission.m03.tutorial.12.title
      value: "\u0627\u0632 \u067E\u0627\u0633\u06AF\u0627\u0647 \u062F\u0641\u0627\u0639
        \u06A9\u0646"
    - key: mission.m03.tutorial.2.body
      value: "\u062C\u0627\u062F\u0647\u200C\u0627\u06CC \u0631\u0648 \u06A9\u0647
        \u062A\u0648\u06CC \u06AF\u0632\u0627\u0631\u0634 \u0627\u0648\u0645\u062F\u0647
        \u0628\u0628\u06CC\u0646. \u0641\u0642\u0637 \u062F\u0648\u0631\u0628\u06CC\u0646
        \u062C\u0627\u0628\u0647\u200C\u062C\u0627 \u0645\u06CC\u200C\u0634\u0647\u061B
        \u062F\u0633\u062A\u0648\u0631 \u0646\u06CC\u0631\u0648\u0647\u0627\u062A
        \u0639\u0648\u0636 \u0646\u0645\u06CC\u200C\u0634\u0647."
    - key: mission.m03.tutorial.2.title
      value: "\u0645\u0633\u06CC\u0631 \u0631\u0648 \u0628\u0631\u0631\u0633\u06CC
        \u06A9\u0646"
    - key: mission.m03.tutorial.3.body
      value: "\u0627\u06AF\u0647 \u062C\u0644\u0648\u062A\u0631 \u062F\u0641\u0627\u0639
        \u06A9\u0646\u06CC\u060C \u0648\u0642\u062A \u0628\u06CC\u0634\u062A\u0631\u06CC
        \u0628\u0631\u0627\u06CC \u0645\u062A\u0648\u0642\u0641\u200C\u06A9\u0631\u062F\u0646
        \u06A9\u0627\u0631\u0648\u0627\u0646 \u062F\u0627\u0631\u06CC. \u0646\u0632\u062F\u06CC\u06A9
        \u067E\u0627\u0633\u06AF\u0627\u0647 \u0647\u0645 \u0645\u06CC\u200C\u062A\u0648\u0646\u06CC
        \u062F\u0641\u0627\u0639 \u06A9\u0646\u06CC\u061B \u0641\u0642\u0637 \u0645\u0633\u06CC\u0631
        \u0645\u0631\u06A9\u0632\u06CC \u0631\u0648 \u067E\u0648\u0634\u0634 \u0628\u062F\u0647."
    - key: mission.m03.tutorial.3.title
      value: "\u0634\u06CC\u0648\u0647\u0654 \u062F\u0641\u0627\u0639 \u0631\u0648
        \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646"
    - key: mission.m03.tutorial.4.body
      value: "\u0641\u0642\u0637 \u06CC\u0647 \u0645\u0627\u0646\u0639 \u062C\u0627\u062F\u0647
        \u06CC\u0627 \u0628\u0631\u062C \u0646\u06AF\u0647\u0628\u0627\u0646\u06CC
        \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646. \u0645\u0627\u0646\u0639
        \u0631\u0648 \u0639\u0631\u0636 \u062C\u0627\u062F\u0647 \u0628\u0630\u0627\u0631
        \u0648 \u0628\u0631\u062C \u0631\u0648 \u0628\u06CC\u0631\u0648\u0646 \u062C\u0627\u062F\u0647.
        \u0627\u06AF\u0647 \u0644\u0627\u0632\u0645 \u0634\u062F \u0628\u0686\u0631\u062E\u0648\u0646\u0634\u061B
        \u0648\u0642\u062A\u06CC \u0645\u062D\u0644 \u0633\u0628\u0632 \u0634\u062F\u060C
        \u062A\u0623\u06CC\u06CC\u062F \u06A9\u0646. \u0628\u0627 \u06CC\u0647 \u0633\u0627\u062E\u062A\u060C
        \u0627\u06CC\u0646 \u062F\u0631\u0633 \u0627\u062E\u062A\u06CC\u0627\u0631\u06CC
        \u062A\u0645\u0648\u0645 \u0645\u06CC\u200C\u0634\u0647."
    - key: mission.m03.tutorial.4.title
      value: "\u0627\u062E\u062A\u06CC\u0627\u0631\u06CC: \u062A\u0642\u0648\u06CC\u062A
        \u062F\u0641\u0627\u0639"
    - key: mission.m03.tutorial.5.body
      value: "\u0627\u0648\u0644 \xAB\u0627\u0646\u062A\u062E\u0627\u0628 \u0645\u062F\u0627\u0641\u0639\u0627\u0646\xBB
        \u0631\u0648 \u0628\u0632\u0646 \u062A\u0627 \u0646\u06CC\u0631\u0648\u0647\u0627\u062A
        \u0627\u0646\u062A\u062E\u0627\u0628 \u0628\u0634\u0646. \u0628\u0639\u062F
        \xAB\u062D\u0631\u06A9\u062A\xBB \u0631\u0648 \u0628\u0632\u0646 \u0648 \u06A9\u0646\u0627\u0631
        \u062C\u0627\u062F\u0647\u060C \u062A\u0648\u06CC \u0645\u062D\u062F\u0648\u062F\u0647\u0654
        \u0632\u0631\u062F\u060C \u06CC\u0647 \u062C\u0627 \u0628\u0631\u0627\u0634\u0648\u0646
        \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646. \u0635\u0628\u0631 \u06A9\u0646
        \u062A\u0627 \u0628\u0631\u0633\u0646."
    - key: mission.m03.tutorial.5.title
      value: "\u06AF\u0631\u0648\u0647\u200C\u0647\u0627 \u0631\u0648 \u0645\u0633\u062A\u0642\u0631
        \u06A9\u0646"
    - key: mission.m03.tutorial.6.body
      value: "\u0648\u0642\u062A\u06CC \u0631\u0633\u06CC\u062F\u0646\u060C \xAB\u062D\u0641\u0638\xBB
        \u0631\u0648 \u0628\u0632\u0646. \u0627\u06CC\u0646\u200C\u0637\u0648\u0631\u06CC
        \u0633\u0631 \u062C\u0627\u0634\u0648\u0646 \u0645\u06CC\u200C\u0645\u0648\u0646\u0646.
        \u0648\u0642\u062A\u06CC \u062F\u0634\u0645\u0646 \u0646\u0632\u062F\u06CC\u06A9
        \u0628\u0634\u0647\u060C \u062E\u0648\u062F\u0634\u0648\u0646 \u0634\u0644\u06CC\u06A9
        \u0645\u06CC\u200C\u06A9\u0646\u0646 \u0648 \u062F\u0646\u0628\u0627\u0644\u0634
        \u0646\u0645\u06CC\u200C\u0631\u0646."
    - key: mission.m03.tutorial.6.title
      value: "\u0645\u0648\u0636\u0639 \u0631\u0648 \u062D\u0641\u0638 \u06A9\u0646"
    - key: mission.m03.tutorial.7.body
      value: "\u062A\u0641\u0646\u06AF\u062F\u0627\u0631\u0647\u0627 \u0631\u0648
        \u0631\u0648\u06CC \xAB\u062D\u0641\u0638\xBB \u0646\u06AF\u0647 \u062F\u0627\u0631.
        \u0633\u0631 \u062C\u0627\u0634\u0648\u0646 \u0645\u06CC\u200C\u0645\u0648\u0646\u0646
        \u0648 \u062E\u0648\u062F\u0634\u0648\u0646 \u0634\u0644\u06CC\u06A9 \u0645\u06CC\u200C\u06A9\u0646\u0646\u061B
        \u0644\u0627\u0632\u0645 \u0646\u06CC\u0633\u062A \u062F\u06A9\u0645\u0647\u0654
        \u062F\u06CC\u06AF\u0647\u200C\u0627\u06CC \u0628\u0632\u0646\u06CC."
    - key: mission.m03.tutorial.7.title
      value: "\u062F\u0641\u0627\u0639 \u0631\u0648 \u0627\u062F\u0627\u0645\u0647
        \u0628\u062F\u0647"
    - key: mission.m03.tutorial.8.body
      value: "\xAB\u0627\u0633\u06A9\u0646\xBB \u0645\u062D\u062F\u0648\u062F\u0647\u0654
        \u062E\u0648\u062F\u0631\u0648\u06CC \u0631\u0627\u062F\u0627\u0631 \u0633\u0627\u0644\u0645\u062A
        \u0631\u0648 \u0628\u0631\u0631\u0633\u06CC \u0645\u06CC\u200C\u06A9\u0646\u0647.
        \u062F\u0648 \u0628\u0627\u0631 \u0645\u06CC\u200C\u062A\u0648\u0646\u06CC
        \u0627\u0632\u0634 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u06A9\u0646\u06CC
        \u0648 \u0628\u06CC\u0646\u0634 \u0628\u0627\u06CC\u062F \u0635\u0628\u0631
        \u06A9\u0646\u06CC \u062A\u0627 \u062F\u0648\u0628\u0627\u0631\u0647 \u0622\u0645\u0627\u062F\u0647
        \u0628\u0634\u0647. \u062D\u062A\u06CC \u0627\u06AF\u0647 \u0686\u06CC\u0632\u06CC
        \u067E\u06CC\u062F\u0627 \u0646\u06A9\u0646\u0647\u060C \u06CC\u0647 \u0646\u0648\u0628\u062A
        \u0645\u0635\u0631\u0641 \u0645\u06CC\u200C\u0634\u0647."
    - key: mission.m03.tutorial.8.title
      value: "\u0627\u0637\u0644\u0627\u0639\u0627\u062A \u0631\u0648 \u062A\u0627\u0632\u0647
        \u06A9\u0646"
    - key: mission.m03.tutorial.9.body
      value: "\u062A\u0648\u0644\u06CC\u062F \u062A\u0641\u0646\u06AF\u062F\u0627\u0631
        \u0631\u0648 \u062A\u0648\u06CC \u0633\u0631\u0628\u0627\u0632\u062E\u0627\u0646\u0647\u0654
        \u0622\u0645\u0627\u062F\u0647 \u0628\u0627\u0632 \u06A9\u0646. \u0647\u0632\u06CC\u0646\u0647\u0654
        \u06AF\u0631\u0648\u0647 \u0686\u0647\u0627\u0631\u0646\u0641\u0631\u06CC
        \u0631\u0648 \u0628\u0628\u06CC\u0646\u060C \u0628\u0639\u062F \u062A\u0635\u0645\u06CC\u0645
        \u0628\u06AF\u06CC\u0631. \u0633\u0627\u062E\u062A\u200C\u0648\u0633\u0627\u0632
        \u0648 \u0646\u06CC\u0631\u0648\u06CC \u06A9\u0645\u06A9\u06CC \u0627\u062E\u062A\u06CC\u0627\u0631\u06CC\u0647."
    - key: mission.m03.tutorial.9.title
      value: "\u0627\u062E\u062A\u06CC\u0627\u0631\u06CC: \u0646\u06CC\u0631\u0648\u06CC
        \u06A9\u0645\u06A9\u06CC"
    - key: mission.m03.tutorial.resume.body
      value: "\xAB\u0642\u0637\u0639 \u0622\u062A\u0634\xBB \u0634\u0644\u06CC\u06A9
        \u062E\u0648\u062F\u06A9\u0627\u0631 \u0631\u0648 \u0642\u0637\u0639 \u06A9\u0631\u062F.
        \u06AF\u0631\u0648\u0647\u062A \u0631\u0648 \u0627\u0646\u062A\u062E\u0627\u0628\u200C\u0634\u062F\u0647
        \u0646\u06AF\u0647 \u062F\u0627\u0631 \u0648 \xAB\u062D\u0641\u0638\xBB \u0631\u0648
        \u0628\u0632\u0646 \u062A\u0627 \u062F\u0648\u0628\u0627\u0631\u0647 \u062F\u0641\u0627\u0639
        \u06A9\u0646\u0646. \u0648\u0642\u062A\u06CC \u062D\u0641\u0638 \u0641\u0639\u0627\u0644
        \u0628\u0634\u0647\u060C \u0627\u06CC\u0646 \u062F\u0631\u0633 \u062A\u0645\u0648\u0645
        \u0645\u06CC\u200C\u0634\u0647."
    - key: mission.m03.tutorial.resume.title
      value: "\u062F\u0641\u0627\u0639 \u0631\u0648 \u0627\u0632 \u0633\u0631 \u0628\u06AF\u06CC\u0631"
    - key: mission.m03.warning.compact.count
      value: "{0} \u062E\u0648\u062F\u0631\u0648"
    - key: mission.m03.warning.compact.eta
      value: "\u0631\u0633\u06CC\u062F\u0646: {0} \u062B\u0627\u0646\u06CC\u0647"
    - key: mission.m03.warning.compact.first
      value: "\u06A9\u0627\u0631\u0648\u0627\u0646 \u0627\u0648\u0644 \xB7 \u062C\u0627\u062F\u0647\u0654
        \u063A\u0631\u0628\u06CC"
    - key: mission.m03.warning.compact.main
      value: "\u06A9\u0627\u0631\u0648\u0627\u0646 \u0627\u0635\u0644\u06CC \xB7
        \u062C\u0627\u062F\u0647\u0654 \u063A\u0631\u0628\u06CC"
    - key: mission.m03.warning.compact.unknown
      value: "\u062A\u0623\u06CC\u06CC\u062F\u0646\u0634\u062F\u0647"
    - key: mission.m03.warning.eta
      value: "\u0628\u0631\u0622\u0648\u0631\u062F \u0632\u0645\u0627\u0646 \u062A\u0645\u0627\u0633:
        {0} \u062B\u0627\u0646\u06CC\u0647"
    - key: mission.m03.warning.jump
      value: "\u0628\u0631\u0631\u0633\u06CC \u0645\u0648\u0642\u0639\u06CC\u062A
        \u06AF\u0632\u0627\u0631\u0634\u200C\u0634\u062F\u0647"
    - key: mission.m03.warning.main
      value: "\u06A9\u0627\u0631\u0648\u0627\u0646 \u0627\u0635\u0644\u06CC \xB7
        \u062C\u0627\u062F\u0647\u0654 \u063A\u0631\u0628\u06CC"
    - key: mission.m03.warning.ping
      value: "\u0627\u0633\u06A9\u0646"
    - key: mission.m03.warning.resolved
      value: "\u0627\u06CC\u0646 \u0628\u062E\u0634 \u06A9\u0627\u0631\u0648\u0627\u0646
        \u0645\u062A\u0648\u0642\u0641 \u0634\u062F"
    - key: mission.m03.warning.scout
      value: "\u06AF\u0632\u0627\u0631\u0634 \u062F\u06CC\u062F\u0647\u200C\u0628\u0627\u0646"
    - key: mission.m03.warning.sensor
      value: "\u0631\u0627\u062F\u0627\u0631 \u0632\u0645\u06CC\u0646\u06CC"
    - key: mission.m03.warning.stale
      value: "\u0622\u062E\u0631\u06CC\u0646 \u0627\u0637\u0644\u0627\u0639\u0627\u062A
        \u062A\u0645\u0627\u0633"
    - key: mission.m03.warning.title
      value: "\u0647\u0634\u062F\u0627\u0631 \u06A9\u0627\u0631\u0648\u0627\u0646"
    - key: mission.m03.warning.unknown
      value: "\u062A\u0631\u06A9\u06CC\u0628 \u0646\u06CC\u0631\u0648\u0647\u0627
        \u062A\u0623\u06CC\u06CC\u062F \u0646\u0634\u062F\u0647"
    - key: mission.m03.warning.vanguard
      value: "\u067E\u06CC\u0634\u200C\u0642\u0631\u0627\u0648\u0644 \xB7 \u062C\u0627\u062F\u0647\u0654
        \u063A\u0631\u0628\u06CC"
    - key: mission.m03.warning.vehicles
      value: "{0} \u062E\u0648\u062F\u0631\u0648 \u0645\u0634\u0627\u0647\u062F\u0647
        \u0634\u062F\u0647"
    - key: mission.m03.warning.visual
      value: "\u0645\u0634\u0627\u0647\u062F\u0647\u0654 \u0645\u0633\u062A\u0642\u06CC\u0645"
    - key: mission.m03.warning.window
      value: "\u0628\u0627\u0632\u0647\u0654 \u062A\u0645\u0627\u0633 \u0622\u063A\u0627\u0632
        \u0634\u062F\u0647"
    - key: mission.m04.access
      value: "\u06F8 \u062A\u0641\u0646\u06AF\u062F\u0627\u0631 \xB7 \u0646\u0641\u0631\u0628\u0631
        \xB7 \u0628\u0627\u0644\u06AF\u0631\u062F \xB7 \u06F4 \u0645\u062A\u062E\u0635\u0635"
    - key: mission.m04.action.passengers
      value: "\u0628\u0627\u0632 \u06A9\u0631\u062F\u0646 \u0645\u0633\u0627\u0641\u0631\u0627\u0646"
    - key: mission.m04.camera.opening
      value: "\u0645\u0633\u06CC\u0631 \u0646\u062C\u0627\u062A\n\u062F\u0648\u0631\u0628\u06CC\u0646
        \u062C\u0627\u06CC \u062A\u06CC\u0645 \u0648 \u0645\u062D\u0644 \u0641\u0631\u0648\u062F
        \u0631\u0648 \u0646\u0634\u0648\u0646\u062A \u0645\u06CC\u200C\u062F\u0647.
        \u0648\u0642\u062A\u06CC \u0628\u0631\u06AF\u0634\u062A\u060C \u0622\u0645\u0648\u0632\u0634
        \u0622\u0631\u06CC\u0627 \u0634\u0631\u0648\u0639 \u0645\u06CC\u200C\u0634\u0647."
    - key: mission.m04.camera.victory
      value: "\u0646\u062C\u0627\u062A \u06A9\u0627\u0645\u0644 \u0634\u062F\n\u0647\u0631
        \u0686\u0647\u0627\u0631 \u0645\u062A\u062E\u0635\u0635 \u0633\u0627\u0644\u0645\u200C\u0627\u0646\u062F.
        \u0644\u06CC\u0644\u0627 \u062F\u0631 \u062D\u0627\u0644 \u062E\u0631\u0648\u062C
        \u0627\u0633\u062A."
    - key: mission.m04.enemy_intel
      value: "\u06AF\u0634\u062A \u063A\u0631\u0628\u06CC \u06F1\u06F5 \u062B\u0627\u0646\u06CC\u0647
