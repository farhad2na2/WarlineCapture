        \u0628\u0627 \u0647\u0645 \u0627\u0646\u062A\u062E\u0627\u0628 \u0628\u0634\u0646.
        \u0628\u0639\u062F \u0631\u0627\u0647\u0646\u0645\u0627\u06CC \u0632\u0631\u062F
