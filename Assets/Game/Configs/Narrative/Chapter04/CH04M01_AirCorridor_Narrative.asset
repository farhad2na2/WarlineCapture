    lines:
    - lineId: air_corridor-debrief-laila
      textKey: narrative.air_corridor.debrief-laila
      englishFallback: The medical cargo and evacuees are through. These pilots flew
        a coordinated military plan. Vanguard isn't just supplying Qassem anymore;
        it's moving to take the Relay.
      speaker: 5
      voiceClip: {fileID: 8300000, guid: dca65048f297d476ca9814c94f86eae0, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
