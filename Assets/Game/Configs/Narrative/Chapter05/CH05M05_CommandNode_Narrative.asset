    lines:
    - lineId: command_node-brief-07
      textKey: narrative.command_node.brief-07
      englishFallback: Dalia controls the military breach; I coordinate civic continuity.
        Neither mandate replaces the other. Keep the specialists alive through the
        final release.
      speaker: 2
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 11.357142
