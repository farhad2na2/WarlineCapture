      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: command_node-brief-02
      textKey: narrative.command_node.brief-02
      englishFallback: My engineers will preserve the civic connections. Keep the
        protected service sites and their staff intact; losing them defeats the purpose
        of this operation.
      speaker: 2
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 11.285714
      essentialCaption: 1
    continueStateId: CommandNode-brief-2
    skipStateId: CommandNode-brief-complete
    reducedMotionSupported: 1
    durationSeconds: 11.285714
    motionPreset: 0
    locationTitleKey: 
    locationTitleFallback: 
    locationSubtitleKey: 
    locationSubtitleFallback: 
    musicCue: 0
    ambienceCue: 0
