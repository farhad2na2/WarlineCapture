  states:
  - stateId: TrustUnderFire-brief-0
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: 9bab85e848b144e0b87e13d0942f48f4
      m_SubObjectName: CH05M02_TrustUnderFire-a-16x9
      m_SubObjectType: 
