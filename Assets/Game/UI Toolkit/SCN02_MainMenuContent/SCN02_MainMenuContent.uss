.scn02-main-menu-content {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    -unity-font-definition: url("../../../Synty/InterfaceMilitaryCombatHUD/Fonts/Oxanium/Oxanium-Medium.ttf");
    color: rgb(219, 214, 189);
}

.scn02-main-menu-content Button {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
}

.menu-background-content,
.background-viewport,
.background-art,
.background-art-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.background-art {
    left: -2.5%;
    right: -2.5%;
    background-image: url("../../Art/UI/Generated/MainMenuV15C/LayeredOneGo/scn02_background_art.png");
    -unity-background-scale-mode: scale-and-crop;
}

.background-art-overlay {
    background-color: rgba(0, 0, 0, 0.42);
}

.header-content {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 12.96%;
}

.header-back-plate {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(5, 6, 5, 0.88);
}

.header-logo-panel {
    position: absolute;
    left: 0;
    top: 14px;
    width: 19.8%;
    height: 86.8%;
}

.header-logo-frame,
.header-logo,
.header-actions-frame {
    position: absolute;
}

.header-logo-frame {
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/MainMenuV15C/LayeredOneGo/scn02_header_logo_panel_bg.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 34;
    -unity-slice-right: 34;
    -unity-slice-top: 24;
    -unity-slice-bottom: 24;
}

.header-logo {
    left: 13.7%;
    right: 13.7%;
    top: 22.8%;
    bottom: 22.8%;
    background-image: url("../../Art/UI/Generated/MainMenuV15C/LayeredOneGo/scn02_brand_logo_lockup.png");
    -unity-background-scale-mode: scale-to-fit;
}

.header-resource-area {
    position: absolute;
    right: 12.65%;
    top: 14px;
    width: 47.08%;
    height: 86.8%;
    background-image: url("../../Art/UI/Generated/MainMenuV15C/LayeredOneGo/scn02_header_resource_panel_bg.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 24;
    -unity-slice-bottom: 24;
}

.resource-panel {
    position: absolute;
    top: 0;
    height: 100%;
    width: 32.52%;
}

.credits-panel {
    left: 0;
}

.supplies-panel {
    left: 33.74%;
}

.command-panel {
    left: 67.26%;
}

.resource-icon {
    position: absolute;
    left: 9.5%;
    top: 20%;
    width: 23%;
    height: 62%;
    -unity-background-scale-mode: scale-to-fit;
}

.credits-icon {
    background-image: url("../../Art/UI/Generated/MainMenuV15C/LayeredOneGo/scn02_resource_coin_badge.png");
}

.supplies-icon {
    background-image: url("../../Art/UI/Generated/MainMenuV15C/LayeredOneGo/scn02_resource_supplies_crate.png");
}

.command-icon {
    background-image: url("../../Art/UI/Generated/MainMenuV15C/LayeredOneGo/scn02_resource_command_shield.png");
}

.resource-label {
    position: absolute;
    left: 34%;
    top: 20%;
    width: 60%;
    height: 50px;
    font-size: 36px;
    color: rgb(219, 214, 189);
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.resource-value {
    position: absolute;
    left: 34%;
    top: 43%;
    width: 60%;
    height: 84px;
    font-size: 58px;
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.credits-value {
    color: rgb(235, 179, 65);
}

.supplies-value {
    color: rgb(161, 166, 105);
}

.command-value {
    color: rgb(119, 180, 215);
}

.header-actions-panel {
    position: absolute;
    right: 0;
    top: 14px;
    width: 12.67%;
    height: 86.8%;
}

.header-actions-frame {
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/MainMenuV15C/LayeredOneGo/scn02_header_right_actions_bg.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 34;
    -unity-slice-right: 34;
    -unity-slice-top: 24;
    -unity-slice-bottom: 24;
}

.header-icon-button {
    position: absolute;
    width: 26%;
    height: 62.5%;
    top: 18.5%;
    left: 22%;
}

.settings-button {
    left: 57%;
}

.inbox-icon,
.settings-icon {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.inbox-icon {
    background-image: url("../../Art/UI/Generated/MainMenuV15C/LayeredOneGo/scn02_icon_inbox_envelope.png");
}

.settings-icon {
    background-image: url("../../Art/UI/Generated/MainMenuV15C/LayeredOneGo/scn02_icon_settings_gear.png");
}

.left-content {
    position: absolute;
    left: 0;
    top: 13%;
    bottom: 11.2%;
    width: 15%;
}

.left-nav-panel {
    position: absolute;
    left: 50px;
    top: 13.2%;
    width: 79.7%;
    height: 72.9%;
}

.nav-item {
    position: relative;
    width: 100%;
    height: 19.6%;
    margin-bottom: 0;
}

.nav-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Final/scn02_nav_button_inactive_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 36;
    -unity-slice-right: 36;
    -unity-slice-top: 24;
    -unity-slice-bottom: 24;
}

.nav-item-selected .nav-frame {
    -unity-background-image-tint-color: rgb(235, 179, 65);
}

.nav-icon {
    position: absolute;
    left: 8%;
    top: 23%;
    width: 20%;
    height: 54%;
    background-image: url("../../Art/UI/Generated/MainMenuV15C/LayeredOneGo/scn02_icon_operations_pin.png");
