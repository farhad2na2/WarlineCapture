    lines:
    - lineId: m04-brief-01
      textKey: narrative.m04.brief.01
      englishFallback: Captain Laila Nasser. My helicopter is ready at the eastern
        landing area. Bring the four specialists to me in the APC; I can keep this
        extraction window open for ten minutes.
      speaker: 5
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 12.428572
