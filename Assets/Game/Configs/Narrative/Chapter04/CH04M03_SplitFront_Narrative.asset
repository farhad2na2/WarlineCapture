      textKey: narrative.split_front.comms-qassem
      englishFallback: ARIA, your complete memory is within reach. Commander, I can
        give you unrestricted Relay access. Let her authorize the battery and the
        city will answer to you.
      speaker: 9
      voiceClip: {fileID: 8300000, guid: 467323a9b96fc4978bd69581d6fef092, type: 3}
      femaleVoiceClip: {fileID: 0}
