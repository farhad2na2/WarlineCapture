  - stateId: M02-DEBRIEF-DIALOGUE
    kind: 0
    panel16x9: {fileID: 21300000, guid: 96505a723997b4ab3a20d460b23e78cd, type: 3}
    panel20x9: {fileID: 21300000, guid: 96505a723997b4ab3a20d460b23e78cd, type: 3}
    panel16x9Reference:
      m_AssetGUID: 
      m_SubObjectName: 
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    panel20x9Reference:
      m_AssetGUID: 
      m_SubObjectName: 
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: m02-debrief.line.1
      textKey: narrative.m02.debrief.samira
      englishFallback: The post is active again. The clinic road and city response
        teams are connected.
      speaker: 2
      voiceClip: {fileID: 8300000, guid: e9b68851e55c04450adde06013331fd2, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 7.63
      essentialCaption: 1
    - lineId: m02-debrief.line.2
      textKey: narrative.m02.debrief.dalia
      englishFallback: Commander, Dalia Rahim. I will lead the ground response from
        this post.
      speaker: 1
      voiceClip: {fileID: 8300000, guid: 01d27a48490754b4dba2d2527cfcce49, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 7.88
      deadlineSeconds: 15.27
      essentialCaption: 1
    - lineId: m02-debrief.line.3
      textKey: narrative.m02.debrief.aria
      englishFallback: The warning network ahead has gone dark. Armored vehicles
        are moving toward the next sector.
      speaker: 3
      voiceClip: {fileID: 8300000, guid: 83ca18b0363864a188aaa00a2cf3c5d6, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 15.52
      deadlineSeconds: 24.19
      essentialCaption: 1
    continueStateId: M02-DEBRIEF-COMPLETE
