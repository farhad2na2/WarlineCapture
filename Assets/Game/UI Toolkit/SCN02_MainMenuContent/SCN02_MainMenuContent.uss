    right: 5%;
    top: 0;
    bottom: 0;
    font-size: 34px;
    color: rgb(219, 214, 189);
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.middle-content {
    position: absolute;
    left: 15%;
    right: 15%;
    top: 13%;
    bottom: 11.2%;
}

.mode-cards-container {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 86.93%;
    height: 60.06%;
    translate: -50% -50%;
    flex-direction: row;
    justify-content: space-between;
    align-items: stretch;
}

.mode-card {
    position: relative;
    width: 30.68%;
    height: 100%;
}

.mode-card-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/MainMenuV15C/LayeredOneGo/scn02_mode_card_frame.png");
