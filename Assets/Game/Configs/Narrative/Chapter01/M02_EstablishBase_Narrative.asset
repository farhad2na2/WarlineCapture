    panel20x9Reference:
      m_AssetGUID: 
      m_SubObjectName: 
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: m02-brief.line.1
      textKey: narrative.m02.brief.dalia
      englishFallback: This forward post is abandoned, but we need it. Restore it
        and prepare to defend the clinic road.
      speaker: 1
      voiceClip: {fileID: 8300000, guid: 46cbc7b1f2f034cea867ea4017fbd224, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 10.030001
      essentialCaption: 1
    - lineId: m02-brief.line.2
      textKey: narrative.m02.brief.aria
      englishFallback: Build a Barracks here, then train one rifle squad. That will
        make the post operational.
      speaker: 3
      voiceClip: {fileID: 8300000, guid: f96cfe69e17c24416aed81bb3e48b3bd, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 10.280001
      deadlineSeconds: 19.03
      essentialCaption: 1
    - lineId: m02-brief.line.3
      textKey: narrative.m02.brief.samira
      englishFallback: The clinic and city crews use this road. Holding the post
        keeps their route open.
      speaker: 2
      voiceClip: {fileID: 8300000, guid: 7ed03ee80b3fc459ea084fb159cf902d, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 19.28
      deadlineSeconds: 27.87
      essentialCaption: 1
    continueStateId: M02-BRIEF-COMPLETE
    skipStateId: M02-BRIEF-COMPLETE
    reducedMotionSupported: 1
    durationSeconds: 28.12
    motionPreset: 0
