using System;using System.Collections.Generic;using System.Runtime.InteropServices;using Game.Components;using Unity.Mathematics;using UnityEngine;
namespace Unity.Collections {public enum Allocator{Temp} public struct FixedString64Bytes {string s;public FixedString64Bytes(string x){if(System.Text.Encoding.UTF8.GetByteCount(x)>61)throw new ArgumentException();s=x;}public bool Equals(FixedString64Bytes x)=>s==x.s;public override string ToString()=>s??"";} public struct NativeArray<T>:IDisposable {
 readonly T[] data;readonly int offset,count;
 public NativeArray(T[] values):this(values,0,values==null?0:values.Length){}
 public NativeArray(T[] values,int start,int length){if(values==null||start<0||length<0||start>values.Length-length)throw new ArgumentException("Invalid borrowed range");data=values;offset=start;count=length;}
 public int Length=>count;
 public T this[int i]{get{if((uint)i>=(uint)count)throw new IndexOutOfRangeException();return data[offset+i];}set{if((uint)i>=(uint)count)throw new IndexOutOfRangeException();data[offset+i]=value;}}
 public System.Collections.Generic.IEnumerator<T> GetEnumerator(){for(int i=0;i<count;i++)yield return data[offset+i];}
 public void Dispose(){}
 } public struct FixedList512Bytes<T> where T:struct{List<T> a;public int Capacity{get{int size=Marshal.SizeOf<T>();if(size!=24)throw new NotSupportedException("Only original24byte AI cache entries supported");return 21;}}public int Length=>a==null?0:a.Count;public T this[int i]=>a[i];public void Clear(){if(a!=null)a.Clear();}public void Add(T x){if(Length>=Capacity)throw new ArgumentException();if(a==null)a=new List<T>();a.Add(x);}}}
namespace Unity.Entities {public interface IComponentData{} public struct Entity:IEquatable<Entity>{public int Index,Version;public static Entity Null=>default;public bool Equals(Entity x)=>Index==x.Index&&Version==x.Version;public override bool Equals(object x)=>x is Entity e&&Equals(e);public override int GetHashCode()=>Index*31+Version;public static bool operator==(Entity a,Entity b)=>a.Equals(b);public static bool operator!=(Entity a,Entity b)=>!a.Equals(b);} public struct EntityTypeHandle{} public struct ComponentTypeHandle<T>{}
 public struct ArchetypeChunk {
 public Entity[] Entities;public BuildingResourceStorageComponent[] Storage;public BuildingResourceProductionProfileComponent[] Profile;public int Offset,Count;public bool ProfilePresent;
 public Unity.Collections.NativeArray<Entity> GetNativeArray(EntityTypeHandle h)=>new Unity.Collections.NativeArray<Entity>(Entities);
 public Unity.Collections.NativeArray<T> GetNativeArray<T>(ref ComponentTypeHandle<T> h){if(typeof(T)==typeof(BuildingResourceStorageComponent))return new Unity.Collections.NativeArray<T>((T[])(object)Storage,Offset,Count);if(typeof(T)==typeof(BuildingResourceProductionProfileComponent)&&ProfilePresent)return new Unity.Collections.NativeArray<T>((T[])(object)Profile,Offset,Count);throw new NotSupportedException("Unknown chunk view");}
 public bool Has<T>(ref ComponentTypeHandle<T> h)=>typeof(T)==typeof(BuildingResourceProductionProfileComponent)&&ProfilePresent;
 }
 public struct EntityQuery:IDisposable {
 public Entity[] Entities;public ArchetypeChunk[] Chunks;
 public bool IsEmptyIgnoreFilter=>Chunks!=null?Chunks.Length==0:Entities==null||Entities.Length==0;
 public int CalculateEntityCount(){if(Chunks==null)return Entities==null?0:Entities.Length;int count=0;foreach(var c in Chunks)count=checked(count+c.Count);return count;}
 public Unity.Collections.NativeArray<ArchetypeChunk> ToArchetypeChunkArray(Unity.Collections.Allocator a)=>new Unity.Collections.NativeArray<ArchetypeChunk>(Chunks??new[]{new ArchetypeChunk{Entities=Entities}});
 public Unity.Collections.NativeArray<Entity> ToEntityArray(Unity.Collections.Allocator a){if(Chunks!=null)throw new NotSupportedException("Production query is a typed chunk view");return new Unity.Collections.NativeArray<Entity>(Entities);}
 public void Dispose(){}
 }

public sealed class EntityManager {
 readonly Dictionary<Entity,Dictionary<Type,object>> data=new Dictionary<Entity,Dictionary<Type,object>>();
 Game.Runtime.CanonicalStorageBank bank;
 public Entity[] Sessions=new Entity[0];public Entity CurrentHauler;internal int HaulStatusStructuralAdds;
 internal bool BankBound=>bank!=null; internal Action<Entity,object> AfterCanonicalSet;
 public bool Exists(Entity e)=>data.ContainsKey(e)||(bank!=null&&bank.Contains(e));
 public bool HasComponent<T>(Entity e){if(bank!=null&&typeof(T)==typeof(BuildingResourceStorageComponent))return bank.Contains(e);if(bank!=null&&typeof(T)==typeof(BuildingResourceProductionProfileComponent))return bank.Contains(e)&&bank.HasProfile(e);return data.ContainsKey(e)&&data[e].ContainsKey(typeof(T));}
 public T GetComponentData<T>(Entity e){if(typeof(T)==typeof(UnitResourceHauler))CurrentHauler=e;if(!HasComponent<T>(e))throw new InvalidOperationException("Missing actual component "+typeof(T).Name);if(bank!=null&&typeof(T)==typeof(BuildingResourceStorageComponent))return(T)(object)bank.ReadStorage(e);if(bank!=null&&typeof(T)==typeof(BuildingResourceProductionProfileComponent))return(T)(object)bank.ReadProfile(e).Value;return(T)data[e][typeof(T)];}
 public void SetComponentData<T>(Entity e,T value){if(!HasComponent<T>(e))throw new InvalidOperationException("Set requires actual presence");if(bank!=null&&typeof(T)==typeof(BuildingResourceStorageComponent)){bank.WriteStorage(e,(BuildingResourceStorageComponent)(object)value);AfterCanonicalSet?.Invoke(e,value);return;}if(bank!=null&&typeof(T)==typeof(BuildingResourceProductionProfileComponent)){bank.WriteProfile(e,(BuildingResourceProductionProfileComponent)(object)value);return;}data[e][typeof(T)]=value;}
 public void AddComponentData<T>(Entity e,T value){if(bank!=null&&(typeof(T)==typeof(BuildingResourceStorageComponent)||typeof(T)==typeof(BuildingResourceProductionProfileComponent)))throw new NotSupportedException("Canonical structural/reseed Add unsupported");if(typeof(T)==typeof(UnitResourceHaulStatus)&&!HasComponent<T>(e))HaulStatusStructuralAdds++;if(!data.ContainsKey(e))data[e]=new Dictionary<Type,object>();data[e][typeof(T)]=value;}
 public EntityTypeHandle GetEntityTypeHandle()=>default;
 public ComponentTypeHandle<T> GetComponentTypeHandle<T>(bool readOnly)=>default;
 public EntityQuery CreateEntityQuery(params Type[] types){if(types.Length!=1||types[0]!=typeof(SkirmishExpandedSessionComponent))throw new NotSupportedException("Unknown query");return new EntityQuery{Entities=Sessions};}
 internal void BindStorageBank(Game.Runtime.CanonicalStorageBank value){
 if(bank!=null||value==null)throw new NotSupportedException("Canonical bank binds once");
 foreach(var row in data){object raw;if(row.Value.TryGetValue(typeof(BuildingResourceStorageComponent),out raw)){if(!value.Contains(row.Key)||!Game.Runtime.CanonicalStorageBank.Same((BuildingResourceStorageComponent)raw,value.ReadStorage(row.Key)))throw new NotSupportedException("Raw initial storage mismatch before bind");object profile;bool present=row.Value.TryGetValue(typeof(BuildingResourceProductionProfileComponent),out profile);var current=value.ReadProfile(row.Key);if(present!=current.HasValue||(present&&!Game.Runtime.CanonicalStorageBank.Same((BuildingResourceProductionProfileComponent)profile,current.Value)))throw new NotSupportedException("Raw initial profile mismatch before bind");}else if(row.Value.ContainsKey(typeof(BuildingResourceProductionProfileComponent)))throw new NotSupportedException("Profile without canonical storage unsupported");}
 foreach(var row in data){row.Value.Remove(typeof(BuildingResourceStorageComponent));row.Value.Remove(typeof(BuildingResourceProductionProfileComponent));}bank=value;
 }
}
}
