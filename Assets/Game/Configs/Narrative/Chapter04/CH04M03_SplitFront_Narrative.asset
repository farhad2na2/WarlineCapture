      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: split_front-brief-aria
      textKey: narrative.split_front.brief-aria
      englishFallback: Select the launcher, tap Attack, then tap the verified battery.
        Targets must be within range and clear of civilian shelters. Use Hold to
        stop before launch; a missile in flight cannot be recalled. I will show the
        target without issuing orders.
      speaker: 3
      voiceClip: {fileID: 8300000, guid: d6e202b228054431abdecbb1e6f9d321, type: 3}
