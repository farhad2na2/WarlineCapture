    missionContextFlags: []
  - stateId: CitywideAlert-open-4
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: 474d0cd9d99cb45309a834db1ebd90e3
      m_SubObjectName: CH05M01_CitywideAlert_Opening-e-16x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    panel20x9Reference:
      m_AssetGUID: 474d0cd9d99cb45309a834db1ebd90e3
      m_SubObjectName: CH05M01_CitywideAlert_Opening-e-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: citywide_alert-open-05
      textKey: narrative.citywide_alert.open-05
      englishFallback: Every district is calling, Commander. Temporary authority
        cannot answer a permanent crisis. Give the Relay one lasting command, and
        I can make the city obey.
      speaker: 9
      voiceClip: {fileID: 8300000, guid: 10c892f82990d4048abb502de8825095, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 12.66
      essentialCaption: 1
    continueStateId: CitywideAlert-open-5
    skipStateId: CitywideAlert-open-complete
    reducedMotionSupported: 1
    durationSeconds: 12.66
    motionPreset: 0
