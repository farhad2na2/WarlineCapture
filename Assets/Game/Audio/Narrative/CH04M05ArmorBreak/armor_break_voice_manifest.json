      "voiceName": "Warline - ARIA Civic Relay",
      "assetPath": "Assets/Game/Audio/Narrative/CH04M05ArmorBreak/Voice/en/armor_break-debrief-02.wav",
      "durationSeconds": 12.8,
      "sha256": "e37d90c902d75d66096570622f01a25d9162b6b44095a6c4cfd7d38feb78ef3b",
      "captionSha256": "25c28f7d146b582e4116bfc21656decfef7926683d7ad784f46074d504c66001"
    },
    {
      "deliveryProfile": "fa-conversational-v1",
      "voiceSettings": {
        "stability": 0.5,
        "similarity_boost": 0.75
      },
      "performanceDirection": "[conversational tone]",
      "kind": "narrative",
      "id": "armor_break-debrief-02",
      "speaker": "ARIA",
      "locale": "fa-IR",
      "text": "قطعهٔ چهارم پروتکل کامله. قاسم آرشیو بازیابی‌شدهٔ من رو به عنوان کلید دانش و مجوز اضطراری فعلی شما رو به عنوان کلید اختیار زنده می‌خواد. هیچ‌کدوم به‌تنهایی نمی‌تونه کنترل رو بهش بده.",
      "voiceId": "Fi9tPTnEcbh3of7hOHC8",
      "voiceName": "Warline - ARIA Civic Relay",
      "assetPath": "Assets/Game/Audio/Narrative/CH04M05ArmorBreak/Voice/fa/armor_break-debrief-02.wav",
      "durationSeconds": 17.12,
      "sha256": "71b9de567725e14cf1bc386d9dc1320f5b9da234ec311167ab466d214f3abe39",
      "captionSha256": "dceb6752cea6cb58394b9a2d1b5360abbbdfa0f09ba0a0c990409d2744e97f25"
    },
    {
      "kind": "narrative",
      "id": "armor_break-debrief-03",
      "speaker": "LAILA",
      "locale": "en-US",
      "text": "Warnings are coming in from several districts at once. This was one part of a synchronized attack. Take the evidence with us. The next operation will have to protect the city's routes together.",
      "voiceId": "EXAVITQu4vr4xnSDxMaL",
      "voiceName": "Sarah (Captain Laila Nasser)",
      "assetPath": "Assets/Game/Audio/Narrative/CH04M05ArmorBreak/Voice/en/armor_break-debrief-03.wav",
      "durationSeconds": 10.8,
      "sha256": "4191a286a05805c87e4ebc58a4a0188cb5ae1abbeed5a802ccbf919cf4629caa",
      "captionSha256": "fb3d1de0b01774bdfacc0223c8931bc174adadd61c8ee879da8c59f88054fa46"
    },
    {
      "deliveryProfile": "fa-conversational-v1",
      "voiceSettings": {
        "stability": 0.5,
        "similarity_boost": 0.75
      },
      "performanceDirection": "[conversational tone]",
      "kind": "narrative",
