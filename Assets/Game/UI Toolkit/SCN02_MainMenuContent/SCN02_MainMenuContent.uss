}

.progress-value {
    position: absolute;
    right: 0;
    top: -36px;
    width: 34%;
    height: 54px;
    font-size: 34px;
    color: rgb(245, 168, 41);
    -unity-text-align: middle-right;
}

.progress-segments {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 50%;
    height: 18px;
    translate: 0 -50%;
    flex-direction: row;
    justify-content: space-between;
}

.progress-segment {
    width: 7%;
    height: 18px;
    background-color: rgba(46, 48, 41, 0.92);
}

.progress-gold .progress-on {
    background-color: rgb(245, 168, 41);
}

.progress-blue .progress-on {
    background-color: rgb(97, 191, 217);
}

.progress-green .progress-on {
    background-color: rgb(159, 174, 62);
}

