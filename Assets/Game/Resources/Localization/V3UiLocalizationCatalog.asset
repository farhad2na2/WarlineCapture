      value: "\u062D\u0641\u0627\u0638\u062A \u0627\u0632 \u062A\u0631\u0627\u0628\u0631\u06CC"
    - key: mission.m04.result.victory
      value: "\u062A\u062E\u0644\u06CC\u0647 \u06A9\u0627\u0645\u0644 \u0634\u062F"
    - key: mission.m04.reward.card
      value: "\u06F5\u06F0\u06F0 \u062A\u062C\u0631\u0628\u0647 | \u06F2\u06F5\u06F0\u06F0
        \u0627\u0639\u062A\u0628\u0627\u0631 | \u0644\u06CC\u0644\u0627 | \u062A\u0631\u0627\u0628\u0631\u06CC"
    - key: mission.m04.reward.laila
      value: "\u067E\u06CC\u0648\u0633\u062A\u0646 \u0633\u0631\u0648\u0627\u0646
        \u0644\u06CC\u0644\u0627 \u0646\u0627\u0635\u0631"
    - key: mission.m04.reward.transport
      value: "\u062F\u0633\u062A\u0631\u0633\u06CC \u0628\u0647 \u062A\u0631\u0627\u0628\u0631\u06CC"
    - key: mission.m04.specialist.description
      value: "\u0645\u0633\u0627\u0641\u0631 \u0646\u062C\u0627\u062A\u061B \u0647\u0631
        \u0686\u0647\u0627\u0631 \u0645\u062A\u062E\u0635\u0635 \u0631\u0648 \u0633\u0627\u0644\u0645
        \u0646\u06AF\u0647 \u062F\u0627\u0631."
    - key: mission.m04.specialist.group
      value: "{0} \u0645\u062A\u062E\u0635\u0635"
    - key: mission.m04.specialist.name
      value: "\u0645\u062A\u062E\u0635\u0635"
    - key: mission.m04.specialist.role
      value: "\u0645\u0633\u0627\u0641\u0631 \u0646\u062C\u0627\u062A"
    - key: mission.m04.star.1
      value: "\u0647\u0631 \u0686\u0647\u0627\u0631 \u0646\u0641\u0631 \u062A\u062E\u0644\u06CC\u0647
        \u0634\u062F\u0646\u062F"
    - key: mission.m04.star.2
      value: "\u0628\u062F\u0648\u0646 \u062A\u0644\u0641\u0627\u062A \u0645\u062D\u0627\u0641\u0638\u0627\u0646"
    - key: mission.m04.star.3
      value: "\u067E\u0627\u06CC\u0627\u0646 \u062F\u0631 \u06F7 \u062F\u0642\u06CC\u0642\u0647"
    - key: mission.m04.summary
      value: "\u0686\u0647\u0627\u0631 \u0645\u062A\u062E\u0635\u0635 \u0631\u0648
        \u0628\u0627 \u0646\u0641\u0631\u0628\u0631 \u0646\u062C\u0627\u062A \u0628\u062F\u0647\u060C
        \u0628\u0639\u062F \u0628\u0627\u0644\u06AF\u0631\u062F\u0634\u0648\u0646
        \u0631\u0648 \u062A\u0627 \u062E\u0631\u0648\u062C \u0647\u0645\u0631\u0627\u0647\u06CC
        \u06A9\u0646."
    - key: mission.m04.tutorial.1.body
      value: "\u0628\u0627\u06CC\u062F \u0647\u0631 \u0686\u0647\u0627\u0631 \u0645\u062A\u062E\u0635\u0635
        \u0631\u0648 \u0646\u062C\u0627\u062A \u0628\u062F\u06CC: \u0627\u0648\u0644
        \u0628\u0627 \u0646\u0641\u0631\u0628\u0631\u060C \u0628\u0639\u062F \u0628\u0627
        \u0628\u0627\u0644\u06AF\u0631\u062F. \u062F\u0647 \u062F\u0642\u06CC\u0642\u0647
        \u0648\u0642\u062A \u062F\u0627\u0631\u06CC. \u0644\u0627\u0632\u0645 \u0646\u06CC\u0633\u062A
        \u0647\u0645\u0647\u0654 \u062F\u0634\u0645\u0646\u200C\u0647\u0627 \u0631\u0648
        \u0628\u06A9\u0634\u06CC\u061B \u0627\u06AF\u0647 \u0645\u062D\u0627\u0641\u0638\u200C\u0647\u0627
        \u0633\u0627\u0644\u0645 \u0628\u0645\u0648\u0646\u0646\u060C \u06CC\u0647
        \u0633\u062A\u0627\u0631\u0647\u0654 \u0627\u0636\u0627\u0641\u0647 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u06CC."
    - key: mission.m04.tutorial.1.diagram
      value: "\u062A\u06CC\u0645 \u2190 \u0646\u0641\u0631\u0628\u0631 \u2190 \u0645\u062D\u0644
        \u0641\u0631\u0648\u062F \u2190 \u0628\u0627\u0644\u06AF\u0631\u062F \u2190
        \u062E\u0631\u0648\u062C"
    - key: mission.m04.tutorial.1.example
      value: "\u0645\u0633\u06CC\u0631 \u0631\u0648 \u0628\u062E\u0648\u0646 \u0648
        \u0627\u062F\u0627\u0645\u0647 \u0628\u062F\u0647."
    - key: mission.m04.tutorial.1.mistake
      value: "\u0647\u06CC\u0686 \u0645\u062A\u062E\u0635\u0635\u06CC \u0631\u0648
        \u062C\u0627 \u0646\u0630\u0627\u0631."
    - key: mission.m04.tutorial.1.title
      value: "\u0646\u062C\u0627\u062A \u062F\u0631 \u062F\u0648 \u0645\u0631\u062D\u0644\u0647"
    - key: mission.m04.tutorial.10.body
      value: "\u0628\u0627\u0644\u06AF\u0631\u062F \u067E\u0631 \u0631\u0648 \u0628\u06CC\u0633\u062A
        \u062B\u0627\u0646\u06CC\u0647 \u062A\u0648\u06CC \u062D\u0644\u0642\u0647\u0654
        \u0627\u0645\u0646 \u0641\u0631\u0648\u062F \u0646\u06AF\u0647 \u062F\u0627\u0631.
        \u0628\u0627 \u062A\u0641\u0646\u06AF\u062F\u0627\u0631\u0647\u0627 \u0646\u0630\u0627\u0631
        \u062F\u0634\u0645\u0646 \u0648\u0627\u0631\u062F \u062D\u0644\u0642\u0647
        \u0628\u0634\u0647. \u0627\u06AF\u0647 \u0628\u0627\u0644\u06AF\u0631\u062F
        \u0628\u06CC\u0631\u0648\u0646 \u0628\u0631\u0647 \u06CC\u0627 \u062F\u0634\u0645\u0646
        \u0648\u0627\u0631\u062F \u0628\u0634\u0647\u060C \u0632\u0645\u0627\u0646
        \u0627\u0632 \u0627\u0648\u0644 \u0634\u0631\u0648\u0639 \u0645\u06CC\u200C\u0634\u0647."
    - key: mission.m04.tutorial.10.diagram
      value: "\u062A\u06CC\u0645 \u2190 \u0646\u0641\u0631\u0628\u0631 \u2190 \u0645\u062D\u0644
        \u0641\u0631\u0648\u062F \u2190 \u0628\u0627\u0644\u06AF\u0631\u062F \u2190
        \u062E\u0631\u0648\u062C"
    - key: mission.m04.tutorial.10.example
      value: "\u0645\u0646\u062A\u0638\u0631 \u0627\u062C\u0627\u0632\u0647\u0654
        \u062E\u0631\u0648\u062C \u0644\u06CC\u0644\u0627 \u0628\u0645\u0648\u0646."
    - key: mission.m04.tutorial.10.mistake
      value: "\u0627\u06AF\u0647 \u0632\u0648\u062F \u0628\u0644\u0646\u062F \u0634\u06CC\u060C
        \u0645\u0631\u062D\u0644\u0647\u0654 \u0627\u0645\u0646\u200C\u06A9\u0631\u062F\u0646
        \u0645\u062D\u0644 \u0641\u0631\u0648\u062F \u06A9\u0627\u0645\u0644 \u0646\u0645\u06CC\u200C\u0634\u0647."
    - key: mission.m04.tutorial.10.title
      value: "\u0645\u062D\u0644 \u0641\u0631\u0648\u062F \u0631\u0648 \u0627\u0645\u0646
        \u0646\u06AF\u0647 \u062F\u0627\u0631"
    - key: mission.m04.tutorial.11.body
      value: "\u0628\u0627\u0644\u06AF\u0631\u062F \u0631\u0648 \u0627\u0646\u062A\u062E\u0627\u0628
        \u06A9\u0646\u060C \xAB\u062D\u0631\u06A9\u062A\xBB \u0631\u0648 \u0628\u0632\u0646
        \u0648 \u0628\u0647 \u0645\u062D\u0644 \u062E\u0631\u0648\u062C \u0645\u0634\u062E\u0635\u200C\u0634\u062F\u0647
        \u0628\u0641\u0631\u0633\u062A\u0634. \xAB\u0646\u0634\u0627\u0646 \u0628\u062F\u0647\xBB
        \u062E\u0631\u0648\u062C \u0631\u0648 \u0646\u0634\u0648\u0646\u062A \u0645\u06CC\u200C\u062F\u0647.
        \u062A\u0627 \u0646\u062C\u0627\u062A \u062A\u0623\u06CC\u06CC\u062F \u0646\u0634\u062F\u0647\u060C
        \u0647\u0631 \u0686\u0647\u0627\u0631 \u0645\u062A\u062E\u0635\u0635 \u0628\u0627\u06CC\u062F
        \u0633\u0648\u0627\u0631 \u0628\u0645\u0648\u0646\u0646."
    - key: mission.m04.tutorial.11.diagram
      value: "\u062A\u06CC\u0645 \u2190 \u0646\u0641\u0631\u0628\u0631 \u2190 \u0645\u062D\u0644
        \u0641\u0631\u0648\u062F \u2190 \u0628\u0627\u0644\u06AF\u0631\u062F \u2190
        \u062E\u0631\u0648\u062C"
    - key: mission.m04.tutorial.11.example
      value: "\u0628\u0627 \u0628\u0627\u0644\u06AF\u0631\u062F \u062F\u0631 \u062D\u0627\u0644
        \u067E\u0631\u0648\u0627\u0632 \u0648\u0627\u0631\u062F \u0645\u062D\u062F\u0648\u062F\u0647\u0654
        \u062E\u0631\u0648\u062C \u0634\u0648."
    - key: mission.m04.tutorial.11.mistake
      value: "\u0631\u0633\u06CC\u062F\u0646 \u0646\u0641\u0631\u0628\u0631 \u0628\u0647
        \u062E\u0631\u0648\u062C \u06A9\u0627\u0641\u06CC \u0646\u06CC\u0633\u062A\u061B
        \u062A\u06CC\u0645 \u0628\u0627\u06CC\u062F \u0628\u0627 \u0628\u0627\u0644\u06AF\u0631\u062F
        \u062E\u0627\u0631\u062C \u0628\u0634\u0647."
    - key: mission.m04.tutorial.11.title
      value: "\u0628\u0647 \u0645\u062D\u062F\u0648\u062F\u0647\u0654 \u062E\u0631\u0648\u062C
        \u067E\u0631\u0648\u0627\u0632 \u06A9\u0646"
    - key: mission.m04.tutorial.12.body
      value: "\u062F\u0627\u0631\u0645 \u0646\u062C\u0627\u062A \u0631\u0648 \u062A\u0623\u06CC\u06CC\u062F
        \u0645\u06CC\u200C\u06A9\u0646\u0645. \u062A\u0627 \u0646\u062A\u06CC\u062C\u0647
        \u0628\u06CC\u0627\u062F\u060C \u0645\u0633\u0627\u0641\u0631\u0647\u0627
        \u0631\u0648 \u0633\u0648\u0627\u0631 \u0646\u06AF\u0647 \u062F\u0627\u0631
        \u0648 \u0627\u0632 \u0628\u0627\u0644\u06AF\u0631\u062F \u0645\u062D\u0627\u0641\u0638\u062A
        \u06A9\u0646."
    - key: mission.m04.tutorial.12.diagram
      value: "\u062A\u06CC\u0645 \u2190 \u0646\u0641\u0631\u0628\u0631 \u2190 \u0645\u062D\u0644
        \u0641\u0631\u0648\u062F \u2190 \u0628\u0627\u0644\u06AF\u0631\u062F \u2190
        \u062E\u0631\u0648\u062C"
    - key: mission.m04.tutorial.12.example
      value: "\u0628\u0639\u062F \u0627\u0632 \u0627\u0648\u0644\u06CC\u0646 \u0646\u062C\u0627\u062A
        \u0645\u0648\u0641\u0642\u060C \u0644\u06CC\u0644\u0627 \u0628\u0647 \u062A\u06CC\u0645\u062A
        \u0627\u0636\u0627\u0641\u0647 \u0645\u06CC\u200C\u0634\u0647."
    - key: mission.m04.tutorial.12.mistake
      value: "\u0634\u06A9\u0633\u062A \u067E\u0627\u062F\u0627\u0634 \u0646\u062C\u0627\u062A
        \u0646\u0645\u06CC\u200C\u062F\u0647\u062F \u0648 \u062E\u0631\u0648\u062C
        \u0645\u0648\u0641\u0642 \u0646\u0634\u0627\u0646 \u0646\u0645\u06CC\u200C\u062F\u0647\u062F."
    - key: mission.m04.tutorial.12.title
      value: "\u0646\u062C\u0627\u062A \u0631\u0648 \u0645\u0631\u0648\u0631 \u06A9\u0646"
    - key: mission.m04.tutorial.2.body
      value: "\u0646\u0641\u0631\u0628\u0631 \u0686\u0631\u062E\u200C\u062F\u0627\u0631
        \u06A9\u0646\u0627\u0631 \u062A\u0641\u0646\u06AF\u062F\u0627\u0631\u0647\u0627
        \u0631\u0648 \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646. \u0686\u0647\u0627\u0631
        \u0635\u0646\u062F\u0644\u06CC\u0634 \u0631\u0648 \u0628\u0631\u0627\u06CC
        \u0645\u062A\u062E\u0635\u0635\u200C\u0647\u0627 \u062E\u0627\u0644\u06CC
        \u0646\u06AF\u0647 \u062F\u0627\u0631. \u0627\u06AF\u0647 \u067E\u06CC\u062F\u0627\u0634
        \u0646\u06A9\u0631\u062F\u06CC\u060C \xAB\u0646\u0634\u0627\u0646 \u0628\u062F\u0647\xBB
        \u0631\u0648 \u0628\u0632\u0646."
    - key: mission.m04.tutorial.2.diagram
      value: "\u062A\u06CC\u0645 \u2190 \u0646\u0641\u0631\u0628\u0631 \u2190 \u0645\u062D\u0644
        \u0641\u0631\u0648\u062F \u2190 \u0628\u0627\u0644\u06AF\u0631\u062F \u2190
        \u062E\u0631\u0648\u062C"
    - key: mission.m04.tutorial.2.example
      value: "\u0642\u0628\u0644 \u0627\u0632 \u0641\u0631\u0645\u0627\u0646 \u062D\u0631\u06A9\u062A\u060C
        \u0646\u0641\u0631\u0628\u0631 \u0631\u0648 \u0627\u0646\u062A\u062E\u0627\u0628
        \u06A9\u0646."
    - key: mission.m04.tutorial.2.mistake
      value: "\u06AF\u0631\u0648\u0647 \u062A\u0641\u0646\u06AF\u062F\u0627\u0631
        \u0627\u0646\u062A\u062E\u0627\u0628\u200C\u0634\u062F\u0647 \u0646\u0641\u0631\u0628\u0631
        \u0646\u06CC\u0633\u062A."
    - key: mission.m04.tutorial.2.title
      value: "\u0646\u0641\u0631\u0628\u0631 \u0631\u0648 \u0627\u0646\u062A\u062E\u0627\u0628
        \u06A9\u0646"
    - key: mission.m04.tutorial.3.body
      value: "\xAB\u062D\u0631\u06A9\u062A\xBB \u0631\u0648 \u0628\u0632\u0646 \u0648
        \u0646\u0641\u0631\u0628\u0631 \u0631\u0648 \u06A9\u0646\u0627\u0631 \u0686\u0647\u0627\u0631
        \u0645\u062A\u062E\u0635\u0635 \u062A\u0648\u06CC \u062C\u0627\u062F\u0647\u0654
        \u063A\u0631\u0628\u06CC \u0628\u0628\u0631. \xAB\u0646\u0634\u0627\u0646
        \u0628\u062F\u0647\xBB \u062C\u0627\u0634\u0648\u0646 \u0631\u0648 \u0646\u0634\u0648\u0646\u062A
        \u0645\u06CC\u200C\u062F\u0647. \u062A\u0641\u0646\u06AF\u062F\u0627\u0631\u0647\u0627
        \u0631\u0648 \u0647\u0645 \u0628\u0631\u0627\u06CC \u067E\u0648\u0634\u0634
        \u062C\u0644\u0648 \u0628\u0641\u0631\u0633\u062A."
    - key: mission.m04.tutorial.3.diagram
      value: "\u062A\u06CC\u0645 \u2190 \u0646\u0641\u0631\u0628\u0631 \u2190 \u0645\u062D\u0644
        \u0641\u0631\u0648\u062F \u2190 \u0628\u0627\u0644\u06AF\u0631\u062F \u2190
        \u062E\u0631\u0648\u062C"
    - key: mission.m04.tutorial.3.example
      value: "\u062C\u0627\u062F\u0647 \u0645\u0633\u06CC\u0631 \u0645\u0646\u0627\u0633\u0628\u06CC
        \u0628\u0631\u0627\u06CC \u0646\u0632\u062F\u06CC\u06A9\u200C\u0634\u062F\u0646
        \u0646\u0641\u0631\u0628\u0631 \u0627\u0633\u062A."
    - key: mission.m04.tutorial.3.mistake
      value: "\u0627\u0632 \u0645\u06CC\u0627\u0646 \u0633\u0627\u062E\u062A\u0645\u0627\u0646\u200C\u0647\u0627
        \u0639\u0628\u0648\u0631 \u0646\u06A9\u0646 \u0648 \u0646\u0641\u0631\u0628\u0631
        \u0631\u0648 \u0632\u06CC\u0631 \u0622\u062A\u0634 \u0631\u0647\u0627 \u0646\u06A9\u0646."
    - key: mission.m04.tutorial.3.title
      value: "\u0628\u0647 \u062A\u06CC\u0645 \u06AF\u0631\u0641\u062A\u0627\u0631
        \u0628\u0631\u0633\u06CC\u062F"
    - key: mission.m04.tutorial.4.body
      value: "\u0647\u0631 \u0686\u0647\u0627\u0631 \u0645\u062A\u062E\u0635\u0635
        \u06A9\u0646\u0627\u0631 \u062C\u0627\u062F\u0647 \u0631\u0648 \u0628\u0627
        \u062F\u06A9\u0645\u0647\u0654 \u0627\u0646\u062A\u062E\u0627\u0628 \u0645\u062A\u062E\u0635\u0635\u0627\u0646
        \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646. \u0645\u062D\u0627\u0641\u0638\u200C\u0647\u0627\u06CC
        \u0645\u0633\u0644\u062D \u0646\u0628\u0627\u06CC\u062F \u062A\u0648\u06CC
        \u0627\u06CC\u0646 \u06AF\u0631\u0648\u0647 \u0628\u0627\u0634\u0646. \u0648\u0642\u062A\u06CC
        \u0647\u0631 \u0686\u0647\u0627\u0631 \u0646\u0641\u0631 \u0627\u0646\u062A\u062E\u0627\u0628
        \u0628\u0634\u0646\u060C \u0645\u06CC\u200C\u0631\u06CC\u0645 \u0645\u0631\u062D\u0644\u0647\u0654
        \u0628\u0639\u062F."
    - key: mission.m04.tutorial.4.diagram
      value: "\u062A\u06CC\u0645 \u2190 \u0646\u0641\u0631\u0628\u0631 \u2190 \u0645\u062D\u0644
        \u0641\u0631\u0648\u062F \u2190 \u0628\u0627\u0644\u06AF\u0631\u062F \u2190
        \u062E\u0631\u0648\u062C"
    - key: mission.m04.tutorial.4.example
      value: "\u062F\u06A9\u0645\u0647\u0654 \u0627\u0646\u062A\u062E\u0627\u0628
        \u0647\u0645\u0647\u0654 \u0645\u062A\u062E\u0635\u0635\u0627\u0646 \u0631\u0648
        \u062F\u0631 \u067E\u0646\u0644 \u0622\u0631\u06CC\u0627 \u0628\u0632\u0646."
    - key: mission.m04.tutorial.4.mistake
      value: "\u0645\u062D\u0627\u0641\u0638\u0627\u0646 \u0645\u0633\u0644\u062D
        \u0631\u0648 \u0648\u0627\u0631\u062F \u0627\u06CC\u0646 \u0627\u0646\u062A\u062E\u0627\u0628
        \u0646\u06A9\u0646."
    - key: mission.m04.tutorial.4.title
      value: "\u0645\u062A\u062E\u0635\u0635\u0627\u0646 \u0631\u0648 \u0627\u0646\u062A\u062E\u0627\u0628
        \u06A9\u0646"
    - key: mission.m04.tutorial.5.body
      value: "\xAB\u0633\u0648\u0627\u0631\u0634\u062F\u0646\xBB \u0631\u0648 \u0628\u0632\u0646\u060C
        \u0628\u0639\u062F \u0646\u0641\u0631\u0628\u0631 \u0631\u0648 \u0627\u0646\u062A\u062E\u0627\u0628
        \u06A9\u0646. \u0642\u0628\u0644 \u0627\u0632 \u062D\u0631\u06A9\u062A\u060C
        \u0635\u0628\u0631 \u06A9\u0646 \u062A\u0627 \u0647\u0631 \u0686\u0647\u0627\u0631
        \u0645\u062A\u062E\u0635\u0635 \u062A\u0648\u06CC \u0641\u0647\u0631\u0633\u062A
        \u0645\u0633\u0627\u0641\u0631\u0647\u0627 \u0628\u0627\u0634\u0646."
    - key: mission.m04.tutorial.5.diagram
      value: "\u062A\u06CC\u0645 \u2190 \u0646\u0641\u0631\u0628\u0631 \u2190 \u0645\u062D\u0644
        \u0641\u0631\u0648\u062F \u2190 \u0628\u0627\u0644\u06AF\u0631\u062F \u2190
        \u062E\u0631\u0648\u062C"
    - key: mission.m04.tutorial.5.example
      value: "\u0642\u0628\u0644 \u0627\u0632 \u062D\u0631\u06A9\u062A \u062A\u0639\u062F\u0627\u062F
        \u0645\u0633\u0627\u0641\u0631\u0627\u0646 \u0631\u0648 \u0628\u0631\u0631\u0633\u06CC
        \u06A9\u0646."
    - key: mission.m04.tutorial.5.mistake
      value: "\u0632\u0648\u062F \u0631\u0627\u0647 \u0646\u06CC\u0641\u062A\u061B
        \u0645\u0645\u06A9\u0646\u0647 \u06CC\u06A9\u06CC \u0627\u0632 \u0645\u0633\u0627\u0641\u0631\u0647\u0627
        \u062C\u0627 \u0628\u0645\u0648\u0646\u0647."
    - key: mission.m04.tutorial.5.title
      value: "\u0647\u0631 \u0686\u0647\u0627\u0631 \u0646\u0641\u0631 \u0631\u0648
        \u0633\u0648\u0627\u0631 \u0646\u0641\u0631\u0628\u0631 \u06A9\u0646"
    - key: mission.m04.tutorial.6.body
      value: "\u0646\u0641\u0631\u0628\u0631 \u067E\u0631 \u0631\u0648 \u0628\u0647
        \u0645\u062D\u0644 \u0641\u0631\u0648\u062F \u0645\u0634\u062E\u0635\u200C\u0634\u062F\u0647
        \u062A\u0648\u06CC \u0634\u0631\u0642 \u0628\u0628\u0631. \xAB\u0646\u0634\u0627\u0646
        \u0628\u062F\u0647\xBB \u062C\u0627\u06CC \u0644\u06CC\u0644\u0627 \u0631\u0648
        \u0646\u0634\u0648\u0646\u062A \u0645\u06CC\u200C\u062F\u0647. \u062A\u0641\u0646\u06AF\u062F\u0627\u0631\u0647\u0627
        \u0631\u0648 \u0628\u0631\u0627\u06CC \u067E\u0648\u0634\u0634 \u0645\u0633\u06CC\u0631
        \u06AF\u0634\u062A \u062F\u0634\u0645\u0646 \u0646\u06AF\u0647 \u062F\u0627\u0631."
    - key: mission.m04.tutorial.6.diagram
      value: "\u062A\u06CC\u0645 \u2190 \u0646\u0641\u0631\u0628\u0631 \u2190 \u0645\u062D\u0644
        \u0641\u0631\u0648\u062F \u2190 \u0628\u0627\u0644\u06AF\u0631\u062F \u2190
        \u062E\u0631\u0648\u062C"
    - key: mission.m04.tutorial.6.example
      value: "\u062F\u0631 \u0637\u0648\u0644 \u0645\u0633\u06CC\u0631 \u062A\u0639\u062F\u0627\u062F
        \u0645\u0633\u0627\u0641\u0631\u0627\u0646 \u0631\u0648 \u0631\u0648\u06CC
        \u0686\u0647\u0627\u0631 \u0646\u06AF\u0647 \u062F\u0627\u0631."
    - key: mission.m04.tutorial.6.mistake
      value: "\u0645\u062D\u0627\u0641\u0638\u200C\u0647\u0627 \u0631\u0648 \u067E\u0634\u062A
        \u06A9\u0627\u0631\u0648\u0627\u0646 \u062C\u0627 \u0646\u0630\u0627\u0631."
    - key: mission.m04.tutorial.6.title
      value: "\u0646\u0641\u0631\u0628\u0631 \u0631\u0648 \u062A\u0627 \u0644\u06CC\u0644\u0627
        \u0647\u0645\u0631\u0627\u0647\u06CC \u06A9\u0646"
    - key: mission.m04.tutorial.7.body
      value: "\u0628\u062E\u0634 \u0645\u0633\u0627\u0641\u0631\u0647\u0627\u06CC
        \u0646\u0641\u0631\u0628\u0631 \u0631\u0648 \u0628\u0627\u0632 \u06A9\u0646
        \u0648 \xAB\u067E\u06CC\u0627\u062F\u0647\u200C\u0634\u062F\u0646\xBB \u0631\u0648
        \u0628\u0632\u0646. \u0635\u0628\u0631 \u06A9\u0646 \u0647\u0631 \u0686\u0647\u0627\u0631
        \u0645\u062A\u062E\u0635\u0635 \u06A9\u0646\u0627\u0631 \u0628\u0627\u0644\u06AF\u0631\u062F
        \u067E\u06CC\u0627\u062F\u0647 \u0628\u0634\u0646. \u0627\u06AF\u0647 \u062C\u0627
        \u0628\u0633\u062A\u0647\u200C\u0633\u062A\u060C \u0646\u0641\u0631\u0628\u0631
        \u0631\u0648 \u06CC\u0647 \u06A9\u0645 \u0628\u0628\u0631 \u062A\u0648\u06CC
        \u0641\u0636\u0627\u06CC \u0628\u0627\u0632."
    - key: mission.m04.tutorial.7.diagram
      value: "\u062A\u06CC\u0645 \u2190 \u0646\u0641\u0631\u0628\u0631 \u2190 \u0645\u062D\u0644
        \u0641\u0631\u0648\u062F \u2190 \u0628\u0627\u0644\u06AF\u0631\u062F \u2190
        \u062E\u0631\u0648\u062C"
    - key: mission.m04.tutorial.7.example
      value: "\u0632\u06CC\u0631 \u067E\u0648\u0634\u0634 \u062A\u0641\u0646\u06AF\u062F\u0627\u0631\u0647\u0627\u060C
        \u0645\u062A\u062E\u0635\u0635\u200C\u0647\u0627 \u0631\u0648 \u06A9\u0646\u0627\u0631
        \u0628\u0627\u0644\u06AF\u0631\u062F \u067E\u06CC\u0627\u062F\u0647 \u06A9\u0646."
    - key: mission.m04.tutorial.7.mistake
      value: "\u0627\u06AF\u0647 \u062F\u0633\u062A\u0648\u0631 \u067E\u06CC\u0627\u062F\u0647\u200C\u0634\u062F\u0646
        \u0631\u062F \u0628\u0634\u0647\u060C \u0645\u0633\u0627\u0641\u0631\u0647\u0627
        \u062A\u0648\u06CC \u0646\u0641\u0631\u0628\u0631 \u0645\u06CC\u200C\u0645\u0648\u0646\u0646
        \u0648 \u0645\u0646\u062A\u0642\u0644 \u0646\u0645\u06CC\u200C\u0634\u0646."
    - key: mission.m04.tutorial.7.title
      value: "\u0645\u062A\u062E\u0635\u0635\u200C\u0647\u0627 \u0631\u0648 \u06A9\u0646\u0627\u0631
        \u0628\u0627\u0644\u06AF\u0631\u062F \u067E\u06CC\u0627\u062F\u0647 \u06A9\u0646"
    - key: mission.m04.tutorial.8.body
      value: "\u0628\u0627\u0644\u06AF\u0631\u062F \u0644\u06CC\u0644\u0627 \u0631\u0648
        \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646. \u06A9\u0646\u0627\u0631
        \u0645\u062A\u062E\u0635\u0635\u200C\u0647\u0627 \u0631\u0648\u06CC \u0632\u0645\u06CC\u0646
        \u0646\u06AF\u0647\u0634 \u062F\u0627\u0631 \u062A\u0627 \u0647\u0631 \u0686\u0647\u0627\u0631
        \u0646\u0641\u0631 \u0628\u062A\u0648\u0646\u0646 \u0633\u0648\u0627\u0631
        \u0628\u0634\u0646."
    - key: mission.m04.tutorial.8.diagram
      value: "\u062A\u06CC\u0645 \u2190 \u0646\u0641\u0631\u0628\u0631 \u2190 \u0645\u062D\u0644
        \u0641\u0631\u0648\u062F \u2190 \u0628\u0627\u0644\u06AF\u0631\u062F \u2190
        \u062E\u0631\u0648\u062C"
    - key: mission.m04.tutorial.8.example
      value: "\u062A\u0627 \u0633\u0648\u0627\u0631\u0634\u062F\u0646 \u0647\u0631
        \u0686\u0647\u0627\u0631 \u0646\u0641\u0631 \u0627\u0648\u0646 \u0631\u0648
        \u062F\u0631 \u0645\u062D\u0644 \u0641\u0631\u0648\u062F \u0646\u06AF\u0647
        \u062F\u0627\u0631."
    - key: mission.m04.tutorial.8.mistake
      value: "\u0628\u0627\u0644\u06AF\u0631\u062F \u0628\u0627\u06CC\u062F \u0631\u0648\u06CC
        \u0632\u0645\u06CC\u0646 \u0628\u0627\u0634\u0647 \u062A\u0627 \u0645\u0633\u0627\u0641\u0631\u0647\u0627
        \u0633\u0648\u0627\u0631 \u0628\u0634\u0646."
    - key: mission.m04.tutorial.8.title
      value: "\u0628\u0627\u0644\u06AF\u0631\u062F \u0631\u0648 \u0628\u0631\u0631\u0633\u06CC
        \u06A9\u0646"
    - key: mission.m04.tutorial.9.body
      value: "\u0628\u0627 \u062F\u06A9\u0645\u0647\u0654 \u0627\u0646\u062A\u062E\u0627\u0628
        \u0645\u062A\u062E\u0635\u0635\u0627\u0646\u060C \u0647\u0631 \u0686\u0647\u0627\u0631
        \u0646\u0641\u0631 \u0631\u0648 \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646.
        \xAB\u0633\u0648\u0627\u0631\u0634\u062F\u0646\xBB \u0631\u0648 \u0628\u0632\u0646\u060C
        \u0628\u0639\u062F \u0628\u0627\u0644\u06AF\u0631\u062F \u0631\u0648\u06CC
        \u0632\u0645\u06CC\u0646 \u0631\u0648 \u0627\u0646\u062A\u062E\u0627\u0628
        \u06A9\u0646. \u0628\u0627\u06CC\u062F \u0647\u0631 \u0686\u0647\u0627\u0631
        \u0646\u0641\u0631 \u062A\u0648\u06CC \u0641\u0647\u0631\u0633\u062A \u0645\u0633\u0627\u0641\u0631\u0647\u0627
        \u0628\u0627\u0634\u0646."
    - key: mission.m04.tutorial.9.diagram
      value: "\u062A\u06CC\u0645 \u2190 \u0646\u0641\u0631\u0628\u0631 \u2190 \u0645\u062D\u0644
        \u0641\u0631\u0648\u062F \u2190 \u0628\u0627\u0644\u06AF\u0631\u062F \u2190
        \u062E\u0631\u0648\u062C"
    - key: mission.m04.tutorial.9.example
      value: "\u0641\u0642\u0637 \u062A\u06CC\u0645 \u0645\u062A\u062E\u0635\u0635\u200C\u0647\u0627
        \u0631\u0648 \u0633\u0648\u0627\u0631 \u06A9\u0646\u061B \u062A\u0641\u0646\u06AF\u062F\u0627\u0631\u0647\u0627\u06CC
        \u0645\u062D\u0627\u0641\u0638 \u0628\u06CC\u0631\u0648\u0646 \u0628\u0645\u0648\u0646\u0646."
    - key: mission.m04.tutorial.9.mistake
      value: "\u067E\u0631\u0648\u0627\u0632 \u0645\u0633\u062A\u0642\u06CC\u0645
        \u0628\u0647 \u0633\u0645\u062A \u062A\u06CC\u0645\u060C \u0645\u0631\u062D\u0644\u0647\u0654
        \u0646\u0641\u0631\u0628\u0631 \u0631\u0648 \u062D\u0630\u0641 \u0645\u06CC\u200C\u06A9\u0646\u0647
        \u0648 \u0645\u0623\u0645\u0648\u0631\u06CC\u062A \u0631\u0648 \u06A9\u0627\u0645\u0644
        \u0646\u0645\u06CC\u200C\u06A9\u0646\u0647."
    - key: mission.m04.tutorial.9.title
      value: "\u0645\u062A\u062E\u0635\u0635\u0627\u0646 \u0631\u0648 \u0645\u0646\u062A\u0642\u0644
        \u06A9\u0646"
    - key: mission.m04.tutorial.hold.contested
      value: "\u062F\u0634\u0645\u0646 \u0648\u0627\u0631\u062F \u062D\u0644\u0642\u0647\u0654
        \u0641\u0631\u0648\u062F \u0634\u062F\u0647\u061B \u0632\u0645\u0627\u0646
        \u0627\u06CC\u0645\u0646\u06CC \u0627\u0632 \u0627\u0648\u0644 \u0634\u0631\u0648\u0639
        \u0645\u06CC\u200C\u0634\u0647. \u0628\u0627\u0644\u06AF\u0631\u062F \u0631\u0648
        \u0647\u0645\u06CC\u0646\u200C\u062C\u0627 \u0646\u06AF\u0647 \u062F\u0627\u0631.
        \u0645\u062D\u0627\u0641\u0638\u200C\u0647\u0627 \u0631\u0648 \u0627\u0646\u062A\u062E\u0627\u0628
        \u06A9\u0646 \u0648 \u0628\u0647 \u0645\u0647\u0627\u062C\u0645\u200C\u0647\u0627
        \u062D\u0645\u0644\u0647 \u06A9\u0646\u061B \u0648\u0642\u062A\u06CC \u062D\u0644\u0642\u0647
        \u067E\u0627\u06A9 \u0628\u0634\u0647\u060C \u0634\u0645\u0627\u0631\u0634
        \u0627\u062F\u0627\u0645\u0647 \u067E\u06CC\u062F\u0627 \u0645\u06CC\u200C\u06A9\u0646\u0647."
    - key: mission.m04.tutorial.hold.return
      value: "\u0628\u0627\u0644\u06AF\u0631\u062F \u0628\u06CC\u0631\u0648\u0646
        \u0645\u062D\u0644 \u0641\u0631\u0648\u062F\u0647. \u0627\u0646\u062A\u062E\u0627\u0628\u0634
        \u06A9\u0646\u060C \xAB\u062D\u0631\u06A9\u062A\xBB \u0631\u0648 \u0628\u0632\u0646
        \u0648 \u062F\u0627\u062E\u0644 \u062D\u0644\u0642\u0647\u0654 \u0632\u0631\u062F
        \u0645\u0642\u0635\u062F \u0628\u062F\u0647. \u062A\u0627 \u0634\u0645\u0627\u0631\u0634
        \u062A\u0645\u0648\u0645 \u0628\u0634\u0647\u060C \u0647\u0645\u0648\u0646\u200C\u062C\u0627
        \u0646\u06AF\u0647\u0634 \u062F\u0627\u0631."
    - key: mission.m04.tutorial.hold.wait
      value: "\u0647\u0631 \u0686\u0647\u0627\u0631 \u0645\u062A\u062E\u0635\u0635
        \u0633\u0648\u0627\u0631\u0646. {0} \u062B\u0627\u0646\u06CC\u0647\u0654
        \u062F\u06CC\u06AF\u0647 \u0635\u0628\u0631 \u06A9\u0646\u061B \u0644\u0627\u0632\u0645
        \u0646\u06CC\u0633\u062A \u062F\u06A9\u0645\u0647\u200C\u0627\u06CC \u0628\u0632\u0646\u06CC.
        \u0628\u0627\u0644\u06AF\u0631\u062F \u0631\u0648 \u062A\u0648\u06CC \u062D\u0644\u0642\u0647\u0654
        \u0632\u0631\u062F \u0641\u0631\u0648\u062F \u0646\u06AF\u0647 \u062F\u0627\u0631.
        \u062F\u0631\u0633 \u0628\u0639\u062F\u06CC \u0645\u0633\u06CC\u0631 \u062E\u0631\u0648\u062C
        \u0631\u0648 \u0646\u0634\u0648\u0646\u062A \u0645\u06CC\u200C\u062F\u0647."
    - key: mission.m04.tutorial.selection_progress
      value: "\u0645\u062A\u062E\u0635\u0635\u200C\u0647\u0627\u06CC \u0627\u0646\u062A\u062E\u0627\u0628\u200C\u0634\u062F\u0647:
        {0} \u0627\u0632 \u06F4. \xAB\u0627\u0646\u062A\u062E\u0627\u0628 \u0647\u0645\u0647\u0654
        \u0645\u062A\u062E\u0635\u0635\u0627\u0646\xBB \u0631\u0648 \u0628\u0632\u0646
        \u062A\u0627 \u062A\u06CC\u0645 \u0646\u062C\u0627\u062A \u0628\u0627 \u0647\u0645
        \u0627\u0646\u062A\u062E\u0627\u0628 \u0628\u0634\u0646. \u0648\u0642\u062A\u06CC
        \u0647\u0631 \u0686\u0647\u0627\u0631 \u0646\u0641\u0631 \u0627\u0646\u062A\u062E\u0627\u0628
        \u0634\u062F\u0646\u060C \u0631\u0627\u0647\u0646\u0645\u0627\u06CC \u0632\u0631\u062F
        \u0628\u0639\u062F\u06CC \u0631\u0648 \u062F\u0646\u0628\u0627\u0644 \u06A9\u0646."
    - key: mission.m05.access
      value: "\u06F8 \u062A\u0641\u0646\u06AF\u062F\u0627\u0631 \xB7 \u0646\u0641\u0631\u0628\u0631
        \u0633\u0646\u06AF\u06CC\u0646"
    - key: mission.m05.camera.opening
      value: "\u0645\u0633\u06CC\u0631 \u062D\u0645\u0644\u0647 \xB7 \u062F\u0631\u0648\u0627\u0632\u0647
        \u2190 \u0641\u0631\u0633\u062A\u0646\u062F\u0647 \u2190 \u0628\u0627\u06CC\u06AF\u0627\u0646\u06CC"
    - key: mission.m05.camera.victory
      value: "\u0628\u0627\u06CC\u06AF\u0627\u0646\u06CC \u0628\u0627\u0632\u06CC\u0627\u0628\u06CC
        \u0634\u062F \xB7 \u0642\u0637\u0639\u0647\u0654 \u0627\u0648\u0644 \u067E\u0631\u0648\u062A\u06A9\u0644
        \u062F\u0631 \u0627\u0645\u0627\u0646 \u0627\u0633\u062A"
