  - stateId: SteelPush-brief-2
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: ef3183cbf9a84e5196963a22a5e4969d
      m_SubObjectName: CH04M02_SteelPush-c-16x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    panel20x9Reference:
      m_AssetGUID: ef3183cbf9a84e5196963a22a5e4969d
      m_SubObjectName: CH04M02_SteelPush-c-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: steel_push-brief-aria
      textKey: narrative.steel_push.brief-aria
      englishFallback: Two armored groups are confirmed. Stop their command vehicles
        before they reach the dormant Relay node. Your existing Select, Move, Attack
        and Hold controls are sufficient; I will show the route without issuing troop
        orders.
      speaker: 3
      voiceClip: {fileID: 8300000, guid: f2325041eb2e5425abad497de6531545, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
