.scn02-main-menu-content {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    -unity-font-definition: url("../../../Synty/InterfaceMilitaryCombatHUD/Fonts/Oxanium/Oxanium-Medium.ttf");
    color: rgb(242, 232, 196);
}

.scn02-main-menu-content Button {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
}

.menu-background-content,
.background-viewport,
.background-art,
.background-art-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.background-art {
    left: -1.5%;
    right: -1.5%;
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_background_command_table_no_ui.png");
    -unity-background-scale-mode: scale-and-crop;
}

.background-art-overlay {
    background-color: rgba(8, 9, 8, 0.13);
}

.header-content {
    position: absolute;
    left: 0.25%;
    right: 0.25%;
    top: 0.6%;
    height: 12.1%;
}

.header-back-plate {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_header_bar_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 110;
    -unity-slice-right: 110;
    -unity-slice-top: 52;
    -unity-slice-bottom: 52;
    -unity-slice-scale: 0.28px;
}

.header-logo-panel {
