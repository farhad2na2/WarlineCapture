    lines:
    - lineId: m04-brief-03
      textKey: narrative.m04.brief.03
      englishFallback: Rifles cover the road; the APC carries the team. Unload beside
        Laila, board the helicopter, hold the area clear for twenty seconds, then
        fly to the marked departure zone.
      speaker: 1
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
