  "auditDecisions": [
    {"category": "query-cache", "decision": "consolidated", "reason": "Two one-component caches had identical World identity, liveness, creation, and reuse behavior; only component type and access mode differed."},
    {"category": "command-queue", "decision": "retained-separate", "reason": "Queues have domain-specific payloads, ownership, consumption, failure, and overflow contracts; no shared behavior owner was found."},
    {"category": "fixed-capacity-scratch", "decision": "retained-separate", "reason": "Scratch capacities are tied to different query counts or fixed budgets and AddNoResize overflow invariants; sharing would hide capacity authority."},
    {"category": "projection-cache", "decision": "retained-separate", "reason": "Projection caches bind different UI/presentation lifecycles and invalidation keys; a shared cache would create a broad managed owner."}
  ],
