      essentialCaption: 1
    - lineId: m01-debrief.line.2
      textKey: narrative.m01.debrief.aria
      englishFallback: Recovered traffic includes a fragment of a revoked civic-relay
        credential. The source identity is unresolved.
      speaker: 3
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 4
      deadlineSeconds: 7.75
      essentialCaption: 1
