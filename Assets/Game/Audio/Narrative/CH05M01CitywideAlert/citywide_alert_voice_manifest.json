      "captionSha256": "7dfca75bb8806bb0648f6a8275b9b3ad382854450f3a46ab5eac0ffb3984b84d"
    },
    {
      "deliveryProfile": "fa-conversational-v1",
      "voiceSettings": {
        "stability": 0.5,
        "similarity_boost": 0.75
      },
      "performanceDirection": "[conversational tone]",
      "kind": "narrative",
      "id": "citywide_alert-open-02",
      "speaker": "DALIA",
      "locale": "fa-IR",
      "text": "گروه‌های خط خاکستر به خدمات محلی حمله می‌کنن و ونگارد مسیرهای اصلی رو زیر فشار گذاشته. این حمله‌ها هماهنگن. نیروها رو در هر دو جبههٔ شهری نگه دارین؛ فرستادن همه به یک نبرد، جبههٔ دیگه رو بی‌دفاع می‌ذاره.",
      "voiceId": "MK1Zvh93428YrgOQ8Obr",
      "voiceName": "Warline - Major Dalia Rahim",
      "assetPath": "Assets/Game/Audio/Narrative/CH05M01CitywideAlert/Voice/fa/citywide_alert-open-02.wav",
      "durationSeconds": 17.28,
      "sha256": "e5d0dc5efe247585f87ab209447bb0473d56d50c251b6ffcfeafd87af4068285",
      "captionSha256": "b3cced2312e3cca03b1710ffa77eec5b84cde94e075961b3c64b87613751ba32"
    },
    {
      "kind": "narrative",
      "id": "citywide_alert-open-03",
      "speaker": "SAMIRA",
      "locale": "en-US",
      "text": "The clinic must keep treating people, and the utility site must keep water and power moving. Our shelters, roads, and workers depend on both. Laila is tracking the air corridor while Dalia holds the military picture.",
