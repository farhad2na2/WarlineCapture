using System;using System.IO;using System.Linq;using System.Collections.Generic;using Newtonsoft.Json.Linq;using Unity.Entities;using Game.Components;
namespace Game.Runtime {
// Consumes only a closed, source-contract-admitted material cursor. No wire row
// balance/version/progress/result is installed as a later simulation operand.
internal sealed class MaterialWireReplay {
 readonly EntityManager em;readonly CanonicalStorageBank bank;readonly MaterialFabricationSystem core;readonly Dictionary<Entity,JObject> fabs=new Dictionary<Entity,JObject>(),mats=new Dictionary<Entity,JObject>();bool clockBound,stopped;int updates,ingresses;internal int PendingRequestAfterFabrication,PendingTickBeforeFabrication,PendingSharedBeforeMaterials,PendingSharedAfterMaterials,ComponentAssertions,BufferAssertions,TickResultsCompared,PendingEmptyThresholdDiagnostic;
 static void Need(bool x,string s){if(!x)throw new InvalidDataException("Material wire: "+s);}static bool Present(JToken x)=>x!=null&&x.Type!=JTokenType.Null;static Entity E(JToken x)=>NativeV8CallerAdapter.E(x);static float F(JToken x)=>NativeV8CallerAdapter.F(x);static uint Bits(float x)=>BitConverter.ToUInt32(BitConverter.GetBytes(x),0);static T Read<T>(JToken x)=>(T)NativeV8CallerAdapter.Decode(typeof(T),x);static T? Optional<T>(JToken x)where T:struct=>Present(x)?Read<T>(x):(T?)null;static T[] Array<T>(JToken x)=>Present(x)?((JArray)x).Select(Read<T>).ToArray():null;
 void Same<T>(T actual,JToken expected,string context)where T:struct{Need(CanonicalStorageBank.Same(actual,Read<T>(expected)),context);ComponentAssertions++;}
 void Presence<T>(Entity e,JToken expected,string context)where T:struct{Need(em.HasComponent<T>(e)==Present(expected),context+" presence");if(Present(expected))Same(em.GetComponentData<T>(e),expected,context);}
 void Buffer<T>(T[] actual,JToken expected,string context)where T:struct{Need(expected is JArray&&actual.Length==((JArray)expected).Count,context+" count");for(int i=0;i<actual.Length;i++)Same(actual[i],expected[i],context+"["+i+"]");BufferAssertions++;}
 internal MaterialWireReplay(EntityManager manager,CanonicalStorageBank canonical,JObject seed){Need(seed["kind"].Value<string>()=="initial-material-subsystem","Genuine initial material source row required");em=manager;bank=canonical;var fs=new List<MaterialFabricationSystem.FabSeed>();var ms=new List<MaterialFabricationSystem.MaterialsSeed>();foreach(JObject row in(JArray)seed["fabrication_rows"]){var e=E(row["entity"]);Need(!fabs.ContainsKey(e),"Duplicate initial fabrication owner");fabs.Add(e,(JObject)row.DeepClone());bool health=Present(row["health_bits_or_null"]);fs.Add(new MaterialFabricationSystem.FabSeed{Entity=e,Fabrication=Read<MaterialFabricationComponent>(row["fabrication_bits"]),InputTag=row["input_tag_present"].Value<bool>(),HasHealth=health,HealthCurrent=health?(int?)row["health_bits_or_null"]["Current"].Value<int>():null,Disabled=row["disabled_present"].Value<bool>(),DeathAnimation=row["death_animation_present"].Value<bool>(),CommandQueue=Optional<MaterialFabricationCommandQueueComponent>(row["command_queue_bits_or_null"]),Requests=Array<MaterialFabricationRequestComponent>(row["request_buffer_or_null"]),Results=Array<MaterialFabricationResultComponent>(row["result_buffer_or_null"])});}
 foreach(JObject row in(JArray)seed["material_rows"]){var e=E(row["entity"]);Need(!mats.ContainsKey(e),"Duplicate initial materials owner");mats.Add(e,(JObject)row.DeepClone());ms.Add(new MaterialFabricationSystem.MaterialsSeed{Entity=e,Materials=Read<FactionTacticalMaterialsComponent>(row["tactical_materials_bits"]),EconomyFaction=Present(row["faction_economy_faction_id_or_null"])?(byte?)row["faction_economy_faction_id_or_null"].Value<byte>():null,Disabled=row["disabled_present"].Value<bool>(),Telemetry=Optional<FactionMaterialFabricationTelemetryComponent>(row["fabrication_telemetry_bits_or_null"]),EventQueue=Optional<MaterialFabricationEconomyEventQueueComponent>(row["economy_event_queue_bits_or_null"]),Events=Array<MaterialFabricationEconomyEventElement>(row["economy_event_buffer_or_null"])});}
 core=new MaterialFabricationSystem(em,bank,fs.ToArray(),ms.ToArray(),true,true);AssertSnapshot(seed);}
 void AssertFabRow(JObject row){var e=E(row["entity"]);Need(fabs.ContainsKey(e),"Unknown fabrication snapshot owner");Same(em.GetComponentData<MaterialFabricationComponent>(e),row["fabrication_bits"],"Carried fabrication");Need(em.HasComponent<MaterialFabricationInputTag>(e)==row["input_tag_present"].Value<bool>(),"Retained InputTag");foreach(string k in new[]{"health_bits_or_null","disabled_present","death_animation_present"})Need(JToken.DeepEquals(fabs[e][k],row[k]),"Unmodeled operational prerequisite changed "+k);Presence<MaterialFabricationCommandQueueComponent>(e,row["command_queue_bits_or_null"],"CommandQueue");foreach(string k in new[]{"request_buffer_or_null","result_buffer_or_null"})Need(Present(row[k])==Present(fabs[e][k]),"Retained buffer presence changed");if(Present(row["request_buffer_or_null"]))Buffer(core.Requests(e),row["request_buffer_or_null"],"Requests");if(Present(row["result_buffer_or_null"]))Buffer(core.Results(e),row["result_buffer_or_null"],"Results");}
 void AssertMaterialsRow(JObject row){var e=E(row["entity"]);Need(mats.ContainsKey(e),"Unknown materials snapshot owner");Same(em.GetComponentData<FactionTacticalMaterialsComponent>(e),row["tactical_materials_bits"],"Carried tactical materials");foreach(string k in new[]{"faction_economy_faction_id_or_null","disabled_present"})Need(JToken.DeepEquals(mats[e][k],row[k]),"Unmodeled materials query prerequisite changed");Presence<FactionMaterialFabricationTelemetryComponent>(e,row["fabrication_telemetry_bits_or_null"],"Telemetry");Presence<MaterialFabricationEconomyEventQueueComponent>(e,row["economy_event_queue_bits_or_null"],"EconomyQueue");Need(Present(row["economy_event_buffer_or_null"])==Present(mats[e]["economy_event_buffer_or_null"]),"Economy buffer presence changed");if(Present(row["economy_event_buffer_or_null"]))Buffer(core.Events(e),row["economy_event_buffer_or_null"],"EconomyEvents");}
 internal void AssertSnapshot(JObject row){var fs=(JArray)row["fabrication_rows"];var ms=(JArray)row["material_rows"];Need(fs.Count==fabs.Count&&ms.Count==mats.Count,"Complete same-frontier material domains required");var fseen=new HashSet<Entity>();foreach(JObject f in fs){Need(fseen.Add(E(f["entity"])),"Duplicate material frontier fabrication");AssertFabRow(f);}var mseen=new HashSet<Entity>();foreach(JObject m in ms){Need(mseen.Add(E(m["entity"])),"Duplicate material frontier owner");AssertMaterialsRow(m);}}
 void IngressState(Entity e,JObject row,bool before){string q=before?"queue_before_assertion_or_null":"queue_after_assertion_or_null";string b=before?"requests_before_assertion_or_null":"requests_after_assertion_or_null";Presence<MaterialFabricationCommandQueueComponent>(e,row[q],"Ingress command queue");if(Present(row[b])){Need(fabs.ContainsKey(e)&&Present(fabs[e]["request_buffer_or_null"]),"Ingress native buffer outside retained domain");Buffer(core.Requests(e),row[b],"Ingress requests");}else Need(!fabs.ContainsKey(e)||!Present(fabs[e]["request_buffer_or_null"]),"Ingress request absence differs");}
 internal void Ingress(JObject before,JObject after){Need(!stopped,"Failed material wire cannot continue");try{IngressCore(before,after);}catch{stopped=true;throw;}}
 void IngressCore(JObject before,JObject after){Need(before["kind"].Value<string>()=="material-request-ingress-before"&&after["kind"].Value<string>()=="material-request-ingress-after","Complete genuine producer pair required");var e=E(before["entity"]);Need(e==E(after["entity"])&&before["ingress_id"].Value<int>()==++ingresses&&after["ingress_id"].Value<int>()==ingresses,"Ingress consecutive identity");Need(em.Exists(e)==before["entity_exists_assertion"].Value<bool>()&&em.HasComponent<MaterialFabricationComponent>(e)==before["fabrication_present_assertion"].Value<bool>(),"Ingress target existence/presence not proven in retained world");Need(before["results_presence_assertion"].Value<bool>()==(fabs.ContainsKey(e)&&Present(fabs[e]["result_buffer_or_null"])),"Ingress result buffer presence");IngressState(e,before,true);int id;bool ok=core.TryEnqueueProductionRequest(e,before["requester_faction_id"].Value<byte>(),before["production_enabled"].Value<bool>(),out id);Need(ok==after["success_assertion"].Value<bool>()&&id==after["request_id_assertion"].Value<int>(),"Original producer ID/result");IngressState(e,after,false);}
 internal void Update(JArray block){Need(!stopped,"Failed material wire cannot continue");try{UpdateCore(block);}catch{stopped=true;throw;}}
 void UpdateCore(JArray block){Need(block.Count>=3&&block[0]["kind"].Value<string>()=="material-update-before"&&block.Last["kind"].Value<string>()=="material-update-after","Complete source update bracket required");var before=block[0];var after=block.Last;Need(before["material_update_id"].Value<int>()==++updates&&after["material_update_id"].Value<int>()==updates,"Consecutive material updates");if(!clockBound){Need(before["elapsed_role"].Value<string>()=="initial-private-input","Genuine private clock input once");core.BindInitialClock(F(before["elapsed_before_bits"]),true);clockBound=true;}else Need(Bits(core.ElapsedSeconds)==before["elapsed_before_bits"].Value<uint>(),"Carried private elapsed BEFORE");
 var req=block.Where(x=>x["kind"].Value<string>()=="material-request-owner-before").ToArray();var lookup=block.Where(x=>x["kind"].Value<string>()=="material-lookup-row").ToArray();var ticks=block.Where(x=>x["kind"].Value<string>()=="material-tick-before").ToArray();var posts=block.Where(x=>x["kind"].Value<string>()=="material-tick-after").ToArray();var tickIds=new HashSet<Entity>(ticks.Select(x=>E(x["entity"])));var pendingRequestFab=new HashSet<Entity>();
 foreach(var r in req){var e=E(r["entity"]);Same(em.GetComponentData<MaterialFabricationComponent>(e),r["fabrication_assertion"],"Request owner BEFORE");Buffer(core.Requests(e),r["requests_assertion"],"Pending requests BEFORE");Buffer(core.Results(e),r["results_assertion"],"Results BEFORE");if(core.Requests(e).Length>0)pendingRequestFab.Add(e);}
 foreach(var r in lookup)Same(em.GetComponentData<FactionTacticalMaterialsComponent>(E(r["entity"])),r["tactical_materials_assertion"],"Lookup tactical materials BEFORE");var firstMaterials=new HashSet<Entity>();foreach(var r in ticks){Need(r["building_operational_assertion"].Value<bool>()==(!r["disabled_input"].Value<bool>()&&!r["death_animation_input"].Value<bool>()&&r["health_current_input"].Value<int>()>0),"Operational predicate assertion");var e=E(r["entity"]);Same(bank.ReadStorage(e),r["storage_assertion"],"Unique tick owner storage BEFORE");if(!pendingRequestFab.Contains(e))Same(em.GetComponentData<MaterialFabricationComponent>(e),r["fabrication_assertion"],"Tick owner fabrication BEFORE");else PendingTickBeforeFabrication++;if(Present(r["selected_material_entity_assertion_or_null"])&&Present(r["tactical_materials_assertion_or_null"])){var m=E(r["selected_material_entity_assertion_or_null"]);if(firstMaterials.Add(m))Same(em.GetComponentData<FactionTacticalMaterialsComponent>(m),r["tactical_materials_assertion_or_null"],"First shared material BEFORE");else PendingSharedBeforeMaterials++;}}
 var complete=block.Single(x=>x["kind"].Value<string>()=="material-requests-complete");byte simulation=complete["simulation_active"].Value<byte>();var deltas=block.Where(x=>x["kind"].Value<string>()=="material-delta-input").ToArray();Need(deltas.Length==(simulation==0?0:1),"Active delta missing/inactive read invented");float delta=simulation==0?0f:F(deltas[0]["delta_time_bits"]);bool threshold=block.Any(x=>x["kind"].Value<string>()=="material-lookup-complete");var queries=threshold?new MaterialFabricationSystem.ThresholdQueries{CompleteLookup=true,CompleteTick=true,LookupOrder=lookup.Select(x=>E(x["entity"])).ToArray(),TickOrder=ticks.Select(x=>new MaterialFabricationSystem.TickRow{Entity=E(x["entity"]),HealthCurrent=x["health_current_input"].Value<int>(),Disabled=x["disabled_input"].Value<bool>(),DeathAnimation=x["death_animation_input"].Value<bool>()}).ToArray()}:null;
 core.Step(simulation,delta,req.Select(x=>E(x["entity"])).ToArray(),true,new MaterialFabricationSystem.Ingress[0],queries);Need(Bits(core.ElapsedSeconds)==after["elapsed_after_bits"].Value<uint>(),"Original private elapsed AFTER");Need(after["lookup_reached_assertion"].Value<bool>()==threshold,"Threshold closed source assertion");var traces=core.LastTicks;if(threshold&&traces.Length==0)PendingEmptyThresholdDiagnostic++;Need(traces.Length==posts.Length&&posts.Length==ticks.Length,"Computed tick count");var lastWriters=new Dictionary<Entity,int>();for(int i=0;i<traces.Length;i++){var t=traces[i];var pre=ticks[i];var post=posts[i];Need(t.Entity==E(post["entity"])&&t.Entity==E(pre["entity"])&&t.OwnerCount==pre["material_owner_count_assertion"].Value<byte>(),"Original tick owner/count");Entity selected=Present(post["selected_material_entity_assertion_or_null"])?E(post["selected_material_entity_assertion_or_null"]):Entity.Null;Need(t.SelectedMaterials==selected&&t.TickApplied==post["tick_applied_assertion"].Value<bool>(),"Original tick branch/selection");Need(t.SelectedMaterials==(Present(pre["selected_material_entity_assertion_or_null"])?E(pre["selected_material_entity_assertion_or_null"]):Entity.Null),"Original selected owner BEFORE");if(t.TickApplied){var result=post["tick_result_assertion"];Need(Present(result)&&t.Result.CompletedCycles==result["CompletedCycles"].Value<int>()&&t.Result.MaterialsProduced==result["MaterialsProduced"].Value<int>()&&Bits(t.Result.OilConsumedBarrels)==result["OilConsumedBarrels"].Value<uint>()&&Bits(t.Result.ActiveSeconds)==result["ActiveSeconds"].Value<uint>(),"Original tick result bits");TickResultsCompared++;if(t.SelectedMaterials!=Entity.Null)lastWriters[t.SelectedMaterials]=i;}else Need(!Present(post["tick_result_assertion"]),"NoApply cannot fabricate result");Same(em.GetComponentData<MaterialFabricationComponent>(t.Entity),post["fabrication_assertion"],"Unique owner fabrication AFTER");Same(bank.ReadStorage(t.Entity),post["storage_assertion"],"Unique owner storage AFTER");}
 foreach(var r in block.Where(x=>x["kind"].Value<string>()=="material-request-owner-after")){var e=E(r["entity"]);Buffer(core.Requests(e),r["requests_assertion"],"Requests AFTER");Buffer(core.Results(e),r["results_assertion"],"Results AFTER");if(!tickIds.Contains(e))Same(em.GetComponentData<MaterialFabricationComponent>(e),r["fabrication_assertion"],"Request-only fabrication AFTER");else PendingRequestAfterFabrication++;}
 for(int i=0;i<posts.Length;i++){var post=posts[i];if(!Present(post["selected_material_entity_assertion_or_null"]))continue;var e=E(post["selected_material_entity_assertion_or_null"]);int last;if(!lastWriters.TryGetValue(e,out last)||last!=i){PendingSharedAfterMaterials++;continue;}Same(em.GetComponentData<FactionTacticalMaterialsComponent>(e),post["tactical_materials_assertion_or_null"],"Last actual material writer AFTER");Presence<FactionMaterialFabricationTelemetryComponent>(e,post["telemetry_assertion_or_null"],"Last actual telemetry writer AFTER");Presence<MaterialFabricationEconomyEventQueueComponent>(e,post["economy_event_queue_assertion_or_null"],"Last actual eventqueue writer AFTER");if(Present(post["economy_event_buffer_assertion_or_null"]))Buffer(core.Events(e),post["economy_event_buffer_assertion_or_null"],"Last actual eventbuffer writer AFTER");else Need(!Present(mats[e]["economy_event_buffer_or_null"]),"Eventbuffer disappearance");}
 }
 internal JObject Summary()=>new JObject{["material_updates"]=updates,["material_ingress"]=ingresses,["material_component_assertions"]=ComponentAssertions,["material_buffer_assertions"]=BufferAssertions,["material_tick_results_compared"]=TickResultsCompared,["pending_request_after_fabrication"]=PendingRequestAfterFabrication,["pending_tick_before_fabrication"]=PendingTickBeforeFabrication,["pending_shared_before_materials"]=PendingSharedBeforeMaterials,["pending_shared_after_materials"]=PendingSharedAfterMaterials,["pending_threshold_diagnostic_if_no_tick_rows"]=PendingEmptyThresholdDiagnostic,["inactive_delta_placeholder"]= "0 passed only on proven inactive/not-read path; never recorded as captured input"};
}
}
