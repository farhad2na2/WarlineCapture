  sequenceId: seq.ch05.m03.brief
  entryStateId: NetworkCollapse-brief-0
  defaultSkipDestinationId: NetworkCollapse-brief-complete
  states:
  - stateId: NetworkCollapse-brief-0
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: 56ba14ba6a644ce89bfdb1a4b4f68ffd
      m_SubObjectName: CH05M03_NetworkCollapse-a-16x9
      m_SubObjectType: 
