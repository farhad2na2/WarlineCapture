    routeRole: 0
    completionPayloadId: 
    evidenceIds: []
    missionContextFlags: []
  - stateId: CitywideAlert-open-3
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: 474d0cd9d99cb45309a834db1ebd90e3
      m_SubObjectName: CH05M01_CitywideAlert_Opening-d-16x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    panel20x9Reference:
      m_AssetGUID: 474d0cd9d99cb45309a834db1ebd90e3
      m_SubObjectName: CH05M01_CitywideAlert_Opening-d-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: citywide_alert-open-04
      textKey: narrative.citywide_alert.open-04
      englishFallback: Confirmed threats are facts. Their likely next moves are predictions.
        My suggested responses are recommendations. I will keep those separate in
        the command picture, and no recommendation becomes an order without your
        approval.
      speaker: 3
      voiceClip: {fileID: 8300000, guid: a8c917cda4a7144feab3bea1ee22af9b, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 16.5
      essentialCaption: 1
    continueStateId: CitywideAlert-open-4
    skipStateId: CitywideAlert-open-complete
    reducedMotionSupported: 1
    durationSeconds: 16.5
    motionPreset: 0
    locationTitleKey: 
    locationTitleFallback: 
    locationSubtitleKey: 
    locationSubtitleFallback: 
    musicCue: 0
    ambienceCue: 0
