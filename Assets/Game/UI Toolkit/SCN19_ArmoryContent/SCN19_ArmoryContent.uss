}

.move-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_move_runner.png");
}

.attack-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_attack_reticle.png");
}

.hold-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_hold_shield.png");
}

.patrol-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_patrol_chevrons.png");
}

.ability-label {
