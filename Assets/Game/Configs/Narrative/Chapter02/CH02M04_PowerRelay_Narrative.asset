      m_EditorAssetChanged: 0
    lines:
    - lineId: power_relay-brief-03
      textKey: narrative.power_relay.brief.03
      englishFallback: Do not use the shortest lane. The shelter at its end is full,
        but the school on the longer service road is open. Take the protected route,
        then keep the engineers supplied while they restore power.
      speaker: 2
      voiceClip: {fileID: 8300000, guid: 6c26b5509618f4a189bff8eb428b3247, type: 3}
