        "similarity_boost": 0.75
      },
      "performanceDirection": "[conversational tone]",
      "kind": "narrative",
      "id": "grounded_signal-brief-03",
      "speaker": "YUSUF",
      "locale": "fa-IR",
      "text": "تجهیزات کنترل رو می‌خوام، نه آوارش رو. وقتی رلهٔ نظامی از کار افتاد، ما رو به محل بازیابی برسون. همون‌جا دستگاه رو بررسی و تحویل می‌گیریم.",
      "voiceId": "cjVigY5qzO86Huf0OWal",
      "voiceName": "Eric - Smooth, Trustworthy (Chief Yusuf Darzi)",
      "assetPath": "Assets/Game/Audio/Narrative/CH04M04GroundedSignal/Voice/fa/grounded_signal-brief-03.wav",
      "durationSeconds": 9.76,
      "sha256": "a4b8285cfb505db6d1d767b06238c4f6b186cdfd8f1eb18ee1381e0e9f374185",
