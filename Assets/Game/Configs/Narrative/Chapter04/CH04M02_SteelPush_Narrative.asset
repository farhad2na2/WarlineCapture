      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: steel_push-debrief-samira
      textKey: narrative.steel_push.debrief-samira
      englishFallback: The reserve is operating and the civilian allocation is intact.
        Hospital generators and water pumps can keep running. Holding the site mattered
        as much as breaking the column.
      speaker: 2
      voiceClip: {fileID: 8300000, guid: d970f090ec26e4e0ebee3472ef254f51, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
