<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="SCN19_ArmoryContent.uss" />
    <ui:Button name="ItemView" class="armory-item-view item-card" text="">
        <ui:VisualElement name="Frame" class="item-frame" />
        <ui:VisualElement name="Rarity" class="item-rarity rarity-gold" />
        <ui:VisualElement name="Art" class="item-art rifle-art" />
        <ui:Label name="Title" class="item-title" text="ITEM NAME" />
        <ui:Label name="Subtitle" class="item-subtitle" text="INFANTRY SQUAD" />
        <ui:VisualElement name="State" class="item-state-row">
            <ui:Label name="StateLabel" class="item-state-label owned-state" text="OWNED" />
            <ui:VisualElement name="Badge" class="owned-badge" />
        </ui:VisualElement>
        <ui:VisualElement name="Stats" class="item-stats">
            <ui:VisualElement name="Stat_Primary" class="item-stat-row">
                <ui:Label name="Stat_Primary_Label" class="item-stat-label" text="POWER" />
                <ui:Label name="Stat_Primary_Value" class="item-stat-value" text="85" />
            </ui:VisualElement>
            <ui:VisualElement name="Stat_Secondary" class="item-stat-row">
                <ui:Label name="Stat_Secondary_Label" class="item-stat-label" text="ARMOR" />
                <ui:Label name="Stat_Secondary_Value" class="item-stat-value" text="25" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Progress" class="item-progress">
            <ui:VisualElement name="Track" class="item-progress-track">
                <ui:VisualElement name="Fill" class="item-progress-fill" />
            </ui:VisualElement>
            <ui:Label name="Level" class="item-level" text="LVL 12" />
            <ui:Label name="Type" class="item-type" text="INFANTRY" />
        </ui:VisualElement>
        <ui:VisualElement name="ActionAvailability" class="item-action-availability available">
            <ui:VisualElement name="ActionIcon" class="item-action-icon" />
            <ui:Label name="ActionLabel" class="item-action-label" text="AVAILABLE" />
        </ui:VisualElement>
    </ui:Button>
</ui:UXML>
