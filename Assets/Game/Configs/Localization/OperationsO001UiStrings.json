      ]
    },
    {
      "key": "operations.o001.recovery_interrupted",
      "source": "Recovery stopped. Clear nearby enemies, then return and recover the evidence.",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "بازیابی متوقف شد. دشمنان نزدیک را از بین ببرید، سپس برگردید و مدارک را بازیابی کنید."
        }
      ]
    },
    {
      "key": "operations.o001.carrier_lost",
      "source": "The carrier is down. Recover the dropped evidence before extracting.",
