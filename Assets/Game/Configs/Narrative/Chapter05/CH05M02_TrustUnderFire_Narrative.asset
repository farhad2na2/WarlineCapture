  - stateId: TrustUnderFire-debrief-1
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: 8e2ea2d6a04c4599b85c6616535bce39
