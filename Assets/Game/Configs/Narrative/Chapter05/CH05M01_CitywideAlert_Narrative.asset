    missionContextFlags: []
  - stateId: CitywideAlert-open-2
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: 474d0cd9d99cb45309a834db1ebd90e3
      m_SubObjectName: CH05M01_CitywideAlert_Opening-c-16x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    panel20x9Reference:
      m_AssetGUID: 474d0cd9d99cb45309a834db1ebd90e3
      m_SubObjectName: CH05M01_CitywideAlert_Opening-c-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: citywide_alert-open-03
      textKey: narrative.citywide_alert.open-03
      englishFallback: The clinic must keep treating people, and the utility site
        must keep water and power moving. Our shelters, roads, and workers depend
        on both. Laila is tracking the air corridor while Dalia holds the military
        picture.
      speaker: 2
      voiceClip: {fileID: 8300000, guid: 62f1cf84d23314c99a4719b34ee05cad, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 17.78
      essentialCaption: 1
    continueStateId: CitywideAlert-open-3
    skipStateId: CitywideAlert-open-complete
    reducedMotionSupported: 1
    durationSeconds: 17.78
    motionPreset: 0
    locationTitleKey: 
    locationTitleFallback: 
    locationSubtitleKey: 
    locationSubtitleFallback: 
    musicCue: 0
    ambienceCue: 0
    vehicleCue: 0
