      "voiceName": "Sarah (Captain Laila Nasser)",
      "assetPath": "Assets/Game/Audio/Narrative/CH04M04GroundedSignal/Voice/en/grounded_signal-brief-01.wav",
      "durationSeconds": 11.2,
      "sha256": "8ba5c6113a870addc57060678dc8cfb2a4d8cec6f0b3040981b56dca6b9cdddf",
      "captionSha256": "981f7532628edbe40ca2179cea55b38f0e871ecdd94f3ac5a8a878033ceb3660"
    },
    {
      "deliveryProfile": "fa-conversational-v1",
