}

.tab-depot-icon {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_resource_crate_icon.png");
}

.tab-officers-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_units_group.png");
}

.bottom-tab-label {
    position: absolute;
    left: 28%;
    right: 5%;
