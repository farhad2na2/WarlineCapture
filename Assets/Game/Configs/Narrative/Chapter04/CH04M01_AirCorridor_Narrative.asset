    lines:
    - lineId: air_corridor-brief-aria
      textKey: narrative.air_corridor.brief-aria
      englishFallback: Confirmed hostile aircraft approach from the west, followed
        by a northern strike. Keep the launchers near the radar. They acquire and
        fire automatically; use normal movement to manage their coverage.
      speaker: 3
      voiceClip: {fileID: 8300000, guid: 4e6477a948160489bbe8acf93a800dca, type: 3}
