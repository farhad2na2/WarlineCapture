      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: gridlock-debrief-03
      textKey: narrative.gridlock.debrief.03
      englishFallback: The road is open. Next we need to keep supplies moving, and
        Fuel is running short. Return to the campaign map to review the operation.
      speaker: 1
      voiceClip: {fileID: 8300000, guid: 0d7eab11d918f4bbf9b391af109cc0b3, type: 3}
      femaleVoiceClip: {fileID: 0}
