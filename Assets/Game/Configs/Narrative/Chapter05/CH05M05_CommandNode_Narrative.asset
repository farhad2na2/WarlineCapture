      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: command_node-brief-04
      textKey: narrative.command_node.brief-04
      englishFallback: Karim and I will coordinate relief access beyond the complex.
        The approach here remains with your ground teams; do not sacrifice the services
        to shorten the fight.
      speaker: 5
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 11.642858
      essentialCaption: 1
