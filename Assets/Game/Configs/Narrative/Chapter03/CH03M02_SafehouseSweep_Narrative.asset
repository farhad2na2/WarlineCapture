    lines:
    - lineId: safehouse_sweep-brief-01
      textKey: narrative.safehouse_sweep.brief.01
      englishFallback: The recovered route confirms one weapons node in this residential
        block. The reinforced building is linked to the armed cell. The family home
        beside it is not.
      speaker: 3
      voiceClip: {fileID: 8300000, guid: 963c330f04b914f47ba4b2e12a8074ce, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
