  - stateId: CitywideAlert-open-1
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: 474d0cd9d99cb45309a834db1ebd90e3
      m_SubObjectName: CH05M01_CitywideAlert_Opening-b-16x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    panel20x9Reference:
      m_AssetGUID: 474d0cd9d99cb45309a834db1ebd90e3
      m_SubObjectName: CH05M01_CitywideAlert_Opening-b-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: citywide_alert-open-02
      textKey: narrative.citywide_alert.open-02
      englishFallback: Ash Line cells are striking local services while Vanguard
        pushes the main corridors. These attacks are coordinated. Keep forces on
        both civic fronts; sending everyone to one fight leaves the other exposed.
      speaker: 1
      voiceClip: {fileID: 8300000, guid: e6a652f4184464b7d9c9dbb71c16beba, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 17.78
      essentialCaption: 1
    continueStateId: CitywideAlert-open-2
    skipStateId: CitywideAlert-open-complete
    reducedMotionSupported: 1
    durationSeconds: 17.78
    motionPreset: 0
    locationTitleKey: 
    locationTitleFallback: 
    locationSubtitleKey: 
    locationSubtitleFallback: 
    musicCue: 0
    ambienceCue: 0
