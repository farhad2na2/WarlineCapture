    lines:
    - lineId: false_front-brief-01
      textKey: narrative.false_front.brief.01
      englishFallback: Three evacuation vehicles are gathering at the east road.
        A sealed authority report says the threat is at the old depot, but my people
        have seen no fighters there.
      speaker: 2
      voiceClip: {fileID: 8300000, guid: 15f26207f2419422f9a2ad256ea6f3ca, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
