.pop06-settings-popup {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    -unity-font-definition: url("../../../Synty/InterfaceMilitaryCombatHUD/Fonts/Oxanium/Oxanium-Medium.ttf");
    color: rgb(239, 232, 202);
    background-color: rgba(0, 0, 0, 0);
}

.pop06-settings-popup Button {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
}

.settings-backdrop-scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.64);
}

.settings-popup-frame {
    position: absolute;
    left: 29%;
    right: 29%;
    top: 18%;
    bottom: 16%;
    transform-origin: 50% 50%;
}

.settings-popup-chrome {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_panel_frame_large.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 96;
    -unity-slice-right: 96;
    -unity-slice-top: 64;
    -unity-slice-bottom: 64;
}

.settings-header-panel {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 7%;
    height: 19%;
}

.settings-header-icon {
    position: absolute;
    left: 0;
    top: 8%;
    width: 12%;
    height: 80%;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_icon_settings_gear.png");
    -unity-background-scale-mode: scale-to-fit;
}

.settings-title {
    position: absolute;
    left: 15%;
    right: 28%;
    top: 0;
    height: 55%;
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(247, 217, 99);
    white-space: nowrap;
}

.settings-subtitle {
    position: absolute;
    left: 15.4%;
    right: 28%;
    bottom: 0;
    height: 37%;
    font-size: 18px;
    -unity-text-align: middle-left;
    color: rgb(229, 221, 190);
    white-space: nowrap;
}

.settings-close-action {
    position: absolute;
    right: 0;
    top: 10%;
    width: 24%;
    height: 70%;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_rect_button_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 56;
    -unity-slice-right: 56;
    -unity-slice-top: 34;
    -unity-slice-bottom: 34;
}

.settings-close-label {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 0;
    bottom: 0;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(239, 232, 202);
}

.settings-grid {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 31%;
    bottom: 21%;
}

.settings-row {
    position: relative;
    height: 21%;
    margin-bottom: 3.8%;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_bottom_tab_default_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 28;
    -unity-slice-bottom: 28;
}

.settings-row-label {
    position: absolute;
    left: 6%;
    top: 0;
    bottom: 0;
    width: 48%;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(229, 221, 190);
    white-space: nowrap;
}

.settings-row-value {
    position: absolute;
    right: 6%;
    top: 0;
    bottom: 0;
    width: 36%;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: rgb(169, 205, 55);
    white-space: nowrap;
}

.settings-footer-panel {
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: 8%;
    height: 9%;
    background-color: rgba(6, 11, 11, 0.62);
}

.settings-footer-text {
    position: absolute;
    left: 4%;
    right: 4%;
    top: 0;
    bottom: 0;
    font-size: 14px;
    -unity-text-align: middle-left;
    color: rgb(177, 169, 145);
    white-space: nowrap;
}
