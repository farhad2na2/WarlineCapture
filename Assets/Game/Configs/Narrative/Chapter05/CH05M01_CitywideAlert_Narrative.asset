  - stateId: CitywideAlert-open-5
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: 474d0cd9d99cb45309a834db1ebd90e3
