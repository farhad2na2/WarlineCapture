  sequenceId: seq.ch04.m05.brief
  entryStateId: ArmorBreak-brief-0
  defaultSkipDestinationId: ArmorBreak-brief-complete
  states:
  - stateId: ArmorBreak-brief-0
    kind: 0
    panel16x9: {fileID: 0}
