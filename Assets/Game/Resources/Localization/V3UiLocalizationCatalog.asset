        \u062D\u0627\u0644 \u0633\u0627\u062E\u062A \u0627\u0633\u062A"
    - key: tutorial.m02.materials.body
      value: "\u0628\u0627 \u0635\u062F \u0648 \u0628\u06CC\u0633\u062A \u0648\u0627\u062D\u062F
        \u0645\u0635\u0627\u0644\u062D \u0634\u0631\u0648\u0639 \u06A9\u0631\u062F\u06CC.
        \u0633\u0631\u0628\u0627\u0632\u062E\u0627\u0646\u0647 \u0646\u0648\u062F
        \u062A\u0627 \u0645\u0635\u0631\u0641 \u06A9\u0631\u062F\u061B \u0633\u06CC
        \u062A\u0627 \u0645\u0648\u0646\u062F\u0647. \u0628\u06CC\u0633\u062A \u062A\u0627\u0634
        \u0631\u0648 \u0628\u0631\u0627\u06CC \u0622\u0645\u0648\u0632\u0634 \u06AF\u0631\u0648\u0647
        \u062A\u0641\u0646\u06AF\u062F\u0627\u0631 \u0646\u06AF\u0647 \u062F\u0627\u0631."
    - key: tutorial.m02.materials.title
      value: "\u0645\u0635\u0627\u0644\u062D \u0631\u0648 \u0645\u062F\u06CC\u0631\u06CC\u062A
        \u06A9\u0646"
    - key: tutorial.m02.training_wait.body
      value: "\u0622\u0645\u0648\u0632\u0634 \u0634\u0631\u0648\u0639 \u0634\u062F\u0647.
        \u0635\u0628\u0631 \u06A9\u0646 \u06AF\u0631\u0648\u0647 \u062A\u0641\u0646\u06AF\u062F\u0627\u0631
        \u0622\u0645\u0627\u062F\u0647 \u0628\u0634\u0647\u061B \u0644\u0627\u0632\u0645
        \u0646\u06CC\u0633\u062A \u0686\u06CC\u0632\u06CC \u0628\u0632\u0646\u06CC.
        \u0648\u0642\u062A\u06CC \u0622\u0645\u0627\u062F\u0647 \u0634\u062F\u0646\u060C
        \u0645\u0623\u0645\u0648\u0631\u06CC\u062A \u062E\u0648\u062F\u0634 \u0627\u062F\u0627\u0645\u0647
        \u067E\u06CC\u062F\u0627 \u0645\u06CC\u200C\u06A9\u0646\u0647."
