    - key: mission.m03.action.wait
      value: "\u062F\u0631 \u062D\u0627\u0644 \u062F\u0641\u0627\u0639\u2026"
    - key: mission.m03.action.warning
      value: "\u062E\u0648\u0627\u0646\u062F\u0646 \u0647\u0634\u062F\u0627\u0631"
    - key: mission.m03.build.choose_one
      value: "\u0641\u0642\u0637 \u06CC\u06A9 \u0633\u0627\u0632\u0647\u0654 \u062F\u0641\u0627\u0639\u06CC
        \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646: \u0645\u0627\u0646\u0639
        \u062F\u0631 \u0639\u0631\u0636 \u062C\u0627\u062F\u0647\u060C \u06CC\u0627
        \u0628\u0631\u062C \u0646\u06AF\u0647\u0628\u0627\u0646\u06CC \u06A9\u0646\u0627\u0631
        \u062C\u0627\u062F\u0647."
    - key: mission.m03.camera.opening
      value: "\u0645\u0631\u0648\u0631 \u0645\u0623\u0645\u0648\u0631\u06CC\u062A\n\u062F\u0648\u0631\u0628\u06CC\u0646
        \u0645\u062F\u0627\u0641\u0639\u200C\u0647\u0627 \u0648 \u0645\u0633\u06CC\u0631
        \u06A9\u0627\u0631\u0648\u0627\u0646 \u0631\u0648 \u0646\u0634\u0648\u0646\u062A
        \u0645\u06CC\u200C\u062F\u0647. \u0628\u0639\u062F\u0634 \u0622\u0645\u0648\u0632\u0634
        \u0622\u0631\u06CC\u0627 \u0634\u0631\u0648\u0639 \u0645\u06CC\u200C\u0634\u0647."
    - key: mission.m03.camera.return
      value: "\u0628\u0627\u0632\u06AF\u0634\u062A \u062F\u0648\u0631\u0628\u06CC\u0646"
    - key: mission.m03.camera.skip
      value: "\u0628\u0627\u0632\u06AF\u0634\u062A \u0628\u0647 \u0646\u0645\u0627\u06CC
        \u0641\u0631\u0645\u0627\u0646\u062F\u0647\u06CC"
    - key: mission.m03.camera.victory
      value: "\u067E\u0627\u0633\u06AF\u0627\u0647 \u0627\u0645\u0646 \u0634\u062F\n\u0647\u0631
        \u062F\u0648 \u0628\u062E\u0634 \u06A9\u0627\u0631\u0648\u0627\u0646 \u0645\u062A\u0648\u0642\u0641
        \u0634\u062F\u0646\u062F. \u0645\u062F\u0627\u0641\u0639\u0627\u0646 \u067E\u06CC\u0631\u0648\u0632
        \u0634\u062F\u0646\u062F."
    - key: mission.m03.casualties
      value: "\u062A\u0644\u0641\u0627\u062A \u06AF\u0631\u0648\u0647: {0} \xB7 \u0627\u0632
        \u0633\u0631\u0628\u0627\u0632\u062E\u0627\u0646\u0647 \u0646\u06CC\u0631\u0648\u06CC
        \u06A9\u0645\u06A9\u06CC \u0628\u0633\u0627\u0632"
    - key: mission.m03.clarity.brief
      value: "\u0647\u062F\u0641\u062A \u0627\u06CC\u0646\u0647 \u06A9\u0647 \u0647\u0631
        \u062F\u0648 \u06A9\u0627\u0631\u0648\u0627\u0646 \u0631\u0648 \u0642\u0628\u0644
        \u0627\u0632 \u0631\u0633\u06CC\u062F\u0646 \u0628\u0647 \u067E\u0627\u0633\u06AF\u0627\u0647
        \u0645\u062A\u0648\u0642\u0641 \u06A9\u0646\u06CC \u0648 \u067E\u0627\u0633\u06AF\u0627\u0647
        \u0631\u0648 \u0633\u0627\u0644\u0645 \u0646\u06AF\u0647 \u062F\u0627\u0631\u06CC.
        \u0627\u0648\u0644 \u062A\u0641\u0646\u06AF\u062F\u0627\u0631\u0647\u0627
        \u0631\u0648 \u0622\u0645\u0627\u062F\u0647 \u06A9\u0646\u061B \u06A9\u0627\u0631\u0648\u0627\u0646
        \u062A\u0627 \u067E\u0627\u06CC\u0627\u0646 \u0622\u0645\u0648\u0632\u0634
        \u0645\u0646\u062A\u0638\u0631 \u0645\u06CC\u200C\u0645\u0648\u0646\u0647.
        \u0647\u0634\u062F\u0627\u0631 \u0631\u0648 \u0628\u062E\u0648\u0646\u060C
        \u0628\u0639\u062F \xAB\u0627\u062F\u0627\u0645\u0647\xBB \u0631\u0648 \u0628\u0632\u0646."
    - key: mission.m03.clarity.engage
      value: "\u062E\u0648\u062F\u0631\u0648\u0647\u0627\u06CC \u062F\u0634\u0645\u0646
        \u062F\u0627\u0631\u0646 \u0646\u0632\u062F\u06CC\u06A9 \u0645\u06CC\u200C\u0634\u0646.
        \u062A\u0641\u0646\u06AF\u062F\u0627\u0631\u0647\u0627 \u0631\u0648 \u06A9\u0646\u0627\u0631
        \u062D\u0644\u0642\u0647\u0654 \u0632\u0631\u062F \u0631\u0648\u06CC \xAB\u062D\u0641\u0638\xBB
        \u0646\u06AF\u0647 \u062F\u0627\u0631 \u062A\u0627 \u0648\u0642\u062A\u06CC
        \u062F\u0634\u0645\u0646 \u062A\u0648\u06CC \u0628\u0631\u062F \u0627\u0648\u0645\u062F\u060C
        \u0634\u0644\u06CC\u06A9 \u06A9\u0646\u0646. \u0647\u0645\u0647\u0654 \u062E\u0648\u062F\u0631\u0648\u0647\u0627
        \u0631\u0648 \u0642\u0628\u0644 \u0627\u0632 \u067E\u0627\u0633\u06AF\u0627\u0647
        \u0645\u062A\u0648\u0642\u0641 \u06A9\u0646. \u0627\u0633\u06A9\u0646 \u062F\u0648\u0628\u0627\u0631\u0647
        \u0644\u0627\u0632\u0645 \u0646\u06CC\u0633\u062A."
    - key: mission.m03.clarity.hold
      value: "\u062D\u0627\u0644\u0627 \xAB\u062D\u0641\u0638\xBB \u0631\u0648 \u0628\u0632\u0646.
        \u062A\u0641\u0646\u06AF\u062F\u0627\u0631\u0647\u0627 \u0628\u0647 \u062E\u0648\u062F\u0631\u0648\u0647\u0627\u06CC\u06CC
        \u06A9\u0647 \u062A\u0648\u06CC \u0628\u0631\u062F\u0634\u0648\u0646 \u0628\u06CC\u0627\u0646
        \u0634\u0644\u06CC\u06A9 \u0645\u06CC\u200C\u06A9\u0646\u0646\u060C \u0648\u0644\u06CC
        \u062F\u0646\u0628\u0627\u0644\u0634\u0648\u0646 \u0646\u0645\u06CC\u200C\u0631\u0646.
        \u0645\u0633\u06CC\u0631 \u067E\u0627\u0633\u06AF\u0627\u0647 \u0631\u0648
        \u0646\u06AF\u0647 \u062F\u0627\u0631."
    - key: mission.m03.clarity.main
      value: "\u06A9\u0627\u0631\u0648\u0627\u0646 \u0628\u0627\u0642\u06CC\u200C\u0645\u0627\u0646\u062F\u0647
        \u0631\u0648 \u0645\u062A\u0648\u0642\u0641 \u06A9\u0646"
    - key: mission.m03.clarity.move
      value: "\xAB\u062D\u0631\u06A9\u062A\xBB \u0631\u0648 \u0628\u0632\u0646\u060C
        \u0628\u0639\u062F \u0645\u062D\u0644 \u0645\u0634\u062E\u0635\u200C\u0634\u062F\u0647
        \u06A9\u0646\u0627\u0631 \u062C\u0627\u062F\u0647 \u0631\u0648 \u0644\u0645\u0633
        \u06A9\u0646. \u062A\u0641\u0646\u06AF\u062F\u0627\u0631\u0647\u0627 \u0628\u0627\u06CC\u062F
        \u0645\u0633\u06CC\u0631 \u06A9\u0627\u0631\u0648\u0627\u0646 \u0631\u0648
        \u067E\u0648\u0634\u0634 \u0628\u062F\u0646\u061B \u062A\u0648\u06CC \u0633\u0631\u0628\u0627\u0632\u062E\u0627\u0646\u0647
        \u0645\u0646\u062A\u0638\u0631 \u0646\u0645\u0648\u0646\u0646."
    - key: mission.m03.clarity.moving
      value: "\u062A\u0641\u0646\u06AF\u062F\u0627\u0631\u0647\u0627 \u062F\u0627\u0631\u0646
        \u0628\u0647 \u0645\u0648\u0636\u0639 \u062F\u0641\u0627\u0639\u06CC \u0645\u06CC\u200C\u0631\u0646.
        \u0635\u0628\u0631 \u06A9\u0646 \u0628\u0631\u0633\u0646\u060C \u0628\u0639\u062F
        \xAB\u062D\u0641\u0638\xBB \u0631\u0648 \u0628\u0632\u0646. \u062D\u0644\u0642\u0647\u0654
        \u0632\u0631\u062F \u0645\u0642\u0635\u062F \u0631\u0648 \u0646\u0634\u0648\u0646
        \u0645\u06CC\u200C\u062F\u0647. \u0644\u0627\u0632\u0645 \u0646\u06CC\u0633\u062A
        \u0645\u0646\u062A\u0638\u0631 \u0622\u0645\u0627\u062F\u0647\u200C\u0634\u062F\u0646
        \u0627\u0633\u06A9\u0646 \u0628\u0645\u0648\u0646\u06CC."
    - key: mission.m03.clarity.prepare
      value: "\u0627\u0648\u0644 \u06A9\u0646\u0627\u0631 \u062C\u0627\u062F\u0647\u0654
        \u0645\u0634\u062E\u0635\u200C\u0634\u062F\u0647 \u062F\u0641\u0627\u0639\u062A
        \u0631\u0648 \u0622\u0645\u0627\u062F\u0647 \u06A9\u0646. \xAB\u0633\u0627\u062E\u062A\xBB
        \u0631\u0648 \u0628\u0632\u0646 \u062A\u0627 \u06AF\u0632\u06CC\u0646\u0647\u200C\u0647\u0627
        \u0631\u0648 \u0628\u0628\u06CC\u0646\u06CC. \u0641\u0642\u0637 \u06CC\u0647
        \u0628\u0631\u062C \u06CC\u0627 \u0645\u0627\u0646\u0639 \u062C\u0627\u062F\u0647
        \u06A9\u0627\u0641\u06CC\u0647\u061B \u0645\u06CC\u200C\u062A\u0648\u0646\u06CC
        \u0627\u0632 \u0633\u0627\u062E\u062A \u0647\u0645 \u0628\u06AF\u0630\u0631\u06CC.
        \u0644\u0627\u0632\u0645 \u0646\u06CC\u0633\u062A \u0647\u0631 \u0633\u0647
        \u0633\u0627\u0632\u0647 \u0631\u0648 \u0628\u0633\u0627\u0632\u06CC."
    - key: mission.m03.clarity.radar
      value: "\u0627\u062E\u062A\u06CC\u0627\u0631\u06CC: \xAB\u0627\u0633\u06A9\u0646\xBB
        \u0631\u0648 \u0628\u0632\u0646 \u062A\u0627 \u0645\u062D\u062F\u0648\u062F\u0647\u0654
        \u062E\u0648\u062F\u0631\u0648\u06CC \u0631\u0627\u062F\u0627\u0631 \u0628\u0631\u0631\u0633\u06CC
        \u0628\u0634\u0647. \u0627\u0633\u06A9\u0646 \u062F\u0634\u0645\u0646 \u0646\u0632\u062F\u06CC\u06A9
        \u0631\u0648 \u067E\u06CC\u062F\u0627 \u0645\u06CC\u200C\u06A9\u0646\u0647\u061B
        \u062D\u0645\u0644\u0647 \u0646\u0645\u06CC\u200C\u06A9\u0646\u0647. \u062F\u0648
        \u0646\u0648\u0628\u062A \u062F\u0627\u0631\u06CC\u060C \u0628\u0627 \u0641\u0627\u0635\u0644\u0647\u0654
        \u06F6\u06F0 \u062B\u0627\u0646\u06CC\u0647. \u0645\u06CC\u200C\u062A\u0648\u0646\u06CC
        \u0627\u06CC\u0646 \u062F\u0631\u0633 \u0631\u0648 \u0631\u062F \u06A9\u0646\u06CC
        \u0648 \u0628\u062F\u0648\u0646 \u0627\u0633\u06A9\u0646 \u062F\u0641\u0627\u0639
        \u06A9\u0646\u06CC."
    - key: mission.m03.clarity.select
      value: "\xAB\u0627\u0646\u062A\u062E\u0627\u0628 \u0645\u062F\u0627\u0641\u0639\u0627\u0646\xBB
        \u0631\u0648 \u062A\u0648\u06CC \u067E\u0646\u0644 \u0622\u0631\u06CC\u0627
        \u0628\u0632\u0646. \u0628\u0627\u06CC\u062F \u0647\u0631 \u062F\u0648 \u06A9\u0627\u0631\u0648\u0627\u0646
        \u0631\u0648 \u0642\u0628\u0644 \u0627\u0632 \u0631\u0633\u06CC\u062F\u0646
        \u0628\u0647 \u067E\u0627\u0633\u06AF\u0627\u0647 \u0645\u062A\u0648\u0642\u0641
        \u06A9\u0646\u06CC. \u0645\u0646\u062A\u0638\u0631 \u0622\u0645\u0627\u062F\u0647\u200C\u0634\u062F\u0646
        \u0627\u0633\u06A9\u0646 \u0646\u0645\u0648\u0646\u061B \u062F\u0641\u0627\u0639
        \u0631\u0648 \u0627\u062F\u0627\u0645\u0647 \u0628\u062F\u0647."
    - key: mission.m03.clarity.vanguard
      value: "\u06A9\u0627\u0631\u0648\u0627\u0646 \u0627\u0648\u0644 \u0631\u0648
        \u0645\u062A\u0648\u0642\u0641 \u06A9\u0646"
    - key: mission.m03.clarity.wait
      value: "\u062F\u0641\u0627\u0639 \u0622\u0645\u0627\u062F\u0647\u200C\u0633\u062A.
        \u062A\u0641\u0646\u06AF\u062F\u0627\u0631\u0647\u0627 \u0631\u0648 \u0647\u0645\u06CC\u0646\u200C\u062C\u0627
        \u0631\u0648\u06CC \xAB\u062D\u0641\u0638\xBB \u0646\u06AF\u0647 \u062F\u0627\u0631
        \u0648 \u0645\u0646\u062A\u0638\u0631 \u06A9\u0627\u0631\u0648\u0627\u0646
        \u0628\u0627\u0634\u061B \u0644\u0627\u0632\u0645 \u0646\u06CC\u0633\u062A
        \u062F\u06A9\u0645\u0647\u0654 \u062F\u06CC\u06AF\u0647\u200C\u0627\u06CC
        \u0628\u0632\u0646\u06CC. \u062D\u0644\u0642\u0647\u0654 \u0632\u0631\u062F
        \u0645\u0633\u06CC\u0631 \u062F\u0641\u0627\u0639 \u0631\u0648 \u0646\u0634\u0648\u0646
        \u0645\u06CC\u200C\u062F\u0647. \u0632\u0645\u0627\u0646 \u0647\u0634\u062F\u0627\u0631\u060C
        \u062A\u062E\u0645\u06CC\u0646 \u0631\u0633\u06CC\u062F\u0646 \u062F\u0634\u0645\u0646\u0647."
    - key: mission.m03.class.Unit_Chr_Bombsuit_Male_01
      value: "\u0645\u062A\u062E\u0635\u0635 \u062E\u0646\u062B\u06CC\u200C\u0633\u0627\u0632\u06CC
        \u0628\u0645\u0628"
    - key: mission.m03.class.Unit_Chr_Civilian_Female_01
      value: "\u0632\u0646 \u063A\u06CC\u0631\u0646\u0638\u0627\u0645\u06CC \u06F1"
    - key: mission.m03.class.Unit_Chr_Civilian_Female_02
      value: "\u0632\u0646 \u063A\u06CC\u0631\u0646\u0638\u0627\u0645\u06CC \u06F2"
    - key: mission.m03.class.Unit_Chr_Civilian_Male_01
      value: "\u0645\u0631\u062F \u063A\u06CC\u0631\u0646\u0638\u0627\u0645\u06CC
        \u06F1"
    - key: mission.m03.class.Unit_Chr_Civilian_Male_02
      value: "\u0645\u0631\u062F \u063A\u06CC\u0631\u0646\u0638\u0627\u0645\u06CC
        \u06F2"
    - key: mission.m03.class.Unit_Chr_Contractor_Female_01
      value: "\u0646\u06CC\u0631\u0648\u06CC \u0642\u0631\u0627\u0631\u062F\u0627\u062F\u06CC
        \u0632\u0646 \u06F1"
    - key: mission.m03.class.Unit_Chr_Contractor_Male_01
      value: "\u0646\u06CC\u0631\u0648\u06CC \u0642\u0631\u0627\u0631\u062F\u0627\u062F\u06CC
        \u0645\u0631\u062F \u06F1"
    - key: mission.m03.class.Unit_Chr_Contractor_Male_02
      value: "\u0646\u06CC\u0631\u0648\u06CC \u0642\u0631\u0627\u0631\u062F\u0627\u062F\u06CC
        \u0645\u0631\u062F \u06F2"
    - key: mission.m03.class.Unit_Chr_Ghillie_Male_01
      value: "\u0631\u0627\u06A9\u062A\u200C\u0627\u0646\u062F\u0627\u0632 \u0627\u0633\u062A\u062A\u0627\u0631\u06CC"
    - key: mission.m03.class.Unit_Chr_Insurgent_Female_01
      value: "\u062A\u0641\u0646\u06AF\u062F\u0627\u0631 \u0634\u0648\u0631\u0634\u06CC
        \u0632\u0646 \u06F1"
    - key: mission.m03.class.Unit_Chr_Insurgent_Female_02
      value: "\u0634\u0648\u0631\u0634\u06CC \u062A\u067E\u0627\u0646\u0686\u0647\u200C\u062F\u0627\u0631
        \u0632\u0646 \u06F2"
    - key: mission.m03.class.Unit_Chr_Insurgent_Male_01
      value: "\u0631\u0627\u06A9\u062A\u200C\u0627\u0646\u062F\u0627\u0632 \u0634\u0648\u0631\u0634\u06CC
        \u0645\u0631\u062F \u06F1"
    - key: mission.m03.class.Unit_Chr_Insurgent_Male_02
      value: "\u062A\u06CC\u0631\u0628\u0627\u0631\u0686\u06CC \u0634\u0648\u0631\u0634\u06CC
        \u0645\u0631\u062F \u06F2"
    - key: mission.m03.class.Unit_Chr_Insurgent_Male_03
      value: "\u0645\u0647\u0627\u062C\u0645 \u0634\u0648\u0631\u0634\u06CC \u0645\u0631\u062F
        \u06F3"
    - key: mission.m03.class.Unit_Chr_Insurgent_Male_04
      value: "\u062A\u06A9\u200C\u062A\u06CC\u0631\u0627\u0646\u062F\u0627\u0632
        \u0634\u0648\u0631\u0634\u06CC \u0645\u0631\u062F \u06F4"
    - key: mission.m03.class.Unit_Chr_Insurgent_Male_05
      value: "\u062A\u0641\u0646\u06AF\u062F\u0627\u0631 \u0634\u0648\u0631\u0634\u06CC
        \u0645\u0631\u062F \u06F5"
    - key: mission.m03.class.Unit_Chr_Leader_Male_01
      value: "\u0641\u0631\u0645\u0627\u0646\u062F\u0647\u0654 \u0645\u06CC\u062F\u0627\u0646"
    - key: mission.m03.class.Unit_Chr_Pilot_Female_01
      value: "\u062E\u0644\u0628\u0627\u0646 \u0632\u0646 \u06F1"
    - key: mission.m03.class.Unit_Chr_Pilot_Male_01
