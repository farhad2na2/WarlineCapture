+                Debug.Log("[CampaignPlayerJourney] selection-cue-deferred lesson=" + journeyStep +
+                    " publicSelectionSatisfied=" + !target.NeedsSelection + " actionInjected=0");
+            }
+            if (now - staleSelectionCueSince > 3)
+                throw new InvalidOperationException("Select guidance disagreed with current public selection/mode for over 3 seconds; lesson=" + journeyStep);
