  var guidance=new CatalogGuidanceFacts{TutorialStep=SourceAssistantShortConstructorGuidance.TutorialStep,TutorialStepCount=SourceAssistantShortConstructorGuidance.TutorialStepCount,RecommendationKind=SourceAssistantShortConstructorGuidance.RecommendationKind,RecommendationTargetKind=SourceAssistantShortConstructorGuidance.RecommendationTargetKind};
  return new CatalogPublicFacts(true,false,default,null,false,default,true,guidance,true,restrictions);
 }
