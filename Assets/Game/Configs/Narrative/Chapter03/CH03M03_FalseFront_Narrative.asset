    lines:
    - lineId: false_front-brief-03
      textKey: narrative.false_front.brief.03
      englishFallback: No strike on a rumor. Put our squad on the two observation
        points, move the three civilian vehicles toward shelter, and be ready to
        turn when we know where the ambush is.
      speaker: 1
      voiceClip: {fileID: 8300000, guid: abcaae170e0d0487d8a0e300f696b871, type: 3}
