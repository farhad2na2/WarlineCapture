    {
      "kind": "narrative",
      "id": "citywide_alert-brief-02",
      "speaker": "DALIA",
      "locale": "en-US",
      "text": "Mixed Ash Line and Vanguard groups are approaching on separate response lanes. Use radar to confirm the threats, split your defenders, and use the existing production controls for reinforcements. Allow time for units to reach the other front.",
