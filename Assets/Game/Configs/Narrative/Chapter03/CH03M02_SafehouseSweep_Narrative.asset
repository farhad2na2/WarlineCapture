      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: safehouse_sweep-brief-02
      textKey: narrative.safehouse_sweep.brief.02
      englishFallback: Waiting gives the cell time to move, but suspicion is not
        a second target. Seal both escape lanes, breach only the confirmed safehouse,
        and keep every shot inside the boundary.
      speaker: 1
      voiceClip: {fileID: 8300000, guid: 9d185024d379d4bc88973ef1d33e3e0e, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 15.86
      essentialCaption: 1
