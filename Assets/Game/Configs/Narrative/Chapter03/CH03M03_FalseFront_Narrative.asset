    lines:
    - lineId: false_front-comms-01
      textKey: narrative.false_front.comms.01
      englishFallback: The depot is empty. Ash Line fighters are building a roadblock
        beyond the second checkpoint, right across the evacuation lane. That's the
        real ambush.
      speaker: 2
      voiceClip: {fileID: 8300000, guid: eed09929292a649babda8f1bcf62bbbf, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
