    -unity-font-style: bold;
    color: rgb(232, 222, 190);
}

.level-label {
    left: 0;
    top: 0;
    width: 35%;
    height: 38%;
    -unity-text-align: middle-left;
}

.level-value {
    right: 0;
    top: 0;
    width: 38%;
    height: 38%;
    -unity-text-align: middle-right;
}

.level-track {
    left: 0;
