    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: 59bc09e4e09542dc9399c1ce405b3c10
      m_SubObjectName: CH05M04_LastCorridor_Debrief-c-16x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    panel20x9Reference:
      m_AssetGUID: 59bc09e4e09542dc9399c1ce405b3c10
      m_SubObjectName: CH05M04_LastCorridor_Debrief-c-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: last_corridor-debrief-03
      textKey: narrative.last_corridor.debrief-03
      englishFallback: The delivered keys preserve bounded access; they do not grant
        permanent unilateral authority. The Relay complex is still connected to power,
        clinics, shelters, transport and communications. Those city systems must
        survive the final approach. I will keep your decisions explicit.
      speaker: 3
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 19.857143
      essentialCaption: 1
