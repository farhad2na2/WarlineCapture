    white-space: normal;
}

.progress-meter {
    position: absolute;
    left: 20.9%;
    width: 58.1%;
    bottom: 21%;
    height: 6.35%;
    background-image: url("../../Art/UI/Generated/MainMenuV15C/LayeredOneGo/scn02_mode_progress_meter_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 20;
