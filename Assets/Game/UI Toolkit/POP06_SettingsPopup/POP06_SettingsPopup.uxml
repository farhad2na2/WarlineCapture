<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="POP06_SettingsPopup.uss" />

    <ui:VisualElement name="POP06_SettingsPopup" class="pop06-settings-popup">
        <ui:VisualElement name="BackdropScrim" class="settings-backdrop-scrim" />
        <ui:VisualElement name="PopupFrame" class="settings-popup-frame shell-motion shell-motion-popup-hidden">
            <ui:VisualElement name="Chrome" class="settings-popup-chrome" />
            <ui:VisualElement name="HeaderPanel" class="settings-header-panel">
                <ui:VisualElement name="SettingsIcon" class="settings-header-icon" />
                <ui:Label name="Title" class="settings-title" text="SETTINGS" />
                <ui:Label name="Subtitle" class="settings-subtitle" text="Command interface preferences" />
                <ui:Button name="CloseButton" class="settings-close-action" text="">
                    <ui:Label name="Label" class="settings-close-label" text="CLOSE" />
                </ui:Button>
            </ui:VisualElement>

            <ui:VisualElement name="SettingsGrid" class="settings-grid">
                <ui:VisualElement name="AudioRow" class="settings-row">
                    <ui:Label name="Label" class="settings-row-label" text="AUDIO" />
                    <ui:Label name="Value" class="settings-row-value" text="BALANCED" />
                </ui:VisualElement>
                <ui:VisualElement name="GraphicsRow" class="settings-row">
                    <ui:Label name="Label" class="settings-row-label" text="GRAPHICS" />
                    <ui:Label name="Value" class="settings-row-value" text="ULTRA" />
                </ui:VisualElement>
                <ui:VisualElement name="ControlsRow" class="settings-row">
                    <ui:Label name="Label" class="settings-row-label" text="CONTROLS" />
                    <ui:Label name="Value" class="settings-row-value" text="TACTICAL" />
                </ui:VisualElement>
                <ui:VisualElement name="NotificationsRow" class="settings-row">
                    <ui:Label name="Label" class="settings-row-label" text="ALERTS" />
                    <ui:Label name="Value" class="settings-row-value" text="ENABLED" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="FooterPanel" class="settings-footer-panel">
                <ui:Label name="FooterText" class="settings-footer-text" text="Runtime settings binding will replace these values from the ECS read model." />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
