  m_Name: M02_EstablishBase_Narrative
  m_EditorClassIdentifier: Game.Configs::Game.Configs.NarrativeSequenceConfig
  sequenceId: seq.ch01.m02.brief
  entryStateId: M02-BRIEF-DIALOGUE
  defaultSkipDestinationId: M02-BRIEF-COMPLETE
  states:
  - stateId: M02-BRIEF-DIALOGUE
    kind: 0
    panel16x9: {fileID: 21300000, guid: 211ff501900b0438789722fab6f7b3a7, type: 3}
    panel20x9: {fileID: 21300000, guid: 211ff501900b0438789722fab6f7b3a7, type: 3}
    panel16x9Reference:
      m_AssetGUID: 
      m_SubObjectName: 
      m_SubObjectType: 
