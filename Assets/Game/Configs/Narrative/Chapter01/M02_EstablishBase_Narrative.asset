  states:
  - stateId: M02-COMMS-DIALOGUE
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID:
      m_SubObjectName:
      m_SubObjectType:
