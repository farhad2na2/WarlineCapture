.scn01-loading-content {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    -unity-font-definition: url("../../../Synty/InterfaceMilitaryCombatHUD/Fonts/Oxanium/Oxanium-Medium.ttf");
    color: rgb(242, 232, 196);
}

.loading-body {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}

.background {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/SplashLoading/TargetLockV04Imagegen/Sprites/scn01_v04_background_no_ui.png");
    -unity-background-scale-mode: scale-and-crop;
}

.screen-vignette {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(8, 9, 8, 0.10);
}

.screen-corner {
    position: absolute;
    width: 6.6%;
    height: 11.2%;
    -unity-background-scale-mode: scale-to-fit;
}

.corner-tl {
    left: 1.1%;
    top: 2.0%;
    background-image: url("../../Art/UI/Generated/SplashLoading/TargetLockV04Imagegen/Sprites/scn01_v04_corner_tl.png");
}

.corner-tr {
    right: 1.2%;
    top: 2.0%;
    background-image: url("../../Art/UI/Generated/SplashLoading/TargetLockV04Imagegen/Sprites/scn01_v04_corner_tr.png");
}

.corner-bl {
    left: 1.2%;
    bottom: 2.0%;
    background-image: url("../../Art/UI/Generated/SplashLoading/TargetLockV04Imagegen/Sprites/scn01_v04_corner_bl.png");
}

.corner-br {
    right: 1.2%;
    bottom: 2.0%;
    background-image: url("../../Art/UI/Generated/SplashLoading/TargetLockV04Imagegen/Sprites/scn01_v04_corner_br.png");
}

.logo-readability-band {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: visible;
}

.brand-logo-lockup {
    position: absolute;
    width: 42%;
    height: 17.5%;
    left: 50%;
    top: 11.8%;
    translate: -50% -50%;
    background-image: url("../../Art/UI/Generated/SplashLoading/TargetLockV04Imagegen/Sprites/scn01_v04_logo_lockup.png");
    -unity-background-scale-mode: scale-to-fit;
}

.command-system-back {
    position: absolute;
    width: 27.0%;
    height: 6.6%;
    left: 50%;
    top: 27.0%;
    translate: -50% -50%;
    background-image: url("../../Art/UI/Generated/SplashLoading/TargetLockV04Imagegen/Sprites/scn01_v04_loading_panel_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    align-items: center;
    justify-content: center;
}

.command-system-text {
    font-size: 62px;
    color: rgb(239, 226, 191);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.loading-panel-frame {
    position: absolute;
    width: 70.8%;
    height: 20.8%;
    left: 50%;
    top: 60.9%;
    translate: -50% 0;
    background-image: url("../../Art/UI/Generated/SplashLoading/TargetLockV04Imagegen/Sprites/scn01_v04_loading_panel_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.loading-panel-status {
    position: absolute;
    left: 6.1%;
    top: 11.0%;
    width: 66%;
    height: 33%;
    font-size: 84px;
    color: rgb(242, 232, 196);
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.loading-panel-percent {
    position: absolute;
    right: 6.1%;
    top: 7.5%;
    width: 16%;
    height: 40%;
    font-size: 106px;
    color: rgb(226, 174, 42);
    -unity-text-align: middle-right;
    white-space: nowrap;
}

.progress-frame {
    position: absolute;
    left: 6.2%;
    right: 6.2%;
    top: 57.0%;
    height: 21%;
    min-height: 34px;
    overflow: hidden;
    background-image: url("../../Art/UI/Generated/SplashLoading/TargetLockV04Imagegen/Sprites/scn01_v04_progress_track_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.progress-fill {
    position: absolute;
    left: 2.0%;
    top: 50%;
    translate: 0 -50%;
    width: 68.0%;
    height: 68%;
    min-height: 12px;
    background-image: url("../../Art/UI/Generated/SplashLoading/TargetLockV04Imagegen/Sprites/scn01_v04_progress_fill_gold.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.progress-tick {
    position: absolute;
    top: 17%;
    width: 2px;
    height: 66%;
    background-color: rgba(0, 0, 0, 0.56);
    display: none;
}

.progress-tick-7 { left: 38.6%; display: flex; }
.progress-tick-11 { left: 61.2%; display: flex; }
.progress-tick-15 { left: 80.4%; display: flex; }
.progress-tick-17 { left: 96.5%; display: flex; }

.bottom-status-chip-fill {
    position: absolute;
    width: 31.5%;
    height: 7.7%;
    left: 50%;
    top: 84.4%;
    translate: -50% 0;
}

.bottom-status-chip {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/SplashLoading/TargetLockV04Imagegen/Sprites/scn01_v04_loading_panel_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.bottom-status-spinner {
    position: absolute;
    left: 7.5%;
    top: 50%;
    width: 64px;
    height: 64px;
    translate: 0 -50%;
    background-image: url("../../Art/UI/Generated/SplashLoading/TargetLockV04Imagegen/Sprites/scn01_v04_spinner_ring.png");
    -unity-background-scale-mode: scale-to-fit;
}

.bottom-status-text {
    position: absolute;
    left: 22%;
    right: 8%;
    top: 50%;
    translate: 0 -50%;
    height: 72%;
    font-size: 54px;
    color: rgb(239, 226, 191);
    -unity-text-align: middle-left;
    white-space: nowrap;
}
