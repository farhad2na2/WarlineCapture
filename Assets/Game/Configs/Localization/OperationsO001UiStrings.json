      "key": "operations.o001.defeat",
      "source": "DEFEAT",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "شکست"
        }
      ]
    },
    {
      "key": "operations.o001.result",
      "source": "{0}\n{1}/3 signals • {2} extracted\n{3}",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "{0}\nسیگنال‌ها {1}/3 • نیروهای خارج‌شده {2}\n{3}"
        }
      ]
    },
    {
      "key": "operations.o001.carried",
      "source": "EVIDENCE CARRIED",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "مدارک همراه نیرو است"
        }
      ]
    },
    {
      "key": "operations.o001.recover_progress",
      "source": "RECOVER {0}/15 s",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "برداشتن {0}/15 ثانیه"
        }
      ]
    },
    {
      "key": "operations.o001.load_refunded",
      "source": "The mission could not load. Your action point was returned. You can try again.",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "مأموریت بارگذاری نشد. امتیاز اقدام شما بازگردانده شد. می‌توانید دوباره تلاش کنید."
        }
      ]
    },
    {
      "key": "operations.o001.load_refund_pending",
      "source": "The mission could not load. Recovery is waiting for a saved refund.",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "مأموریت بارگذاری نشد. بازیابی در انتظار ذخیرهٔ بازگشت امتیاز اقدام است."
        }
      ]
    },
    {
      "key": "operations.o001.advance_marker",
      "source": "ADVANCE: {0}",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "پیشروی: {0}"
        }
      ]
    },
    {
      "key": "operations.o001.advancing",
      "source": "Advancing to the objective. Your selected infantry will engage threats on the way.",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "پیشروی به سوی هدف. پیاده‌نظام منتخب در مسیر با دشمن درگیر می‌شود."
        }
      ]
    },
    {
      "key": "operations.o001.advance_unavailable",
      "source": "Select surviving infantry and resume the mission before advancing.",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "پیش از پیشروی، پیاده‌نظام زنده را انتخاب کنید و مأموریت را از حالت توقف خارج کنید."
        }
      ]
    },
    {
      "key": "operations.o001.interrupted",
      "source": "An interrupted attempt is reserved. Restart from the beginning without another AP cost, or withdraw.",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "یک نوبت ناتمام رزرو شده است. بدون هزینهٔ دوبارهٔ امتیاز اقدام، از ابتدا شروع کنید یا عقب‌نشینی کنید."
        }
      ]
    },
    {
      "key": "operations.o001.restart_attempt",
      "source": "RESTART ATTEMPT",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "شروع دوبارهٔ نوبت"
        }
      ]
    },
    {
      "key": "operations.o001.resume_attempt",
      "source": "RESUME ATTEMPT",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "ادامهٔ نوبت"
        }
      ]
    },
    {
      "key": "operations.o001.save_exit",
      "source": "SAVE & EXIT",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "ذخیره و خروج"
        }
      ]
    },
    {
      "key": "operations.o001.aria_play",
      "source": "ARIA PLAY",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "بازی با آریا"
        }
      ]
    },
    {
      "key": "operations.o001.aria_stop",
      "source": "STOP ARIA",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "توقف آریا"
        }
      ]
    },
    {
      "key": "operations.o001.saved_exit",
      "source": "Mission saved. Resume this attempt from Operations.",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "مأموریت ذخیره شد. از بخش عملیات این نوبت را ادامه دهید."
        }
      ]
    },
    {
      "key": "operations.o001.resume_available",
      "source": "Resume the saved attempt to keep its progress.",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "برای حفظ پیشرفت، نوبت ذخیره‌شده را ادامه دهید."
        }
      ]
    },
    {
      "key": "operations.o001.resumed",
      "source": "Saved attempt resumed.",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "نوبت ذخیره‌شده ادامه یافت."
        }
      ]
    },
    {
      "key": "operations.o001.checkpoint_failed",
      "source": "Could not save mission progress. Try again.",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "پیشرفت مأموریت ذخیره نشد. دوباره تلاش کنید."
        }
      ]
    },
    {
      "key": "operations.o001.interrupted_withdraw_confirm",
      "source": "Withdraw from the interrupted attempt? This spends the reserved action point and applies withdrawal consequences.",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "از نوبت ناتمام عقب‌نشینی می‌کنید؟ امتیاز اقدام رزروشده مصرف می‌شود و پیامدهای عقب‌نشینی اعمال می‌گردد."
        }
      ]
    },
    {
      "key": "operations.o001.resume_unavailable",
      "source": "A saved checkpoint is present. This version cannot resume it; the saved attempt has been preserved.",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "یک نقطهٔ ذخیره وجود دارد. این نسخه نمی‌تواند آن را ادامه دهد؛ نوبت ذخیره‌شده حفظ شده است."
        }
      ]
    },
    {
      "key": "operations.o001.recovery_refunded",
      "source": "The saved attempt is incompatible. Your action point was returned and recovery data was preserved.",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "نوبت ذخیره‌شده سازگار نیست. امتیاز اقدام بازگردانده شد و داده‌های بازیابی حفظ شدند."
        }
      ]
    },
    {
      "key": "operations.o001.brief_compact",
      "source": "Scan 3 courtyards • recover relay evidence • extract 2 infantry\n16 infantry • 12 min • 1 AP",
      "translations": [
        {
          "locale": "fa-IR",
          "value": "۳ حیاط را اسکن کنید • مدارک را بردارید • ۲ نیروی پیاده را خارج کنید\n۱۶ نیروی پیاده • ۱۲ دقیقه • ۱ امتیاز اقدام"
        }
      ]
    },
