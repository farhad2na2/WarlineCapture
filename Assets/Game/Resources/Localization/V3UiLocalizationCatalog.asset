        \u062F\u0633\u062A\u0631\u0633 \u0646\u06CC\u0633\u062A"
    - key: mission.m04.guide.role.protected
      value: "\u0646\u0642\u0634: \u0645\u062A\u062E\u0635\u0635. \u0647\u0631 \u0686\u0647\u0627\u0631
        \u0646\u0641\u0631 \u0628\u0627\u06CC\u062F \u0627\u0648\u0644 \u0633\u0648\u0627\u0631
        \u0646\u0641\u0631\u0628\u0631 \u0628\u0634\u0646\u060C \u0628\u0639\u062F
        \u0628\u0627\u0644\u06AF\u0631\u062F\u060C \u0648 \u0632\u0646\u062F\u0647
        \u062E\u0627\u0631\u062C \u0628\u0634\u0646. \u0627\u06AF\u0647 \u062D\u062A\u06CC
        \u06CC\u0647 \u0646\u0641\u0631 \u0631\u0648 \u0627\u0632 \u062F\u0633\u062A
        \u0628\u062F\u06CC\u060C \u0645\u0623\u0645\u0648\u0631\u06CC\u062A \u0634\u06A9\u0633\u062A
        \u0645\u06CC\u200C\u062E\u0648\u0631\u0647."
    - key: mission.m04.guide.role.transport
      value: "\u0646\u0642\u0634: \u062A\u0631\u0627\u0628\u0631\u06CC. \u0635\u0646\u062F\u0644\u06CC
        \u0645\u0633\u0627\u0641\u0631 \u062F\u0627\u0634\u062A\u0646\u060C \u0628\u0647
        \u0645\u0639\u0646\u06CC \u0645\u0633\u0644\u062D\u200C\u0628\u0648\u062F\u0646
        \u0646\u06CC\u0633\u062A. \u062A\u06CC\u0645 \u0631\u0648 \u0628\u0627 \u0646\u0641\u0631\u0628\u0631
        \u0628\u0628\u0631\u060C \u062A\u0648\u06CC \u0645\u062D\u0644 \u0641\u0631\u0648\u062F
        \u067E\u06CC\u0627\u062F\u0647 \u06A9\u0646\u060C \u0628\u0639\u062F \u0647\u0631
        \u0686\u0647\u0627\u0631 \u0646\u0641\u0631 \u0631\u0648 \u0633\u0648\u0627\u0631
        \u0628\u0627\u0644\u06AF\u0631\u062F \u06A9\u0646."
