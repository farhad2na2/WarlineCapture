      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: citywide_alert-brief-01
      textKey: narrative.citywide_alert.brief-01
      englishFallback: The clinic and utility site protect different needs. Keep
        both intact. Clear each front's attackers, then bring an original engineer
        to its marked recovery point and hold for six seconds to restore service.
      speaker: 2
      voiceClip: {fileID: 8300000, guid: 2b5ddcb5a63244067b37c96b074d932d, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
