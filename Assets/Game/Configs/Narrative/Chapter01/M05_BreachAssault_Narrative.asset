    missionContextFlags: []
  - stateId: M05-debrief-2
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: 2b86266159f1d462b896830d937d595f
      m_SubObjectName: M05-D02-16x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    panel20x9Reference:
      m_AssetGUID: 2b86266159f1d462b896830d937d595f
      m_SubObjectName: M05-D02-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: m05-debrief-02
      textKey: narrative.m05.debrief.02
      englishFallback: "The credential was revoked. Someone used its signature anyway.
        One encrypted message survived: \u201CQassem. The first node is lost.\u201D
        I cannot yet identify the sender."
      speaker: 3
      voiceClip: {fileID: 8300000, guid: d376730830cb94978a6ed55a0052b270, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 17.16
      essentialCaption: 1
    continueStateId: M05-debrief-3
    skipStateId: M05-debrief-complete
