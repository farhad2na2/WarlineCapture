      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: armor_break-brief-01
      textKey: narrative.armor_break.brief-01
      englishFallback: Vanguard's command group is preparing to link heavy weapons
        to the dormant Relay nodes. Break their military position and protect the
        relief corridor. We cannot trade the city's infrastructure for this victory.
      speaker: 1
      voiceClip: {fileID: 8300000, guid: 6b275a506a89b44eda926573b82c29dd, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 15.62
      essentialCaption: 1
    continueStateId: ArmorBreak-brief-1
    skipStateId: ArmorBreak-brief-complete
    reducedMotionSupported: 1
    durationSeconds: 15.62
    motionPreset: 0
    locationTitleKey: 
    locationTitleFallback: 
    locationSubtitleKey: 
    locationSubtitleFallback: 
    musicCue: 0
    ambienceCue: 0
    vehicleCue: 0
    eventCue: 3
    routeRole: 0
    completionPayloadId: 
    evidenceIds: []
    missionContextFlags: []
  - stateId: ArmorBreak-brief-1
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: 174c91ef32bd481ab350b1f574ec3d73
      m_SubObjectName: CH04M05_ArmorBreak-b-16x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    panel20x9Reference:
      m_AssetGUID: 174c91ef32bd481ab350b1f574ec3d73
      m_SubObjectName: CH04M05_ArmorBreak-b-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: armor_break-brief-02
      textKey: narrative.armor_break.brief-02
      englishFallback: Keep our armor, air defense, and long-range weapons working
        together. Fuel has been staged for this operation. Clear the military approach
        before moving the recovery team into the command compound.
      speaker: 5
      voiceClip: {fileID: 8300000, guid: cac38527d958f4098a33dda967d7b2c2, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 14.071428
      essentialCaption: 1
    continueStateId: ArmorBreak-brief-2
    skipStateId: ArmorBreak-brief-complete
    reducedMotionSupported: 1
    durationSeconds: 14.071428
    motionPreset: 0
    locationTitleKey: 
    locationTitleFallback: 
    locationSubtitleKey: 
    locationSubtitleFallback: 
    musicCue: 0
    ambienceCue: 0
    vehicleCue: 0
    eventCue: 3
    routeRole: 0
    completionPayloadId: 
    evidenceIds: []
    missionContextFlags: []
  - stateId: ArmorBreak-brief-2
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: 174c91ef32bd481ab350b1f574ec3d73
      m_SubObjectName: CH04M05_ArmorBreak-c-16x9
      m_SubObjectType: 
      m_SubObjectGUID: 
