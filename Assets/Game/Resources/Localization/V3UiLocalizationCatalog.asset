    - key: mission.m03.guide.previous
      value: "\u0642\u0628\u0644\u06CC"
    - key: mission.m03.guide.radio
      value: "\u0628\u0627\u06CC\u06AF\u0627\u0646\u06CC \u067E\u06CC\u0627\u0645
        \u0631\u0627\u062F\u06CC\u0648\u06CC\u06CC"
    - key: mission.m03.guide.reference_notice
      value: "\u0627\u06CC\u0646 \u0622\u0645\u0627\u0631 \u0627\u0632 \u062A\u0646\u0638\u06CC\u0645\u0627\u062A
        \u0648\u0627\u0642\u0639\u06CC \u06A9\u0644\u0627\u0633 \u0645\u06CC\u0627\u062F.
        \u0628\u0631\u0627\u06CC \u0647\u0632\u06CC\u0646\u0647\u060C \u062A\u0639\u062F\u0627\u062F
        \u0646\u06CC\u0631\u0648\u0647\u0627 \u0648 \u0627\u0645\u06A9\u0627\u0646
        \u0633\u0627\u062E\u062A\u060C \u067E\u0646\u0644 \u062A\u0648\u0644\u06CC\u062F
        \u0645\u0623\u0645\u0648\u0631\u06CC\u062A \u0631\u0648 \u0628\u0628\u06CC\u0646."
    - key: mission.m03.guide.role.armed
      value: "\u0646\u0642\u0634: \u0646\u06CC\u0631\u0648\u06CC \u0645\u0633\u0644\u062D.
        \u0628\u0631\u062F \u0648 \u0622\u0633\u06CC\u0628\u0634 \u062A\u0648\u06CC
        \u0622\u0645\u0627\u0631 \u0645\u0634\u062E\u0635\u0647\u061B \u0645\u0648\u0636\u0639
        \u062E\u0648\u0628 \u0648 \u0647\u062F\u0641 \u062F\u0631\u0633\u062A \u06A9\u0645\u06A9
        \u0645\u06CC\u200C\u06A9\u0646\u0646 \u0645\u0624\u062B\u0631 \u0628\u062C\u0646\u06AF\u0647."
    - key: mission.m03.guide.role.protected
      value: "\u0646\u0642\u0634: \u063A\u06CC\u0631\u0646\u0638\u0627\u0645\u06CC.
        \u0646\u0628\u0631\u062F \u0631\u0648 \u0627\u0632 \u0645\u0631\u062F\u0645
        \u062F\u0648\u0631 \u0646\u06AF\u0647 \u062F\u0627\u0631 \u062A\u0627 \u0633\u062A\u0627\u0631\u0647\u0654
        \u062D\u0641\u0627\u0638\u062A \u0627\u0632 \u0627\u0648\u0646\u200C\u0647\u0627
        \u0631\u0648 \u0628\u06AF\u06CC\u0631\u06CC."
    - key: mission.m03.guide.role.sensor
      value: "\u0646\u0642\u0634: \u0634\u0646\u0627\u0633\u0627\u06CC\u06CC \u0632\u0645\u06CC\u0646\u06CC.
        \u0631\u0627\u062F\u0627\u0631 \u0633\u0644\u0627\u062D \u0646\u062F\u0627\u0631\u0647\u061B
        \u0627\u0632\u0634 \u0645\u062D\u0627\u0641\u0638\u062A \u06A9\u0646 \u062A\u0627
        \u0627\u0637\u0644\u0627\u0639\u0627\u062A \u0628\u062F\u0647."
    - key: mission.m03.guide.role.transport
      value: "\u0646\u0642\u0634 \xB7 \u062A\u0631\u0627\u0628\u0631\u06CC. \u062F\u0627\u0634\u062A\u0646
        \u0638\u0631\u0641\u06CC\u062A \u0645\u0633\u0627\u0641\u0631 \u0628\u0647
        \u0645\u0639\u0646\u06CC \u062F\u0627\u0634\u062A\u0646 \u0633\u0644\u0627\u062D
        \u0646\u06CC\u0633\u062A. \u062F\u0631 \u0645\u0623\u0645\u0648\u0631\u06CC\u062A
        \u06F3 \u0646\u0641\u0631\u0628\u0631 \u062F\u0634\u0645\u0646 \u0628\u062F\u0648\u0646
        \u0634\u0644\u06CC\u06A9 \u0647\u0645 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F
        \u0648\u0627\u0631\u062F \u0645\u0631\u06A9\u0632 \u0634\u0648\u062F."
    - key: mission.m03.guide.role.unarmed
      value: "\u0646\u0642\u0634: \u067E\u0634\u062A\u06CC\u0628\u0627\u0646\u06CC.
        \u0627\u06CC\u0646 \u0648\u0627\u062D\u062F \u0646\u0645\u06CC\u200C\u062A\u0648\u0646\u0647
        \u062D\u0645\u0644\u0647 \u06A9\u0646\u0647\u061B \u0628\u0631\u0627\u06CC
        \u062F\u0641\u0627\u0639 \u0628\u0647 \u0633\u0644\u0627\u062D\u0634 \u062D\u0633\u0627\u0628
        \u0646\u06A9\u0646."
    - key: mission.m03.guide.scroll
      value: "\u0628\u0631\u0627\u06CC \u062E\u0648\u0627\u0646\u062F\u0646 \u0646\u0645\u0648\u0646\u0647
        \u0648 \u0627\u0634\u062A\u0628\u0627\u0647 \u0631\u0627\u06CC\u062C\u060C
        \u0635\u0641\u062D\u0647 \u0631\u0648 \u0628\u0627\u0644\u0627 \u0648 \u067E\u0627\u06CC\u06CC\u0646
        \u06A9\u0646"
    - key: mission.m03.guide.search
      value: "\u062C\u0633\u062A\u200C\u0648\u062C\u0648\u06CC \u06A9\u0644\u0627\u0633\u200C\u0647\u0627\u2026"
    - key: mission.m03.guide.stats
      value: "\u0633\u0644\u0627\u0645\u062A {0} \xB7 \u0633\u0631\u0639\u062A {1}\n\u0622\u0633\u06CC\u0628
        {2} \xB7 \u0628\u0631\u062F {3}\n\u0631\u0627\u062F\u0627\u0631 \u0632\u0645\u06CC\u0646\u06CC
        {4} \xB7 \u0631\u0627\u062F\u0627\u0631 \u0647\u0648\u0627\u06CC\u06CC {5}\n\u0638\u0631\u0641\u06CC\u062A
        \u0646\u0641\u0631 {6} \xB7 \u0638\u0631\u0641\u06CC\u062A \u062E\u0648\u062F\u0631\u0648
        {7}"
    - key: mission.m03.guide.title
      value: "\u0631\u0627\u0647\u0646\u0645\u0627\u06CC \u0645\u06CC\u062F\u0627\u0646\u06CC
        \xB7 \u0647\u0634\u062F\u0627\u0631 \u0631\u0627\u062F\u0627\u0631"
    - key: mission.m03.guide.topic.1.body
      value: "\u0647\u0631 \u062F\u0634\u0645\u0646 \u062B\u0628\u062A\u200C\u0634\u062F\u0647
        \u0631\u0648 \u0645\u062A\u0648\u0642\u0641 \u06A9\u0646 \u0648 \u067E\u0627\u0633\u06AF\u0627\u0647
        \u0648 \u0645\u062D\u062F\u0648\u062F\u0647\u0654 \u0645\u0631\u06A9\u0632\u06CC
        \u0631\u0648 \u062D\u0641\u0638 \u06A9\u0646."
    - key: mission.m03.guide.topic.1.diagram
      value: "\u062C\u0627\u062F\u0647\u0654 \u063A\u0631\u0628\u06CC \u2190 \u062F\u0641\u0627\u0639
        \u2190 \u067E\u0627\u0633\u06AF\u0627\u0647"
    - key: mission.m03.guide.topic.1.example
      value: "\u0627\u06AF\u0647 \u0646\u0641\u0631\u0628\u0631 \u0633\u0631\u06CC\u0639
        \u0627\u0632 \u0622\u062A\u0634 \u0646\u06CC\u0631\u0648\u0647\u0627\u062A
        \u0631\u062F \u0634\u062F\u060C \u0642\u0628\u0644 \u0627\u0632 \u0631\u0633\u06CC\u062F\u0646
        \u0628\u0647 \u0645\u0631\u06A9\u0632 \u067E\u0627\u0633\u06AF\u0627\u0647
        \u062C\u0644\u0648\u0634 \u0631\u0648 \u0628\u06AF\u06CC\u0631."
    - key: mission.m03.guide.topic.1.mistake
      value: "\u062A\u0644\u0641\u0627\u062A \u0645\u0631\u062F\u0645\u060C \u0645\u0623\u0645\u0648\u0631\u06CC\u062A
        \u0631\u0648 \u0634\u06A9\u0633\u062A \u0646\u0645\u06CC\u200C\u062F\u0647\u061B
        \u0648\u0644\u06CC \u0633\u062A\u0627\u0631\u0647\u0654 \u062D\u0641\u0627\u0638\u062A
        \u0627\u0632 \u063A\u06CC\u0631\u0646\u0638\u0627\u0645\u06CC\u200C\u0647\u0627
        \u0631\u0648 \u0627\u0632 \u062F\u0633\u062A \u0645\u06CC\u200C\u062F\u06CC."
    - key: mission.m03.guide.topic.1.title
      value: "\u0645\u0623\u0645\u0648\u0631\u06CC\u062A \u062A\u0648"
    - key: mission.m03.guide.topic.10.body
      value: "\u06CC\u0647 \u06AF\u0631\u0648\u0647 \u0645\u0633\u06CC\u0631 \u062F\u0627\u062E\u0644\u06CC
        \u0631\u0648 \u067E\u0648\u0634\u0634 \u0628\u062F\u0647 \u0648 \u06AF\u0631\u0648\u0647
        \u062F\u06CC\u06AF\u0647 \u062C\u0644\u0648\u062A\u0631\u060C \u062A\u0648\u06CC
        \u063A\u0631\u0628\u060C \u062C\u0644\u0648\u06CC \u062F\u0634\u0645\u0646
        \u0631\u0648 \u0628\u06AF\u06CC\u0631\u0647."
    - key: mission.m03.guide.topic.10.diagram
      value: "\u0645\u0642\u0627\u0628\u0644\u0647\u0654 \u062C\u0644\u0648 + \u067E\u0648\u0634\u0634
        \u0645\u0633\u06CC\u0631 \u062F\u0627\u062E\u0644\u06CC"
    - key: mission.m03.guide.topic.10.example
      value: "\u0627\u06AF\u0647 \u06AF\u0631\u0648\u0647 \u062C\u0644\u0648\u06CC\u06CC
        \u0639\u0642\u0628 \u0646\u0634\u0633\u062A\u060C \u0642\u0628\u0644 \u0627\u0632
        \u0627\u06CC\u0646\u06A9\u0647 \u0646\u0641\u0631\u0628\u0631 \u0627\u0632
        \u0622\u062E\u0631\u06CC\u0646 \u067E\u06CC\u0686 \u0631\u062F \u0628\u0634\u0647\u060C
        \u0646\u06CC\u0631\u0648\u06CC \u0630\u062E\u06CC\u0631\u0647 \u0631\u0648
        \u0633\u0631 \u0631\u0627\u0647\u0634 \u0628\u0628\u0631."
    - key: mission.m03.guide.topic.10.mistake
      value: "\u0647\u0645\u0647\u0654 \u0646\u06CC\u0631\u0648\u0647\u0627\u062A
        \u0631\u0648 \u062F\u0646\u0628\u0627\u0644 \u06CC\u0647 \u0647\u062F\u0641
        \u0646\u0641\u0631\u0633\u062A\u061B \u0645\u0633\u06CC\u0631 \u067E\u0627\u0633\u06AF\u0627\u0647
        \u0628\u06CC\u200C\u062F\u0641\u0627\u0639 \u0645\u06CC\u200C\u0645\u0648\u0646\u0647."
    - key: mission.m03.guide.topic.10.title
      value: "\u062D\u0641\u0627\u0638\u062A \u0627\u0632 \u0645\u0631\u06A9\u0632"
    - key: mission.m03.guide.topic.11.body
      value: "\u0628\u0639\u062F \u0627\u0632 \u0628\u0631\u062F\u060C \u0633\u062A\u0627\u0631\u0647\u200C\u0647\u0627\u06CC
        \u062D\u0641\u0627\u0638\u062A \u0627\u0632 \u0645\u0631\u062F\u0645 \u0648
        \u067E\u0627\u0633\u06AF\u0627\u0647 \u0631\u0648 \u062C\u062F\u0627 \u0628\u0628\u06CC\u0646.
        \u0645\u06CC\u200C\u062A\u0648\u0646\u06CC \u062F\u0648\u0628\u0627\u0631\u0647
        \u0628\u0627\u0632\u06CC \u06A9\u0646\u06CC \u0648 \u062F\u0641\u0627\u0639\u062A
        \u0631\u0648 \u0628\u0647\u062A\u0631 \u06A9\u0646\u06CC."
    - key: mission.m03.guide.topic.11.diagram
      value: "\u067E\u06CC\u0631\u0648\u0632\u06CC + \u0633\u0644\u0627\u0645\u062A
        \u063A\u06CC\u0631\u0646\u0638\u0627\u0645\u06CC\u0627\u0646 + \u067E\u0627\u0633\u06AF\u0627\u0647
        \u0628\u06CC\u200C\u0622\u0633\u06CC\u0628"
    - key: mission.m03.guide.topic.11.example
      value: "\u062D\u062A\u06CC \u0627\u06AF\u0647 \u067E\u0627\u0633\u06AF\u0627\u0647
        \u0622\u0633\u06CC\u0628 \u0628\u0628\u06CC\u0646\u0647\u060C \u0628\u0627\u0632
        \u0647\u0645 \u0645\u06CC\u200C\u062A\u0648\u0646\u06CC \u0628\u0628\u0631\u06CC.
        \u0635\u0641\u062D\u0647\u0654 \u0646\u062A\u06CC\u062C\u0647 \u0645\u06CC\u200C\u06AF\u0647
        \u06A9\u062F\u0648\u0645 \u0633\u062A\u0627\u0631\u0647 \u0631\u0648 \u0627\u0632
        \u062F\u0633\u062A \u062F\u0627\u062F\u06CC \u0648 \u0686\u0631\u0627."
    - key: mission.m03.guide.topic.11.mistake
      value: "\u0627\u0646\u062A\u0638\u0627\u0631 \u062F\u0631\u06CC\u0627\u0641\u062A
        \u062F\u0648\u0628\u0627\u0631\u0647\u0654 \u067E\u0627\u062F\u0627\u0634
        \u0627\u0648\u0644\u06CC\u0646 \u067E\u06CC\u0631\u0648\u0632\u06CC \u062F\u0631
        \u062A\u06A9\u0631\u0627\u0631 \u0645\u0623\u0645\u0648\u0631\u06CC\u062A."
    - key: mission.m03.guide.topic.11.title
      value: "\u0633\u062A\u0627\u0631\u0647\u200C\u0647\u0627 \u0648 \u062A\u0644\u0627\u0634
        \u062F\u0648\u0628\u0627\u0631\u0647"
    - key: mission.m03.guide.topic.12.body
      value: "\u0628\u06CC\u0646 \u06F5\u06F7 \u06A9\u0644\u0627\u0633 \u0628\u06AF\u0631\u062F
        \u0648 \u0642\u0627\u0628\u0644\u06CC\u062A\u200C\u0647\u0627\u06CC \u0648\u0627\u0642\u0639\u06CC\u0634\u0648\u0646
        \u0631\u0648 \u0645\u0642\u0627\u06CC\u0633\u0647 \u06A9\u0646."
    - key: mission.m03.guide.topic.12.diagram
      value: "\u062E\u0648\u062F\u06CC \xB7 \u062F\u0634\u0645\u0646 \xB7 \u0645\u062D\u0627\u0641\u0638\u062A\u200C\u0634\u062F\u0647
        \xB7 \u0645\u0631\u062C\u0639 \xB7 \u0622\u06CC\u0646\u062F\u0647"
    - key: mission.m03.guide.topic.12.example
      value: "\u062E\u0648\u062F\u0631\u0648\u06CC \u0631\u0627\u062F\u0627\u0631
        \u0631\u0648 \u067E\u06CC\u062F\u0627 \u06A9\u0646 \u0648 \u0628\u0631\u062F
        \u062D\u0633\u06AF\u0631 \u0632\u0645\u06CC\u0646\u06CC\u0634 \u0631\u0648
        \u0628\u0627 \u062F\u06CC\u0634 \u0631\u0627\u062F\u0627\u0631 \u0647\u0648\u0627\u06CC\u06CC
        \u0645\u0642\u0627\u06CC\u0633\u0647 \u06A9\u0646. \u0631\u0648\u06CC \u0647\u0631
        \u06A9\u0627\u0631\u062A \u0646\u0648\u0634\u062A\u0647 \u062A\u0648\u06CC
        \u0627\u06CC\u0646 \u0645\u0623\u0645\u0648\u0631\u06CC\u062A \u062F\u0631
        \u062F\u0633\u062A\u0631\u0633 \u0647\u0633\u062A \u06CC\u0627 \u0646\u0647."
    - key: mission.m03.guide.topic.12.mistake
      value: "\u0641\u0631\u0636 \u0627\u06CC\u0646\u06A9\u0647 \u0647\u0645\u0647\u0654
        \u06A9\u0644\u0627\u0633\u200C\u0647\u0627\u06CC \u0645\u0631\u062C\u0639
        \u062F\u0631 \u0645\u0623\u0645\u0648\u0631\u06CC\u062A \u06F3 \u0642\u0627\u0628\u0644\u200C\u062A\u0648\u0644\u06CC\u062F\u0646\u062F."
    - key: mission.m03.guide.topic.12.title
      value: "\u0647\u0645\u0647\u0654 \u06A9\u0644\u0627\u0633\u200C\u0647\u0627"
    - key: mission.m03.guide.topic.2.body
      value: "\u0642\u0628\u0644 \u0627\u0632 \u0627\u0642\u062F\u0627\u0645\u060C
        \u0628\u0628\u06CC\u0646 \u06AF\u0632\u0627\u0631\u0634 \u0645\u0648\u0642\u0639\u06CC\u062A
        \u0627\u0632 \u06A9\u062C\u0627 \u0627\u0648\u0645\u062F\u0647."
    - key: mission.m03.guide.topic.2.diagram
      value: "\u06AF\u0632\u0627\u0631\u0634 \u062F\u06CC\u062F\u0647\u200C\u0628\u0627\u0646
        \u2190 \u062A\u0645\u0627\u0633 \u0631\u0627\u062F\u0627\u0631 \u2190 \u062A\u0623\u06CC\u06CC\u062F
        \u062F\u06CC\u062F\u0627\u0631\u06CC"
    - key: mission.m03.guide.topic.2.example
      value: "\u062F\u06CC\u062F\u0647\u200C\u0628\u0627\u0646 \u0645\u0633\u06CC\u0631
        \u0648 \u0632\u0645\u0627\u0646 \u062A\u0642\u0631\u06CC\u0628\u06CC \u0631\u0648
        \u06AF\u0632\u0627\u0631\u0634 \u0645\u06CC\u200C\u062F\u0647. \u0647\u0634\u062F\u0627\u0631
        \u0631\u0648 \u0628\u062E\u0648\u0646\u060C \u062C\u0627\u062F\u0647 \u0631\u0648
        \u0628\u0628\u06CC\u0646 \u0648 \u0645\u0646\u062A\u0638\u0631 \u062A\u0623\u06CC\u06CC\u062F
        \u0631\u0627\u062F\u0627\u0631 \u0628\u0627\u0634."
    - key: mission.m03.guide.topic.2.mistake
      value: "\u0642\u0637\u0639\u06CC \u062F\u0627\u0646\u0633\u062A\u0646 \u0632\u0645\u0627\u0646
        \u062A\u0642\u0631\u06CC\u0628\u06CC \u0631\u0633\u06CC\u062F\u0646."
    - key: mission.m03.guide.topic.2.title
      value: "\u062E\u0648\u0627\u0646\u062F\u0646 \u0647\u0634\u062F\u0627\u0631"
    - key: mission.m03.guide.topic.3.body
      value: "\u062E\u0648\u062F\u0631\u0648\u06CC \u0631\u0627\u062F\u0627\u0631
        \u0632\u0645\u06CC\u0646\u06CC\u060C \u062E\u0648\u062F\u0631\u0648\u0647\u0627\u06CC
        \u0631\u0648\u06CC \u0632\u0645\u06CC\u0646 \u0631\u0648 \u067E\u06CC\u062F\u0627
        \u0645\u06CC\u200C\u06A9\u0646\u0647. \u062F\u06CC\u0634 \u0631\u0627\u062F\u0627\u0631
        \u0647\u0648\u0627\u06CC\u06CC \u0628\u0631\u0627\u06CC \u0647\u062F\u0641\u200C\u0647\u0627\u06CC
        \u0647\u0648\u0627\u06CC\u06CC\u0647."
    - key: mission.m03.guide.topic.3.diagram
      value: "\u06AF\u0632\u0627\u0631\u0634 \u2260 \u062A\u0623\u06CC\u06CC\u062F
        \xB7 \u062A\u0645\u0627\u0633 \u0642\u062F\u06CC\u0645\u06CC \u2260 \u0646\u0627\u0628\u0648\u062F\u06CC"
    - key: mission.m03.guide.topic.3.example
      value: "\u0627\u06AF\u0647 \u062E\u0648\u062F\u0631\u0648 \u0627\u0632 \u067E\u0648\u0634\u0634
        \u0631\u0627\u062F\u0627\u0631 \u062E\u0627\u0631\u062C \u0628\u0634\u0647\u060C
        \u0622\u062E\u0631\u06CC\u0646 \u062C\u0627\u06CC\u06CC \u06A9\u0647 \u062F\u06CC\u062F\u06CC\u0645\u0634
        \u0647\u0646\u0648\u0632 \u0628\u0647 \u062F\u0631\u062F \u0645\u06CC\u200C\u062E\u0648\u0631\u0647\u061B
        \u0648\u0644\u06CC \u062C\u0627\u06CC \u0627\u0644\u0627\u0646\u0634 \u0646\u06CC\u0633\u062A."
    - key: mission.m03.guide.topic.3.mistake
      value: "\u062A\u0639\u0628\u06CC\u0631 \u062A\u0645\u0627\u0633 \u0627\u0632\u062F\u0633\u062A\u200C\u0631\u0641\u062A\u0647
        \u06CC\u0627 \u0642\u062F\u06CC\u0645\u06CC \u0628\u0647\u200C\u0639\u0646\u0648\u0627\u0646
        \u062F\u0634\u0645\u0646 \u0646\u0627\u0628\u0648\u062F\u0634\u062F\u0647."
    - key: mission.m03.guide.topic.3.title
      value: "\u0645\u0646\u0628\u0639 \u0648 \u0627\u0637\u0645\u06CC\u0646\u0627\u0646"
    - key: mission.m03.guide.topic.4.body
      value: "\u062C\u0627\u062F\u0647 \u0631\u0648 \u0628\u0628\u06CC\u0646\u060C
        \u0628\u0631\u06AF\u0631\u062F \u0633\u0631\u0627\u063A \u06AF\u0631\u0648\u0647\u062A
        \u0648 \u0627\u06AF\u0647 \u0644\u0627\u0632\u0645 \u0634\u062F \u062F\u0633\u062A\u0648\u0631
        \u062D\u0631\u06A9\u062A \u0628\u062F\u0647."
    - key: mission.m03.guide.topic.4.diagram
      value: "\u067E\u0631\u0634 \u2190 \u062F\u0648\u0631\u0628\u06CC\u0646 \xB7
        \u062D\u0631\u06A9\u062A \u2190 \u0648\u0627\u062D\u062F\u0647\u0627\u06CC
        \u0627\u0646\u062A\u062E\u0627\u0628\u200C\u0634\u062F\u0647"
    - key: mission.m03.guide.topic.4.example
      value: "\u06AF\u0631\u0648\u0647 \u0627\u0644\u0641 \u0631\u0648 \u0627\u0646\u062A\u062E\u0627\u0628\u200C\u0634\u062F\u0647
        \u0646\u06AF\u0647 \u062F\u0627\u0631 \u0648 \u0628\u0627 \u062F\u06A9\u0645\u0647\u0654
        \u0647\u0634\u062F\u0627\u0631\u060C \u062C\u0627\u062F\u0647 \u0631\u0648
        \u0628\u0628\u06CC\u0646. \u0628\u0639\u062F \xAB\u062D\u0631\u06A9\u062A\xBB
        \u0631\u0648 \u0628\u0632\u0646 \u0648 \u06CC\u0647 \u0645\u0642\u0635\u062F
        \u0642\u0627\u0628\u0644\u200C\u062F\u0633\u062A\u0631\u0633\u06CC \u06A9\u0646\u0627\u0631
        \u062C\u0627\u062F\u0647 \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646."
    - key: mission.m03.guide.topic.4.mistake
      value: "\u0627\u0646\u062A\u0638\u0627\u0631 \u062C\u0627\u0628\u0647\u200C\u062C\u0627\u06CC\u06CC
        \u06AF\u0631\u0648\u0647 \u0627\u0632 \u062F\u06A9\u0645\u0647\u0654 \u067E\u0631\u0634
        \u062F\u0648\u0631\u0628\u06CC\u0646."
    - key: mission.m03.guide.topic.4.title
      value: "\u067E\u0631\u0634 \u0648 \u062D\u0631\u06A9\u062A"
    - key: mission.m03.guide.topic.5.body
      value: "\u0628\u0631\u062C \u0622\u0645\u0627\u062F\u0647\u060C \u0642\u062F\u0631\u062A
        \u0622\u062A\u0634 \u0628\u06CC\u0634\u062A\u0631\u06CC \u0645\u06CC\u200C\u062F\u0647.
        \u0645\u0627\u0646\u0639 \u0645\u0645\u06A9\u0646\u0647 \u0645\u0633\u06CC\u0631
        \u062F\u0634\u0645\u0646 \u0631\u0648 \u0639\u0648\u0636 \u06A9\u0646\u0647\u061B
        \u0645\u0633\u06CC\u0631 \u062C\u0627\u06CC\u06AF\u0632\u06CC\u0646 \u0631\u0648
        \u0647\u0645 \u067E\u0648\u0634\u0634 \u0628\u062F\u0647."
    - key: mission.m03.guide.topic.5.diagram
      value: "\u0647\u0632\u06CC\u0646\u0647 \u2190 \u0645\u062D\u0644 \u0645\u062C\u0627\u0632
        \u2190 \u062A\u0623\u06CC\u06CC\u062F \u2190 \u062A\u06A9\u0645\u06CC\u0644"
    - key: mission.m03.guide.topic.5.example
      value: "\u0633\u0627\u062E\u062A \u0628\u0631\u062C \u0631\u0648 \u0632\u0648\u062F
        \u0634\u0631\u0648\u0639 \u06A9\u0646 \u0648 \u0628\u0627 \u062A\u0641\u0646\u06AF\u062F\u0627\u0631\u0647\u0627
        \u0627\u0632\u0634 \u0645\u062D\u0627\u0641\u0638\u062A \u06A9\u0646. \u0645\u0627\u0646\u0639
        \u0631\u0648 \u062C\u0627\u06CC\u06CC \u0628\u0630\u0627\u0631 \u06A9\u0647
        \u0645\u0633\u06CC\u0631 \u062C\u0627\u06CC\u06AF\u0632\u06CC\u0646\u0634
        \u0647\u0645 \u0632\u06CC\u0631 \u067E\u0648\u0634\u0634\u062A \u0628\u0627\u0634\u0647."
    - key: mission.m03.guide.topic.5.mistake
      value: "\u0647\u0632\u06CC\u0646\u0647\u200C\u06A9\u0631\u062F\u0646 \u0628\u0631\u0627\u06CC
        \u062F\u0641\u0627\u0639 \u0646\u06CC\u0645\u0647\u200C\u062A\u0645\u0627\u0645
        \u0648 \u0628\u06CC\u200C\u062F\u0641\u0627\u0639 \u06AF\u0630\u0627\u0634\u062A\u0646
        \u0645\u0633\u06CC\u0631."
    - key: mission.m03.guide.topic.5.title
      value: "\u0628\u0631\u062C \u0648 \u0645\u0627\u0646\u0639"
    - key: mission.m03.guide.topic.6.body
      value: "\u0627\u06AF\u0647 \u0628\u0648\u062F\u062C\u0647\u0654 \u0646\u0645\u0627\u06CC\u0634\u200C\u062F\u0627\u062F\u0647\u200C\u0634\u062F\u0647
        \u06A9\u0627\u0641\u06CC\u0647\u060C \u0627\u0632 \u0633\u0631\u0628\u0627\u0632\u062E\u0627\u0646\u0647
        \u06CC\u0647 \u06AF\u0631\u0648\u0647 \u0686\u0647\u0627\u0631\u0646\u0641\u0631\u06CC
        \u062A\u0641\u0646\u06AF\u062F\u0627\u0631 \u0633\u0641\u0627\u0631\u0634
        \u0628\u062F\u0647."
    - key: mission.m03.guide.topic.6.diagram
      value: "\u067E\u0627\u062F\u06AF\u0627\u0646 \u2190 \u062A\u0648\u0644\u06CC\u062F
        \u2190 \u0686\u0647\u0627\u0631 \u062A\u0641\u0646\u06AF\u062F\u0627\u0631
        \u2190 \u0627\u0633\u062A\u0642\u0631\u0627\u0631"
    - key: mission.m03.guide.topic.6.example
      value: "\u0633\u0631\u0628\u0627\u0632\u062E\u0627\u0646\u0647\u0654 \u0622\u0645\u0627\u062F\u0647
        \u0631\u0648 \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646 \u0648 \u06CC\u0647
        \u06AF\u0631\u0648\u0647 \u062A\u0641\u0646\u06AF\u062F\u0627\u0631 \u0633\u0641\u0627\u0631\u0634
        \u0628\u062F\u0647. \u0642\u0628\u0644 \u0627\u0632 \u0627\u06CC\u0646\u06A9\u0647
        \u0631\u0648\u0634\u0648\u0646 \u062D\u0633\u0627\u0628 \u06A9\u0646\u06CC\u060C
        \u0635\u0628\u0631 \u06A9\u0646 \u0647\u0631 \u0686\u0647\u0627\u0631 \u0646\u0641\u0631
        \u0622\u0645\u0627\u062F\u0647 \u0628\u0634\u0646."
    - key: mission.m03.guide.topic.6.mistake
      value: "\u0627\u0634\u062A\u0628\u0627\u0647 \u06AF\u0631\u0641\u062A\u0646
        \u0647\u0632\u06CC\u0646\u0647\u0654 \u0645\u0631\u062C\u0639 \u06CC\u06A9
        \u06A9\u0644\u0627\u0633 \u0628\u0627 \u0647\u0632\u06CC\u0646\u0647\u0654
        \u0648\u0627\u0642\u0639\u06CC \u06AF\u0631\u0648\u0647 \u062F\u0631 \u0645\u0623\u0645\u0648\u0631\u06CC\u062A."
    - key: mission.m03.guide.topic.6.title
      value: "\u062A\u0641\u0646\u06AF\u062F\u0627\u0631\u0627\u0646 \u06A9\u0645\u06A9\u06CC"
    - key: mission.m03.guide.topic.7.body
      value: "\xAB\u062D\u0641\u0638\xBB \u0646\u06CC\u0631\u0648\u0647\u0627\u062A
        \u0631\u0648 \u0633\u0631 \u062C\u0627\u0634\u0648\u0646 \u0646\u06AF\u0647
        \u0645\u06CC\u200C\u062F\u0627\u0631\u0647 \u062A\u0627 \u062F\u0641\u0627\u0639
        \u06A9\u0646\u0646. \u0627\u06AF\u0647 \u0645\u06CC\u200C\u062E\u0648\u0627\u06CC
        \u062F\u0633\u062A\u0648\u0631\u0647\u0627 \u0648 \u0634\u0644\u06CC\u06A9
        \u062E\u0648\u062F\u06A9\u0627\u0631 \u0631\u0648 \u0642\u0637\u0639 \u06A9\u0646\u06CC\u060C
        \u0646\u06CC\u0631\u0648\u0647\u0627\u062A \u0631\u0648 \u0627\u0646\u062A\u062E\u0627\u0628
        \u06A9\u0646\u060C \xAB\u0641\u0631\u0645\u0627\u0646\u200C\u0647\u0627\xBB
        \u0631\u0648 \u0628\u0627\u0632 \u06A9\u0646 \u0648 \xAB\u0642\u0637\u0639
        \u0622\u062A\u0634\xBB \u0631\u0648 \u0628\u0632\u0646. \u0628\u0631\u0627\u06CC
        \u062F\u0641\u0627\u0639 \u062F\u0648\u0628\u0627\u0631\u0647\u060C \xAB\u062D\u0641\u0638\xBB
        \u0631\u0648 \u0628\u0632\u0646."
    - key: mission.m03.guide.topic.7.diagram
      value: "\u062D\u0641\u0638 \u2190 \u062F\u0641\u0627\u0639 \xB7 \u0641\u0631\u0645\u0627\u0646\u200C\u0647\u0627
        \u2190 \u0642\u0637\u0639 \u0622\u062A\u0634"
    - key: mission.m03.guide.topic.7.example
      value: "\u0648\u0642\u062A\u06CC \u0646\u06CC\u0631\u0648\u0647\u0627\u062A
        \u06A9\u0646\u0627\u0631 \u062C\u0627\u062F\u0647 \u0631\u0633\u06CC\u062F\u0646\u060C
        \xAB\u062D\u0641\u0638\xBB \u0631\u0648 \u0628\u0632\u0646. \u0627\u06AF\u0647
        \u0645\u06CC\u200C\u062E\u0648\u0627\u06CC \u062C\u0627\u0634\u0648\u0646
        \u0631\u0648 \u0639\u0648\u0636 \u06A9\u0646\u06CC\u060C \u0628\u0627 \xAB\u062D\u0631\u06A9\u062A\xBB
        \u0645\u0642\u0635\u062F \u062A\u0627\u0632\u0647 \u0628\u062F\u0647."
    - key: mission.m03.guide.topic.7.mistake
      value: "\xAB\u0642\u0637\u0639 \u0622\u062A\u0634\xBB \u0646\u0628\u0631\u062F
        \u0631\u0648 \u0645\u062A\u0648\u0642\u0641 \u0646\u0645\u06CC\u200C\u06A9\u0646\u0647.
        \u0627\u06AF\u0647 \u0628\u0631\u0627\u06CC \u062E\u0648\u0646\u062F\u0646
        \u0648\u0642\u062A \u0645\u06CC\u200C\u062E\u0648\u0627\u06CC\u060C \u0628\u0627\u0632\u06CC
        \u0631\u0648 \u0645\u06A9\u062B \u06A9\u0646."
    - key: mission.m03.guide.topic.7.title
      value: "\u062D\u0641\u0638 \u0648 \u0642\u0637\u0639 \u0622\u062A\u0634"
    - key: mission.m03.guide.topic.8.body
      value: "\u0627\u0633\u06A9\u0646\u060C \u0645\u062D\u062F\u0648\u062F\u0647\u0654
        \u0631\u0627\u062F\u0627\u0631 \u0633\u0627\u0644\u0645 \u0631\u0648 \u0628\u0631\u0631\u0633\u06CC
        \u0645\u06CC\u200C\u06A9\u0646\u0647. \u0627\u06AF\u0647 \u0686\u06CC\u0632\u06CC
        \u067E\u06CC\u062F\u0627 \u0646\u06A9\u0631\u062F\u060C \u06CC\u0639\u0646\u06CC
        \u062E\u0648\u062F\u0631\u0648\u06CC\u06CC \u062A\u0648\u06CC \u0627\u0648\u0646
        \u0645\u062D\u062F\u0648\u062F\u0647 \u0634\u0646\u0627\u0633\u0627\u06CC\u06CC
        \u0646\u0634\u062F\u0647. \u0645\u06CC\u200C\u062A\u0648\u0646\u06CC \u0627\u0633\u06A9\u0646
        \u0631\u0648 \u0628\u0631\u0627\u06CC \u0647\u0634\u062F\u0627\u0631 \u06A9\u0627\u0631\u0648\u0627\u0646
        \u0646\u06AF\u0647 \u062F\u0627\u0631\u06CC."
    - key: mission.m03.guide.topic.8.diagram
      value: "\u06F2 \u0646\u0648\u0628\u062A \xB7 \u0628\u0627\u0632\u06CC\u0627\u0628\u06CC
        \u06F6\u06F0 \u062B\u0627\u0646\u06CC\u0647 \xB7 \u067E\u0648\u0634\u0634
        \u0631\u0627\u062F\u0627\u0631 \u0632\u0645\u06CC\u0646\u06CC"
    - key: mission.m03.guide.topic.8.example
      value: "\u06CC\u0647 \u062E\u0648\u062F\u0631\u0648\u06CC \u062A\u0623\u06CC\u06CC\u062F\u0634\u062F\u0647
        \u0646\u0632\u062F\u06CC\u06A9\u0647\u061B \u0628\u0627 \u06CC\u0647 \u0627\u0633\u06A9\u0646
        \u0645\u06CC\u200C\u062A\u0648\u0646\u06CC \u062C\u0627\u0634 \u0631\u0648
        \u062A\u0627\u0632\u0647 \u06A9\u0646\u06CC. \u0646\u0648\u0628\u062A \u0628\u0639\u062F\u06CC
        \u0631\u0648 \u0628\u0631\u0627\u06CC \u0628\u062E\u0634 \u0627\u0635\u0644\u06CC
        \u06A9\u0627\u0631\u0648\u0627\u0646 \u0646\u06AF\u0647 \u062F\u0627\u0631."
    - key: mission.m03.guide.topic.8.mistake
      value: "\u0627\u0646\u062A\u0638\u0627\u0631 \u0628\u0627\u0632\u06AF\u0634\u062A
        \u0646\u0648\u0628\u062A \u0627\u0633\u06A9\u0646 \u0628\u062F\u0648\u0646
        \u062A\u0645\u0627\u0633 \u06CC\u0627 \u0622\u0634\u06A9\u0627\u0631\u0634\u062F\u0646
        \u06A9\u0644 \u0646\u0642\u0634\u0647."
    - key: mission.m03.guide.topic.8.title
      value: "\u0627\u0633\u06A9\u0646"
    - key: mission.m03.guide.topic.9.body
      value: "\u0628\u0647 \u062E\u0648\u062F\u0631\u0648\u06CC \u0645\u0633\u0644\u062D
        \u062A\u0623\u06CC\u06CC\u062F\u0634\u062F\u0647 \u0634\u0644\u06CC\u06A9
        \u06A9\u0646\u061B \u0646\u0641\u0631\u0628\u0631 \u0628\u06CC\u200C\u0633\u0644\u0627\u062D
        \u0631\u0648 \u0647\u0645 \u0642\u0628\u0644 \u0627\u0632 \u0631\u0633\u06CC\u062F\u0646
        \u0628\u0647 \u0645\u0631\u06A9\u0632 \u0645\u062A\u0648\u0642\u0641 \u06A9\u0646."
    - key: mission.m03.guide.topic.9.diagram
      value: "\u062E\u0648\u062F\u0631\u0648\u06CC \u0645\u0633\u0644\u062D \u2190
        \u0622\u0633\u06CC\u0628 \xB7 \u0646\u0641\u0631\u0628\u0631 \u2190 \u0648\u0631\u0648\u062F
        \u0628\u0647 \u0645\u0631\u06A9\u0632"
    - key: mission.m03.guide.topic.9.example
      value: "\u0622\u062A\u0634 \u062A\u0641\u0646\u06AF\u062F\u0627\u0631\u0647\u0627
        \u0631\u0648 \u0631\u0648\u06CC \u062E\u0648\u062F\u0631\u0648\u06CC \u0645\u0633\u0644\u062D
        \u0645\u062A\u0645\u0631\u06A9\u0632 \u06A9\u0646\u060C \u0648\u0644\u06CC
        \u06CC\u0647 \u06AF\u0631\u0648\u0647 \u0630\u062E\u06CC\u0631\u0647 \u0628\u06CC\u0646
        \u0646\u0641\u0631\u0628\u0631 \u0648 \u067E\u0627\u0633\u06AF\u0627\u0647
        \u0646\u06AF\u0647 \u062F\u0627\u0631."
    - key: mission.m03.guide.topic.9.mistake
      value: "\u0646\u0627\u062F\u06CC\u062F\u0647 \u06AF\u0631\u0641\u062A\u0646
        \u062E\u0648\u062F\u0631\u0648\u06CC \u062F\u0634\u0645\u0646 \u0628\u06CC\u200C\u0633\u0644\u0627\u062D
        \u0686\u0648\u0646 \u0646\u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F
        \u0634\u0644\u06CC\u06A9 \u06A9\u0646\u062F."
    - key: mission.m03.guide.topic.9.title
      value: "\u0627\u0646\u062A\u062E\u0627\u0628 \u0647\u062F\u0641"
    - key: mission.m03.guide.topics
      value: "\u06F1\u06F2 \u062F\u0631\u0633"
    - key: mission.m03.guide.unarmed
      value: "\u0628\u06CC\u200C\u0633\u0644\u0627\u062D"
    - key: mission.m03.guide.unavailable_stats
      value: "\u0648\u0642\u062A\u06CC \u0627\u0637\u0644\u0627\u0639\u0627\u062A
        \u06A9\u0644\u0627\u0633 \u0622\u0645\u0627\u062F\u0647 \u0628\u0634\u0647\u060C
        \u0622\u0645\u0627\u0631\u0634 \u0627\u06CC\u0646\u062C\u0627 \u0646\u0634\u0648\u0646
        \u062F\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0647."
    - key: mission.m03.jump
      value: "\u0646\u0645\u0627\u06CC\u0634 \u0645\u062D\u0644 \u06AF\u0632\u0627\u0631\u0634"
    - key: mission.m03.label.forces
      value: "\u0646\u06CC\u0631\u0648\u0647\u0627\u06CC \u0622\u063A\u0627\u0632\u06CC\u0646"
    - key: mission.m03.label.options
      value: "\u06AF\u0632\u06CC\u0646\u0647\u200C\u0647\u0627\u06CC \u062F\u0641\u0627\u0639\u06CC"
    - key: mission.m03.location
      value: "\u0645\u0633\u06CC\u0631 \u063A\u0631\u0628\u06CC \xB7 \u067E\u0627\u0633\u06AF\u0627\u0647
        \u0646\u06CC\u0631\u0648\u0647\u0627\u06CC \u0645\u0634\u062A\u0631\u06A9"
    - key: mission.m03.name
      value: "\u0647\u0634\u062F\u0627\u0631 \u0631\u0627\u062F\u0627\u0631"
    - key: mission.m03.objective.hold_post
      value: "\u067E\u0627\u0633\u06AF\u0627\u0647 \u0631\u0648 \u062D\u0641\u0638
        \u06A9\u0646"
    - key: mission.m03.objective.keep_core_clear
      value: "\u0627\u0632 \u0648\u0631\u0648\u062F \u062F\u0634\u0645\u0646 \u0628\u0647
        \u0645\u062D\u062F\u0648\u062F\u0647\u0654 \u0645\u0631\u06A9\u0632\u06CC
        \u062C\u0644\u0648\u06AF\u06CC\u0631\u06CC \u06A9\u0646"
    - key: mission.m03.objective.prevent_breach
      value: "\u0627\u0632 \u0648\u0631\u0648\u062F \u062F\u0634\u0645\u0646 \u0628\u0647
        \u0645\u062D\u062F\u0648\u062F\u0647\u0654 \u0645\u0631\u06A9\u0632\u06CC
        \u062C\u0644\u0648\u06AF\u06CC\u0631\u06CC \u06A9\u0646"
    - key: mission.m03.objective.protect_post
      value: "\u067E\u0627\u0633\u06AF\u0627\u0647 \u0631\u0648 \u062D\u0641\u0638
        \u06A9\u0646"
    - key: mission.m03.objective.stop_convoy
      value: "\u0647\u0631 \u062F\u0648 \u0628\u062E\u0634 \u06A9\u0627\u0631\u0648\u0627\u0646
        \u0631\u0648 \u0645\u062A\u0648\u0642\u0641 \u06A9\u0646"
    - key: mission.m03.optional.skip
      value: "\u0631\u062F\u06A9\u0631\u062F\u0646 \u062F\u0631\u0633 \u0627\u062E\u062A\u06CC\u0627\u0631\u06CC"
    - key: mission.m03.options
      value: "\u0628\u0631\u062C \u0646\u06AF\u0647\u0628\u0627\u0646\u06CC\u060C
        \u0645\u0627\u0646\u0639 \u06CC\u0627 \u062A\u0641\u0646\u06AF\u062F\u0627\u0631\u0627\u0646
        \u06A9\u0645\u06A9\u06CC"
    - key: mission.m03.order.holding
      value: "\u062F\u0631 \u062D\u0627\u0644 \u062D\u0641\u0638 \u0645\u0648\u0636\u0639"
    - key: mission.m03.ping.cooldown
      value: "\u0622\u0645\u0627\u062F\u0647 \u062A\u0627 {0} \u062B\u0627\u0646\u06CC\u0647\u0654
        \u062F\u06CC\u06AF\u0631"
    - key: mission.m03.ping.empty
      value: "\u0646\u0648\u0628\u062A\u06CC \u0628\u0627\u0642\u06CC \u0646\u0645\u0627\u0646\u062F\u0647
        \u0627\u0633\u062A"
    - key: mission.m03.ping.label
      value: "\u0627\u0633\u06A9\u0646"
    - key: mission.m03.ping.no_sensor
      value: "\u062D\u0633\u06AF\u0631 \u0632\u0645\u06CC\u0646\u06CC \u062F\u0631
        \u062F\u0633\u062A\u0631\u0633 \u0646\u06CC\u0633\u062A"
    - key: mission.m03.ping.paused
      value: "\u0645\u06A9\u062B"
    - key: mission.m03.ping.ready
      value: "\u0627\u0633\u06A9\u0646 \xB7 {0} \u0646\u0648\u0628\u062A"
    - key: mission.m03.ping.recharging_label
      value: "\u0628\u0627\u0632\u06CC\u0627\u0628\u06CC \u0631\u0627\u062F\u0627\u0631"
    - key: mission.m03.ping.requested
