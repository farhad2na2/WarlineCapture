.scn08-match-hud-content {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    -unity-font-definition: url("../../../Synty/InterfaceMilitaryCombatHUD/Fonts/Oxanium/Oxanium-Medium.ttf");
    color: rgb(220, 216, 192);
    background-color: rgba(0, 0, 0, 0);
}

.scn08-match-hud-content Button {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
}

.header-content {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 10.4%;
}

.header-back-plate {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 100%;
    background-color: rgba(7, 10, 10, 0.78);
}

.objectives-panel {
    position: absolute;
    left: 0.35%;
    top: 5.8%;
    width: 13.95%;
    height: 192%;
}

.objectives-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV01/scn08_objective_panel_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 44;
    -unity-slice-right: 44;
    -unity-slice-top: 34;
    -unity-slice-bottom: 34;
}

.objectives-title {
    position: absolute;
    left: 9%;
    right: 9%;
    top: 5%;
    height: 12%;
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(232, 227, 203);
}

.objective-row {
    position: absolute;
    left: 5%;
    right: 5%;
    top: 24%;
    height: 16%;
}

.objective-row-second {
    top: 43.5%;
}

.objective-row-third {
    top: 63%;
}

.objective-icon {
    position: absolute;
    left: 3%;
    top: 17%;
    width: 9%;
    height: 66%;
    -unity-background-scale-mode: scale-to-fit;
}

.objective-unchecked {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV01/scn08_icon_checkbox_empty.png");
}

.objective-checked {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV01/scn08_icon_checkbox_checked.png");
}

.objective-star {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV01/scn08_icon_objective_star.png");
}

.objective-text {
    position: absolute;
    left: 17%;
    right: 2%;
    top: 0;
    bottom: 0;
    font-size: 22px;
    -unity-text-align: middle-left;
    color: rgba(218, 222, 208, 0.9);
}

.objectives-elapsed {
    position: absolute;
    left: 13%;
    right: 13%;
    bottom: 5%;
    height: 9.5%;
    font-size: 20px;
    -unity-text-align: middle-center;
    color: rgba(202, 214, 205, 0.78);
}

.resource-strip {
