      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: m03-brief-03
      textKey: narrative.m03.brief.03
      englishFallback: We have roughly a minute to prepare. Two rifle squads and
        a working Barracks are ready. Choose a Tower, a Barrier, or reinforcements.
        The first warning is an estimate.
      speaker: 3
      voiceClip: {fileID: 8300000, guid: 78be0347e2db04fae802ac187911a557, type: 3}
