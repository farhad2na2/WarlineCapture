      m_SubObjectName: CH05M03_NetworkCollapse_Debrief-b-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: network_collapse-debrief-02
      textKey: narrative.network_collapse.debrief-02
      englishFallback: The complete audit ties Qassem to the original override, the
        attempted erasure, Ash Line bombings, false reports, diverted Fuel and Vanguard
        hardware. Civilian and military authorities have copies. He manufactured
        the crisis to make permanent emergency rule appear necessary.
      speaker: 3
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 19.642857
      essentialCaption: 1
    continueStateId: NetworkCollapse-debrief-2
    skipStateId: NetworkCollapse-debrief-complete
    reducedMotionSupported: 1
    durationSeconds: 19.642857
