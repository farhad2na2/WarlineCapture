}

.xp-value {
    right: 0;
    top: 45%;
    width: 38%;
    height: 44%;
    font-size: 15px;
    -unity-text-align: middle-right;
}

.stats-panel {
    position: absolute;
    left: 8.6%;
    right: 8.6%;
    top: 48.4%;
    height: 23.5%;
}

.stat-row {
    position: relative;
    width: 100%;
    height: 20%;
}

.stat-icon {
    position: absolute;
    left: 0;
    top: 17%;
    width: 8%;
    height: 66%;
