      m_SubObjectName: CH05M02_TrustUnderFire_Debrief-b-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: trust_under_fire-debrief-02
      textKey: narrative.trust_under_fire.debrief-02
      englishFallback: The secured transmitter and the witness recording identify
        the same source. I have preserved the signal records and their custody trail.
        They point to Qassem's final command network and remain available to civilian
        and military oversight.
      speaker: 3
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 17
      essentialCaption: 1
    continueStateId: TrustUnderFire-debrief-2
    skipStateId: TrustUnderFire-debrief-complete
    reducedMotionSupported: 1
    durationSeconds: 17
    motionPreset: 0
    locationTitleKey: 
    locationTitleFallback: 
    locationSubtitleKey: 
