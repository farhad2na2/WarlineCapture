/* ==========================================================================
   SCN-19 Armory Content — UI Toolkit USS
   Target reference: SCN-19_Armory_NewMainMenuArtDirection_TargetLock_V04.png
   1672×941 landscape, bright premium command-table art direction.
   All percentage positions are relative to the screen root (1672×941 ref).
   Slice values computed from actual sprite pixel dimensions.
   ========================================================================== */

/* --- Root --- */
.scn19-armory-content {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    -unity-font-definition: url("../../../Synty/InterfaceMilitaryCombatHUD/Fonts/Oxanium/Oxanium-Bold.ttf");
    color: rgb(242, 232, 196);
    background-color: rgb(8, 10, 10);
}

.scn19-armory-content Button,
.armory-item-view {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
}

/* --- Absolute-fill helpers --- */
.background,
.background-shade,
.header-back-plate,
.middle-frame,
.inspection-frame,
.inspection-backing,
.category-frame,
.item-frame,
.bottom-tab-frame,
.resource-frame,
.header-menu-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* --- Background --- */
.background {
    left: -1.5%;
    right: -1.5%;
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_background_command_table_no_ui.png");
    -unity-background-scale-mode: scale-and-crop;
}

.background-shade {
    background-color: rgba(6, 7, 6, 0.22);
}

/* ========================================================================
   HEADER
   Ref: top bar spanning full width, logo left ~14% width, resource chips
   center-right, menu button far right.  Header height ~11% of screen.
   ======================================================================== */
.header-content {
    position: absolute;
    left: 0.3%;
    right: 0.3%;
    top: 0.6%;
    height: 11.5%;
}

/* Header bar frame: sprite 1608×262, slice ~6.8% L/R, ~19.8% T/B */
.header-back-plate {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_header_bar_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 110;
    -unity-slice-right: 110;
    -unity-slice-top: 52;
    -unity-slice-bottom: 52;
    -unity-slice-scale: 0.30;
}

.header-logo-panel {
    position: absolute;
    left: 1.5%;
    top: 10%;
    width: 14.5%;
    height: 78%;
}

.header-logo {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/SplashLoading/TargetLockV04Imagegen/Sprites/scn01_v04_logo_lockup.png");
    -unity-background-scale-mode: scale-to-fit;
}

.header-resource-area {
    position: absolute;
    right: 6.2%;
    top: 18%;
    width: 52%;
    height: 62%;
    flex-direction: row;
    justify-content: space-between;
}

.resource-panel {
    position: relative;
    width: 23%;
    height: 100%;
}

.risk-panel {
    width: 27%;
}

/* Resource chip frame: sprite 1466×325, slice ~9.2% L/R, ~25.2% T/B */
.resource-frame {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_resource_chip_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 135;
    -unity-slice-right: 135;
    -unity-slice-top: 82;
    -unity-slice-bottom: 82;
    -unity-slice-scale: 0.20;
}

.resource-icon,
.resource-text-block,
.resource-plus,
.header-menu-icon {
    position: absolute;
}

.resource-icon {
    left: 6%;
    top: 20%;
    width: 16%;
    height: 60%;
    -unity-background-scale-mode: scale-to-fit;
}

.credits-icon {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_icon_credits_coin.png");
}

.fuel-icon {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_icon_fuel_can.png");
}

.supply-icon {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_resource_crate_icon.png");
}

.risk-icon {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_icon_civilian_group.png");
}

.resource-text-block {
    left: 25%;
    right: 16%;
    top: 10%;
    bottom: 8%;
}

.risk-text-block {
    right: 8%;
}

.resource-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 38%;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: lower-left;
    color: rgb(200, 192, 160);
    letter-spacing: 1px;
    white-space: nowrap;
}

.resource-value {
    position: absolute;
    left: 0;
    right: 0;
    top: 36%;
    bottom: 0;
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: upper-left;
    color: rgb(238, 202, 58);
    white-space: nowrap;
}

.resource-plus {
    right: 4%;
    top: 33%;
    width: 10%;
    height: 34%;
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_plus_icon.png");
    -unity-background-scale-mode: scale-to-fit;
}

.header-menu-button {
    position: absolute;
    right: 1.5%;
    top: 18%;
    width: 4.5%;
    height: 62%;
}

/* Menu button frame: sprite 887×902, nearly square — slice ~16.9% all sides */
.header-menu-frame {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_header_square_button_frame_default.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 150;
    -unity-slice-right: 150;
    -unity-slice-top: 150;
    -unity-slice-bottom: 150;
    -unity-slice-scale: 0.16;
}

.header-menu-icon {
    left: 22%;
    right: 22%;
    top: 22%;
    bottom: 22%;
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_menu_hamburger_icon.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* ========================================================================
   LEFT CATEGORY RAIL
   Ref: vertical button stack, ~16% width, centered vertically between
   header and footer. 5 category buttons evenly spaced.
   ======================================================================== */
.left-content {
    position: absolute;
    left: 0.8%;
    top: 14%;
    width: 15.5%;
    height: 72%;
}

.left-nav-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
    justify-content: space-between;
}

.category-button {
    position: relative;
    width: 100%;
    height: 18.5%;
}

/* Category button frame: sprite 307×75, slice ~18.9% L/R, ~26.7% T/B */
.category-frame {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_category_button_default_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 58;
    -unity-slice-right: 58;
    -unity-slice-top: 20;
    -unity-slice-bottom: 20;
    -unity-slice-scale: 0.50;
}

.category-selected .category-frame {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_category_button_selected_frame.png");
}

.category-icon {
    position: absolute;
    left: 10%;
    top: 22%;
    width: 16%;
    height: 56%;
    -unity-background-scale-mode: scale-to-fit;
}

.units-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_units_group.png");
}

.vehicles-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_vehicle_truck.png");
}

.aircraft-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_aircraft_helicopter.png");
}

.buildings-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_buildings.png");
}

.upgrades-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_upgrades_chevrons.png");
}

.category-label {
    position: absolute;
    left: 32%;
    right: 6%;
    top: 0;
    bottom: 0;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(240, 232, 199);
    white-space: nowrap;
}

/* ========================================================================
   MIDDLE PANEL — Armory inventory grid
   Ref: large central panel with title, dropdowns, scrollable card grid.
   ======================================================================== */
.middle-content {
    position: absolute;
    left: 17%;
    top: 13%;
    width: 57%;
    height: 73%;
}

/* Panel frame large: sprite 1496×204, slice ~5.2% L/R, ~29.4% T/B */
.middle-frame {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_panel_frame_large.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 78;
    -unity-slice-right: 78;
    -unity-slice-top: 60;
    -unity-slice-bottom: 60;
    -unity-slice-scale: 0.40;
    -unity-background-image-tint-color: rgb(246, 232, 182);
}

.screen-title {
    position: absolute;
    left: 2.5%;
    top: 2.5%;
    width: 28%;
    height: 8%;
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(242, 232, 196);
    letter-spacing: 2px;
}

/* Dropdown frame: sprite 247×75, slice ~19.4% L/R, ~29.3% T/B */
.dropdown {
    position: absolute;
    top: 3.5%;
    height: 6.5%;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_dropdown_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 22;
    -unity-slice-bottom: 22;
    -unity-slice-scale: 0.50;
}

.filter-dropdown {
    right: 30%;
    width: 22%;
}

.sort-dropdown {
    right: 3.5%;
    width: 22%;
}

.dropdown-label {
    position: absolute;
    left: 7%;
    right: 16%;
    top: 0;
    bottom: 0;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(242, 232, 196);
    white-space: nowrap;
}

.dropdown-chevron {
    position: absolute;
    right: 5%;
    top: 28%;
    width: 8%;
    height: 44%;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_dropdown_chevron.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* --- Scroll view & grid --- */
.armory-scroll-view {
    position: absolute;
    left: 2.5%;
    right: 2.5%;
    top: 13%;
    bottom: 3%;
    background-color: rgba(0, 0, 0, 0);
}

.armory-scroll-view .unity-scroll-view__vertical-scroller,
.armory-scroll-view .unity-scroll-view__horizontal-scroller {
    display: none;
}

.armory-scroll-view > .unity-scroll-view__content-container {
    width: 100%;
    min-width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

.armory-catalog-grid {
    width: 100%;
    min-width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    padding-left: 0.5%;
    padding-right: 0.5%;
    padding-top: 0.5%;
    padding-bottom: 20px;
}

/* --- Item card --- */
/* Ref shows 4 cards per row with consistent spacing, card aspect ~2:2.87 */
.armory-item-view {
    position: relative;
    width: 23%;
    height: 300px;
    margin-right: 1.5%;
    margin-bottom: 16px;
    overflow: hidden;
}

/* Roster card frame: sprite 288×414, slice ~18.8% L/R, ~15.5% T/B */
.item-frame {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_roster_card_default_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 54;
    -unity-slice-right: 54;
    -unity-slice-top: 64;
    -unity-slice-bottom: 64;
    -unity-slice-scale: 0.72;
}

.armory-item-view.selected .item-frame {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_roster_card_selected_frame.png");
}

.armory-item-view.locked .item-frame {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_roster_card_locked_frame.png");
}

/* Rarity star/badge at top center */
.item-rarity {
    position: absolute;
    left: 44%;
    top: 1%;
    width: 12%;
    height: 7%;
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_deploy_star_icon.png");
    -unity-background-scale-mode: scale-to-fit;
}

.rarity-purple {
    -unity-background-image-tint-color: rgb(190, 126, 231);
}

/* Card art well — centered portrait area */
.item-art {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 12%;
    height: 38%;
    background-color: rgb(14, 17, 16);
    -unity-background-scale-mode: scale-and-crop;
}

.rifle-art,
.sniper-art,
.bomb-art {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_art_rifleman_male_ii.png");
}

.vehicle-art,
.tank-art,
.artillery-art {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_art_canopy_truck.png");
}

.aircraft-art,
.helicopter-art {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_art_attack_helicopter.png");
}

/* Item title — centered below art */
.item-title {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 53%;
    height: 8%;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(244, 238, 210);
    white-space: nowrap;
}

/* State row — OWNED/LOCKED label + badge */
.item-state-row {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 63%;
    height: 8%;
}

.owned-badge,
.lock-badge {
    position: absolute;
    right: 0;
    top: 10%;
    width: 16%;
    height: 80%;
    -unity-background-scale-mode: scale-to-fit;
}

.owned-badge {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_badge_owned_checkmark.png");
}

.lock-badge {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_hold_shield.png");
    -unity-background-image-tint-color: rgb(205, 81, 64);
}

.item-state-label {
    position: absolute;
    left: 0;
    right: 18%;
    top: 0;
    bottom: 0;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.owned-state {
    color: rgb(154, 226, 64);
}

.locked-state {
    color: rgb(229, 84, 60);
}

/* Progress bar + level/type labels at bottom of card */
.item-progress {
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: 6%;
    height: 13%;
}

/* Progress meter empty frame: sprite 339×26, slice ~10.6% L/R, ~26.9% T/B */
.item-progress-track {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 32%;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_progress_meter_empty_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 36;
    -unity-slice-right: 36;
    -unity-slice-top: 7;
    -unity-slice-bottom: 7;
    -unity-slice-scale: 0.72;
}

/* Progress fill: sprite 112×46, slice ~19.6% L/R, ~10.9% T/B */
.item-progress-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 78%;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_progress_fill_olive_segment.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 22;
    -unity-slice-right: 22;
    -unity-slice-top: 5;
    -unity-slice-bottom: 5;
    -unity-slice-scale: 0.72;
}

.medium-fill {
    width: 58%;
}

.item-level,
.item-type {
    position: absolute;
    top: 38%;
    bottom: 0;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(226, 218, 188);
}

.item-level {
    left: 0;
    width: 42%;
    -unity-text-align: middle-left;
}

.item-type {
    right: 0;
    width: 52%;
    -unity-text-align: middle-right;
}

/* ========================================================================
   RIGHT — INSPECTION PANEL
   Ref: tall panel on right side, portrait + stats + CTAs.
   Layered composition: hollow outer frame + dark solid backing +
   section bar backings for clean content alignment.
   ======================================================================== */
.right-content {
    position: absolute;
    right: 0.8%;
    top: 13%;
    width: 25%;
    height: 73%;
}

.inspection-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* Dark solid backing fills the entire panel interior */
.inspection-backing {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_mode_card_backing_selected.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* Outer frame: sprite 783×1390, hollow 9-slice, borders ~33px L/R, ~31px T/B
   Tall vertical card frame — clean border, no baked-in sections */
.inspection-frame {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_mode_card_frame_selected.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 33;
    -unity-slice-right: 34;
    -unity-slice-top: 30;
    -unity-slice-bottom: 32;
    -unity-slice-scale: 0.30;
}

.inspection-name {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 2.5%;
    height: 6%;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(242, 232, 196);
    white-space: nowrap;
}

.inspection-type {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 8.5%;
    height: 4%;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    color: rgb(156, 226, 62);
    letter-spacing: 1px;
}

/* --- Section containers --- */
/* Each section is a positioned container with a dark bar backing */
.inspection-section {
    position: absolute;
    left: 6%;
    right: 6%;
}

/* Section bar backing: uses comms_status_panel_frame sprite (439×112)
   which is a solid dark bar with a thin gold accent on left edge.
   Slice ~4.1% L (gold accent), ~2.3% R, ~25% T/B */
.section-bar-backing {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_comms_status_panel_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 18;
    -unity-slice-right: 10;
    -unity-slice-top: 28;
    -unity-slice-bottom: 28;
    -unity-slice-scale: 0.50;
}

/* Portrait section: art well with backing */
.portrait-section {
    top: 14%;
    height: 27%;
}

.inspection-portrait-frame {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 10%;
    bottom: 10%;
    background-color: rgb(10, 14, 13);
    overflow: hidden;
}

.inspection-portrait-art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_art_rifleman_male_ii.png");
    -unity-background-scale-mode: scale-and-crop;
}

/* Level section: level label, value, XP bar */
.level-section {
    top: 42.5%;
    height: 12%;
}

.level-label,
.level-value,
.xp-value {
    position: absolute;
    -unity-font-style: bold;
    color: rgb(232, 222, 190);
}

.level-label {
    left: 8%;
    top: 12%;
    width: 28%;
    height: 30%;
    font-size: 13px;
    -unity-text-align: middle-left;
}

.level-value {
    right: 8%;
    top: 12%;
    width: 36%;
    height: 30%;
    font-size: 13px;
    -unity-text-align: middle-right;
}

.level-track {
    position: absolute;
    left: 8%;
    right: 36%;
    top: 52%;
    height: 22%;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_progress_meter_empty_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 36;
    -unity-slice-right: 36;
    -unity-slice-top: 7;
    -unity-slice-bottom: 7;
    -unity-slice-scale: 0.72;
}

.level-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 62%;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_progress_fill_olive_segment.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 22;
    -unity-slice-right: 22;
    -unity-slice-top: 5;
    -unity-slice-bottom: 5;
    -unity-slice-scale: 0.72;
}

.xp-value {
    right: 8%;
    top: 52%;
    width: 28%;
    height: 40%;
    font-size: 11px;
    -unity-text-align: middle-right;
    color: rgb(180, 172, 140);
}

/* Stats section: 5 stat rows with icon, name, value */
.stats-section {
    top: 55.5%;
    height: 19%;
}

.stats-panel {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 8%;
    bottom: 8%;
}

.stat-row {
    position: relative;
    width: 100%;
    height: 20%;
}

.stat-icon {
    position: absolute;
    left: 0;
    top: 15%;
    width: 8%;
    height: 70%;
    -unity-background-scale-mode: scale-to-fit;
}

.health-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_health_cross.png");
}

.damage-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_damage_burst.png");
}

.armor-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_hold_shield.png");
}

.speed-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_speed_boot.png");
}

.capacity-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_units_group.png");
}

.stat-name {
    position: absolute;
    left: 11%;
    width: 52%;
    top: 0;
    bottom: 0;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(207, 197, 164);
}

.stat-value {
    position: absolute;
    right: 0;
    width: 34%;
    top: 0;
    bottom: 0;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: rgb(157, 226, 61);
}

/* --- CTA buttons --- */
/* CTA frames: primary gold 172×77, secondary dark 158×77
   slice ~24.4% L/R, ~28.6% T/B for primary; ~26.6% L/R for secondary */
.cta-button {
    position: absolute;
    left: 8%;
    right: 8%;
    height: 7%;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_cta_secondary_dark_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 42;
    -unity-slice-right: 42;
    -unity-slice-top: 22;
    -unity-slice-bottom: 22;
    -unity-slice-scale: 0.55;
}

.primary-cta {
    top: 76%;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_cta_primary_gold_frame.png");
}

.equip-cta {
    top: 84%;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_category_button_selected_frame.png");
}

.close-cta {
    top: 92%;
}

.cta-icon,
.close-x {
    position: absolute;
    left: 18%;
    top: 18%;
    width: 12%;
    height: 64%;
    -unity-background-scale-mode: scale-to-fit;
}

.upgrade-cta-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_upgrades_chevrons.png");
}

.equip-cta-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_attack_reticle.png");
}

.close-x {
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(232, 222, 190);
}

.cta-label {
    position: absolute;
    left: 33%;
    right: 6%;
    top: 0;
    bottom: 0;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(242, 232, 196);
}

.primary-cta .cta-label {
    color: rgb(37, 31, 13);
}

/* ========================================================================
   FOOTER — Bottom navigation tab strip
   Ref: compact tab strip, 5 tabs, spanning most of the bottom width.
   ======================================================================== */
.footer-content {
    position: absolute;
    left: 2%;
    right: 2%;
    bottom: 1.5%;
    height: 8.5%;
}

.bottom-nav-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: row;
    justify-content: space-between;
}

.bottom-tab {
    position: relative;
    width: 19%;
    height: 100%;
}

/* Bottom tab frame: sprite 174×77, slice ~21.8% L/R, ~27.3% T/B */
.bottom-tab-frame {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_bottom_tab_default_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 38;
    -unity-slice-right: 38;
    -unity-slice-top: 21;
    -unity-slice-bottom: 21;
    -unity-slice-scale: 0.50;
}

.bottom-tab-selected .bottom-tab-frame {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_bottom_tab_selected_frame.png");
}

.bottom-tab-icon {
    position: absolute;
    left: 10%;
    top: 22%;
    width: 14%;
    height: 56%;
    -unity-background-scale-mode: scale-to-fit;
}

.tab-armory-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_armory_crossed_weapons.png");
}

.tab-workshop-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_settings_gear.png");
}

.tab-doctrine-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_hold_shield.png");
}

.tab-depot-icon {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_resource_crate_icon.png");
}

.tab-officers-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_units_group.png");
}

.bottom-tab-label {
    position: absolute;
    left: 28%;
    right: 5%;
    top: 0;
    bottom: 0;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(242, 232, 196);
    white-space: nowrap;
}