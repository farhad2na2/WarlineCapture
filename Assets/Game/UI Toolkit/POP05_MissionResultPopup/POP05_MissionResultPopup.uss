.pop05-mission-result-popup {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    -unity-font-definition: url("../../../Synty/InterfaceMilitaryCombatHUD/Fonts/Oxanium/Oxanium-Medium.ttf");
    color: rgb(239, 232, 202);
    background-color: rgba(0, 0, 0, 0);
}

.pop05-mission-result-popup Button {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
}

.backdrop-scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/SplashLoading/TargetLockV04Imagegen/Sprites/scn01_v04_background_no_ui.png");
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgb(92, 80, 48);
    background-color: rgba(0, 0, 0, 0.74);
}

.popup-frame {
    position: absolute;
    left: 13.4%;
    right: 13.4%;
    top: 4.4%;
    bottom: 4.8%;
    transform-origin: 50% 50%;
    background-color: rgba(5, 9, 9, 0.94);
}

.popup-chrome {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/chrome_01_drawer_outer_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 96;
    -unity-slice-right: 96;
    -unity-slice-top: 72;
    -unity-slice-bottom: 72;
    -unity-slice-scale: 0.54px;
}

.modal-header {
    position: absolute;
    left: 6.2%;
    right: 6.2%;
    top: 3.5%;
    height: 11.8%;
}

.modal-header-badge {
    position: absolute;
    left: 27.5%;
    top: 3%;
    width: 7.2%;
    height: 92%;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_icon_squad_badge.png");
    -unity-background-scale-mode: scale-to-fit;
}

.modal-title {
    position: absolute;
    left: 35.2%;
    right: 12%;
    top: 0;
    bottom: 0;
    font-size: 84px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    letter-spacing: 0;
    color: rgb(238, 225, 190);
    white-space: nowrap;
}

.close-visual-button {
    position: absolute;
    right: 0;
    top: 10%;
    width: 7.2%;
    height: 78%;
    translate: 0 0;
    scale: 1 1;
    transition-property: translate, scale;
    transition-duration: 90ms;
    transition-timing-function: ease-out;
}

.close-visual-button:hover,
.close-visual-button:focus {
    translate: 0 -3px;
    scale: 1.045 1.045;
}

.close-visual-button:active {
    translate: 0 -1px;
    scale: 0.985 0.985;
}

.close-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_header_square_button_frame_default.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 34;
    -unity-slice-right: 34;
    -unity-slice-top: 34;
    -unity-slice-bottom: 34;
    -unity-slice-scale: 0.48px;
}

.close-icon {
    position: absolute;
    left: 28%;
    right: 28%;
    top: 28%;
    bottom: 28%;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_20_icon_close.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(238, 222, 181);
}

.result-choice-band {
    position: absolute;
    left: 4.2%;
    right: 4.2%;
    top: 15.7%;
    height: 15.2%;
    flex-direction: row;
    justify-content: space-between;
}

.result-choice-panel {
    position: relative;
    width: 49.2%;
    height: 100%;
    background-color: rgba(9, 16, 14, 0.88);
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_panel_frame_large.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 92;
    -unity-slice-right: 92;
    -unity-slice-top: 62;
    -unity-slice-bottom: 62;
    -unity-slice-scale: 0.40px;
}

.result-choice-selected {
    background-color: rgba(78, 92, 17, 0.90);
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_selected_panel_frame.png");
    -unity-slice-scale: 0.44px;
}

.selected-pointer {
    position: absolute;
    left: 50%;
    top: -10%;
    width: 7%;
    height: 19%;
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_deploy_chevron_right.png");
    -unity-background-scale-mode: scale-to-fit;
    rotate: 90deg;
}

.result-badge {
    position: absolute;
    left: 13.8%;
    top: 18%;
    width: 13%;
    height: 64%;
    -unity-background-scale-mode: scale-to-fit;
}

.victory-badge {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_icon_squad_badge.png");
}

.loss-badge,
.defeat-badge {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_icon_warning_triangle.png");
    -unity-background-image-tint-color: rgb(212, 82, 45);
}

.result-title {
    position: absolute;
    left: 33%;
    right: 7%;
    top: 13%;
    height: 49%;
    font-size: 82px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    letter-spacing: 0;
    color: rgb(247, 217, 99);
    white-space: nowrap;
}

.result-subtitle {
    position: absolute;
    left: 33.4%;
    right: 6%;
    bottom: 16%;
    height: 25%;
    font-size: 27px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    letter-spacing: 0;
    color: rgb(218, 214, 166);
    white-space: nowrap;
}

.defeat-title {
    color: rgb(210, 80, 42);
}

.defeat-subtitle {
    color: rgb(193, 185, 160);
}

.mission-rating-panel {
    position: absolute;
    left: 32%;
    right: 32%;
    top: 31.8%;
    height: 11.2%;
}

.rating-rule {
    position: absolute;
    top: 18%;
    width: 26%;
    height: 2px;
    background-color: rgba(208, 157, 52, 0.92);
}

#LeftRule {
    left: 0;
}

#RightRule {
    right: 0;
}

.rating-title {
    position: absolute;
    left: 25.5%;
    right: 25.5%;
    top: 0;
    height: 34%;
    font-size: 25px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 0;
    color: rgb(233, 219, 185);
    white-space: nowrap;
}

.stars-row {
    position: absolute;
    left: 20%;
    right: 20%;
    bottom: 0;
    height: 67%;
    flex-direction: row;
    justify-content: space-between;
}

.rating-star {
    width: 27%;
    height: 100%;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_icon_objective_star.png");
    -unity-background-scale-mode: scale-to-fit;
}

.rating-star-filled {
    -unity-background-image-tint-color: rgb(255, 214, 61);
}

.rating-star-empty {
    opacity: 0.40;
    -unity-background-image-tint-color: rgb(230, 162, 42);
}

.stats-panel {
    position: absolute;
    left: 4.2%;
    right: 4.2%;
    top: 43.6%;
    height: 11.5%;
    background-color: rgba(9, 13, 13, 0.88);
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_wide_rail_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 82;
    -unity-slice-right: 82;
    -unity-slice-top: 38;
    -unity-slice-bottom: 38;
    -unity-slice-scale: 0.46px;
}

.stats-grid {
    position: absolute;
    left: 2%;
    right: 2%;
    top: 13%;
    bottom: 13%;
    flex-direction: row;
}

.stat-card {
    position: relative;
    width: 20%;
    height: 100%;
    border-right-width: 1px;
    border-right-color: rgba(208, 157, 52, 0.38);
}

.stat-card.highlighted {
    border-right-width: 0;
}

.stat-icon {
    position: absolute;
    left: 6%;
    top: 22%;
    width: 18%;
    height: 56%;
