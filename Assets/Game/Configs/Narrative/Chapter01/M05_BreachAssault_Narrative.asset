      m_EditorAssetChanged: 0
    lines:
    - lineId: m05-comms-01
      textKey: narrative.m05.comms.01
      englishFallback: The archive is intact. I have recovered Protocol Fragment
        One. Its authorization record includes a credential issued to me, then revoked
        before these attacks.
      speaker: 3
      voiceClip: {fileID: 8300000, guid: d6fd38cb7335c49bc96a85c95421d355, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 12.92
      essentialCaption: 1
    continueStateId: M05-debrief-1
    skipStateId: M05-debrief-complete
    reducedMotionSupported: 1
    durationSeconds: 13.17
    motionPreset: 0
