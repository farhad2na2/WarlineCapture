  m_Name: CH02M01_Gridlock_brief
  m_EditorClassIdentifier: Game.Configs::Game.Configs.NarrativeSequenceConfig
  sequenceId: seq.ch02.m01.brief
  entryStateId: Gridlock-brief-0
  defaultSkipDestinationId: Gridlock-brief-complete
  states:
  - stateId: Gridlock-brief-0
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: ae7730a65d54f44d79a4c9e1e1596f74
      m_SubObjectName: CH02-B01-16x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    panel20x9Reference:
      m_AssetGUID: ae7730a65d54f44d79a4c9e1e1596f74
      m_SubObjectName: CH02-B01-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: gridlock-brief-01
      textKey: narrative.gridlock.brief.01
      englishFallback: The hospital still has patients, but its supply road is blocked.
        That truck carries the relief they need. We must get it through.
      speaker: 2
      voiceClip: {fileID: 8300000, guid: a60de91f1a5b746bfa525720231b1b97, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 12.28
      essentialCaption: 1
    continueStateId: Gridlock-brief-1
    skipStateId: Gridlock-brief-complete
    reducedMotionSupported: 1
    durationSeconds: 12.28
    motionPreset: 0
    locationTitleKey: 
    locationTitleFallback: 
    locationSubtitleKey: 
    locationSubtitleFallback: 
    musicCue: 0
    ambienceCue: 0
    vehicleCue: 0
    eventCue: 3
    routeRole: 0
    completionPayloadId: 
    evidenceIds: []
    missionContextFlags: []
  - stateId: Gridlock-brief-1
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: 496abf8de1b614539b128c6a6ddb34e0
      m_SubObjectName: CH02-B02-16x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    panel20x9Reference:
      m_AssetGUID: 496abf8de1b614539b128c6a6ddb34e0
      m_SubObjectName: CH02-B02-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: gridlock-brief-02
      textKey: narrative.gridlock.brief.02
      englishFallback: Fadi here. The main road is gone, but we kept a service lane
        open for years. Two obstructions are all that stand between us and the hospital.
        Protect my crew while we clear them.
      speaker: 6
      voiceClip: {fileID: 8300000, guid: 718a572633f1745138d7e5d7c79a0a7a, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 13.72
      essentialCaption: 1
    continueStateId: Gridlock-brief-2
    skipStateId: Gridlock-brief-complete
    reducedMotionSupported: 1
    durationSeconds: 13.72
    motionPreset: 0
    locationTitleKey: 
    locationTitleFallback: 
    locationSubtitleKey: 
    locationSubtitleFallback: 
    musicCue: 0
    ambienceCue: 0
    vehicleCue: 0
    eventCue: 3
    routeRole: 0
    completionPayloadId: 
    evidenceIds: []
    missionContextFlags: []
  - stateId: Gridlock-brief-2
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: a7c15f52e3a0746da9b1045de6102939
      m_SubObjectName: CH02-B03-16x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    panel20x9Reference:
      m_AssetGUID: a7c15f52e3a0746da9b1045de6102939
      m_SubObjectName: CH02-B03-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: gridlock-brief-03
      textKey: narrative.gridlock.brief.03
      englishFallback: Rifles first; workers behind cover. Keep Fadi and at least
        one worker at each site for twenty-five seconds of safe work. Then protect
        the truck and hold the hospital clear for twenty seconds. We have twelve
        minutes.
      speaker: 1
      voiceClip: {fileID: 8300000, guid: 9d9c3e68a32b0411ebc5557c65d33ece, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 18.68
      essentialCaption: 1
    continueStateId: Gridlock-brief-complete
    skipStateId: Gridlock-brief-complete
    reducedMotionSupported: 1
    durationSeconds: 18.68
    motionPreset: 0
    locationTitleKey: 
    locationTitleFallback: 
    locationSubtitleKey: 
    locationSubtitleFallback: 
    musicCue: 0
    ambienceCue: 0
    vehicleCue: 0
