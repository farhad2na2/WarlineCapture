        \u0627\u0632 \u0627\u0648\u0644 \u0634\u0631\u0648\u0639 \u06A9\u0646\u06CC\u0645."
    - key: mission.m05.hud.recovery.reinforcements
      value: "\u0646\u06CC\u0631\u0648\u06CC \u06A9\u0645\u06A9\u06CC \u062F\u0634\u0645\u0646
