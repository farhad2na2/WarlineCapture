    lines:
    - lineId: command_node-debrief-01
      textKey: narrative.command_node.debrief-01
      englishFallback: "The override failed. Qassem\u2019s force is defeated, and
        the Civic Relay is separated from his command. Our teams will secure the
        complex without shutting down its essential services."
      speaker: 1
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 12.785714
      essentialCaption: 1
