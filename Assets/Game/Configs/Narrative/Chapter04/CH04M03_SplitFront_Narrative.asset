    lines:
    - lineId: split_front-debrief-samira
      textKey: narrative.split_front.debrief-samira
      englishFallback: The battery is silent and the forward base is holding. The
        shelters are safe. Keeping defenders on the second front protected the people
        between them.
      speaker: 2
      voiceClip: {fileID: 8300000, guid: a725ead6072c84a78ad7be23c08fcd74, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
