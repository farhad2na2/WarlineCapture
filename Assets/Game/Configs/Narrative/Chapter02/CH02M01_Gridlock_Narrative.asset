    lines:
    - lineId: gridlock-debrief-01
      textKey: narrative.gridlock.debrief.01
      englishFallback: The relief truck has reached the hospital. The ward can keep
        working. We opened a route people can depend on.
      speaker: 2
      voiceClip: {fileID: 8300000, guid: fba3bd8cee82b4d679e1db95a7812692, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
