  - stateId: LastCorridor-brief-2
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: 4b6f740d733a46a6a59b6961951f52c3
      m_SubObjectName: CH05M04_LastCorridor-c-16x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    panel20x9Reference:
      m_AssetGUID: 4b6f740d733a46a6a59b6961951f52c3
      m_SubObjectName: CH05M04_LastCorridor-c-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: last_corridor-brief-03
      textKey: narrative.last_corridor.brief-03
      englishFallback: Karim and I are tracking the air approaches, but we cannot
        certify an air delivery through this threat picture. Keep every required
        load on the marked ground routes. Preserve the original trucks and key APC;
        a replacement cannot carry their custody record.
      speaker: 5
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 18.714285
      essentialCaption: 1
