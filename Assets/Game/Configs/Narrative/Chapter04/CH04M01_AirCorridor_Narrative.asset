    lines:
    - lineId: air_corridor-comms-aria
      textKey: narrative.air_corridor.comms-aria
      englishFallback: The next tracks are confirmed Vanguard attackers. Radar support
        improves range and tracking, but a displaced launcher can lose that support.
        Protect the radar and keep the coverage linked.
      speaker: 3
      voiceClip: {fileID: 8300000, guid: 2f31ef939922d43c0ada306b7dc37f68, type: 3}
