      m_EditorAssetChanged: 0
    lines:
    - lineId: safehouse_sweep-brief-03
      textKey: narrative.safehouse_sweep.brief.03
      englishFallback: Local guards and residents use the east passage. Keep that
        route protected. The service lane behind the safehouse is the courier's most
        likely exit.
