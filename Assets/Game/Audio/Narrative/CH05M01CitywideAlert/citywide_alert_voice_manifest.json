      "voiceName": "Warline - Engineer Samira Haddad",
      "assetPath": "Assets/Game/Audio/Narrative/CH05M01CitywideAlert/Voice/fa/citywide_alert-brief-01.wav",
      "durationSeconds": 19.04,
      "sha256": "7fb36601141f0264266927717627d8c9a4f6e337bd28841f525bc4beb1cb357b",
