/* ==========================================================================
   SCN-19 Armory Content — UI Toolkit USS
   Target reference: SCN-19_Armory_NewMainMenuArtDirection_TargetLock_V04.png
   1672×941 landscape, bright premium command-table art direction.
   All percentage positions are relative to the screen root (1672×941 ref).
   Slice values computed from actual sprite pixel dimensions.
   ========================================================================== */

/* --- Root --- */
.scn19-armory-content {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    -unity-font-definition: url("../../../Synty/InterfaceMilitaryCombatHUD/Fonts/Oxanium/Oxanium-Bold.ttf");
    color: rgb(242, 232, 196);
    background-color: rgb(8, 10, 10);
}

.scn19-armory-content Button,
.armory-item-view {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
}

/* --- Absolute-fill helpers --- */
.background,
.background-shade,
.header-back-plate,
.middle-frame,
.category-frame,
.item-backing,
.item-frame,
.bottom-tab-frame,
.resource-frame,
.header-menu-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* --- Background --- */
.background {
    left: -1.5%;
    right: -1.5%;
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_background_command_table_no_ui.png");
    -unity-background-scale-mode: scale-and-crop;
}

.background-shade {
    background-color: rgba(6, 7, 6, 0.22);
}

/* ========================================================================
   HEADER
   Ref: top bar spanning full width, logo left ~14% width, resource chips
   center-right, menu button far right.  Header height ~11% of screen.
   ======================================================================== */
.header-content {
    position: absolute;
    left: 0.3%;
    right: 0.3%;
    top: 0.6%;
    height: 11.5%;
}

/* Header bar frame: sprite 1608×262, slice ~6.8% L/R, ~19.8% T/B */
.header-back-plate {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_header_bar_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 110;
    -unity-slice-right: 110;
    -unity-slice-top: 52;
    -unity-slice-bottom: 52;
    -unity-slice-scale: 0.30px;
}

.header-logo-panel {
    position: absolute;
    left: 1.5%;
    top: 10%;
    width: 14.5%;
    height: 78%;
}

.header-logo {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/SplashLoading/TargetLockV04Imagegen/Sprites/scn01_v04_logo_lockup.png");
    -unity-background-scale-mode: scale-to-fit;
}

.header-resource-area {
    position: absolute;
    right: 6.2%;
    top: 18%;
    width: 52%;
    height: 62%;
    flex-direction: row;
    justify-content: space-between;
}

.resource-panel {
    position: relative;
    width: 23%;
    height: 100%;
}

.risk-panel {
    width: 27%;
}

/* Resource chip frame: sprite 1466×325, slice ~9.2% L/R, ~25.2% T/B */
.resource-frame {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_resource_chip_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 135;
    -unity-slice-right: 135;
    -unity-slice-top: 82;
    -unity-slice-bottom: 82;
    -unity-slice-scale: 0.20px;
}

.resource-icon,
.resource-text-block,
.resource-plus,
.header-menu-icon {
    position: absolute;
}

.resource-icon {
    left: 6%;
    top: 20%;
    width: 16%;
    height: 60%;
    -unity-background-scale-mode: scale-to-fit;
}

.credits-icon {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_icon_credits_coin.png");
}

.fuel-icon {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_icon_fuel_can.png");
}

.supply-icon {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_resource_crate_icon.png");
}

.risk-icon {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_icon_civilian_group.png");
}

.resource-text-block {
    left: 25%;
    right: 16%;
    top: 10%;
    bottom: 8%;
}

.risk-text-block {
    right: 8%;
}

.resource-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 38%;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: lower-left;
    color: rgb(200, 192, 160);
    letter-spacing: 1px;
    white-space: nowrap;
}

.resource-value {
    position: absolute;
    left: 0;
    right: 0;
    top: 36%;
    bottom: 0;
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: upper-left;
    color: rgb(238, 202, 58);
    white-space: nowrap;
}

.resource-plus {
    right: 4%;
    top: 33%;
    width: 10%;
    height: 34%;
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_plus_icon.png");
    -unity-background-scale-mode: scale-to-fit;
}

.header-menu-button {
    position: absolute;
    right: 1.5%;
    top: 18%;
    width: 4.5%;
    height: 62%;
}

/* Menu button frame: sprite 887×902, nearly square — slice ~16.9% all sides */
.header-menu-frame {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_header_square_button_frame_default.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 150;
    -unity-slice-right: 150;
    -unity-slice-top: 150;
    -unity-slice-bottom: 150;
    -unity-slice-scale: 0.16px;
}

.header-menu-icon {
    left: 22%;
    right: 22%;
    top: 22%;
    bottom: 22%;
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_menu_hamburger_icon.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* ========================================================================
   LEFT CATEGORY RAIL
   Ref: vertical button stack, ~16% width, centered vertically between
   header and footer. 5 category buttons evenly spaced.
   ======================================================================== */
.left-content {
    position: absolute;
    left: 1.55%;
    top: 16.7%;
    width: 16.9%;
    height: 56.3%;
}

.left-nav-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
    justify-content: space-between;
}

.category-button {
    position: relative;
    width: 100%;
    height: 14.45%;
}

.category-frame {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_nav_button_frame_default.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 130;
    -unity-slice-right: 130;
    -unity-slice-top: 95;
    -unity-slice-bottom: 95;
    -unity-slice-scale: 0.22px;
}

.category-selected .category-frame {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_nav_button_frame_selected.png");
}

.category-icon {
    position: absolute;
    left: 8.5%;
    top: 22%;
    width: 17.5%;
    height: 56%;
    -unity-background-scale-mode: scale-to-fit;
}

.units-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_units_group.png");
}

.vehicles-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_vehicle_truck.png");
}

.aircraft-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_aircraft_helicopter.png");
}

.buildings-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_buildings.png");
}

.upgrades-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_upgrades_chevrons.png");
}

.category-label {
    position: absolute;
    left: 28%;
    right: 10%;
    top: 0;
    bottom: 0;
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(240, 232, 199);
    white-space: nowrap;
}

.category-chevron {
    position: absolute;
    right: 6.8%;
    top: 34%;
    width: 6.5%;
    height: 32%;
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_nav_chevron_icon.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* ========================================================================
   MIDDLE PANEL — Armory inventory grid
   Ref: large central panel with title, dropdowns, scrollable card grid.
   ======================================================================== */
.middle-content {
    position: absolute;
    left: 19.4%;
    top: 13%;
    width: 53.8%;
    height: 73%;
}

/* Panel frame large: sprite 1496×204, slice ~5.2% L/R, ~29.4% T/B */
.middle-frame {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_panel_frame_large.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 78;
    -unity-slice-right: 78;
    -unity-slice-top: 60;
    -unity-slice-bottom: 60;
    -unity-slice-scale: 0.40px;
    -unity-background-image-tint-color: rgb(246, 232, 182);
}

.screen-title {
    position: absolute;
    left: 2.5%;
    top: 2.5%;
    width: 28%;
    height: 8%;
    font-size: 46px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(242, 232, 196);
    letter-spacing: 2px;
}

/* Dropdown frame: sprite 247×75, slice ~19.4% L/R, ~29.3% T/B */
.dropdown {
    position: absolute;
    top: 3.5%;
    height: 6.5%;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_dropdown_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 22;
    -unity-slice-bottom: 22;
    -unity-slice-scale: 0.50px;
}

.filter-dropdown {
    right: 30%;
    width: 22%;
}

.sort-dropdown {
    right: 3.5%;
    width: 22%;
}

.dropdown-label {
    position: absolute;
    left: 7%;
    right: 16%;
    top: 0;
    bottom: 0;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(242, 232, 196);
    white-space: nowrap;
}

.dropdown-chevron {
    position: absolute;
    right: 5%;
    top: 28%;
    width: 8%;
    height: 44%;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_dropdown_chevron.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* --- Scroll view & grid --- */
.armory-scroll-view {
    position: absolute;
    left: 2.5%;
    right: 2.5%;
    top: 13%;
    bottom: 3%;
    background-color: rgba(0, 0, 0, 0);
}

.armory-scroll-view .unity-scroll-view__vertical-scroller,
.armory-scroll-view .unity-scroll-view__horizontal-scroller {
    display: none;
}

.armory-scroll-view > .unity-scroll-view__content-container {
    width: 100%;
    min-width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

.armory-catalog-grid {
    width: 100%;
    min-width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    padding-left: 0.5%;
    padding-right: 0.5%;
    padding-top: 0.5%;
    padding-bottom: 20px;
}

/* --- Item card --- */
/* Ref shows 4 cards per row with consistent spacing, card aspect ~2:2.87 */
.armory-item-view {
    position: relative;
    width: 23%;
    height: 520px;
    margin-right: 1.5%;
    margin-bottom: 26px;
    overflow: hidden;
}

/* Roster card frame: sprite 288×414, slice ~18.8% L/R, ~15.5% T/B */
.item-backing {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_mode_card_backing_blue.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 72;
    -unity-slice-right: 72;
    -unity-slice-top: 104;
    -unity-slice-bottom: 104;
    -unity-slice-scale: 0.32px;
}

.armory-item-view.selected .item-backing {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_mode_card_backing_selected.png");
}

.armory-item-view.locked .item-backing {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_mode_card_backing_amber.png");
    opacity: 0.62;
}

.item-frame {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_mode_card_frame_default_blue.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 72;
    -unity-slice-right: 72;
    -unity-slice-top: 104;
    -unity-slice-bottom: 104;
    -unity-slice-scale: 0.32px;
}

.armory-item-view.selected .item-frame {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_mode_card_frame_selected.png");
}

.armory-item-view.locked .item-frame {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_mode_card_frame_default_amber.png");
}

/* Rarity star/badge at top center */
.item-rarity {
    position: absolute;
    left: 44%;
    top: 1%;
    width: 12%;
    height: 7%;
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_deploy_star_icon.png");
    -unity-background-scale-mode: scale-to-fit;
}

.rarity-purple {
    -unity-background-image-tint-color: rgb(190, 126, 231);
}

/* Card art well — centered portrait area */
.item-art {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 12%;
    height: 38%;
    background-color: rgb(14, 17, 16);
    -unity-background-scale-mode: scale-and-crop;
}

.rifle-art,
.sniper-art,
.bomb-art {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_art_rifleman_male_ii.png");
}

.vehicle-art,
.tank-art,
.artillery-art {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_art_canopy_truck.png");
}

.aircraft-art,
.helicopter-art {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_art_attack_helicopter.png");
}

/* Item title — centered below art */
.item-title {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 51%;
    height: 7%;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(244, 238, 210);
    white-space: nowrap;
}

.item-subtitle {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 58%;
    height: 5%;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(183, 174, 137);
    white-space: nowrap;
}

/* State row — OWNED/LOCKED label + badge */
.item-state-row {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 64%;
    height: 7%;
}

.owned-badge,
.lock-badge {
    position: absolute;
    right: 0;
    top: 10%;
    width: 16%;
    height: 80%;
    -unity-background-scale-mode: scale-to-fit;
}

.owned-badge {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_badge_owned_checkmark.png");
}

.lock-badge {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_hold_shield.png");
    -unity-background-image-tint-color: rgb(205, 81, 64);
}

.item-state-label {
    position: absolute;
    left: 0;
    right: 18%;
    top: 0;
    bottom: 0;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.owned-state {
    color: rgb(154, 226, 64);
}

.locked-state {
    color: rgb(229, 84, 60);
}

.item-stats {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 72%;
    height: 10%;
}

.item-stat-row {
    position: relative;
    width: 100%;
    height: 50%;
}

.item-stat-label,
.item-stat-value {
    position: absolute;
    top: 0;
    bottom: 0;
    font-size: 21px;
    -unity-font-style: bold;
    color: rgb(213, 204, 169);
}

.item-stat-label {
    left: 0;
    width: 52%;
    -unity-text-align: middle-left;
}

.item-stat-value {
    right: 0;
    width: 42%;
    -unity-text-align: middle-right;
    color: rgb(242, 206, 74);
}

/* Progress bar + level/type labels at bottom of card */
.item-progress {
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: 8%;
    height: 10%;
}

/* Progress meter empty frame: sprite 339×26, slice ~10.6% L/R, ~26.9% T/B */
.item-progress-track {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 32%;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_progress_track_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 80;
    -unity-slice-right: 80;
    -unity-slice-top: 24;
    -unity-slice-bottom: 24;
    -unity-slice-scale: 0.24px;
}

/* Progress fill: sprite 112×46, slice ~19.6% L/R, ~10.9% T/B */
.item-progress-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 78%;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_progress_fill_gold.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 50;
    -unity-slice-right: 50;
    -unity-slice-top: 18;
    -unity-slice-bottom: 18;
    -unity-slice-scale: 0.24px;
}

.medium-fill {
    width: 58%;
}

.item-level,
.item-type {
    position: absolute;
    top: 38%;
    bottom: 0;
    font-size: 23px;
    -unity-font-style: bold;
    color: rgb(226, 218, 188);
}

.item-level {
    left: 0;
    width: 42%;
    -unity-text-align: middle-left;
}

.item-type {
    right: 0;
    width: 52%;
    -unity-text-align: middle-right;
}

.item-action-availability {
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: 2%;
    height: 5%;
}

.item-action-icon {
    position: absolute;
    left: 0;
    top: 12%;
    width: 10%;
    height: 76%;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_badge_owned_checkmark.png");
    -unity-background-scale-mode: scale-to-fit;
}

.item-action-label {
    position: absolute;
    left: 12%;
    right: 0;
    top: 0;
    bottom: 0;
    font-size: 21px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(154, 226, 64);
}

.armory-item-view.locked .item-action-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_hold_shield.png");
    -unity-background-image-tint-color: rgb(205, 81, 64);
}

.armory-item-view.locked .item-action-label {
    color: rgb(229, 84, 60);
}

/* ========================================================================
   RIGHT — INSPECTION PANEL
   Ref: tall panel on right side, portrait + stats + CTAs.
   Layered composition: hollow outer frame + dark solid backing +
   section bar backings for clean content alignment.
   ======================================================================== */
.right-content {
    position: absolute;
    right: 1.4%;
    top: 13%;
    width: 21.4%;
    height: 73%;
}

.inspection-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.inspection-section,
.section-backing,
.section-frame,
.portrait-backing,
.portrait-frame,
.inspection-name,
.inspection-type,
.inspection-portrait-frame,
.inspection-portrait-art,
.level-label,
.level-value,
.level-track,
.level-fill,
.xp-value,
.stats-panel,
.cta-button {
    position: absolute;
}

.inspection-section {
    left: 0;
    right: 0;
}

.title-section {
    top: 0;
    height: 8.5%;
}

.portrait-section {
    top: 9.8%;
    height: 30.5%;
}

.level-section {
    top: 42%;
    height: 10.5%;
}

.stats-section {
    top: 53.8%;
    height: 20%;
}

.action-section {
    bottom: 0;
    height: 24.8%;
}

.section-backing,
.section-frame,
.portrait-backing,
.portrait-frame {
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.section-backing {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_nav_button_backing_default.png");
    -unity-slice-left: 130;
    -unity-slice-right: 130;
    -unity-slice-top: 95;
    -unity-slice-bottom: 95;
    -unity-slice-scale: 0.22px;
}

.section-frame {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_nav_button_frame_default.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 130;
    -unity-slice-right: 130;
    -unity-slice-top: 95;
    -unity-slice-bottom: 95;
    -unity-slice-scale: 0.22px;
}

.portrait-backing {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_mode_card_backing_blue.png");
    -unity-slice-left: 72;
    -unity-slice-right: 72;
    -unity-slice-top: 104;
    -unity-slice-bottom: 104;
    -unity-slice-scale: 0.32px;
}

.portrait-frame {
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_mode_card_frame_default_blue.png");
    -unity-slice-left: 72;
    -unity-slice-right: 72;
    -unity-slice-top: 104;
    -unity-slice-bottom: 104;
    -unity-slice-scale: 0.32px;
}

.inspection-name {
    left: 7%;
    right: 7%;
    top: 2%;
    height: 56%;
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(242, 232, 196);
    white-space: nowrap;
}

.inspection-type {
    left: 8%;
    right: 8%;
    bottom: 7%;
    height: 34%;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(156, 226, 62);
    letter-spacing: 1px;
}

.inspection-portrait-frame {
    left: 7%;
    right: 7%;
    top: 6%;
    bottom: 6%;
    background-color: rgb(10, 14, 13);
    overflow: hidden;
}

.inspection-portrait-art {
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_art_rifleman_male_ii.png");
    -unity-background-scale-mode: scale-and-crop;
}

.level-label {
    left: 6%;
    top: 10%;
    width: 30%;
    height: 35%;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(232, 222, 190);
    -unity-text-align: middle-left;
}

.level-value {
    right: 6%;
    top: 10%;
    width: 38%;
    height: 35%;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(232, 222, 190);
    -unity-text-align: middle-right;
}

.level-track {
    left: 6%;
    right: 38%;
    top: 56%;
    height: 24%;
    background-color: rgba(22, 24, 24, 0.92);
}

.level-fill {
    left: 0;
    top: 0;
    bottom: 0;
    width: 62%;
    background-color: rgb(191, 174, 57);
}

.xp-value {
    right: 6%;
    top: 50%;
    width: 30%;
    height: 42%;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: rgb(180, 172, 140);
}

.stats-panel {
    left: 7%;
    right: 7%;
    top: 7%;
    bottom: 7%;
}

.stat-row {
    position: relative;
    width: 100%;
    height: 18.8%;
}

.stat-icon,
.stat-name,
.stat-value {
    position: absolute;
}

.stat-icon {
    left: 0;
    top: 12%;
    width: 9%;
    height: 76%;
    -unity-background-scale-mode: scale-to-fit;
}

.health-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_health_cross.png");
}

.damage-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_damage_burst.png");
}

.armor-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_hold_shield.png");
}

.speed-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_speed_boot.png");
}

.capacity-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_units_group.png");
}

.stat-name {
    left: 13%;
    width: 46%;
    top: 0;
    bottom: 0;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(207, 197, 164);
}

.stat-value {
    right: 2%;
    width: 32%;
    top: 0;
    bottom: 0;
    font-size: 25px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: rgb(157, 226, 61);
}

/* --- CTA buttons --- */
/* CTA frames: primary gold 172×77, secondary dark 158×77
   slice ~24.4% L/R, ~28.6% T/B for primary; ~26.6% L/R for secondary */
.cta-button {
    left: 6%;
    right: 6%;
    height: 28%;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_rect_button_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 150;
    -unity-slice-right: 150;
    -unity-slice-top: 110;
    -unity-slice-bottom: 110;
    -unity-slice-scale: 0.22px;
}

.primary-cta {
    top: 5%;
    background-image: url("../../Art/UI/Generated/MainMenuBrightCommand/Sprites/scn02c_deploy_button_frame.png");
    -unity-slice-left: 155;
    -unity-slice-right: 155;
    -unity-slice-top: 116;
    -unity-slice-bottom: 96;
    -unity-slice-scale: 0.20px;
}

.equip-cta {
    top: 36%;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_rect_button_selected_frame.png");
}

.close-cta {
    top: 67%;
    height: 28%;
}

.cta-icon,
.close-x {
    position: absolute;
    left: 13%;
    top: 13%;
    width: 16%;
    height: 70%;
    -unity-background-scale-mode: scale-to-fit;
}

.upgrade-cta-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_upgrades_chevrons.png");
}

.equip-cta-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_attack_reticle.png");
}

.close-x {
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(232, 222, 190);
}

.cta-label {
    left: 34%;
    right: 6%;
    top: 0;
    bottom: 0;
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(242, 232, 196);
}

.primary-cta .cta-label {
    color: rgb(37, 31, 13);
}

/* ========================================================================
   FOOTER — Bottom navigation tab strip
   Ref: compact tab strip, 5 tabs, spanning most of the bottom width.
   ======================================================================== */
.footer-content {
    position: absolute;
    left: 2%;
    right: 2%;
    bottom: 1.5%;
    height: 8.5%;
}

.bottom-nav-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: row;
    justify-content: space-between;
}

.bottom-tab {
    position: relative;
    width: 19%;
    height: 100%;
}

/* Bottom tab frame: sprite 174×77, slice ~21.8% L/R, ~27.3% T/B */
.bottom-tab-frame {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_bottom_tab_default_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 38;
    -unity-slice-right: 38;
    -unity-slice-top: 21;
    -unity-slice-bottom: 21;
