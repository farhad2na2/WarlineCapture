    {
      "kind": "narrative",
      "id": "false_front-comms-01",
      "speaker": "SAMIRA",
      "locale": "en-US",
      "text": "The depot is empty. Ash Line fighters are building a roadblock beyond the second checkpoint, right across the evacuation lane. That's the real ambush.",
