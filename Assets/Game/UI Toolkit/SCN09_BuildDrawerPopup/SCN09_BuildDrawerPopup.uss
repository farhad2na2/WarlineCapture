.scn09-build-drawer-popup {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    -unity-font-definition: url("../../../Synty/InterfaceMilitaryCombatHUD/Fonts/Oxanium/Oxanium-Medium.ttf");
    color: rgb(235, 229, 202);
    background-color: rgba(0, 0, 0, 0);
}

.scn09-build-drawer-popup Button,
.catalog-item-view {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
}

.build-drawer-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.drawer-frame {
    position: absolute;
    right: 4.6%;
    top: 8.2%;
    width: 64.2%;
    height: 80.2%;
}

.outer-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_panel_frame_large.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 92;
    -unity-slice-right: 92;
    -unity-slice-top: 62;
    -unity-slice-bottom: 62;
}

.build-icon {
    position: absolute;
    left: 4%;
    top: 3.4%;
    width: 5%;
    height: 7.2%;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_06_icon_build_tools.png");
    -unity-background-scale-mode: scale-to-fit;
}

.drawer-title {
    position: absolute;
    left: 10.3%;
    top: 2.8%;
    width: 18%;
    height: 5.4%;
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(245, 238, 210);
}

.drawer-subtitle {
    position: absolute;
    left: 10.4%;
    top: 8%;
    width: 35%;
    height: 3.6%;
    font-size: 20px;
    -unity-text-align: middle-left;
    color: rgba(214, 223, 212, 0.9);
}

.left-panel {
    position: absolute;
    left: 3.4%;
    top: 14%;
    width: 56.2%;
    bottom: 8%;
}

.right-panel {
    position: absolute;
    right: 3.4%;
    top: 14%;
    width: 36.3%;
    bottom: 8%;
}

.tabs {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 10.5%;
    flex-direction: row;
    justify-content: space-between;
}

.drawer-tab {
    position: relative;
    width: 24%;
    height: 100%;
}

.tab-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_rect_button_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 90;
    -unity-slice-right: 90;
    -unity-slice-top: 60;
    -unity-slice-bottom: 60;
}

.drawer-tab-selected .tab-frame {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_rect_button_selected_frame.png");
}

.tab-icon {
    position: absolute;
    left: 8.5%;
    top: 24%;
    width: 17%;
    height: 52%;
    -unity-background-scale-mode: scale-to-fit;
}

.aircrafts-icon {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_icon_support_parachute.png");
}

.vehicles-icon {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_12_icon_vehicle_depot.png");
}

.soldiers-icon {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_11_icon_squad_group.png");
}

.buildings-icon {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_06_icon_build_tools.png");
}

.tab-label {
    position: absolute;
    left: 30%;
    right: 8%;
    top: 0;
    bottom: 0;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(238, 232, 204);
}

.catalog-scroll-view {
    position: absolute;
    left: 0;
    right: 0;
    top: 13.5%;
    bottom: 12.2%;
}

.catalog-scroll-view .unity-scroll-view__vertical-scroller,
.catalog-scroll-view .unity-scroll-view__horizontal-scroller,
.production-scroll-view .unity-scroll-view__vertical-scroller,
.production-scroll-view .unity-scroll-view__horizontal-scroller {
    display: none;
}

.catalog-scroll-view > .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

.catalog-content {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 2px;
    padding-bottom: 22px;
}

.catalog-item-view {
    position: relative;
    width: 30.7%;
    height: 235px;
    margin-right: 2.6%;
    margin-bottom: 20px;
    overflow: hidden;
}

.catalog-item-frame,
.catalog-thumb,
.catalog-top-overlay,
.catalog-bottom-overlay {
    position: absolute;
}

.catalog-item-frame {
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_squad_card_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 92;
    -unity-slice-right: 92;
    -unity-slice-top: 86;
    -unity-slice-bottom: 86;
}

.catalog-item-view.selected .catalog-item-frame {
    -unity-background-image-tint-color: rgb(255, 220, 90);
}

.catalog-thumb {
    left: 9%;
    right: 9%;
    top: 9%;
    height: 47%;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/thumb_06_building_oil_refinery_thumb.png");
    -unity-background-scale-mode: scale-and-crop;
}

.catalog-top-overlay {
    left: 9%;
    right: 9%;
    top: 9%;
    height: 22%;
    background-color: rgba(0, 0, 0, 0.15);
}

.catalog-bottom-overlay {
    left: 9%;
    right: 9%;
    top: 56%;
    height: 29%;
    background-color: rgba(3, 8, 8, 0.74);
}

.catalog-title {
    position: absolute;
    left: 11%;
    right: 11%;
    top: 58%;
    height: 12%;
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(244, 238, 210);
}

.catalog-role {
    position: absolute;
    left: 12%;
    right: 12%;
    top: 70%;
    height: 9%;
    font-size: 12px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgba(210, 222, 210, 0.8);
}

.catalog-cost-panel {
    position: absolute;
    left: 12%;
    right: 12%;
    bottom: 7%;
    height: 9%;
    flex-direction: row;
    justify-content: space-between;
}

.tiny-cost {
    position: relative;
    width: 46%;
    height: 100%;
}

.tiny-cost-icon {
    position: absolute;
    left: 0;
    top: 9%;
    width: 30%;
    height: 82%;
    -unity-background-scale-mode: scale-to-fit;
}

.credits-icon {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_01_icon_credits.png");
}

.supplies-icon {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_02_icon_supplies.png");
}

.time-icon {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_05_icon_time.png");
}

.tiny-cost-value {
