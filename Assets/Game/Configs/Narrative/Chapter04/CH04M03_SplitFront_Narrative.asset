      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: split_front-brief-dalia
      textKey: narrative.split_front.brief-dalia
      englishFallback: Vanguard's battery is confirmed on the far side of the district.
        Ash Line is moving against our forward base. Keep the tanks and infantry
        on the approach while the launcher takes the battery.
      speaker: 1
      voiceClip: {fileID: 8300000, guid: 5333be9ef541b4d47aaec7f668c09b5f, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
