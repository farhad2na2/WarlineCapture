  - stateId: SupplyLine-brief-2
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: b99d871cee7b64c25a2a9970a28c409f
