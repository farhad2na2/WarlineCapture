      m_SubObjectGUID:
      m_EditorAssetChanged: 0
    lines:
    - lineId: m02-comms.line.1
      textKey: narrative.m02.comms.dalia
      englishFallback: Hold the post. The incoming cell cannot be allowed through
        to the clinic route.
      speaker: 1
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 3.75
      essentialCaption: 1
    - lineId: m02-comms.line.2
      textKey: narrative.m02.comms.aria
      englishFallback: A municipal access list was recovered from the attackers.
        Its copy timestamp predates the first strike.
      speaker: 3
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 4
      deadlineSeconds: 7.75
      essentialCaption: 1
    - lineId: m02-comms.line.3
      textKey: narrative.m02.comms.samira
      englishFallback: That list maps substations, maintenance gates, and service
        tunnels. It was stolen before the attack.
      speaker: 2
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 8
      deadlineSeconds: 11.75
      essentialCaption: 1
