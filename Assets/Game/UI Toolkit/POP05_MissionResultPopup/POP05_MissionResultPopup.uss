    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.25;
}

.casualty-pip-on {
    opacity: 0.92;
}

.score-badge {
    position: absolute;
    left: 24%;
    right: 24%;
    top: 24%;
    height: 30%;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_icon_squad_badge.png");
    -unity-background-scale-mode: scale-to-fit;
}

.score-value {
    position: absolute;
    left: 6%;
    right: 6%;
    top: 54%;
    height: 25%;
    font-size: 78px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 0;
    color: rgb(240, 191, 56);
    white-space: nowrap;
}

.score-rank {
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: 7%;
    height: 12%;
    font-size: 23px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 0;
    color: rgb(174, 210, 58);
    white-space: nowrap;
}

.actions-panel {
    position: absolute;
    left: 7%;
    right: 7%;
    bottom: 5.3%;
    height: 8.3%;
    flex-direction: row;
    justify-content: space-between;
}

.result-action {
    position: relative;
    width: 28%;
    height: 100%;
    translate: 0 0;
    scale: 1 1;
    transition-property: translate, scale;
    transition-duration: 90ms;
    transition-timing-function: ease-out;
}

.result-action:hover,
.result-action:focus {
    translate: 0 -5px;
    scale: 1.035 1.035;
}

.result-action:active {
    translate: 0 -1px;
    scale: 0.985 0.985;
}

.selected-action {
    translate: 0 -2px;
    scale: 1.015 1.015;
}

.action-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 72;
    -unity-slice-right: 72;
    -unity-slice-top: 42;
    -unity-slice-bottom: 42;
    -unity-slice-scale: 0.46px;
}

.primary-frame {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_rect_button_selected_frame.png");
}

.secondary-frame {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_rect_button_frame.png");
}

.result-action:hover .action-frame,
.result-action:focus .action-frame {
    -unity-background-image-tint-color: rgb(255, 232, 158);
}

.result-action:active .action-frame {
    -unity-background-image-tint-color: rgb(198, 171, 103);
}

.action-label {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 0;
    bottom: 0;
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 0;
    color: rgb(248, 237, 205);
    white-space: nowrap;
}

.primary-action .action-label {
    color: rgb(246, 237, 202);
}
