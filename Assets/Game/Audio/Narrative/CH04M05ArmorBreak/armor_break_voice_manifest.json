    {
      "kind": "narrative",
      "id": "armor_break-close-01",
      "speaker": "DALIA",
      "locale": "en-US",
      "text": "This is the captured handshake. Vanguard hardware was trying to connect to a dormant Civic Relay node. The authority package preserves the request exactly as it was sent.",
