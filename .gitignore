# macOS
.DS_Store
Assets/**/.DS_Store

# Addressables / generated caches
Assets/AddressableAssetsData/*/*.bin*
Assets/AddressableAssetsData/Android.meta
Assets/AddressableAssetsData/ProfileDataSourceSettings.asset*
Assets/AddressableAssetsData/link.xml*
Assets/SceneDependencyCache/*.sceneWithBuildSettings*

# Narrative review render intermediates (retain final review/evidence outputs only)
Design/NarrativeVision/**/.build/

# Narrative review videos stay local; commit still-image and report evidence instead
Design/NarrativeVision/**/*.mp4
Design/NarrativeVision/**/*.mov
Design/NarrativeVision/**/*.mkv
Design/NarrativeVision/**/*.webm

# Transient Android build-scene optimization output
Assets/Game/GeneratedAndroidBuild/
Assets/Game/GeneratedAndroidBuild.meta

# Unity/Bee transient native build scratch
.utmp/

# Python generated bytecode
__pycache__/
*.py[cod]

# Theatre zone and blur plates are regenerated by SkirmishLibraryZoneComposer during SCN-13 Build.
# PNG bytes are skipped when unchanged. They are not source maps, and the editor reads them from disk.
Assets/Game/Art/SkirmishLibrary/Zones/
Assets/Game/Art/SkirmishLibrary/Zones.meta
Assets/Game/Art/SkirmishLibrary/Blurs/
Assets/Game/Art/SkirmishLibrary/Blurs.meta

# Mission review images remain local; production game artwork is tracked under Assets.
Design/AgentReports/M03RadarWarning/**/*.png
Design/AgentReports/M04Airlift/**/*.png
Design/NarrativeVision/M3StyleAlignment/**/*.png

# Unity crash memory may contain process data; keep it local.
mono_crash.mem.*.blob
mono_crash*.json
