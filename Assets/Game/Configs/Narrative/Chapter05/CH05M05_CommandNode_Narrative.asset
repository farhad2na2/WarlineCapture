      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: command_node-brief-05
      textKey: narrative.command_node.brief-05
      englishFallback: You centralized force and made this city obey. The only difference
        is that you still pretend you will give the power back. I am beginning the
        override.
      speaker: 9
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 10.785714
      essentialCaption: 1
    continueStateId: CommandNode-brief-5
    skipStateId: CommandNode-brief-complete
    reducedMotionSupported: 1
    durationSeconds: 10.785714
    motionPreset: 0
    locationTitleKey: 
    locationTitleFallback: 
    locationSubtitleKey: 
    locationSubtitleFallback: 
    musicCue: 0
    ambienceCue: 0
