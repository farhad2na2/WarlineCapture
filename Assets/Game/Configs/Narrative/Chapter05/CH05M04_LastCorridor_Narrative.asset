  - stateId: LastCorridor-brief-1
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: 4b6f740d733a46a6a59b6961951f52c3
      m_SubObjectName: CH05M04_LastCorridor-b-16x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    panel20x9Reference:
      m_AssetGUID: 4b6f740d733a46a6a59b6961951f52c3
      m_SubObjectName: CH05M04_LastCorridor-b-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: last_corridor-brief-02
      textKey: narrative.last_corridor.brief-02
      englishFallback: "Hold the original engineer at the repair marker for six seconds.
        Medicine takes the safer alternate lane. Fuel and the key APC may use the
        repaired main lane or the alternate. Follow each route\u2019s marked entry,
        midpoint and exit, then hold at receiving for six seconds."
      speaker: 2
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 19.142857
      essentialCaption: 1
    continueStateId: LastCorridor-brief-2
    skipStateId: LastCorridor-brief-complete
    reducedMotionSupported: 1
    durationSeconds: 19.142857
