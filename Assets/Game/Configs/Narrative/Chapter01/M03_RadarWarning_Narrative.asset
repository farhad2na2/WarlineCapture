      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: m03-brief-01
      textKey: narrative.m03.brief.01
      englishFallback: The warning sector is offline. Scouts report an armored convoy
        on the western road. Our Ground Radar Tank can confirm vehicles once they
        enter coverage.
      speaker: 3
      voiceClip: {fileID: 8300000, guid: 01d374e363358425ea29e337d9b32fd2, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 15.24
