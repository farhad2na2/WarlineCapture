.ui-shell-app-canvas {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    -unity-font-definition: url("../../../Synty/InterfaceMilitaryCombatHUD/Fonts/Oxanium/Oxanium-Medium.ttf");
    color: rgb(232, 226, 198);
    background-color: rgba(0, 0, 0, 0);
}

.ui-shell-app-canvas Button {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
}

.safe-area-root,
.content-root,
.modal-overlay,
.tooltip-layer,
.shell-slot,
.screen-slot {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.safe-area-root {
    overflow: hidden;
}

.shell-hidden {
    display: none;
}

.screen-slot {
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0);
    picking-mode: position;
}

.popup-screen-slot {
    overflow: visible;
}

.shell-motion {
    transition-property: opacity, translate, scale;
    transition-duration: 180ms;
    transition-timing-function: ease-out;
    transform-origin: 50% 50%;
}

.shell-motion-visible {
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
}

.shell-motion-fade-out {
    opacity: 0;
    translate: 0 0;
    scale: 1 1;
    picking-mode: ignore;
}

.shell-motion-slide-left-out {
    opacity: 0;
    translate: -104% 0;
    scale: 1 1;
    picking-mode: ignore;
}

.shell-motion-slide-right-out {
    opacity: 0;
    translate: 104% 0;
    scale: 1 1;
    picking-mode: ignore;
}

.shell-motion-slide-top-out {
    opacity: 0;
    translate: 0 -104%;
    scale: 1 1;
    picking-mode: ignore;
}

.shell-motion-slide-bottom-out {
    opacity: 0;
    translate: 0 104%;
    scale: 1 1;
    picking-mode: ignore;
}

.shell-motion-scale-out {
    opacity: 0;
    translate: 0 0;
    scale: 0 0;
    picking-mode: ignore;
}

.shell-motion-popup-visible {
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
}

.shell-motion-popup-hidden {
    opacity: 0;
    translate: 0 0;
    scale: 0 0;
    picking-mode: ignore;
}

.header-bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 12%;
    background-color: rgba(8, 13, 15, 0.82);
}

.footer-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 12%;
    background-color: rgba(8, 13, 15, 0.82);
}

.content-root {
    overflow: hidden;
}

.menu-background-region {
    background-color: rgba(0, 0, 0, 0);
}

.loading-layer {
    background-color: rgba(0, 0, 0, 0);
}

.header-region,
.left-region,
.middle-region,
.right-region,
.footer-region {
    background-color: rgba(0, 0, 0, 0);
}

.modal-overlay {
    background-color: rgba(0, 0, 0, 0.58);
}

.tooltip-layer {
    picking-mode: ignore;
}

.placeholder-popup {
    position: absolute;
    left: 32%;
    right: 32%;
    top: 26%;
    bottom: 26%;
    background-color: rgba(6, 9, 11, 0.98);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(108, 142, 153, 0.58);
    border-right-color: rgba(108, 142, 153, 0.58);
    border-top-color: rgba(108, 142, 153, 0.58);
    border-bottom-color: rgba(108, 142, 153, 0.58);
}

.placeholder-title {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 10%;
    height: 18%;
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(245, 241, 220);
}

.placeholder-body {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 32%;
    height: 42%;
    font-size: 24px;
    -unity-text-align: upper-left;
    white-space: normal;
    color: rgb(199, 224, 235);
}

.placeholder-close-button {
    position: absolute;
    left: 34%;
    right: 34%;
    bottom: 8%;
    height: 12%;
    background-color: rgba(18, 26, 31, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(145, 180, 194, 0.58);
    border-right-color: rgba(145, 180, 194, 0.58);
    border-top-color: rgba(145, 180, 194, 0.58);
    border-bottom-color: rgba(145, 180, 194, 0.58);
}

.placeholder-close-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(232, 244, 255);
}

.tooltip-layer {
    background-color: rgba(0, 0, 0, 0);
}

.diagnostics-overlay {
    position: absolute;
    right: 12px;
    top: 12px;
    width: 78px;
    height: 34px;
    overflow: visible;
}

.diagnostics-overlay-expanded {
    width: 544px;
    height: 474px;
}

.diagnostics-fps-button {
    position: absolute;
    right: 0;
    top: 0;
    width: 78px;
    height: 34px;
    background-color: rgba(5, 8, 10, 0.86);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(215, 174, 72, 0.78);
    border-right-color: rgba(215, 174, 72, 0.78);
    border-top-color: rgba(215, 174, 72, 0.78);
    border-bottom-color: rgba(215, 174, 72, 0.78);
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.diagnostics-fps-value {
    font-size: 19px;
    color: rgb(246, 210, 94);
    -unity-text-align: middle-right;
    margin-right: 4px;
}

.diagnostics-fps-suffix {
    font-size: 11px;
    color: rgb(222, 216, 190);
    -unity-text-align: middle-left;
}

.diagnostics-log-panel {
    position: absolute;
    right: 0;
    top: 42px;
    width: 520px;
    height: 420px;
    background-color: rgba(5, 8, 10, 0.94);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(215, 174, 72, 0.82);
    border-right-color: rgba(215, 174, 72, 0.82);
    border-top-color: rgba(215, 174, 72, 0.82);
    border-bottom-color: rgba(215, 174, 72, 0.82);
}

.diagnostics-log-header {
    position: absolute;
    left: 16px;
    right: 16px;
    top: 12px;
    height: 34px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.diagnostics-log-title {
    font-size: 18px;
    color: rgb(240, 235, 210);
    -unity-text-align: middle-left;
}

.diagnostics-close-button {
    width: 96px;
    height: 30px;
    background-color: rgba(20, 26, 25, 0.94);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(215, 174, 72, 0.7);
    border-right-color: rgba(215, 174, 72, 0.7);
    border-top-color: rgba(215, 174, 72, 0.7);
    border-bottom-color: rgba(215, 174, 72, 0.7);
}

.diagnostics-close-label {
    font-size: 13px;
    color: rgb(240, 235, 210);
    -unity-text-align: middle-center;
}

.diagnostics-log-scroll-view {
    position: absolute;
    left: 16px;
    right: 16px;
    top: 58px;
    bottom: 16px;
    background-color: rgba(0, 0, 0, 0.32);
}

.diagnostics-log-text {
    font-size: 13px;
    color: rgb(218, 230, 224);
    white-space: normal;
    -unity-text-align: upper-left;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
}
