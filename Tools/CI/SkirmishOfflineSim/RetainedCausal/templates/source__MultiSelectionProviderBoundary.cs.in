using System;using System.Collections.Generic;using Game.Components;using Unity.Entities;using UnityEngine;
namespace Game.Runtime {
// Typed ordered callback tape. Mac owns raw/native capture schema and decoder.
// Prior false selection exits are assertions AFTER original computation; current
// firstpair selection exit/future scopes remain unread at suspension.
internal enum ProviderEvidenceBoundary { None=0, LegacyClosedSelectionProbe=1, CompleteWindowAtFirstOwnedRootPairExit=2 }
internal sealed class TerminalOpenWindowCertificate {
 internal int GlobalEventVersion;internal long GlobalEventMaxExclusive;
 internal bool AdmissionVerified,StartComplete,EndComplete,ChildJournalComplete,FirstAttemptOwnedRoot;
 internal string Failure,RootKind;
 internal Unity.Collections.FixedString64Bytes SessionId;
 internal Entity Owner;
 internal long DispatchOrdinal,TerminalSelectionEntryOrdinal,RootScopeId,RootEntryOrdinal,RootExitOrdinal,WindowEndOrdinal;
 internal long? RootParentScopeId;
}
internal sealed class MultiSelectionProviderBoundary {
 readonly ObserverOrdinalAdmission ordinals;readonly ProviderEvidenceBoundary boundary;readonly TerminalOpenWindowCertificate certificate;readonly FirstSelectionProviderBoundary.Row[] rows;readonly EntityManager em;int at;Entity owner;bool active;internal int CompletedSelections{get;private set;}internal int FalseSelections{get;private set;}internal int ConsumedRows=>at;internal int RemainingRows=>rows.Length-at;internal long LastConsumedOrdinal=>at==0?-1:rows[at-1].ObserverOrdinal;
 static void Need(bool ok,string why){if(!ok)throw new NotSupportedException(why);}
 static readonly HashSet<string> FocusSites=new HashSet<string>{"automatic-route.focus-0","automatic-route.focus-1","automatic-route.focus-2","automatic-route.focus-3","automatic-route.focus-4"};
 static float Float(uint bits){float x=BitConverter.ToSingle(BitConverter.GetBytes(bits),0);Need(!float.IsNaN(x)&&!float.IsInfinity(x),"Finite actual focus return required");return x;}
 internal MultiSelectionProviderBoundary(bool complete,EntityManager manager,FirstSelectionProviderBoundary.Row[] captured,Entity[] actualQuery,int candidates,ProviderEvidenceBoundary evidenceBoundary,TerminalOpenWindowCertificate terminalCertificate,long dispatchOrdinal,ObserverOrdinalAdmission ordinalAdmission){Need(complete&&manager!=null&&captured!=null&&actualQuery!=null&&captured.Length>=2&&captured.Length<=Math.Min(4096L,(long)actualQuery.Length*(4L*candidates+5)),"Complete bounded actual multi-selection tape required");Need(ordinalAdmission!=null,"Explicit observer ordinal authority required");ordinals=ordinalAdmission;em=manager;rows=captured;boundary=evidenceBoundary;certificate=terminalCertificate;Need(boundary==ProviderEvidenceBoundary.LegacyClosedSelectionProbe||boundary==ProviderEvidenceBoundary.CompleteWindowAtFirstOwnedRootPairExit,"Explicit provider evidence boundary required");var query=new HashSet<Entity>(actualQuery);long previous=-1;bool inside=false;Entity scope=default;long lastEntryOrdinal=-1;foreach(var row in rows){Need(row!=null&&row.ObserverOrdinal>previous&&ordinals.Contains(row.ObserverOrdinal),"Ordered actual provider ordinal required");previous=row.ObserverOrdinal;if(row.Kind=="selection-entry"){Need(!inside&&row.Callsite=="TryAssignAutomaticHaulerOrder"&&row.ResultAssertion==null&&query.Contains(row.Unit),"Exact actual selection entry required");inside=true;scope=row.Unit;lastEntryOrdinal=row.ObserverOrdinal;}else if(row.Kind=="selection-exit"){Need(inside&&row.Unit==scope&&row.Callsite=="TryAssignAutomaticHaulerOrder"&&row.ResultAssertion.HasValue,"Exact actual selection exit required");inside=false;}else{Need(inside&&row.Unit==scope&&row.ResultAssertion==null,"Provider escaped actual selection owner scope");if(row.Kind=="focus-return")Need(FocusSites.Contains(row.Callsite)&&row.PositionBits!=null&&row.PositionBits.Length==3,"Exact focus return shape required");else Need(row.Kind=="ai-resolver-return"&&row.Callsite=="TryResolveCachedInput.actual-resolver-expression","Known actual resolver return required");}}if(boundary==ProviderEvidenceBoundary.LegacyClosedSelectionProbe){Need(certificate==null&&!inside,"Legacy closed-selection probe requires balanced tape and no window certificate");}
 else{
 Need(inside&&certificate!=null,"Terminal open selection requires complete causal-window certificate");
 Need(ordinals.IsCanonicalV8&&certificate.GlobalEventVersion==ordinals.Version&&certificate.GlobalEventMaxExclusive==ordinals.MaxExclusive,"Terminal certificate global event domain differs from canonical V8 authority");
 Need(ordinals.Contains(certificate.RootEntryOrdinal)&&ordinals.Contains(certificate.RootExitOrdinal)&&ordinals.Contains(certificate.WindowEndOrdinal),"Terminal certificate root entry/EXIT/window ordinal outside admitted global event domain");
 Need(certificate.AdmissionVerified&&certificate.StartComplete&&certificate.EndComplete&&certificate.ChildJournalComplete&&certificate.FirstAttemptOwnedRoot&&certificate.Failure==null&&certificate.RootKind=="ReservePair"&&certificate.RootScopeId>=0&&!certificate.RootParentScopeId.HasValue,"Admitted complete first-owned root ReservePair EXIT window required");
 Need(certificate.DispatchOrdinal==dispatchOrdinal&&certificate.TerminalSelectionEntryOrdinal==lastEntryOrdinal&&certificate.Owner==scope&&certificate.RootEntryOrdinal>previous&&certificate.RootExitOrdinal>certificate.RootEntryOrdinal&&certificate.WindowEndOrdinal==certificate.RootExitOrdinal,"Window certificate owner/scope/ordinal endpoint differs");
 Need(em.Exists(scope)&&em.HasComponent<SkirmishAttemptOwnedComponent>(scope)&&em.HasComponent<Faction>(scope),"Actual terminal owner ownership/faction facts required");var ownership=em.GetComponentData<SkirmishAttemptOwnedComponent>(scope);Need(ownership.SessionId.Equals(certificate.SessionId)&&ownership.CapacityReleased==0&&ownership.FactionId==em.GetComponentData<Faction>(scope).Id,"Terminal owner does not belong to admitted active window session");
 }
}
 internal void Enter(Entity unit){Need(!active&&at<rows.Length&&rows[at].Kind=="selection-entry"&&rows[at].Unit==unit,"Computed selection order differs from actual tape");owner=unit;active=true;at++;}
 internal void Exit(Entity unit,bool computedResult){Need(!(boundary==ProviderEvidenceBoundary.CompleteWindowAtFirstOwnedRootPairExit&&active&&at==rows.Length),"Original terminal selection returned without computed pair; terminal EOF cannot supply a return");Need(active&&owner==unit&&at<rows.Length&&rows[at].Kind=="selection-exit"&&rows[at].Unit==unit,"Computed selection exit/provider prefix differs");Need(rows[at].ResultAssertion==computedResult,"Computed selection return assertion differs");at++;active=false;CompletedSelections++;if(!computedResult)FalseSelections++;}
 FirstSelectionProviderBoundary.Row Next(string kind){Need(active&&at<rows.Length&&rows[at].Kind==kind&&rows[at].Unit==owner&&em.CurrentHauler==owner,"Actual provider-return order/owner missing: "+kind);return rows[at++];}
 internal void Install(BuildingResourceHaulerBridgeCompositionSystemHelper.Context context,bool actualResolverPresent,bool actualFocusPresent){
 if(actualResolverPresent)context.TryResolveFactionAIOilAllocationInput=(EntityManager manager,byte faction,out BuildingResourceHaulerBridgeCompositionSystemHelper.FactionAIOilAllocationInput input)=>{var row=Next("ai-resolver-return");Need(row.ResolverPresent&&row.Faction==faction,"Actual AI resolver presence/faction differs");input=row.Input;return row.HasInput;};else context.TryResolveFactionAIOilAllocationInput=null;
 context.ResolveBuildingFocusWorldPosition=actualFocusPresent?(Func<RuntimeBuildingEntity,Vector3>)(b=>{var row=Next("focus-return");Need(row.RuntimeBuildingId==b.Id,"Actual focus target differs");return new Vector3(Float(row.PositionBits[0]),Float(row.PositionBits[1]),Float(row.PositionBits[2]));}):null;
 }
 internal void AssertAtPair(PairRequestEmitted request){Need(active&&request!=null&&request.Unit==owner,"Computed pair owner differs from active source selection");if(boundary==ProviderEvidenceBoundary.CompleteWindowAtFirstOwnedRootPairExit){Need(owner==certificate.Owner&&at==rows.Length,"Computed pair must consume complete terminal-open provider prefix EOF");}else Need(at<rows.Length&&rows[at].Kind=="selection-exit"&&rows[at].Unit==owner,"Legacy pair probe did not consume exact current provider prefix");/* No current selection result or native pair arguments are read. */}
 internal void AssertCompleted(){Need(boundary==ProviderEvidenceBoundary.LegacyClosedSelectionProbe&&!active&&at==rows.Length,"Unconsumed actual selection scopes remain after completed dispatch");}
 }
 internal sealed partial class BuildingResourceHaulerBridgeCompositionSystemHelper {
 internal MultiSelectionProviderBoundary ProviderTape;
 private bool TryAssignAutomaticHaulerOrder(Context context,EntityManager em,GridConfig grid,Entity unit){if(ProviderTape==null)throw new NotSupportedException("Actual ordered multi-selection provider tape missing");ProviderTape.Enter(unit);bool result=TryAssignAutomaticHaulerOrderOriginal(context,em,grid,unit);ProviderTape.Exit(unit,result);return result;}
 }
}
