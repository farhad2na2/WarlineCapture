      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: false_front-comms-02
      textKey: narrative.false_front.comms.02
      englishFallback: My first interpretation was wrong. I treated the seal as stronger
        evidence than the missing source trail. Redirect to the confirmed roadblock;
        keep the vehicles out of its fire.
      speaker: 3
      voiceClip: {fileID: 8300000, guid: 98c88f0e886134ca297b7ca0bbd0b0cf, type: 3}
