      "assetPath": "Assets/Game/Audio/Narrative/CH02M02SupplyLine/Voice/en/supply_line-brief-03.wav",
      "durationSeconds": 15.92,
      "sha256": "70acebb4ded02be7fac268eb0c3ed285b8cbe0003e11fe3b46f0b3fb369b0cb8",
