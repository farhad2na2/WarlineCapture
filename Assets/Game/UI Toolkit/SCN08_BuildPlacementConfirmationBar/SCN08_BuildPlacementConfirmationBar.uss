.scn08-build-placement-confirmation-bar {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    -unity-font-definition: url("../../../Synty/InterfaceMilitaryCombatHUD/Fonts/Oxanium/Oxanium-Medium.ttf");
    color: rgb(232, 226, 198);
    background-color: rgba(0, 0, 0, 0);
}

.scn08-build-placement-confirmation-bar Button {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
}

.build-placement-confirmation-bar-root {
    position: absolute;
    left: 3.6%;
    right: 3.6%;
    bottom: 5.5%;
    height: 29%;
}

.bar-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_panel_frame_large.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 92;
    -unity-slice-right: 92;
    -unity-slice-top: 62;
    -unity-slice-bottom: 62;
}

.building-preview-card {
    position: absolute;
    left: 3.1%;
    top: 12.5%;
    width: 13.3%;
    height: 73%;
}

.preview-card-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/chrome_08_card_frame_standard.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.building-preview-image {
    position: absolute;
    left: 9%;
    right: 9%;
    top: 9%;
    bottom: 9%;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/thumb_03_building_watchtower_thumb.png");
    -unity-background-scale-mode: scale-and-crop;
}

.building-preview-badge {
    position: absolute;
    left: -4%;
    bottom: -4%;
    width: 24%;
    height: 24%;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_icon_squad_badge.png");
    -unity-background-scale-mode: scale-to-fit;
}

.placement-title {
    position: absolute;
    left: 18.8%;
    top: 12.5%;
    width: 26%;
    height: 22%;
    font-size: 72px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(241, 232, 203);
}

.status-chip {
    position: absolute;
    left: 18.8%;
    top: 38%;
    width: 25%;
    height: 18.5%;
    min-width: 25%;
    max-width: 25%;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/chrome_13_small_status_chip_bg.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(24, 66, 28, 0.64);
    overflow: hidden;
}

.status-icon {
    position: absolute;
    left: 4.5%;
    top: 12%;
    width: 14%;
    height: 76%;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_08_icon_confirm.png");
    -unity-background-scale-mode: scale-to-fit;
}

.status-text {
    position: absolute;
    left: 22%;
    right: 6%;
    top: 8%;
    bottom: 8%;
    font-size: 46px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(158, 250, 89);
    white-space: nowrap;
    overflow: hidden;
}

.placement-valid .status-chip {
    background-color: rgba(24, 74, 30, 0.72);
}

.placement-valid .status-text {
    color: rgb(158, 250, 89);
}

.placement-invalid .status-chip {
    background-color: rgba(78, 30, 24, 0.72);
}

.placement-invalid .status-text {
    color: rgb(255, 126, 94);
}

.metric-icon {
    position: absolute;
    top: 65.3%;
    width: 3.5%;
    height: 15.5%;
    -unity-background-scale-mode: scale-to-fit;
}

.metric-chip {
    position: absolute;
    top: 61.5%;
    height: 23.5%;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/chrome_13_small_status_chip_bg.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(13, 15, 14, 0.68);
    overflow: hidden;
}

.cost-chip {
    left: 18.8%;
    width: 12.5%;
}

.time-chip {
    left: 32%;
    width: 12.5%;
}

.credits-icon {
    left: 20.1%;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_01_icon_credits.png");
}

.time-icon {
    left: 33.2%;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_05_icon_time.png");
}

.metric-label {
    position: absolute;
    top: 63.3%;
    height: 8%;
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgba(238, 231, 199, 0.78);
    white-space: nowrap;
    overflow: hidden;
}

.cost-label {
    left: 24.4%;
    width: 5.2%;
}

.time-label {
    left: 37.4%;
    width: 5.2%;
}

.cost-text,
.duration-text {
    position: absolute;
    top: 70.1%;
    height: 11.5%;
    font-size: 50px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(245, 241, 220);
    white-space: nowrap;
    overflow: hidden;
}

.cost-text {
    left: 24.4%;
    width: 5.8%;
    min-width: 5.8%;
    max-width: 5.8%;
    color: rgb(230, 196, 74);
}

.duration-text {
    left: 37.4%;
    width: 6.5%;
    min-width: 6.5%;
    max-width: 6.5%;
    color: rgb(230, 196, 74);
}

.section-divider {
    position: absolute;
    top: 15%;
    width: 0.24%;
    height: 70%;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/chrome_11_thin_divider.png");
    -unity-background-scale-mode: stretch-to-fill;
    opacity: 0.8;
}

.info-divider {
    left: 45.4%;
}

.action-divider {
    left: 67.9%;
}

.placement-action,
.rotate-action {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
    overflow: visible;
    transform-origin: center;
    translate: 0 0;
    scale: 1 1;
    transition-property: translate, scale;
    transition-duration: 90ms;
    transition-timing-function: ease-out;
}

.placement-action {
    top: 18%;
    height: 66%;
    width: 8.8%;
}

.cancel-action {
    left: 69.6%;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/chrome_12_secondary_button_bg.png");
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
    background-color: rgba(46, 43, 38, 0.72);
}

.confirm-action {
    right: 2.8%;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/chrome_06_gold_action_button_bg.png");
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 25;
    -unity-slice-bottom: 25;
    background-color: rgba(183, 122, 28, 0.72);
}

.placement-invalid .confirm-action {
    background-color: rgba(72, 67, 54, 0.62);
    opacity: 0.64;
}

.rotate-action {
    left: 79.8%;
    top: 18%;
    width: 8.8%;
    height: 66%;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/chrome_12_secondary_button_bg.png");
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
    background-color: rgba(33, 36, 33, 0.72);
}

.placement-action:hover,
.placement-action:focus,
.rotate-action:hover,
.rotate-action:focus {
    translate: 0 -4px;
    scale: 1.045 1.045;
}

.placement-action:active,
.rotate-action:active {
    translate: 0 -1px;
    scale: 0.985 0.985;
}

.cancel-action:hover,
.cancel-action:focus,
.rotate-action:hover,
.rotate-action:focus {
    background-color: rgba(67, 60, 45, 0.84);
}

.confirm-action:hover,
.confirm-action:focus {
    background-color: rgba(196, 143, 35, 0.9);
}

.action-icon {
    position: absolute;
    left: 28%;
    right: 28%;
    top: 13%;
    height: 36%;
    -unity-background-scale-mode: scale-to-fit;
}

.cancel-icon {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_20_icon_close.png");
}

.confirm-icon {
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_08_icon_confirm.png");
}

.rotate-icon {
    position: absolute;
    left: 27%;
    right: 27%;
    top: 13%;
    height: 37%;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_17_icon_placement_corners.png");
    -unity-background-scale-mode: scale-to-fit;
}

.action-label {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 54%;
    bottom: 7%;
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(245, 241, 220);
    white-space: nowrap;
    overflow: hidden;
}

.rotate-label {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 54%;
    bottom: 7%;
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(245, 241, 220);
    white-space: nowrap;
    overflow: hidden;
}

.instruction-strip {
    position: absolute;
    left: 46.6%;
    top: 24%;
    width: 20.2%;
    height: 52%;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/chrome_14_bottom_instruction_strip.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(13, 15, 14, 0.72);
}

.info-icon {
    position: absolute;
    left: 41%;
    top: 4%;
    width: 18%;
    height: 30%;
    background-image: url("../../Art/UI/Generated/BuildDrawer/LayeredOneGo/icon_18_icon_placement_cursor.png");
    -unity-background-scale-mode: scale-to-fit;
}

.instruction-text {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 36%;
    height: 21%;
    font-size: 39px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(241, 232, 203);
    white-space: nowrap;
    overflow: hidden;
}

.instruction-secondary-text {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 59%;
    height: 17%;
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgba(238, 231, 199, 0.78);
    white-space: nowrap;
    overflow: hidden;
}

.placement-progress-pips {
    position: absolute;
    left: 21%;
    right: 21%;
    bottom: 7%;
    height: 10%;
    flex-direction: row;
    justify-content: space-between;
}

.placement-progress-pip {
    width: 12%;
    height: 100%;
    background-color: rgba(116, 112, 75, 0.72);
}

.placement-progress-pip-active {
    background-color: rgb(142, 209, 44);
}
