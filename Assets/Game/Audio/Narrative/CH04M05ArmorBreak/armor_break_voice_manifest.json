      "sha256": "17f8cdcaffd631fb0c1fea9386d53710e32733f3931a9e2e32be45646c91d926",
      "captionSha256": "aefbd34d61b087934cccc4b6264efc1c59aaca44d23f9342ee38a028b6781de8"
    },
    {
      "kind": "narrative",
      "id": "armor_break-debrief-02",
      "speaker": "ARIA",
      "locale": "en-US",
      "text": "Protocol Fragment Four is complete. Qassem needs my restored archive as the knowledge key and your current emergency credential as the live authority key. Neither key alone can complete his override.",
