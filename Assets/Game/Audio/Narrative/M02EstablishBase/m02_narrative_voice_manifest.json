  "clips": [
    {
      "kind": "narrative",
      "id": "m02_brief_line_1",
      "speaker": "DALIA",
      "locale": "en-US",
      "text": "This forward post is abandoned, but we need it. Restore it and prepare to defend the clinic road.",
      "voiceId": "MK1Zvh93428YrgOQ8Obr",
      "voiceName": "Warline - Major Dalia Rahim",
      "assetPath": "Assets/Game/Audio/Narrative/M02EstablishBase/Voice/en/m02_brief_line_1.wav",
      "durationSeconds": 6.48,
      "sha256": "34184f965ef132678e1136537339a58194da31c7c051315e3f81b5954649aff6"
    },
    {
      "kind": "narrative",
      "id": "m02_brief_line_1",
      "speaker": "DALIA",
      "locale": "fa-IR",
      "text": "این پاسگاه متروکه است، اما به آن نیاز داریم. آن را دوباره فعال کنید و برای دفاع از مسیر درمانگاه آماده شوید.",
      "voiceId": "MK1Zvh93428YrgOQ8Obr",
      "voiceName": "Warline - Major Dalia Rahim",
      "assetPath": "Assets/Game/Audio/Narrative/M02EstablishBase/Voice/fa/m02_brief_line_1_fa.wav",
      "durationSeconds": 9.68,
      "sha256": "6ae841c6ccb11d682d8d7be7709db2ad325b1a4c21c1a0fa2794959d22d796c0"
    },
    {
      "kind": "narrative",
      "id": "m02_brief_line_2",
      "speaker": "ARIA",
      "locale": "en-US",
      "text": "Build a Barracks here, then train one rifle squad. That will make the post operational.",
      "voiceId": "Fi9tPTnEcbh3of7hOHC8",
      "voiceName": "Warline - ARIA Civic Relay",
      "assetPath": "Assets/Game/Audio/Narrative/M02EstablishBase/Voice/en/m02_brief_line_2.wav",
      "durationSeconds": 5.36,
      "sha256": "a83b1aaaf9efe2ca900366d3db272f4b5d9f8fd81dc3c154a428f5901a9759f4"
    },
    {
      "kind": "narrative",
      "id": "m02_brief_line_2",
      "speaker": "ARIA",
      "locale": "fa-IR",
      "text": "اینجا یک سربازخانه بسازید، سپس یک گروه تفنگدار آموزش دهید. با این کار پاسگاه دوباره فعال می‌شود.",
      "voiceId": "Fi9tPTnEcbh3of7hOHC8",
      "voiceName": "Warline - ARIA Civic Relay",
      "assetPath": "Assets/Game/Audio/Narrative/M02EstablishBase/Voice/fa/m02_brief_line_2_fa.wav",
      "durationSeconds": 8.4,
      "sha256": "6e98f113f59b5858105d6175086ab6e79d555bf07ed57df4b8847f6dc19e6342"
    },
    {
      "kind": "narrative",
      "id": "m02_brief_line_3",
      "speaker": "SAMIRA",
      "locale": "en-US",
      "text": "The clinic and city crews use this road. Holding the post keeps their route open.",
      "voiceId": "7uxeJ73HfJL9gOH2mttA",
      "voiceName": "Warline - Engineer Samira Haddad",
      "assetPath": "Assets/Game/Audio/Narrative/M02EstablishBase/Voice/en/m02_brief_line_3.wav",
      "durationSeconds": 4.72,
      "sha256": "a91b2adee489debc390dcf5e500f89c1bb16805a411fdc700ef83e973f70ace9"
    },
    {
      "kind": "narrative",
      "id": "m02_brief_line_3",
      "speaker": "SAMIRA",
      "locale": "fa-IR",
      "text": "درمانگاه و نیروهای خدمات شهری از این مسیر استفاده می‌کنند. حفظ پاسگاه، راه آن‌ها را باز نگه می‌دارد.",
      "voiceId": "7uxeJ73HfJL9gOH2mttA",
      "voiceName": "Warline - Engineer Samira Haddad",
      "assetPath": "Assets/Game/Audio/Narrative/M02EstablishBase/Voice/fa/m02_brief_line_3_fa.wav",
      "durationSeconds": 8.24,
      "sha256": "abd9b2272579cee3f98985347e64d76df1a1f5362570dcecc63d2e9579012110"
    },
    {
      "kind": "narrative",
      "id": "m02_comms_line_1",
      "speaker": "DALIA",
      "locale": "en-US",
      "text": "Enemy patrol approaching from the west. Hold the post and keep them away from the clinic road.",
      "voiceId": "MK1Zvh93428YrgOQ8Obr",
      "voiceName": "Warline - Major Dalia Rahim",
      "assetPath": "Assets/Game/Audio/Narrative/M02EstablishBase/Voice/en/m02_comms_line_1.wav",
      "durationSeconds": 5.36,
      "sha256": "9a439ae14757713936a0f48858fc8f430807abcc94c2b7a5203775c0780dc00c"
    },
    {
      "kind": "narrative",
      "id": "m02_comms_line_1",
      "speaker": "DALIA",
      "locale": "fa-IR",
      "text": "یک گشت دشمن از غرب نزدیک می‌شود. پاسگاه را حفظ کنید و نگذارید به مسیر درمانگاه برسند.",
      "voiceId": "MK1Zvh93428YrgOQ8Obr",
      "voiceName": "Warline - Major Dalia Rahim",
      "assetPath": "Assets/Game/Audio/Narrative/M02EstablishBase/Voice/fa/m02_comms_line_1_fa.wav",
      "durationSeconds": 7.44,
      "sha256": "d5fcd2d87846ad9e73efa597a1b84ee9663e7575fa44009ad468d3da12f39b74"
    },
    {
      "kind": "narrative",
      "id": "m02_comms_line_2",
      "speaker": "ARIA",
      "locale": "en-US",
      "text": "We found a city access list on one attacker. It was copied before the first strike.",
      "voiceId": "Fi9tPTnEcbh3of7hOHC8",
      "voiceName": "Warline - ARIA Civic Relay",
      "assetPath": "Assets/Game/Audio/Narrative/M02EstablishBase/Voice/en/m02_comms_line_2.wav",
      "durationSeconds": 5.12,
      "sha256": "d0574b56616b917bdef52e053524ffb6d8f2c7b0e69c1a4216b9fd7b5393ac3c"
    },
    {
      "kind": "narrative",
      "id": "m02_comms_line_2",
      "speaker": "ARIA",
      "locale": "fa-IR",
      "text": "یک فهرست دسترسی شهری همراه یکی از مهاجمان پیدا شد. این فهرست پیش از نخستین حمله کپی شده است.",
      "voiceId": "Fi9tPTnEcbh3of7hOHC8",
      "voiceName": "Warline - ARIA Civic Relay",
      "assetPath": "Assets/Game/Audio/Narrative/M02EstablishBase/Voice/fa/m02_comms_line_2_fa.wav",
      "durationSeconds": 8.4,
      "sha256": "062d36984eed5ce1d77fff6afddf349b93ed95fa2d7e19a0bfaced4cbf24f1ff"
    },
    {
      "kind": "narrative",
      "id": "m02_comms_line_3",
      "speaker": "SAMIRA",
      "locale": "en-US",
      "text": "It marks power stations, service gates, and tunnels. Someone stole it before the attack.",
      "voiceId": "7uxeJ73HfJL9gOH2mttA",
      "voiceName": "Warline - Engineer Samira Haddad",
      "assetPath": "Assets/Game/Audio/Narrative/M02EstablishBase/Voice/en/m02_comms_line_3.wav",
      "durationSeconds": 5.52,
      "sha256": "2498e2e6555722b44802f8c615f692b85e8d16b11d3a70246bf4674e4bc1a094"
    },
    {
      "kind": "narrative",
      "id": "m02_comms_line_3",
      "speaker": "SAMIRA",
      "locale": "fa-IR",
      "text": "در آن، پست‌های برق، ورودی‌های خدماتی و تونل‌ها مشخص شده‌اند. کسی پیش از حمله آن را دزدیده است.",
      "voiceId": "7uxeJ73HfJL9gOH2mttA",
      "voiceName": "Warline - Engineer Samira Haddad",
      "assetPath": "Assets/Game/Audio/Narrative/M02EstablishBase/Voice/fa/m02_comms_line_3_fa.wav",
      "durationSeconds": 8.0,
      "sha256": "b73e3d427da34cdb713d7d923d57663d9bcd467ee697478f28ff250011768c37"
    },
    {
      "kind": "narrative",
      "id": "m02_debrief_line_1",
      "speaker": "SAMIRA",
      "locale": "en-US",
      "text": "The post is active again. The clinic road and city response teams are connected.",
      "voiceId": "7uxeJ73HfJL9gOH2mttA",
      "voiceName": "Warline - Engineer Samira Haddad",
      "assetPath": "Assets/Game/Audio/Narrative/M02EstablishBase/Voice/en/m02_debrief_line_1.wav",
      "durationSeconds": 5.2,
      "sha256": "46d7551fa5ed8a01ca7761ada5bf67c4930fba086c4f3e69d6d0329c15cda2a9"
    },
    {
      "kind": "narrative",
      "id": "m02_debrief_line_1",
      "speaker": "SAMIRA",
      "locale": "fa-IR",
      "text": "پاسگاه دوباره فعال است. مسیر درمانگاه و تیم‌های امداد شهری دوباره به هم متصل شده‌اند.",
      "voiceId": "7uxeJ73HfJL9gOH2mttA",
      "voiceName": "Warline - Engineer Samira Haddad",
      "assetPath": "Assets/Game/Audio/Narrative/M02EstablishBase/Voice/fa/m02_debrief_line_1_fa.wav",
      "durationSeconds": 7.28,
      "sha256": "1a29ba7e58f6155bda14f993f4504ac1abf526d74d9ed4cb53e99521bf2564d8"
    },
    {
      "kind": "narrative",
      "id": "m02_debrief_line_2",
      "speaker": "DALIA",
      "locale": "en-US",
      "text": "Commander, Dalia Rahim. I will lead the ground response from this post.",
      "voiceId": "MK1Zvh93428YrgOQ8Obr",
      "voiceName": "Warline - Major Dalia Rahim",
      "assetPath": "Assets/Game/Audio/Narrative/M02EstablishBase/Voice/en/m02_debrief_line_2.wav",
      "durationSeconds": 4.96,
      "sha256": "716820aa89e77fe4a72eab61304713d2eca223b8b4e11c24e3f0f08b9df0059c"
    },
    {
      "kind": "narrative",
      "id": "m02_debrief_line_2",
      "speaker": "DALIA",
      "locale": "fa-IR",
      "text": "فرمانده، دالیا رحیم هستم. از این پاسگاه، هدایت نیروهای زمینی را بر عهده می‌گیرم.",
      "voiceId": "MK1Zvh93428YrgOQ8Obr",
      "voiceName": "Warline - Major Dalia Rahim",
      "assetPath": "Assets/Game/Audio/Narrative/M02EstablishBase/Voice/fa/m02_debrief_line_2_fa.wav",
      "durationSeconds": 7.04,
      "sha256": "4c21804c2a489e18db8406db3e49d47ca432b355ccf3015c6cc3712e77d82372"
    },
    {
      "kind": "narrative",
      "id": "m02_debrief_line_3",
      "speaker": "ARIA",
      "locale": "en-US",
      "text": "The warning network ahead has gone dark. Armored vehicles are moving toward the next sector.",
      "voiceId": "Fi9tPTnEcbh3of7hOHC8",
      "voiceName": "Warline - ARIA Civic Relay",
      "assetPath": "Assets/Game/Audio/Narrative/M02EstablishBase/Voice/en/m02_debrief_line_3.wav",
      "durationSeconds": 5.36,
      "sha256": "2dd85e2a3b5eaf0f2d44547ff04f384d1ff48e02615fc9d8eaaaa481cb510437"
    },
    {
      "kind": "narrative",
      "id": "m02_debrief_line_3",
      "speaker": "ARIA",
      "locale": "fa-IR",
      "text": "شبکه هشدار در مسیر پیش رو خاموش شده است. خودروهای زرهی به سمت منطقه بعدی حرکت می‌کنند.",
      "voiceId": "Fi9tPTnEcbh3of7hOHC8",
      "voiceName": "Warline - ARIA Civic Relay",
      "assetPath": "Assets/Game/Audio/Narrative/M02EstablishBase/Voice/fa/m02_debrief_line_3_fa.wav",
      "durationSeconds": 8.32,
      "sha256": "5a339e7439733d6b13529f2f9529ff178d27d2b26cfe6740375025cb060955d7"
    }
  ]
