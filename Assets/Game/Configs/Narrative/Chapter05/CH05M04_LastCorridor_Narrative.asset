  sequenceId: seq.ch05.m04.brief
  entryStateId: LastCorridor-brief-0
  defaultSkipDestinationId: LastCorridor-brief-complete
  states:
  - stateId: LastCorridor-brief-0
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: 4b6f740d733a46a6a59b6961951f52c3
      m_SubObjectName: CH05M04_LastCorridor-a-16x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    panel20x9Reference:
      m_AssetGUID: 4b6f740d733a46a6a59b6961951f52c3
      m_SubObjectName: CH05M04_LastCorridor-a-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: last_corridor-brief-01
      textKey: narrative.last_corridor.brief-01
      englishFallback: 'Fuel, medicine, the engineer, reinforcements and the physical
        authority keys must reach the city center. Samira and I set one plan: protect
        the relief vehicles and the military escort together. Clear the blockade
        before moving the column.'
      speaker: 1
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 17
      essentialCaption: 1
    continueStateId: LastCorridor-brief-1
    skipStateId: LastCorridor-brief-complete
    reducedMotionSupported: 1
    durationSeconds: 17
    motionPreset: 0
    locationTitleKey: 
    locationTitleFallback: 
    locationSubtitleKey: 
