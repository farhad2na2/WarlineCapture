      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: citywide_alert-brief-02
      textKey: narrative.citywide_alert.brief-02
      englishFallback: Mixed Ash Line and Vanguard groups are approaching on separate
        response lanes. Use radar to confirm the threats, split your defenders, and
        use the existing production controls for reinforcements. Allow time for units
        to reach the other front.
      speaker: 1
      voiceClip: {fileID: 8300000, guid: 34fd80f246fa5403d8ca556f62f1570c, type: 3}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 18.58
