  - stateId: NetworkCollapse-debrief-1
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: ca6721c4398d439c921c381ea5a97822
      m_SubObjectName: CH05M03_NetworkCollapse_Debrief-b-16x9
