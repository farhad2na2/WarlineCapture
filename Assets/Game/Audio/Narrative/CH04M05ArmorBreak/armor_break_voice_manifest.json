      "voiceName": "George - Warm, Captivating Storyteller (Nadir Qassem)",
      "assetPath": "Assets/Game/Audio/Narrative/CH04M05ArmorBreak/Voice/en/armor_break-comms-02.wav",
      "durationSeconds": 12.32,
      "sha256": "cd760a46a99e6b8742a59c3441ee47278bc8fec736912f944d61de417b899f20",
      "captionSha256": "95e586cfe6cf73837009d596322ae5cd23a51625f7b0d553b15bb03ae4747326"
    },
    {
      "deliveryProfile": "fa-conversational-v1",
      "voiceSettings": {
        "stability": 0.5,
        "similarity_boost": 0.75
      },
      "performanceDirection": "[conversational tone]",
      "kind": "narrative",
      "id": "armor_break-comms-02",
      "speaker": "QASSEM",
      "locale": "fa-IR",
      "text": "فرمانده، می‌تونی گروه فرماندهی من رو بشکنی. ولی نمی‌تونی تمام شهر رو جدا نگه داری. آریا دانش سامانه رو داره، تو اختیار اضطراری رو. سهرین هر دوتون رو به یک در می‌رسونه.",
      "voiceId": "JBFqnCBsd6RMkjVDRZzb",
      "voiceName": "George - Warm, Captivating Storyteller (Nadir Qassem)",
      "assetPath": "Assets/Game/Audio/Narrative/CH04M05ArmorBreak/Voice/fa/armor_break-comms-02.wav",
      "durationSeconds": 12.72,
      "sha256": "2135c0acda643b635af7046714d5200e02d3006ed1db694a2b69154a85ebeeb1",
      "captionSha256": "0fe236e61b7e0d03a863c8afbbeb50e6aac0db0533a57c160ac0720ca2f848d8"
    },
    {
