    color: rgb(157, 226, 61);
}

.cta-button {
    position: absolute;
    left: 8.6%;
    right: 8.6%;
    height: 7.7%;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_cta_secondary_dark_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 42;
    -unity-slice-right: 42;
    -unity-slice-top: 22;
    -unity-slice-bottom: 22;
    -unity-slice-scale: 0.52px;
}

.primary-cta {
    top: 73.5%;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_cta_primary_gold_frame.png");
}

.equip-cta {
    top: 82.6%;
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_category_button_selected_frame.png");
}

.close-cta {
    top: 91.5%;
}

.cta-icon,
.close-x {
    position: absolute;
    left: 21%;
    top: 20%;
    width: 13%;
    height: 60%;
    -unity-background-scale-mode: scale-to-fit;
}

.upgrade-cta-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_upgrades_chevrons.png");
}

.equip-cta-icon {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_icon_attack_reticle.png");
}

.close-x {
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(232, 222, 190);
}

.cta-label {
    position: absolute;
    left: 36%;
    right: 8%;
    top: 0;
    bottom: 0;
    font-size: 27px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(242, 232, 196);
}

.primary-cta .cta-label {
    color: rgb(37, 31, 13);
}

.footer-content {
    position: absolute;
    left: 9.8%;
    right: 20.0%;
    bottom: 2.3%;
    height: 8.2%;
}

.bottom-nav-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: row;
    justify-content: space-between;
}

.bottom-tab {
    position: relative;
    width: 19.2%;
    height: 100%;
}

.bottom-tab-frame {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_bottom_tab_default_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 38;
    -unity-slice-right: 38;
    -unity-slice-top: 21;
    -unity-slice-bottom: 21;
    -unity-slice-scale: 0.48px;
}

.bottom-tab-selected .bottom-tab-frame {
    background-image: url("../../Art/UI/Generated/Armory/LayeredOneGo/scn19_bottom_tab_selected_frame.png");
}

.bottom-tab-icon {
    position: absolute;
    left: 13%;
