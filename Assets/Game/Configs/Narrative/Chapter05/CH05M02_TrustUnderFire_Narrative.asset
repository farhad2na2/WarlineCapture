    missionContextFlags: []
  - stateId: TrustUnderFire-brief-2
    kind: 0
    panel16x9: {fileID: 0}
    panel20x9: {fileID: 0}
    panel16x9Reference:
      m_AssetGUID: 9bab85e848b144e0b87e13d0942f48f4
      m_SubObjectName: CH05M02_TrustUnderFire-c-16x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    panel20x9Reference:
      m_AssetGUID: 9bab85e848b144e0b87e13d0942f48f4
      m_SubObjectName: CH05M02_TrustUnderFire-c-20x9
      m_SubObjectType: 
      m_SubObjectGUID: 
      m_EditorAssetChanged: 0
    lines:
    - lineId: trust_under_fire-brief-03
      textKey: narrative.trust_under_fire.brief-03
      englishFallback: We are ready to receive the protected convoys at both shelters.
        Keep their approaches open. A civilian witness recognized the maintenance
        noise behind Qassem's broadcasts. Preserve the broadcast compound and its
        equipment so that report can be checked.
      speaker: 8
      voiceClip: {fileID: 0}
      femaleVoiceClip: {fileID: 0}
      neutralVoiceClip: {fileID: 0}
      startSeconds: 0
      deadlineSeconds: 18
      essentialCaption: 1
    continueStateId: TrustUnderFire-brief-complete
    skipStateId: TrustUnderFire-brief-complete
