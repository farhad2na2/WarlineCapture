.scn08-match-hud-content {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    -unity-font-definition: url("../../../Synty/InterfaceMilitaryCombatHUD/Fonts/Oxanium/Oxanium-Bold.ttf");
    color: rgb(238, 229, 198);
    background-color: rgba(0, 0, 0, 0);
}

.scn08-match-hud-content Button {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
}

.background-plate {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    background-color: rgba(0, 0, 0, 0);
}

.header-content,
.left-content,
.right-content,
.footer-content {
    position: absolute;
}

.header-content {
    left: 0.8%;
    right: 0.8%;
    top: 1.25%;
    height: 9.2%;
}

.left-content {
    left: 0.8%;
    top: 11.2%;
    width: 20.3%;
    height: 68.4%;
}

.right-content {
    right: 0.8%;
    top: 11.2%;
    width: 24.1%;
    height: 57.8%;
}

.footer-content {
    left: 0.8%;
    right: 0.8%;
    bottom: 1.25%;
    height: 18.7%;
    overflow: visible;
}

/* ── Frame helpers (absolute fill) ── */
.panel-frame,
.chip-frame,
.resource-frame,
.command-rail-frame,
.squad-tray-frame,
.minimap-frame,
.selected-portrait-frame,
.selected-health-frame,
.squad-health-frame,
.square-frame,
.rect-button-frame,
.command-button-frame,
.squad-card-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

/* ── 9-slice values NOW MATCH actual spriteBorder from .meta files ── */

.panel-frame {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_objectives_panel_frame.png");
    -unity-slice-left: 96;
    -unity-slice-right: 96;
    -unity-slice-top: 96;
    -unity-slice-bottom: 96;
}

.objectives-panel .panel-frame {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_objectives_panel_frame.png");
    -unity-slice-left: 96;
    -unity-slice-right: 96;
    -unity-slice-top: 96;
    -unity-slice-bottom: 96;
}

.selected-squad-panel .panel-frame {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_selected_panel_frame.png");
    -unity-slice-left: 96;
    -unity-slice-right: 96;
    -unity-slice-top: 96;
    -unity-slice-bottom: 96;
}

.chip-frame {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_chip_frame.png");
    -unity-slice-left: 56;
    -unity-slice-right: 56;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
}

.logo-panel .chip-frame,
.current-order-banner .chip-frame,
.threat-jump-panel .chip-frame,
.feedback-panel .chip-frame {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_wide_rail_frame.png");
    -unity-slice-left: 110;
    -unity-slice-right: 110;
    -unity-slice-top: 54;
    -unity-slice-bottom: 54;
}

.resource-frame {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_resource_chip_frame.png");
    -unity-slice-left: 90;
    -unity-slice-right: 90;
    -unity-slice-top: 60;
    -unity-slice-bottom: 60;
}

.square-frame {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_square_button_frame.png");
    -unity-slice-left: 150;
    -unity-slice-right: 150;
    -unity-slice-top: 150;
    -unity-slice-bottom: 150;
}

.command-button-frame {
    left: -4%;
    right: -4%;
    top: -2%;
    bottom: -2%;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_square_button_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 150;
    -unity-slice-right: 150;
    -unity-slice-top: 150;
    -unity-slice-bottom: 150;
}

.command-button:hover .command-button-frame,
.command-button:focus .command-button-frame,
.command-button-selected .command-button-frame {
    left: -7%;
    right: -7%;
    top: -5%;
    bottom: -5%;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_square_button_selected_frame.png");
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.rect-button-frame {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_rect_button_frame.png");
    -unity-slice-left: 90;
    -unity-slice-right: 90;
    -unity-slice-top: 60;
    -unity-slice-bottom: 60;
}

.squad-card-frame {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_squad_card_frame.png");
    -unity-slice-left: 92;
    -unity-slice-right: 92;
    -unity-slice-top: 86;
    -unity-slice-bottom: 86;
}

.squad-card:hover .squad-card-frame,
.squad-card:focus .squad-card-frame,
.squad-card-selected .squad-card-frame {
    left: -3%;
    right: -3%;
    top: -2.5%;
    bottom: -2.5%;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_squad_card_selected_frame.png");
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.squad-card:hover .squad-number,
.squad-card:focus .squad-number,
.squad-card-selected .squad-number,
.squad-card:hover .squad-card-title,
.squad-card:focus .squad-card-title,
.squad-card-selected .squad-card-title,
.squad-card:hover .squad-health-text,
.squad-card:focus .squad-health-text,
.squad-card-selected .squad-health-text {
    color: rgb(255, 239, 174);
}

.command-rail-frame,
.squad-tray-frame,
.minimap-frame {
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_panel_frame_large.png");
    -unity-slice-left: 92;
    -unity-slice-right: 92;
    -unity-slice-top: 62;
    -unity-slice-bottom: 62;
}

/* ── Header ── */

.header-content {
    overflow: visible;
}

.logo-panel {
    position: absolute;
    left: 0;
    top: 0;
    width: 23.6%;
    height: 100%;
}

.logo-lockup {
    position: absolute;
    left: 6.2%;
    right: 6.2%;
    top: 10%;
    bottom: 10%;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_logo_lockup.png");
    -unity-background-scale-mode: scale-to-fit;
}

.current-order-banner {
    position: absolute;
    left: 34.2%;
    top: 0;
    width: 19.3%;
    height: 100%;
}

.current-order-chevrons {
    position: absolute;
    left: 8%;
    top: 21%;
    width: 17%;
    height: 58%;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_icon_move_chevrons.png");
    -unity-background-scale-mode: scale-to-fit;
}

.current-order-text {
    position: absolute;
    left: 31%;
    right: 8%;
    top: 18%;
    height: 34%;
    font-size: 23px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(241, 232, 203);
}

.current-order-squad {
    position: absolute;
    left: 31%;
    right: 8%;
    bottom: 18%;
    height: 24%;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(209, 223, 146);
}

.resource-strip {
    position: absolute;
    right: 5.6%;
    top: 0;
    width: 38.2%;
    height: 100%;
}

.resource-slot {
    position: absolute;
    top: 14%;
    height: 72%;
    width: 23.2%;
}

.credits-slot { left: 3.2%; }
.fuel-slot { left: 27.1%; }
.supply-slot { left: 51%; }
.civilian-risk-slot { left: 75%; }

.resource-icon {
    position: absolute;
    left: 2%;
    top: 14%;
    width: 25%;
    height: 72%;
    -unity-background-scale-mode: scale-to-fit;
}

.resource-label {
    position: absolute;
    left: 32%;
    right: 0;
    top: 9%;
    height: 30%;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgba(237, 229, 199, 0.85);
}

.resource-value {
    position: absolute;
    left: 32%;
    right: 0;
    bottom: 6%;
    height: 46%;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(230, 196, 74);
}

.header-icon-button {
    position: absolute;
    right: 0;
    top: 0;
    width: 4.5%;
    height: 100%;
    overflow: visible;
    transform-origin: center;
    translate: 0 0;
    scale: 1 1;
    transition-property: translate, scale;
    transition-duration: 90ms;
    transition-timing-function: ease-out;
}

.header-icon-button:hover,
.header-icon-button:focus {
    translate: 0 -3px;
    scale: 1.045 1.045;
}

.header-icon-button:hover .square-frame,
.header-icon-button:focus .square-frame {
    left: -7%;
    right: -7%;
    top: -5%;
    bottom: -5%;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_square_button_selected_frame.png");
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.header-icon-button:hover .menu-icon,
.header-icon-button:focus .menu-icon {
    -unity-background-image-tint-color: rgb(255, 239, 174);
}

/* ── Left panel: Objectives + Selected Squad ── */

.objectives-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 34.2%;
}

.selected-squad-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 36.5%;
    bottom: 0;
}

.panel-title {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 6%;
    height: 13%;
    font-size: 25px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(241, 232, 203);
}

.objective-row {
    position: absolute;
    left: 8%;
    right: 8%;
    height: 14%;
    margin-top: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(170, 132, 45, 0.28);
}

#NeutralizeHostiles { top: 27%; }
#ProtectCivilians { top: 45%; }
#KeepLossesLow { top: 63%; }

.objective-icon {
    position: absolute;
    left: 0;
    top: 12%;
    width: 12.5%;
    height: 76%;
    -unity-background-scale-mode: scale-to-fit;
}

.objective-text {
    position: absolute;
    left: 18%;
    right: 0;
    top: 0;
    bottom: 0;
    font-size: 19px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(234, 228, 202);
}

.objectives-elapsed {
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: 6%;
    height: 12%;
    font-size: 19px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(184, 216, 64);
}

/* ── Selected squad panel ── */

.selected-badge {
    position: absolute;
    left: 7%;
    top: 5.5%;
    width: 12%;
    height: 9%;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_icon_squad_badge.png");
    -unity-background-scale-mode: scale-to-fit;
}

.selected-title {
    position: absolute;
    left: 22%;
    right: 7%;
    top: 5.2%;
    height: 7%;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(242, 232, 203);
}

.selected-subtitle {
    position: absolute;
    left: 22%;
    right: 7%;
    top: 13%;
    height: 4.6%;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgba(236, 229, 199, 0.78);
}

.selected-portrait-frame {
    left: 7%;
    right: 7%;
    top: 20.5%;
    height: 26%;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_rect_button_frame.png");
    -unity-slice-left: 90;
    -unity-slice-right: 90;
    -unity-slice-top: 60;
    -unity-slice-bottom: 60;
}

.selected-portrait {
    position: absolute;
    left: 4.4%;
    right: 4.4%;
    top: 9%;
    bottom: 9%;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_selected_squad_group_portrait.png");
    -unity-background-scale-mode: scale-and-crop;
}

.selected-health-frame {
    left: 8%;
    right: 8%;
    top: 50%;
    height: 5.6%;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_progress_track_frame.png");
    -unity-slice-left: 52;
    -unity-slice-right: 52;
    -unity-slice-top: 18;
    -unity-slice-bottom: 18;
}

.selected-health-fill {
    position: absolute;
    left: 5%;
    top: 24%;
    width: 61%;
    height: 52%;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_progress_fill_gold.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 52;
    -unity-slice-right: 52;
    -unity-slice-top: 18;
    -unity-slice-bottom: 18;
}

.selected-health-text {
    position: absolute;
    left: 68%;
    right: 5%;
    top: 0;
    bottom: 0;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: rgb(240, 232, 203);
}

.order-row {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 59%;
    height: 8%;
}

.order-label,
.order-value {
    position: absolute;
    top: 0;
    bottom: 0;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.order-label {
    left: 0;
    width: 30%;
    font-size: 15px;
    color: rgba(236, 229, 199, 0.75);
}

.order-value {
    left: 31%;
    right: 0;
    font-size: 20px;
    color: rgb(184, 216, 64);
}

.selected-command-buttons {
    position: absolute;
    left: 7%;
    right: 7%;
    top: 69%;
    height: 17.5%;
}

.selected-action-button {
    position: absolute;
    top: 0;
    width: 30%;
    height: 100%;
    overflow: visible;
    transform-origin: center;
    translate: 0 0;
    scale: 1 1;
    transition-property: translate, scale;
    transition-duration: 90ms;
    transition-timing-function: ease-out;
}

#ReturnButton { left: 0; }
#DestroyButton { left: 35%; }
#BoardButton { right: 0; }

.selected-action-button .rect-button-frame {
    -unity-slice-left: 90;
    -unity-slice-right: 90;
    -unity-slice-top: 60;
    -unity-slice-bottom: 60;
}

.selected-action-selected .rect-button-frame {
    left: -5%;
    right: -5%;
    top: -5%;
    bottom: -5%;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_rect_button_selected_frame.png");
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.selected-action-selected {
    translate: 0 -2px;
    scale: 1.035 1.035;
}

.selected-action-button:hover,
.selected-action-button:focus {
    translate: 0 -3px;
    scale: 1.045 1.045;
}

.selected-action-button:hover .rect-button-frame,
.selected-action-button:focus .rect-button-frame {
    left: -5%;
    right: -5%;
    top: -5%;
    bottom: -5%;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_rect_button_selected_frame.png");
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.selected-action-button:hover .return-icon,
.selected-action-button:focus .return-icon,
.selected-action-selected .return-icon,
.selected-action-button:hover .destroy-icon,
.selected-action-button:focus .destroy-icon,
.selected-action-selected .destroy-icon,
.selected-action-button:hover .board-icon,
.selected-action-button:focus .board-icon,
.selected-action-selected .board-icon {
    -unity-background-image-tint-color: rgb(255, 239, 174);
}

.selected-action-button:hover .selected-action-label,
.selected-action-button:focus .selected-action-label,
.selected-action-selected .selected-action-label {
    color: rgb(255, 239, 174);
}

.selected-action-button .return-icon,
.selected-action-button .destroy-icon,
.selected-action-button .board-icon {
    position: absolute;
    left: 23%;
    right: 23%;
    top: 12%;
    height: 45%;
    -unity-background-scale-mode: scale-to-fit;
}

.selected-action-label {
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: 8%;
    height: 24%;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(238, 231, 199);
}

/* ── Passenger drawer (hidden by default) ── */

.passenger-chip,
.transport-passenger-drawer {
    display: none;
}

.passenger-chip-visible,
.transport-passenger-drawer-visible {
    display: flex;
}

.passenger-chip {
    position: absolute;
    left: 7%;
    right: 7%;
    bottom: 5%;
    height: 7%;
    overflow: visible;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_chip_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 56;
    -unity-slice-right: 56;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
    transform-origin: center;
    translate: 0 0;
    scale: 1 1;
    transition-property: translate, scale;
    transition-duration: 90ms;
    transition-timing-function: ease-out;
}

.passenger-chip:hover,
.passenger-chip:focus {
    translate: 0 -2px;
    scale: 1.025 1.025;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_rect_button_selected_frame.png");
    -unity-slice-left: 90;
    -unity-slice-right: 90;
    -unity-slice-top: 60;
    -unity-slice-bottom: 60;
}

.passenger-chip-label {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 0;
    bottom: 0;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(238, 231, 199);
}

.transport-passenger-drawer {
    position: absolute;
    left: 101.5%;
    top: 36%;
    width: 92%;
    height: 62%;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_selected_panel_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 96;
    -unity-slice-right: 96;
    -unity-slice-top: 96;
    -unity-slice-bottom: 96;
}

.passenger-drawer-header {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 5%;
    height: 10%;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(230, 196, 74);
}

.passenger-empty-state {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 18%;
    height: 15%;
}

.passenger-empty-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgba(238, 231, 199, 0.64);
}

.passenger-scroll-view {
    position: absolute;
    left: 7%;
    right: 7%;
    top: 18%;
    bottom: 20%;
}

.passenger-content {
    flex-direction: column;
}

.passenger-footer {
    position: absolute;
    left: 7%;
    right: 7%;
    bottom: 6%;
    height: 11%;
}

.passenger-footer-button {
    position: absolute;
    top: 0;
    width: 47%;
    height: 100%;
    overflow: visible;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_rect_button_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 90;
    -unity-slice-right: 90;
    -unity-slice-top: 60;
    -unity-slice-bottom: 60;
    transform-origin: center;
    translate: 0 0;
    scale: 1 1;
    transition-property: translate, scale;
    transition-duration: 90ms;
    transition-timing-function: ease-out;
}

.passenger-footer-button:hover,
.passenger-footer-button:focus {
    translate: 0 -2px;
    scale: 1.035 1.035;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_rect_button_selected_frame.png");
}

.passenger-footer-button:hover .passenger-footer-label,
.passenger-footer-button:focus .passenger-footer-label {
    color: rgb(255, 239, 174);
}

#ExitAllButton {
    left: 0;
}

#CloseButton {
    right: 0;
}

.passenger-footer-label {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 0;
    bottom: 0;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(238, 231, 199);
}

.passenger-item-view {
    position: relative;
    height: 78px;
    margin-bottom: 7px;
    background-image: url("../../Art/UI/Generated/MatchHUD/TargetLockV02/scn08_v02_chip_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 56;
    -unity-slice-right: 56;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
}

.passenger-portrait {
    position: absolute;
